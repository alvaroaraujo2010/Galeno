<Application x:Class="GestorReportes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:vm="clr-namespace:GestorReportes.VistaModelo"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             StartupUri=""
             mc:Ignorable="d">
    <Application.Resources>
        <!--   <vm:LocalizadorVistaModelo x:Key="GHC_Locator" d:IsDataSource="True"/> Global View Model Locator-->
        <ResourceDictionary>
            <vm:LocalizadorVistaModelo x:Key="GHC_Locator"  d:IsDataSource="True"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sistema;component/Skins/EstiloSistema.xaml" />
                <ResourceDictionary Source="/Sistema;component/Skins/EstiloSistemaTouch.xaml" />
                <ResourceDictionary Source="/Sistema;component/Skins/EditorReportesDiseño.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
