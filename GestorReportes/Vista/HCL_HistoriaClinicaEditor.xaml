<Window x:Class="GestorReportes.Vista.VistaEditorReportes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GestorReportes.Vista" 
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        Title="Vista editor reportes" 
        Height="700" 
        Width="1024"  
        Name="MaxHCLEditorFormatos"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        ShowInTaskbar="False"
        WindowState="Maximized"
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="58" />
            <RowDefinition />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="1"
                Grid.Row="0"/>
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#FFB0AFAF">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE2E2E2" Offset="0"/>
                    <GradientStop Color="#FFE2E2E2" Offset="1"/>
                    <GradientStop Color="#FFD3D1D1" Offset="0.538"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Logo del Sistema -->
        <Image Name="ImgPpal" 
               Grid.Row="0" 
               Height="40" 
               Width="50"
               Stretch="Fill"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Margin="10,10,0,0"
               Source="/GestorReportes;component/Imagenes/Edt_edt_icono.png" />
        <!-- Titulo del Sistema -->
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Stretch" 
        	VerticalAlignment="Top"
        	Margin="84,15,130,0" 
        	FontSize="26"  
        	FontFamily="Segoe UI Light" Height="35">
            <Run Text="Editor de Formatos"/>
            <Run Language="es-co"/><Run Text=" "/>
            <LineBreak/>
            <Run Language="es-co"/></TextBlock>
        <!-- Boton Cerrar -->
        <Image MouseDown="CloseButton_Click" 
               Width="45"
               Margin="0,0,20,0" 
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="CloseButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
        <!-- Boton Minimizar -->
        <Image Name="MinimizeButton" 
                           MouseDown="MinimizeButton_Click" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Width="45"
                           Grid.Row="0"
                           Visibility="Visible"
                           Cursor="Hand"
                           TouchDown="MinimizeButton_TouchDown"
                           Source="/Sistema;component/Imagenes/sys_minimizar.png"
                           Margin="0,0,74,0" />
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="2"
               Margin="0,0,-1,-1" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" 
               Grid.RowSpan="3" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,52,02"
               Grid.Row="2"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="2"
                   FontFamily="Segoe UI Light"
                   Foreground="#FFFBF7F6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="10,0,0,4" 
                   Width="236" 
                   Height="21"/>
        <StackPanel Name="GridBarraDeTareas" 
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
                    Orientation="Horizontal"
              Grid.Row="1">
            <Button Name="cmdPlaMenu"
                        Margin="10,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtGestionGeneral}"
                        Click="fcvMostrarMenuContextual"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Opciones" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgAgrupar"
                    		Source="/GestorReportes;component/Imagenes/Edt_edt_configurar.png"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="MenuContextAgrupar" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                        <MenuItem Name="opCerraVistaPlantilla"
                                  Click="fcvCmdCerrarVista"
                                  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                  Header="Cerrar vista plantilla activa">
                            <MenuItem.Icon>
                                <Image Stretch="UniformToFill"
                                       Source="/GestorReportes;component/Imagenes/Edt_hist_anulado.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="Transparent" BorderBrush="Black" />
                        <MenuItem Name="opImportarDatos"
                                  Click="fcvPlantillaImportar"
                                  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                  Header="Importar datos...">
                            <MenuItem.Icon>
                                <Image Stretch="UniformToFill"
                                       Source="/GestorReportes;component/Imagenes/Edt_hist_importar.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Name="opExportarDatos"
                                  Click="fcvPlantillaExportar"
                                  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                  Header="Exportar datos...">
                            <MenuItem.Icon>
                                <Image Stretch="UniformToFill"
                                                           Source="/GestorReportes;component/Imagenes/Edt_hist_exportar.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
            <Button Name="cmdPlaNueva"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtGestionGeneral}"
                        Click="fcvPlantillaNueva"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Crear una nueva plantilla" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgPlaNueva"
                		Source="/GestorReportes;component/Imagenes/Edt_edt_adicionar.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdPlaAbrir"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtGestionGeneral}"
                        Click="fcvPlantillaAbrir"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Buscar una plantilla existente" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgPlaAbrirr"
                		Source="/GestorReportes;component/Imagenes/Edt_edt_abrir.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdPlaGuardar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtGestionGeneral}"
                        Click="fcvPlantillaGuardar"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Guardar plantilla" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgPlaGuardar"
                		Source="/GestorReportes;component/Imagenes/Edt_edt_guardar.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdImprimir"
                    Margin="2,4,0,0"
                    TabIndex="53"
                    Click="fcvPlantillaImprimir"
                    Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                    ToolTip="Imprimir..." >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgImprimir"
                		        Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"/>
                </StackPanel>
            </Button>
            <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
            <Button Name="cmdTecladoVirtual"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Click="fcvCmdTecladoVirtual"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Activar teclado en pantalla" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgTecladoVirtual"
                		Source="/GestorReportes;component/Imagenes/Edt_edt_teclado.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdPlaEstiloVista"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Click="fcvMostrarMenuContextual"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Estilo Vista" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgPagina"
                    		Source="/GestorReportes;component/Imagenes/Edt_edt_archivo.png"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu Name="MenuContextEstiloVista" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                        <Separator Background="Transparent" BorderBrush="Black" />
                        <MenuItem Name="opPlaEscritorioNavV"
                                  Click="fcvCmdNavEscritorioVertical"
                                  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                  Header="Escritorio Navegación Vertical">
                            <MenuItem.Icon>
                                <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Name="opPlaEscritorioNavH"
                                  Click="fcvCmdNavEscritorioHorizontal"
                                  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                  Header="Escritorio Navegación Horizontal">
                            <MenuItem.Icon>
                                <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Grid Name="grdCmdZoom" Margin="2,5,0,7" 
                              Width="80"
                              Height="45">
                <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                <TextBlock Name="lblCmdZoomVista"
                                       Margin="2,4,2,21" 
                                       Height="20"
                                       FontSize="12"
                                       Foreground="#FF30594E" 
                                       FontFamily="Segoe UI Symbol"> 
                                <Run Language="es-co" Text="Tamaño vista"/>
                </TextBlock>
                <Slider Name="objSliderZoom"
                        Value="1"
                        Minimum="0.4"
                        Maximum="2"
                        Height="25"
                        Width="70"
                        ValueChanged="fcvSliderZoomScroll"
                        Margin="2,20,2,0">
                </Slider>
            </Grid>
            <Grid Name="grdCmdMargenVertical" Margin="2,5,0,7" 
                              Width="80"
                              Height="45">
                <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                <TextBlock Name="lblCmdMargenVertical"
                                       Margin="6,4,2,23" 
                                       Height="20"
                                       FontSize="12"
                                       Foreground="#FF30594E" 
                                       FontFamily="Segoe UI Symbol"> 
                                <Run Language="es-co" Text="Vertical"/>
                </TextBlock>
                <Slider Name="objSliderMargenVertical"
                                    Value="10"
                                    ToolTip="Alineación vertical de la vista"
                                    ValueChanged="fcvSliderMargenZoomVista"
                                    Minimum="10"
                                    Maximum="650"
                                    Height="25"
                                    Width="70"
                                    Margin="0,20,0,0">
                </Slider>
            </Grid>
            <Grid Name="grdCmdMargenHorizontal" Margin="2,5,0,7" 
                              Width="80"
                              Height="45">
                <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                <TextBlock Name="lblCmdMargenHorizontal"
                                       Margin="6,4,2,23" 
                                       Height="20"
                                       FontSize="12"
                                       Foreground="#FF30594E" 
                                       FontFamily="Segoe UI Symbol"> 
                                <Run Language="es-co" Text="Horizontal"/>
                </TextBlock>
                <Slider Name="objSliderMargenHorizontal"
                                    Value="0"
                                    ToolTip="Alineación horizontal de la vista"
                                    ValueChanged="fcvSliderMargenZoomVista"
                                    Minimum="-500"
                                    Maximum="750"
                                    Height="25"
                                    Width="70"
                                    Margin="0,20,0,0">
                </Slider>
            </Grid>
            <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
            <Button Name="cmdEdtNuevaPagina"
                    Margin="2,4,0,0"
                    TabIndex="53"
                    Click="fcvCmdAddPaginaObjetos"
                    ToolTip="Agragar nueva pagina" 
                    Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgAddPagina" Source="/GestorReportes;component/Imagenes/Edt_edt_adicionarpagina.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtEliminarPagina"
                    Margin="2,4,0,0"
                    TabIndex="53"
                    Command="{Binding CmdEdtEliminarPagina}"
                    Click="fcvCmdEliminarPagina"
                    ToolTip="Eliminar pagina seleccionada" 
                    Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgDelPagina" Source="/GestorReportes;component/Imagenes/Edt_edt_eliminarpagina.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtEliminarObjeto"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtEliminarObjeto}"
                        Click="fcvCmdEliminarObjeto"
                        ToolTip="Eliminar objeto seleccionado" 
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgDelObjeto" Source="/GestorReportes;component/Imagenes/Edt_edt_eliminarobjeto.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtCopiar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtEliminarObjeto}"
                        ToolTip="Copiar" 
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgEdtCopiar" Source="/GestorReportes;component/Imagenes/Edt_edt_copiar.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtPegar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtEliminarObjeto}"
                        ToolTip="Pegar" 
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgEdtPegar" Source="/GestorReportes;component/Imagenes/Edt_edt_pegar.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtDeshacer"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtDeshacer}"
                        Click="fcvCmdDesHacerAtras"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Deshacer cambios" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgDeshacer"
                    		Source="/GestorReportes;component/Imagenes/Edt_edt_cancelar1.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtRehacer"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Command="{Binding CmdEdtRehacer}"
                        Click="fcvCmdDesHacerAdelante"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Rehacer cambios" >
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="imgRehacer"
                    		Source="/GestorReportes;component/Imagenes/Edt_edt_cancelar2.png"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEdtDesactAddObjeto"
                    Margin="2,4,0,0"
                    TabIndex="53"
                    Click="fcvCmdDesHacerAddObjeto"
                    ToolTip="Desactivar acción adicionar objetos" 
                    Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgDesObjeto" Source="/GestorReportes;component/Imagenes/Edt_edt_desactivaraddobjeto.png"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- Zona del Editor -->
        <ScrollViewer Name="PanelScroll" 
                      HorizontalAlignment="Stretch" 
                      Margin="0,0,40,0"
                      Width="Auto"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Focusable="False"
                      Height="Auto">
            <StackPanel Name="stkContenedor">
                <StackPanel Name="objReglaHorizontal" 
                            Focusable="False"
                            Width="970"
                            Height="39"
                            Background="Azure"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"/>
                <StackPanel Name="stkBase"
                            Focusable="False"
                            HorizontalAlignment="Center"
                            Orientation="Vertical"
                            Style="{StaticResource styleStackPanelEdtFondoEditor}">
                    <StackPanel.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Value, ElementName=objSliderZoom}" ScaleY="{Binding Value, ElementName=objSliderZoom}" />
                    </StackPanel.RenderTransform>
                    <WrapPanel x:Name="wraPlantilla" 
                                Focusable="False"
                                HorizontalAlignment="Center"
                                Style="{StaticResource styleWrapPanelEdtFondoEditor}" 
                                Orientation="Vertical"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- NAVEGADOR DE ETIQUETAS -->
        <Canvas Name="cvaEtiqueta" 
                Grid.Row="3"
                Margin="0,8,0,0"
                Height="90"
                Width="1020">
            <Grid Name="grdEtiquetaContenedor" Height="90" Width="1020" Margin="0" Canvas.Left="0" Canvas.Top="0">
                <Border Name="objBorderEtiqueta" BorderThickness="1" Background="#99000608"/>
                <WrapPanel Name="plaEtiqueta" 
                           Grid.Row="2"
                           Focusable="False"
                           Height="90"
                           Width="1020"
                           Style="{StaticResource styleWrapPanelEdtFondoEditor}" 
                           Orientation="Horizontal">
                </WrapPanel>
            </Grid>
        </Canvas>
        <!-- MENU PROPIEDADES CORTINA DE LA DERECHA-->
        <Grid Name="MenuPropideades" 
              Grid.Row="2"
              Grid.RowSpan="3"
              Width="40" 
              HorizontalAlignment="Right">
            <Image HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Stretch="UniformToFill"
                   Width="40"
                   Source="/Sistema;component/Imagenes/sys_panel_fondo7.png" />
            <Button Name="cmdPropideades"
                    Margin="-94,96,-90,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="50"
                    Click="fcvActivarVistaPropiedades"
                    ToolTip="Mostrar la ventana propiedades y Herramientas" 
                    RenderTransformOrigin="0.5,0.5" 
                    Width="224" 
                    Height="32" 
                    BorderBrush="#00082708">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Grid Width="205">
                        <Image x:Name="imgAdicionar"
                               Height="28"
                               Width="28"
                               HorizontalAlignment="Left"
                               Source="/GestorReportes;component/Imagenes/Edt_edt_modificar.png"/>
                        <TextBlock x:Name="lblPropideades" 
                                   Text="Propiedades y Herramientas"
                                   Margin="38,5,-14,5"/>
                    </Grid>
            </Button>
            <Canvas Name="ExtrasCanvas">
                <!-- Capa Cortina Propiedades  ExtrasGrid Height= 700-->
                <Grid Name="ExtrasGrid" 
                      Width="485"
                      Height="900"
                      Style="{StaticResource styleTabControlEdtGridCortinaPropiedades}"
                      Canvas.Left="35" 
                      Canvas.Top="-110" 
                      Margin="0">
                    <!-- IMAGEN ENCABEZADO DEL MENU -->
                    <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="#FFB0AFAF" Background="#E5446662">
                    </Border>
                    <Image HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="93,9,0,0" 
                           Height="30"
                           Width="30"
                           Source="/GestorReportes;component/Imagenes/Edt_edt_modificar.png" />
                    <TextBlock Name="lblVPropiedades"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                	           Width="295"
                	           Margin="125,10,0,0" FontSize="20" Foreground="White">
                	           <Run Language="es-co" Text="Propiedades"/>
                    </TextBlock>
                    <Button Name="cmdPropOcultar"
                            Margin="5,7,0,0"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaPropiedades"
                            ToolTip="Ocultar la ventan propiedades" 
                            Height="34" 
                            Width="38">
                            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                                        <Image Name="imgPropCerrar"
                                               Source="/GestorReportes;component/Imagenes/Edt_edt_contraer.png"
                                               Style="{StaticResource styleImagBotonesForm}"
                                               Stretch="UniformToFill"/>
                            </StackPanel>
                    </Button>
                    <Button Name="cmdPropAnclar"
                            Margin="49,7,0,0"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvAnclarVentanPropiedades"
                            ToolTip="Anclar ventan propiedades" 
                            Height="34" 
                            Width="38">
                        <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                            <Image Name="imgPropAnclar"
                                               Source="/GestorReportes;component/Imagenes/Edt_edt_anclar.png"
                                               Style="{StaticResource styleImagBotonesForm}"
                                               Stretch="UniformToFill"/>
                        </StackPanel>
                    </Button>
                    <TabControl Name="pagPropObjetos"
                                TabIndex="7"
                                TabStripPlacement="Right"
                                Style="{StaticResource styleTabControlEdtPropiedades}">
                        <TabItem Name="pagPropiedades"
                                 Visibility="Visible"
                                 Header="Propiedades"
                                 MouseLeftButtonDown="fcvClickTabsPropieades"
                                 Style="{StaticResource styleTabItemEdtPropiedades}">
                            <Grid Style="{StaticResource styleGridTabItemEdtPropiedades}" Margin="-1,0,1,8">
                                <Grid/>
                                <Button Visibility="Collapsed" Command="{Binding CmdPropCamposTexto}"/>
                                <ScrollViewer Name="PanelScrollProp"
                                              HorizontalAlignment="Stretch" 
                                              Width="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Hidden"
                                              CanContentScroll="False"
                                              Height="Auto" Margin="0,0,0,0">
                                    <StackPanel Name="stkPropBasicas">
                                        <Expander Name="PropBasicas" 
                                                  Header="Propiedades Básicas" 
                                                  HorizontalAlignment="Left" 
                                                  Margin="4,5,0,0" 
                                                  VerticalAlignment="Top" 
                                                  Width="430" 
                                                  FontSize="18"
                                                  Focusable="False"
                                                  IsExpanded="False">
                                            <StackPanel Background="#FFF7F7F7" Margin="0,0,0,5" Height="Auto">
                                                <Grid Name="propName" Style="{StaticResource styleTabControlEdtGridPropiedades}">
                                                    <TextBlock Name="lblPropTxtName"
                                                               ToolTip="Nombre unico interno del objeto"
                                                               Style="{StaticResource styleEtiquetasEdtPropiedades}"> 
                                                            <Run Language="es-co" Text="Nombre del Objeto"/>
                                                    </TextBlock>
                                                    <TextBox Name="txtPropTxtName"
                                                             TabIndex="60"
                                                             IsReadOnly="True"
                                                             Text="{Binding Path=PropTxtName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtPropiedades}"
                                                             Foreground="#FF999595"/>
                                                </Grid>
                                                <Grid Name="propTipoObjeto" Visibility="Visible" Style="{StaticResource styleTabControlEdtGridPropiedades}">
                                                    <TextBlock Name="lblPropTxtTipoObjeto"
                                                               ToolTip="Tipo Objeto (TextBox, ComboBox, Etiquetas y otros)"
                                                               Style="{StaticResource styleEtiquetasEdtPropiedades}"> 
                                                            <Run Language="es-co" Text="Tipo Objeto"/>
                                                    </TextBlock>
                                                    <TextBox Name="txtPropTxtTipoObjeto"
                                                             TabIndex="62"
                                                             Focusable="False"
                                                             Text="{Binding Path=PropTxtTipoObjeto, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtPropiedades}"
                                                             IsEnabled="{Binding GlgSIS_ModoEdicion}" />
                                                </Grid>
