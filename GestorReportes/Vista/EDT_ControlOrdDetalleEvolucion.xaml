<UserControl x:Class="GestorReportes.Vista.ControlDetalleEvolucion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="110" 
             d:DesignWidth="300"
             Height="Auto"
             Width="730">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0.9,0,0"
                BorderBrush="#FFD1CFCF"
                Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="txtProfesional" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
        		       FontSize="14"
                       Margin="5,11,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtFecha" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
                       Grid.RowSpan="2"
        		       FontSize="14"
                       Margin="5,11,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtHora" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="14"
                       Margin="5,11,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <Image Name="imgEstado"
                   Grid.Column="3"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,3,12,0"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
                   Stretch="UniformToFill"/>
            <Button Name="cmdEliminar"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Eliminar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialDel"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdVerRegistro"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Ver o editar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_edt_propiedades.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Name="txtEspecialidad" 
        		   HorizontalAlignment="Left" 
        		   VerticalAlignment="Top"
                   Grid.Row="2"
        		   FontSize="12"
                   Width="428"
                   Margin="5,3,0,0"
        		   FontFamily="Segoe UI Symbol"
        		   Foreground="#FF7E7B7B"/>
        <TextBox Name="txtObservacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Row="3"
                       IsReadOnly="True"
                       BorderThickness="0" 
        		       FontSize="12"
                       Margin="10,7,50,0"
                       Width="Auto"
                       Height="Auto" 
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       Background="Transparent" 
                       TextWrapping="Wrap"/>
    </Grid>
</UserControl>
