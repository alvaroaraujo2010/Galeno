<Window x:Class="GestorReportes.Vista.VistaCapturaReportes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GestorReportes.Vista" 
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        Title="Vista captura reportes" 
        Height="700" 
        Width="1024" 
        Name="VistaHistClinica"
        ShowInTaskbar="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="False" 
        Background="Transparent" 
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="Transparent"
                Margin="0,0,0,0"
                Grid.RowSpan="4"
                Grid.Row="0"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="0"
               Margin="0,0,-1,-1" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" 
               Grid.RowSpan="3" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,52,02"
               Grid.Row="1"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="1"
                   FontFamily="Segoe UI Light"
                   Foreground="#FFFBF7F6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="10,0,0,4" 
                   Width="236" 
                   Height="21"/>
        <Image Name="imgEscFotoPerfil"
               Grid.Row="1"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Stretch="UniformToFill"
               Margin="40,6,0,0" 
               Height="74"
               Width="80"
               Source="/Sistema;component/Imagenes/sys_usu01.png" />
        <TextBlock Name="lblEscNombrePaciente"
                   Grid.Row="1"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Width="680"
                   Margin="130,10,0,0" 
                   FontSize="24" 
                   Foreground="White" 
                   Height="30">
               <Run Language="es-co" Text="NOMBRE DEL PACIENTE"/>
        </TextBlock>
        <TextBlock Name="lblEscIdentificacion"
                   Grid.Row="1"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Width="580"
                   Margin="130,43,0,0" 
                   FontSize="12" 
                   Foreground="White" 
                   Height="20">
               <Run Language="es-co" Text="IDENTIFICACION:"/>
        </TextBlock>
        <TextBlock Name="lblEscAdmision"
                   Grid.Row="1"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Width="580"
                   Margin="130,60,0,0" 
                   FontSize="12" 
                   Foreground="White" 
                   Height="20">
               <Run Language="es-co" Text="ADMISION:"/>
        </TextBlock>
        <TextBlock Name="lblEscDatosMedicos"
                   Grid.Row="1"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Width="580"
                   Margin="130,60,0,0" 
                   FontSize="12"
                   Visibility="Collapsed"
                   Foreground="White" 
                   Height="20">
               <Run Language="es-co" Text="ESTADO DATOS MEDICOS"/>
        </TextBlock>
        <!-- ZONA DEL EDITOR -->
        <ScrollViewer Name="PanelScroll" 
                      HorizontalAlignment="Stretch" 
                      Margin="10,14,10,0"
                      Width="Auto"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="HorizontalFirst"
                      CanContentScroll="False"
                      Height="Auto">
            <StackPanel Name="stkContenedor">
                <StackPanel Name="stkBase"
                            Focusable="False"
                            Background="Transparent"
                            Orientation="Vertical"
                            Style="{StaticResource styleStackPanelEdtFondoEditor}">
                        <StackPanel.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Value, ElementName=objSliderZoom}" ScaleY="{Binding Value, ElementName=objSliderZoom}" />
                        </StackPanel.RenderTransform>
                        <WrapPanel x:Name="wraPlantilla" 
                                  Focusable="False"
                                  Style="{StaticResource styleWrapPanelEdtFondoEditor}" 
                                  Orientation="Vertical">
                        </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- MENU SUPERIOR -->
        <Grid Name="MenuSuperior"
              Grid.Row="0"
              Height="30"
              Margin="0,0,0,0"
              Background="Transparent"
              TouchEnter="fcvActivarVistaMenuSuperiorTouchEnter"
              MouseEnter="fcvActivarVistaMenuSuperiorMouseEnter">
            <Canvas Name="ExtMenuSuperior"
                    Width="Auto"
                    Height="30">
                <Grid Name="grdMenuSuperior" 
                      Width="Auto"
                      Height="110"
                      Canvas.Left="0" 
                      Canvas.Top="-110" 
                      Margin="0,0,0,0"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderThickness="0"
                            Background="White"
                            BorderBrush="#FFB0AFAF">
                    </Border>
                    <Border Grid.Row="1"
                            BorderThickness="1"
                            Background="#E5D3D3D3"
                            BorderBrush="#FFB0AFAF">
                    </Border>
                    <!-- Logo del Sistema -->
                    <Image Name="ImgPpal" 
                           Grid.Row="0" 
                           Height="40" 
                           Width="50"
                           Stretch="Fill"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="10,8,0,0"
                           Source="/GestorReportes;component/Imagenes/Edt_edt_icono.png" />
                    <!-- Titulo del Sistema -->
                    <TextBlock x:Name="TextTitulo" 
        	                    Grid.Row="0" 
        	                    HorizontalAlignment="Stretch" 
        	                    VerticalAlignment="Top"
        	                    Margin="84,15,130,0" 
        	                    FontSize="26"  
        	                    FontFamily="Segoe UI Light" Height="35">
                                <Run Text="Historia clinica"/>
                                <Run Language="es-co"/><Run Text=" "/>
                                <LineBreak/>
                                <Run Language="es-co"/></TextBlock>
                    <!-- Boton Minimizar -->
                    <Image Name="MinimizeButton" 
                           MouseDown="MinimizeButton_Click" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Width="45"
                           Grid.Row="0"
                           Visibility="Visible"
                           Cursor="Hand"
                           TouchDown="MinimizeButton_TouchDown"
                           Source="/Sistema;component/Imagenes/sys_minimizar.png"
                           Margin="0,0,74,0" />
                    <!-- Boton Cerrar -->
                    <Image MouseDown="CloseButton_Click" 
                           Width="45"
                           Margin="0,0,20,0" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Grid.Row="0" 
                           Cursor="Hand"
                           TouchDown="CloseButton_TouchDown"
                           Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
                    <!-- Barra de botones -->
                    <StackPanel Name="GridBarraDeTareas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Margin="0,0,70,0"
                                Grid.Row="1">
                        <Button Name="cmdPlaMenu"
                                Margin="10,4,0,0"
                                TabIndex="53"
                                Click="fcvMostrarMenuContextual"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Opciones" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgAgrupar"
                    		        Source="/GestorReportes;component/Imagenes/Edt_edt_configurar.png"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MenuContextAgrupar" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                                    <MenuItem Name="opCerraVistaPlantilla"
                                              Click="fcvCmdCerrarVista"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Cerrar vista plantilla activa">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                               Source="/GestorReportes;component/Imagenes/Edt_hist_anulado.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="Transparent" BorderBrush="Black" />
                                    <MenuItem Name="opImportarDatos"
                                              Click="fcvPlantillaImportar"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Importar datos...">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/GestorReportes;component/Imagenes/Edt_hist_importar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="opExportarDatos"
                                              Click="fcvPlantillaExportar"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Exportar datos...">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/GestorReportes;component/Imagenes/Edt_hist_exportar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                        <Button Name="cmdPlaNueva"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Visibility="Collapsed"
                                Click="fcvPlantillaNueva"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Nuevo registro de atención" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgPlaNueva"
                		        Source="/GestorReportes;component/Imagenes/Edt_edt_adicionar.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdPlaAbrir"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvBrowserBuscarHClinica"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Abrir historia clinica existente" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgPlaAbrirr"
                		        Source="/GestorReportes;component/Imagenes/Edt_edt_abrir.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdPlaGuardar"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvMostrarMenuContextual"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Guardar registro" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgPlaGuardar"
                		        Source="/GestorReportes;component/Imagenes/Edt_edt_guardar.png"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuContextAccRegistro" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                                    <MenuItem Name="opAccRegistroGuardar"
											  Click="fcvAccRegistroGuardar"
                                              IsEnabled="{Binding Path=GlgSIS_PuedeGuardar}"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
											  Header="Guardar registro">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_hist_abierto.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="opAccRegistroConfirmar"
											  Click="fcvAccRegistroConfirmar"
                                              IsEnabled="{Binding Path=GlgSIS_PuedeConfirmar}"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
											  Header="Guardar y Confirmar el registro">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_hist_confirmado.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="Transparent" BorderBrush="Black"/>
                                    <MenuItem Name="opAccRegistroAnular"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Anular registro">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_hist_anulado.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Name="cmdPlaImprimir"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvMostrarMenuContextual"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                IsEnabled="{Binding Path=GlgSIS_ModoVistaObjetos}"
                                ToolTip="Imprimir..." >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgPlaImprimir"
                		        Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuContextAccImprimir" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                                    <MenuItem Name="opAccRegistroImprimir"
											  Click="fcvAccImprimirVista"
                                              IsEnabled="{Binding Path=GlgSIS_PuedePrnDiseñoVista}"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
											  Header="Vista captura en pantalla - Imprimir...">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="Transparent" BorderBrush="Black"/>
                                    <MenuItem Name="opAccRegistroImprimirRp"
											  Click="fcvAccImprimirModoInforme"
                                              IsEnabled="{Binding Path=GlgSIS_PuedePrnTipoInforme}"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
											  Header="Reporte básico - Imprimir...">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="Transparent" BorderBrush="Black"/>
                                    <MenuItem Name="opAccRegistroPDF"
                                              IsEnabled="False"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
											  Header="Exportar a formato PDF">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/Edt_edt_pdf.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="opAccRegistroDOC"
                                              IsEnabled="False"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Exportar a formato Microsoft Word">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                   Source="/GestorReportes;component/Imagenes/Edt_hist_anulado.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                        <Button Name="cmdEdtFinAtencion"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvAccRegFinalizarAtencion"
                                IsEnabled="{Binding Path=GlgSIS_PuedeFinAtencion}"
                                ToolTip="Finalizar Atención ambulatoria del paciente activo" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgFinAtenbjeto" Source="/GestorReportes;component/Imagenes/Edt_edt_gestionado.png"/>
                            </StackPanel>
                        </Button>
                        <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                        <Button Name="cmdEdtEliminarObjeto"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Command="{Binding CmdEdtEliminarObjeto}"
                                Click="fcvCmdEliminarObjeto"
                                ToolTip="Eliminar objeto seleccionado" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgDelObjeto" Source="/GestorReportes;component/Imagenes/Edt_edt_eliminarobjeto.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdEdtCopiar"
                            Visibility="Collapsed"
                            Margin="2,4,0,0"
                            TabIndex="53"
                            Command="{Binding CmdEdtEliminarObjeto}"
                            ToolTip="Copiar" 
                            Style="{StaticResource styleButtonImgEdtFormTouch}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgEdtCopiar" Source="/GestorReportes;component/Imagenes/Edt_edt_copiar.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdEdtPegar"
                            Visibility="Collapsed"
                            Margin="2,4,0,0"
                            TabIndex="53"
                            Command="{Binding CmdEdtEliminarObjeto}"
                            ToolTip="Pegar" 
                            Style="{StaticResource styleButtonImgEdtFormTouch}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgEdtPegar" Source="/GestorReportes;component/Imagenes/Edt_edt_pegar.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdEdtDeshacer"
                            Visibility="Collapsed"
                            Margin="2,4,0,0"
                            TabIndex="53"
                            Command="{Binding CmdEdtDeshacer}"
                            Click="fcvCmdDesHacerAtras"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            ToolTip="Deshacer cambios" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgDeshacer"
                    		        Source="/GestorReportes;component/Imagenes/Edt_edt_cancelar1.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdEdtRehacer"
                            Visibility="Collapsed"
                            Margin="2,4,0,0"
                            TabIndex="53"
                            Command="{Binding CmdEdtRehacer}"
                            Click="fcvCmdDesHacerAdelante"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            ToolTip="Rehacer cambios" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgRehacer"
                    		        Source="/GestorReportes;component/Imagenes/Edt_edt_cancelar2.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdEdtDesactAddObjeto"
                            Margin="2,4,0,0"
                            TabIndex="53"
                            Click="fcvCmdDesHacerAddObjeto"
                            ToolTip="Desactivar acción adicionar objetos" 
                            Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgDesObjeto" Source="/GestorReportes;component/Imagenes/Edt_edt_desactivaraddobjeto.png"/>
                            </StackPanel>
                        </Button>
                        <Grid Name="grdCmdAdornos" Margin="2,6,0,7" 
                              Width="87"
                              Visibility="Collapsed"
                              Height="47">
                            <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                            <TextBlock Name="lblCmdAdornos"
                                       Margin="1,1,3,29" 
                                       Height="20"
                                       FontSize="11"
                                       Foreground="#FF30594E" 
                                       FontFamily="Segoe UI Symbol"> 
                                <Run Language="es-co" Text="Tamaño Control"/>
                            </TextBlock>
                            <ComboBox Name="cboCmdTamAdornos"
                                      TabIndex="69"
                                      Style="{StaticResource styleComboBoxEdtPropiedades}"
                                      SelectedIndex="0"
                                      FontSize="16"
                                      ToolTip="Tamaño Control de arrastre objetos"
                                      SelectionChanged="fcvSetObjSeleccionComboBoxPropiedad"
                                      ItemsSource="{Binding PropCboTamAdornos}"
                                      SelectedValuePath="Codigo" 
                                      Margin="2,17,0,0" 
                                      Width="82" 
                                      Height="28">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Descripcion}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Button Name="cmdTecladoVirtual"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvCmdTecladoVirtual"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Activar teclado en pantalla" >
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgTecladoVirtual"
                		               Source="/GestorReportes;component/Imagenes/Edt_edt_teclado.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdPlaEstiloVista"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                Click="fcvMostrarMenuContextual"
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                                ToolTip="Estilo Vista" >
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="imgPagina"
                    		        Source="/GestorReportes;component/Imagenes/Edt_edt_archivo.png"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Name="MenuContextEstiloVista" Style="{StaticResource styleMenuContextButtonEdtTouch}">
                                    <MenuItem Name="opPlaEscritorioNavV"
                                              Click="fcvCmdNavEscritorioVertical"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Escritorio Navegación Vertical">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="opPlaEscritorioNavH"
                                              Click="fcvCmdNavEscritorioHorizontal"
											  Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Escritorio Navegación Horizontal">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="Transparent" BorderBrush="Black" />
                                    <MenuItem Name="opPlaPaginasOrientacionV"
                                              Style="{StaticResource styleMenuItemContextButtonEdtTouch}"
                                              Header="Paginas Orientación Vertical">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="opPlaPaginasOrientacionH"
                                              Style="{StaticResource styleMenuItemContextButtonTouch}"
                                              Header="Paginas Orientación Horizontal">
                                        <MenuItem.Icon>
                                            <Image Stretch="UniformToFill"
                                                           Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Name="cmdEdtElimarRegistro"
                                Margin="2,4,0,0"
                                TabIndex="53"
                                IsEnabled="{Binding Path=GlgSIS_PuedeEliminarReg}"
                                Click="fcvCmdEliminarRegistroHc"
                                ToolTip="Eliminar formato activo" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgElimarRegistro" Source="/GestorReportes;component/Imagenes/Edt_edt_eliminaregistro.png"/>
                            </StackPanel>
                        </Button>
                        <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                        <Grid Name="grdCmdZoom" Margin="2,5,0,7" 
                              Width="80"
                              Height="45">
                            <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                            <TextBlock Name="lblCmdZoomVista"
                                       Margin="2,4,2,21" 
                                       Height="20"
                                       FontSize="12"
                                       Foreground="#FF30594E" 
                                       FontFamily="Segoe UI Symbol"> 
                                <Run Language="es-co" Text="Tamaño vista"/>
                            </TextBlock>
                            <Slider Name="objSliderZoom"
                                    Value="1.3"
                                    Minimum="0.4"
                                    Maximum="1.8"
                                    Height="25"
                                    Width="70"
                                    ValueChanged="fcvSliderZoomScroll"
                                    Margin="2,20,2,0">
                             </Slider>
                        </Grid>
                        <Grid Name="grdCmdMargenVertical" Margin="2,5,0,7" 
                              Width="80"
                              Height="45">
                            <Border BorderThickness="0.9"
                                    BorderBrush="White"/>
                            <TextBlock Name="lblCmdMargenVertical"
                                       Margin="6,4,2,23" 
                                       Height="20"
                                       FontSize="12"
