<UserControl x:Class="GestorReportes.Vista.ControlFirmaProfesional"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="90" 
             Width="280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        <Image Name="ImgFirma"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               Grid.RowSpan="3"
               Source="/GestorReportes;component/Imagenes/Edt_controles_firma.png"/>
        <TextBox Name="txtNombreFondo"  
                 Margin="3,3,2,0"
                 Grid.Row="1"
                 FontSize="9"
                 TextAlignment="Center"
                 BorderThickness="0"
                 Background="Transparent"
                 Text="[NOMBRE DEL PROFESIONAL]"
                 IsReadOnly="True"
                 Foreground="White"/>
        <TextBox Name="txtNombre" 
                 Margin="2,3,2,0"
                 Grid.Row="1"
                 FontSize="9"
                 Background="Transparent"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Text="[NOMBRE DEL PROFESIONAL]"/>
        <TextBox Name="txtEspecialidad" 
                 Margin="2,1,2,2"
                 Grid.Row="2"
                 FontSize="8"
                 BorderThickness="0"
                 Background="Transparent"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 Text="[ESPECIALIDAD]"/>
        <TextBox Name="txtRegistro" 
                 Margin="2,1,2,2"
                 Grid.Row="3"
                 FontSize="8"
                 Visibility="Collapsed"
                 BorderThickness="0"
                 Background="Transparent"
                 TextAlignment="Center"
                 IsReadOnly="True"
                 Text="[REGISTRO]"/>
    </Grid>
</UserControl>
