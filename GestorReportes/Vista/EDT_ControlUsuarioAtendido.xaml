<UserControl x:Class="GestorReportes.Vista.ControlUsuarioAtendido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="120"
             Width="700"
             d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="White"
                Visibility="Collapsed"
                Margin="0,0,0,0"
                BorderThickness="0.8"
                BorderBrush="#FFD1CFCF"
                Grid.RowSpan="5"
                Grid.Row="0"/>
        <!-- FILA 1 - DATOS USUARIO  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="33"/>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="70*"/>
            </Grid.ColumnDefinitions>
            <!-- Identificación -->
            <TextBlock Name="lblG1Sia_nroide_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Identificación"/>
            </TextBlock>
            <!-- Tipo ide -->
            <TextBox Name="txtG1Sia_tipide_tide" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Numero Ide -->
            <TextBox Name="txtG1Sia_nroide_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="2"/>
            <!-- Nombre -->
            <TextBlock Name="lblG1Sia_nomusu_usua" Grid.Column="3" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Nombre"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_nomusu_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="4"/>
        </Grid>
        <!-- FILA 2 - DATOS USUARIOS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>
            <!-- Fecha nacimiento -->
            <TextBlock Name="lblSia_fecnac_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Fecha nacimiento"/>
            </TextBlock>
            <TextBox Name="txtSia_fecnac_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Sexo -->
            <TextBlock Name="lblSis_codsex_sexo" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Sexo"/>
            </TextBlock>
            <TextBox Name="txtSis_codsex_sexo" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
            <!-- Edad -->
            <TextBlock Name="lblSia_edaymd_usua" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Edad"/>
            </TextBlock>
            <TextBox Name="txtSia_edaymd_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5"/>
        </Grid>
        <!-- FILA 2 - DATOS DIRECCION -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="60*"/>
            </Grid.ColumnDefinitions>
            <!-- Telefono -->
            <TextBlock Name="lblSia_telres_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Telefono"/>
            </TextBlock>
            <TextBox Name="txtSia_telres_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Direccion -->
            <TextBlock Name="lblSia_dirres_usua" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Dirección"/>
            </TextBlock>
            <TextBox Name="txtSia_dirres_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
        </Grid>
        <!-- FILA 3 - TIPO DE ATENCION -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="60*"/>
            </Grid.ColumnDefinitions>
            <!-- Tipo de atencion -->
            <TextBlock Name="lblSia_idesec_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Secuencial unico"/>
            </TextBlock>
            <TextBox Name="txtSia_idesec_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Diagnostico de ingreso -->
            <TextBlock Name="lblSia_codeps_teps" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="EPS"/>
            </TextBlock>
            <TextBox Name="txtSia_codeps_teps" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
        </Grid>
        <!-- FILA 4 - HISTORIA CLINICA -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="60*"/>
            </Grid.ColumnDefinitions>
            <!-- Numero Historia clinica -->
            <TextBlock Name="lblHcl_nrohis_hicl" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Historia clinica"/>
            </TextBlock>
            <TextBox Name="txtHcl_nrohis_hicl" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Municipio -->
            <TextBlock Name="lblSis_nommun_muni" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Municipio"/>
            </TextBlock>
            <TextBox Name="txtG1Sis_nommun_muni" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>

        </Grid>
    </Grid>
</UserControl>
