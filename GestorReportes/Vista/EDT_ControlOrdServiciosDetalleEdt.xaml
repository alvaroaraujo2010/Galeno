<UserControl x:Class="GestorReportes.Vista.ControlOrdServiciosDetalleEdt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="85" 
             d:DesignWidth="750"
             Height="Auto"
             Width="780">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!-- ENCABEZADO DETALLES MEDICAMENTOS -->
        <Border Name="detFondo" 
                    Background="White"
                    Visibility="Visible"
                    BorderThickness="0"
                    Grid.Row="1"/>
        <TextBlock Name="lblTituloIndicacion"
                   Grid.Row="1"
                   FontSize="14"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Left"
                   Width="270"
                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                 <Run Language="es-co" Text="Indicación"/>
        </TextBlock>
        <Grid Name="grdTituloDetalle" 
                  Grid.Row="1"
                  Visibility="Visible"
                  Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="lblMedicamento"
                     Margin="5,0,5,0"
                     BorderThickness="0,0,1,0"
                     FontWeight="Bold"
                     Focusable="False"
                     Grid.Column="0"
                    Text="Medicamentos"/>
            <TextBox Name="lblCantidad"
                     FontWeight="Bold"
                     BorderThickness="0,0,1,0"
                     Focusable="False"
                     Text="Cantidad"
                     Grid.Column="1"/>
            <TextBox Name="lblDosificacion"
                     FontWeight="Bold"
                     BorderThickness="0,0,1,0"
                     Focusable="False"
                     Grid.Column="2"
                     Text="Dosificación"/>
            <TextBox Name="lblDias"
                     FontWeight="Bold"
                     BorderThickness="0"
                     Focusable="False"
                     Text="Días"
                     Grid.Column="3"/>
        </Grid>
        <Border BorderThickness="0,0,0,0.9"
                BorderBrush="#FFB0AFAF"
                Grid.Row="2"
                Grid.RowSpan="2"/>
        <Image Name="imgEstado"
               Grid.Row="2"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,2,12,0"
               Width="20"
               Height="20"
               Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
               Stretch="UniformToFill"/>
        <Button Name="cmdEliminar"
                Margin="0,0,8,0"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Background="Transparent"
                Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                TabIndex="50"
                ToolTip="Eliminar registro" 
                Height="30" 
                Cursor="Hand"
                Width="40">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="0,0,55,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                TabIndex="50"
                ToolTip="Modificar el registro" 
                Height="30"
                Grid.Row="2"
                Cursor="Hand"
                Width="40">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEditar"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Name="grdMedicamento" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtDetalle" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Margin="2,5,3,0"
                       Width="Auto"
                       Background="Transparent" 
                       BorderThickness="0"
        		       FontFamily="Segoe UI Symbol"
                       IsReadOnly="True"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBox Name="txtCantidad" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
                       IsReadOnly="True"
        		       FontSize="12"
                       Margin="10,5,8,5"
                       Width="Auto"
                       Background="Transparent" 
                       BorderThickness="0"
                       TextAlignment="Center"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBox Name="txtObservacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Background="Transparent" 
                       BorderThickness="0"
                       Margin="3,5,10,0"
                       IsReadOnly="True"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBox Name="txtDias" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="3"
                       IsReadOnly="True"
                       Background="Transparent" 
                       BorderThickness="0"
        		       FontSize="12"
                       Margin="8,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
        </Grid>
        <Grid Name="grdIndicacion" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtInidicacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Background="Transparent" 
                       BorderThickness="0"
                       IsReadOnly="True"
                       Margin="2,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
