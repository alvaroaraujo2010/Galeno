<Window x:Class="GestorReportes.Vista.VistaMaestroDiagnosticos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:GestorReportes.Vista" 
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Maestro Actividades tratamiento odontologico"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="730"
        Height="700"
        AllowsTransparency="True"
        Background="{x:Null}" 
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Name="grdPrincipal" Background="#66000E0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="grdCol1" Width="*"/>
            <ColumnDefinition Name="grdCol2" Width="730"/>
            <ColumnDefinition Name="grdCol3" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="700"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="42" />
                <RowDefinition Height="600" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="4"
                Grid.Row="1">
            </Border>
            <Image HorizontalAlignment="Left"
                   Height="40"
                   Width="730"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Grid.Row="1"
                   Source="/Sistema;component/Imagenes/sys_barratitulo.png"
                   StretchDirection="UpOnly"
                   Stretch="Fill"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <Image HorizontalAlignment="Left"
                   Height="50"
                   Margin="5,1,0,0"
                   VerticalAlignment="Top"
                   Width="50"
                   Grid.RowSpan="2"
                   Source="/Sistema;component/Imagenes/sis_logo40.png"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <TextBlock Name="txtTituloVentana"
                   Text="Actividades tratamiento odontologico"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdSalir_Click"
                    ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                    </Image>
                </StackPanel>
            </Button>
            <Image MouseDown="btnCerrar_KeyDown"
                   Style="{StaticResource styleImgButtonCerrarForm}"
                   Source="/Sistema;component/Imagenes/sis_cerrar40.png"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
                   Cursor="Hand"/>
            <Image HorizontalAlignment="Left"
               Height="50"
               Width="728"
               Margin="1,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="3"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
            <!-- Filtro -->
            <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFILTRO}" Grid.RowSpan="2"/>
            <!-- Fin Filtro-->
            <!-- Filtro -->
            <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista2"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFILREL}" Grid.RowSpan="2"/>
            <!-- Fin Filtro-->
            <!-- Perfil Usuario -->
            <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
            <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
            <!-- Fin Perfil Usuario -->
            <!-- Control modo edicion formulario -->
            <TextBox Name="lblFormModoPopup"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrSIS_FormModoPopup,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
            <!-- Fin Control modo edicion formulario -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,2,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblG1odn_nroreg_odac"
                                   Grid.Column="0"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                 <Run Language="es-co" Text="Actividad"/>
                        </TextBlock>
                        <TextBox Name="txtG1Odn_nroreg_odac"
                                             TabIndex="1"
                                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             Focusable="False"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblG1odn_fecact_odac"
                                   Grid.Column="0"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                <Run Language="es-co" Text="Fecha"/>
                        </TextBlock>
                        <Grid Grid.Column="1"
                                      Style="{StaticResource styleDatePickerGridFormResize}">
                            <Border Style="{StaticResource styleDatePickerBorder}"/>
                            <TextBox Name="txtG1Odn_fecact_odac"
                                             TabIndex="1"
                                             Style="{StaticResource styleTextBoxFormFecha}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             TextChanged="fcvActualizarDatePicker"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                            <DatePicker Name="dpkG1Odn_fecact_odac"
                                            IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                            Style="{StaticResource styleDatePickerForm}"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblG1hcl_tiptur_hctu"
                                   Grid.Column="0"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                 <Run Language="es-co" Text="Turno"/>
                        </TextBlock>
                        <TextBox Name="txtG1Hcl_tiptur_hctu"
                                                 TabIndex="2"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 TextChanged="fcvValidacionTexto"
                                                 Grid.Column="1"
                                                 KeyDown="txtG1Hcl_tiptur_hctu_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                        <Button Name="cmdG1Hcl_tiptur_hctu"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="104"
                                                Click="cmdG1Hcl_tiptur_hctu_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Codigo clasificacion turnos diarios para la prestacion de servicios medicos"/>
                        <TextBox Name="txtG1Hcl_destur_hctu"
                                                 TabIndex="104"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblG1sia_codpfa_prof"
                                   Grid.Column="0"
                                   Style="{StaticResource styleEtiquetasFormResize}" Height="16" Margin="4,6,2,6">
                                 <Run Language="es-co" Text="Profesional"/>
                        </TextBlock>
                        <TextBox Name="txtG1Sia_nompro_prof"
                                             TabIndex="102"
                                             Text="{Binding Path=G1Sia_nompro_prof, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                                             Grid.Column="3"
                                             Focusable="False"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus" Margin="4,4,2,4"/>
                        <TextBox Name="txtG1Sia_codpfa_prof"
                                             TabIndex="3"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             IsEnabled="{Binding Path=llgModoEdicion}"
                                             TextChanged="fcvValidacionTexto"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             KeyDown="txtG1Sia_codpfa_prof_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                        <Button Name="cmdG1Sia_codpfa_prof"
                                            Content="..."
                                            Style="{StaticResource styleButtonMiniFormBrows}"
                                            TabIndex="102"
                                            Click="cmdG1Sia_codpfa_prof_Click"
                                            Grid.Column="2"
                                            IsEnabled="{Binding Path=llgModoEdicion}"
                                            ToolTip="Código del Profesional  que realiza actividad" Margin="2,3"/>
                    </Grid>
                </Grid>
                <TabControl Name="pagPaginas"
                            Style="{StaticResource styleTabControlZonaForm}"
                            TabIndex="4"
                            Grid.Row="2">
                    <TabItem Name="pagActividad"
                             Header="Actividad"
                             Style="{StaticResource styleTabItemZonaForm}">
                        <Grid Style="{StaticResource styleGridTabItemZona}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="100"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="lblG1cto_seccon_cont"
                                                   ToolTip="Secuencial Unico de Contrato"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Número Contrato"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Cto_seccon_cont"
                                                 TabIndex="4"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TextChanged="fcvValidacionTexto"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 KeyDown="txtG1Cto_seccon_cont_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <Button Name="cmdG1Cto_seccon_cont"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="101"
                                                Click="cmdG1Cto_seccon_cont_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Secuencial Unico de Contrato"/>
                                    <TextBox Name="txtG1Cto_nrocon_cont"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="lblG1cto_nrocon_cont"
                                                   ToolTip="Descripcion contrato"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Descripcion contrato"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Cto_descon_cont"
                                                 TabIndex="101"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="txtG1Sia_deseps_teps"
                                                 TabIndex="103"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <Button Name="cmdG1Sia_codeps_teps"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="103"
                                                Click="cmdG1Sia_codeps_teps_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Codigo de Eps o Asegurador según codigos asignados por la supersalud"/>
                                    <TextBlock Name="lblG1sia_codeps_teps"
                                                   ToolTip="Codigo de Eps o Asegurador según codigos asignados por la supersalud"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Código EPS"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Sia_codeps_teps"
                                                 TabIndex="5"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TextChanged="fcvValidacionTexto"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 KeyDown="txtG1Sia_codeps_teps_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                </Grid>
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="txtG1Sia_desare_aser"
                                                 TabIndex="105"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <Button Name="cmdG1Sia_codare_aser"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="105"
                                                Click="cmdG1Sia_codare_aser_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Código área donde se prestan los servicios"/>
                                    <TextBlock Name="lblG1sia_codare_aser"
                                                   ToolTip="Código área donde se prestan los servicios"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Area de servicios"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Sia_codare_aser"
                                                 TabIndex="6"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TextChanged="fcvValidacionTexto"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 KeyDown="txtG1Sia_codare_aser_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                </Grid>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="txtG1Fcm_descpr_cpro"
                                                 TabIndex="106"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <Button Name="cmdG1Fcm_codcpr_cpro"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="106"
                                                Click="cmdG1Fcm_codcpr_cpro_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Codigo centro de produccion donde se presta el servicio"/>
                                    <TextBlock Name="lblG1fcm_codcpr_cpro"
                                                   ToolTip="Codigo centro de produccion donde se presta el servicio"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Centro de producción"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Fcm_codcpr_cpro"
                                                 TabIndex="7"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TextChanged="fcvValidacionTexto"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 KeyDown="txtG1Fcm_codcpr_cpro_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                </Grid>
                                <Grid Grid.Row="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="700"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="lblG1odn_observ_odac"
                                               HorizontalAlignment="Left"
                                               Grid.Row="0"
                                               Style="{StaticResource styleEtiquetasFormResize}" 
                                               Height="20" 
                                               FontSize="14"
                                               Margin="4,5,0,0" Width="142">
                                             <Run Language="es-co" Text="Observación"/>
                                    </TextBlock>
                                    <TextBox Name="txtG1Odn_observ_odacXXX"
                                             TabIndex="8"
                                             Visibility="Collapsed"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TextChanged="fcvValidacionTexto"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus" 
                                             Margin="4,10,21,23" 
                                             FontSize="14"
                                             Grid.Row="1"
                                             TextWrapping="Wrap"
                                             Height="142"/>
                                    <RichTextBox Name="txtG1Odn_observ_odac"
                                                 TabIndex="8"
                                                 FontSize="14"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TouchEnter="fcvTouchEnterTecladoRt"
                                                 TextChanged="fcvValidacionTextoRt"
                                                 KeyDown="fcvMoverFocus_KeyDownRt"
                                                 GotFocus="fcvTextBox_GotFocusRt" 
                                                 Margin="4,10,21,23" 
                                                 Grid.Row="1" 
                                                 Height="142"/>
                                </Grid>
                                <Border BorderThickness="1,1,1,1"
                                        BorderBrush="#FFB0AFAF"
                                        Grid.Row="6" 
                                        Margin="0,10" 
                                        Background="#F2EEEEEE"/>
                                <TextBlock Name="lblGenerales"
                                           Grid.Row="6"
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource styleEtiquetasFormResize}" Height="51" Margin="20,27,299,22">
                                        <Run Language="es-co" Text="Ver o adicionar diagnosticos o servicios no relacionados directamente con el odontograma."/>
                                </TextBlock>
                                <Button Name="cmdDatosGenerales"
                                        Content="Diagnosticos o servicios..."
                                        Click="fcvClickPropGeneral"
                                        Style="{StaticResource styleButtonImgEdtFormTouch}"
                                        TabIndex="105"
                                        Grid.Row="6"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        Height="51" 
                                        Margin="440,24,0,0" Width="215"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Name="pagOdontograma"
                             Header="Odontograma"
                             Style="{StaticResource styleTabItemZonaForm}" >
                        <Grid Style="{StaticResource styleGridTabItemZona}">
                            <local:OdontogramaAdultos x:Name="odnAdulto"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Height="440"
                                    Width="700"
                                    Visibility="Collapsed"
                                    Margin="0,5,0,0"/>
                            <local:OdontogramaNinos x:Name="odnNino"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Height="440"
                                    Width="450"
                                    Visibility="Collapsed"
                                    Margin="118,5,0,0" 
                                    Grid.RowSpan="2"/>
                            <local:Odontograma x:Name="odnMixto"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Height="480"
                                    Width="600"
                                    Visibility="Visible"
                                    Margin="0,5,0,0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <!-- BOTONES BARRA DE EDICION -->
            <Button Name="cmdLogErrores"
                    Margin="10,7,0,0"
                    Style="{StaticResource styleButtonImgFormError}"
                    TabIndex="19"
                    Click="fcvVistaLogErrores"
                    Grid.Row="3"
                    ToolTip="Ver registro de errores">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdConfirmar"
                    HorizontalAlignment="Left"
                    Margin="150,7,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="9"
                    Click="fcvConfirmarRegistro"
                    Grid.Row="3"
                    ToolTip="Haga click aqui para guardar confirmar registro">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgConfirmarr"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblConfirmar"
                               Text="Confirmar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdGuardar"
                    Margin="451,7,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="9"
                    Click="fcvGuardarRegistro"
                    Grid.Row="3"
                    ToolTip="Haga clic aqui para guardar los cambios">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
