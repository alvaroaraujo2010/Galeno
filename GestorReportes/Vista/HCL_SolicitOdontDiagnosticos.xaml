                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>
                                            <Border BorderThickness="0.6" 
                                                    BorderBrush="#FFB0AFAF" 
                                                    Grid.Row="0" 
                                                    Background="White"  
                                                    Grid.RowSpan="3"/>
                                            <TextBlock Name="lblsrAplicarTodos"
												       Grid.Row="0"
                                                       TextWrapping="Wrap"
												       Style="{StaticResource styleEtiquetasFormResize}" Margin="5,0,5,2">
												<Run Language="es-co" Text="Aplicar el servicio en todo el odontograma"/>
                                            </TextBlock>
                                            <TextBox Name="txtSrAplicarTodoListaDientes"
                                                     TabIndex="7"
                                                     TextChanged="fcvValidacionTexto"
                                                     Visibility="Collapsed"
                                                     Grid.Column="1"/>
                                            <CheckBox Name="chkSrAplicarTodo"
                                                      Grid.Row="2"
                                                      Click="fcvSelectCheckBox"
                                                      Margin="10,6,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"/>
                                            <Button Name="cmdSrSelDientes"
													Content="Dientes..."
													Style="{StaticResource styleButtonImgEdtFormTouch}"
													TabIndex="105"
													Grid.Row="2"
													Click="fcvVistaSelectDientes"
													IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
													ToolTip="Seleccionar dientes para generar grafica en odontograma" 
													Height="23" 
													Width="85" 
                                                    Margin="56,0,0,0"/>
                                        </Grid>
                                        <Button Name="cmdAddPlanRegistros"
                                                Content="Agregar..."
                                                Style="{StaticResource styleButtonImgEdtFormTouch}"
                                                TabIndex="105"
                                                Click="fcvGuardarRegistroRelacion"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Agregar servicios desde manuales tarifarios" 
                                                Height="30" 
                                                Width="160" 
                                                Margin="263,95,0,0" Grid.ColumnSpan="2"/>
                                    </Grid>
                                </Grid>
                            </Expander>
                            <Grid Name="grdPlanDetalles" Margin="10,0,8,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Name="txtPlanTituloDetalles" 
                                           Text="Detalles"
                                           Grid.Row="0"
                                           FontSize="12"
                                           Foreground="Black"
                                           Visibility="Collapsed"
                                           Style="{StaticResource styleTituloForm}" 
                                           Height="18" 
                                           Margin="8,5,92,0" 
                                           Grid.RowSpan="2"/>
                                <StackPanel Name="stkPlanDetalles"
                                            Grid.Row="1"
                                            Orientation="Vertical"
                                            Height="Auto"
                                            Background="White"
                                            Margin="0,10,0,0">
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
