<UserControl x:Class="GestorReportes.Vista.ControlOrdBliquidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="300" 
             Height="Auto"
             Width="750"
             d:DesignWidth="300">
    <Grid Name="grdContenedor">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Grid.RowSpan="8"/>
        <Border BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Margin="0,0,0,0"
                Background="#FFF2F3F3"/>
        <Button Name="cmdHistorialOcultar"
                Grid.Row="1"
                Margin="0,14,60,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Background="Transparent"
                Click="fcvActivarVistaDetalles"
                ToolTip="Ocultar detalles" 
                Height="30"
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropHistorial"
                        Source="/GestorReportes;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Button Name="cmdImprimir"
                Grid.Row="1"
                Margin="0,14,8,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Background="Transparent"
                ToolTip="Imprimir registro" 
                Height="30" 
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgHistorialVer"
                        		   Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Grid.Row="1" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <!-- Orden servicio -->
            <Image Name="imgRegistro"
                   HorizontalAlignment="Left"
                   Margin="5,4,0,1"
                   Width="59"
                   Height="55"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_xcap_balancedeliquidos.png"
                   Stretch="Uniform"/>
            <!-- Orden servicio -->
            <Image Name="imgEstado"
                   HorizontalAlignment="Left"
                   Margin="5,37,0,3"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
                   Stretch="UniformToFill"/>
            <TextBox Name="txtG1Hcl_desreg_hcbm"
                     Margin="64,18,4,0"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="0"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="Balance de liquidos"
                     Focusable="False"/>
            <TextBlock Name="lblG1G1Hcl_nroreg_hcms"
                       Margin="423,22,1,19"
                       FontSize="14"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2">
                      <Run Language="es-co" Text="Numero:"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_nroreg_hcbm"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     FontSize="16"
                     Margin="4,18,4,0"
                     Text="1000"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 2 - DATOS ORDEN SERVICIOS  -->
        <Grid Grid.Row="2" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="160*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1hcl_gesfec_hcms"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" Margin="4,5,2,4">
                   <Run Language="es-co" Text="Fecha"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_gesfec_hcbm"
                     Grid.Column="1"
                     Style="{StaticResource styleTextBoxEdtFormTouch}" 
                     Focusable="False"/>
            <TextBlock Name="lblG1hcl_geshor_hcms"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" Margin="4,5,2,4">
                     <Run Language="es-co" Text="Registro"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_sishor_hcms"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="3"
                     Focusable="False"/>
            <TextBlock Name="lblG1hcl_tiptur_hctu"
                       Grid.Column="4"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                   <Run Language="es-co" Text="Turno"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_destur_hctu"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="5"
                     Focusable="False"/>
            <TextBlock Name="lblG1sis_estpro_espr"
                       Grid.Column="6"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" Margin="4,5,2,4">
                    <Run Language="es-co" Text="Estado"/>
            </TextBlock>
            <TextBox Name="txtG1Sis_despro_espr"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="7"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 3 - DATOS ORDEN SERVICIOS  -->
        <Grid Grid.Row="3" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1sia_codpfa_prof"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="profesional"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codpfa_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBox Name="txtG1Sia_nompro_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     Focusable="False"/>
            <TextBlock Name="lblG1sia_codare_aser"
                                           Grid.Column="3"
                                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                           <Run Language="es-co" Text="Área servicios"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codare_aser"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="4"
                     Focusable="False"/>
            <TextBox Name="txtG1Sia_desare_aser"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="5"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 4 - DETALLES -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ENCABEZADO DE LOS DETALLES -->
            <Grid Grid.Row="0" Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblServicio"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Liquidos pendientes"/>
                </TextBlock>
                <TextBox Name="txtG1Hcl_totape_hcbm"
                         Grid.Column="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}" 
                         Focusable="False"/>
                <TextBlock Name="lblHoraInicioTurno"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Hora Inicio turno"/>
                </TextBlock>
                <TextBox Name="txtG1Hcl_horini_hcbm"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Focusable="False"
                         Grid.Column="3"/>
                <TextBlock Name="lblHoraFinTurno"
                       Grid.Column="4"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Hora fin turno"/>
                </TextBlock>
                <TextBox Name="txtG1Hcl_horfin_hcbm"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="9"
                         Focusable="False"/>
            </Grid>
        </Grid>
        <!-- FILA 5 - OBSERVACION -->
        <Grid Grid.Row="5" 
              Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblObservacion"
                       Grid.Row="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Observación"/>
            </TextBlock>
            <TextBlock Name="txtG1Hcl_obsape_hcbm" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Row="1"
        		       FontSize="12"
                       Margin="10,5,10,10"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Name="stkDetalles"
                    Grid.Row="6"
                    Focusable="False"
                    Orientation="Vertical"
                    Height="Auto" 
                    Margin="4,0,4,0"/>
    </Grid>
</UserControl>
