<UserControl x:Class="GestorReportes.Vista.ControlCaptura"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:GestorReportes.Vista" 
	        mc:Ignorable="d"
	        x:Name="UserControl"
	        d:DesignWidth="730" 
            d:DesignHeight="600" 
            Width="730" 
            Height="Auto" 
            Opacity="50">
    <Grid Name="LayoutRoot" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderThickness="0.2"
                BorderBrush="Transparent"
                Margin="2"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="Transparent">
        </Border>
        <Border BorderThickness="0.2"
                BorderBrush="Transparent"
                Margin="16,0,16,0"
                Grid.Row="0"
                Background="#FF18429C">
        </Border>
        <TextBox Name="txtTitulo"
                 Margin="20,0,20,0"
                 FontSize="20"
                 BorderThickness="0"
                 Focusable="False"
                 Text="TITULO FORMATO"
                 Foreground="White"
                 FontWeight="Bold"
                 TextAlignment="Center"
                 Background="Transparent"/>
        <Border BorderThickness="0.2"
                BorderBrush="Transparent"
                Margin="16,0,16,0"
                Grid.Row="1"
                Background="#FFF2F3F3">
        </Border>
        <local:crtBuscar HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Height="30"
                         Width="300"
                         Grid.Row="1"
                         Margin="24,12,0,0" 
                         Loaded="crtBuscarLoaded" />
        <Button Name="cmdAdicionar"
                Grid.Row="1"
                Margin="0,4,126,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                ToolTip="Adicionar nuevo registro" 
                Height="40" 
                Cursor="Hand"
                Width="45">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA9D4C5" Offset="0"/>
                    <GradientStop Color="#FF5E9380" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Source="/GestorReportes;component/Imagenes/Edt_edt_adicionar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Button Name="cmdConfirmar"
                Grid.Row="1"
                Margin="0,4,73,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                ToolTip="Confirmar registros abiertos" 
                Height="40" 
                Cursor="Hand"
                Width="45">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA9D4C5" Offset="0"/>
                    <GradientStop Color="#FF5E9380" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Source="/GestorReportes;component/Imagenes/Edt_edt_confirmar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Grid.Row="1"
                Margin="0,4,20,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Click="fcvEliminarRegMaestro"
                ToolTip="Eliminar registros no confirmados" 
                Height="40" 
                Cursor="Hand"
                Width="45">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA9D4C5" Offset="0"/>
                    <GradientStop Color="#FF5E9380" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Source="/GestorReportes;component/Imagenes/Edt_edt_anular.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <!-- Titulo del Modulo -->
        <StackPanel Name="stkContenedor"
                    Grid.Row="2"
                    Focusable="False"
                    Orientation="Vertical"
                    Height="Auto"/>
    </Grid>
</UserControl>
