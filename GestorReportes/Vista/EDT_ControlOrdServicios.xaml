<UserControl x:Class="GestorReportes.Vista.ControlOrdServicios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="240" 
             Height="Auto"
             Width="750"
             d:DesignWidth="300">
    <Grid Name="grdContenedor">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Grid.RowSpan="4"/>
        <Border BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Margin="0,0,0,0"
                Background="#FFF2F3F3"/>
        <Grid Grid.Row="1" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <!-- Orden servicio -->
            <Image Name="imgRegistro"
                   HorizontalAlignment="Left"
                   Margin="5,4,0,1"
                   Width="59"
                   Height="55"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_xcap_formulamedica.png"
                   Stretch="Uniform"/>
            <!-- Orden servicio -->
            <Image Name="imgEstado"
                   HorizontalAlignment="Left"
                   Margin="5,37,0,3"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
                   Stretch="UniformToFill"/>
            <TextBox Name="txtG1Hcl_desreg_hctr"
                     Margin="64,18,4,10"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="0"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="Orden de servicios"
                     IsReadOnly="True"/>
            <TextBlock Name="lblG1G1Hcl_nroreg_hcms"
                       FontSize="14"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" 
                       Grid.Column="1">
                      <Run Language="es-co" Text="Numero:"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_nroreg_hcms"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     FontSize="16"
                     Margin="4,18,4,10"
                     Text="1000"
                     IsReadOnly="True"/>
            <Button Name="cmdHistorialOcultar"
                    Grid.Column="3"
                    Margin="5,14,60,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource styleButtonImgEdtFormTouch}"
                    TabIndex="50"
                    Background="Transparent"
                    Click="fcvActivarVistaDetalles"
                    ToolTip="Ocultar detalles" 
                    Height="30"
                    Cursor="Hand"
                    Width="45">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgPropHistorial"
                        Source="/GestorReportes;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdHistorialVer"
                    Grid.Column="4"
                    Margin="55,14,8,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource styleButtonImgEdtFormTouch}"
                    TabIndex="50"
                    Background="Transparent"
                    ToolTip="Ver o editar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="45">
                <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialVer"
                        		   Source="/GestorReportes;component/Imagenes/Edt_edt_propiedades.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdImprimir"
                    Grid.Column="3"
                    Margin="105,14,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource styleButtonImgEdtFormTouch}"
                    TabIndex="50"
                    Background="Transparent"
                    ToolTip="Imprimir registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="45">
                <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgImprimir"
                        		   Source="/GestorReportes;component/Imagenes/Edt_edt_imprimir.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
        <!-- FILA 2 - DATOS ORDEN SERVICIOS  -->
        <Grid Grid.Row="2" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1hcl_gesfec_hcms"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                   <Run Language="es-co" Text="Fecha"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_gesfec_hcms"
                     Grid.Column="1"
                     Style="{StaticResource styleTextBoxEdtFormTouch}" 
                     Focusable="False"/>
            <TextBlock Name="lblG1hcl_geshor_hcms"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Hora"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_geshor_hcms"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="3"
                     Focusable="False"/>
            <TextBlock Name="lblG1sis_estpro_espr"
                       Grid.Column="5"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Estado"/>
            </TextBlock>
            <TextBox Name="txtG1Sis_despro_espr"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="6"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 3 - DATOS ORDEN SERVICIOS  -->
        <Grid Grid.Row="3" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1sia_codpfa_prof"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Profesional"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codpfa_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>                     
            <TextBox Name="txtG1Sia_nompro_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     Focusable="False"/>
            <TextBlock Name="lblG1sia_codare_aser"
                                           Grid.Column="3"
                                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                           <Run Language="es-co" Text="Área servicios"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codare_aser"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="4"
                     Focusable="False"/>
            <TextBox Name="txtG1Sia_desare_aser"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="5"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 4 - DETALLES -->
        <Grid Name="grdDetalles" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ENCABEZADO DETALLES PLAN DE MANEJO MEDICAMENTOS -->
            <Grid Name="grdEncabezado" 
                  Grid.Row="0"
                  Visibility="Collapsed"
                  Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Border Name="detFondo" 
                        Background="Transparent"
                        Visibility="Visible"
                        Margin="0,0,0,0"
                        BorderThickness="0,1,0,1"
                        BorderBrush="#FFD1CFCF"
                        Grid.RowSpan="5"
                        Grid.Row="0" 
                        Grid.ColumnSpan="5"/>
                <TextBlock Name="lblDetalle"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Medicamentos:"/>
                </TextBlock>
                <TextBlock Name="lblCantidad"
                       Grid.Column="1"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Cantidad"/>
                </TextBlock>
                <TextBlock Name="lblObservacon"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Dosificación"/>
                </TextBlock>
                <TextBlock Name="lblDias"
                       Grid.Column="3"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Días"/>
                </TextBlock>
            </Grid>
            <!-- ENCABEZADO DETALLES HOJA DE CONSUMO SERVICIOS  -->
            <Grid Name="grdHcEncabezado" 
                  Grid.Row="0"
                  Visibility="Visible"
                  Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Name="HcdetFondo" 
                        Background="Transparent"
                        Visibility="Visible"
                        Margin="0,0,0,0"
                        BorderThickness="0,1,0,1"
                        BorderBrush="#FFD1CFCF"
                        Grid.RowSpan="5"
                        Grid.Row="0" Grid.ColumnSpan="5"/>
                <TextBlock Name="lblHcFecha"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Fecha"/>
                </TextBlock>
                <TextBlock Name="lblHcHora"
                       Grid.Column="1"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Hora"/>
                </TextBlock>
                <TextBlock Name="lblHcCantidad"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Cantidad"/>
                </TextBlock>
                <TextBlock Name="lblHcServicio"
                       Grid.Column="3"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Servicio"/>
                </TextBlock>
                <TextBlock Name="lblHcDetalle"
                       Grid.Column="4"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Detalle"/>
                </TextBlock>
            </Grid>            
            <StackPanel Name="stkDetalles"
                    Grid.Row="1"
                    Focusable="False"
                    Orientation="Vertical"
                    Height="Auto" 
                    Margin="4,0,4,0"/>
        </Grid>
    </Grid>
</UserControl>
