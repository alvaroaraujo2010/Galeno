<UserControl x:Class="GestorReportes.Vista.ControlOrdRecursoDetalle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="400" 
             d:DesignWidth="750"
             Height="Auto"
             Width="780">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!-- ENCABEZADO -->
        <Grid Name="grdTitulo" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Border Name="detFondo" 
                    Background="#FFF3F3F3"
                    Visibility="Visible"
                    BorderThickness="0"
                    Grid.ColumnSpan="6"
                    Grid.Column="0"/>
            <Button Name="cmdMostrar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Ocultar detalles" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Click="fcvActivarVistaDetalles"
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgVerDeatlles"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_edt_contraer2.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Image Name="imgEstado"
                   Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,6,12,0"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
                   Stretch="UniformToFill"/>
            <Button Name="cmdEliminar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Eliminar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialDel"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdVerRegistro"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Ver o editar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_edt_propiedades.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Name="lblTitulo"
                   Grid.Row="1"
                   FontSize="14"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Left"
                   Width="270"
                   Visibility="Collapsed"
                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                 <Run Language="es-co" Text="Indicación"/>
        </TextBlock>
        <Border BorderThickness="0,0,0,0.9"
                BorderBrush="#FFB0AFAF"
                Grid.Row="2"
                Grid.RowSpan="2"/>
        <Grid Name="grdDetalle" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Image Name="imgArchivo"
                   Grid.Row="0"
                   Height="Auto"
                   Width="Auto"
                   Visibility="Collapsed"
                   Source="/Sistema;component/Imagenes/Edt_edt_adicionar.png"
                   Style="{StaticResource styleImagBotonesForm}"
                   Stretch="UniformToFill" 
                   Margin="5,5,40,5"/>
            <WebBrowser Name="wbrVistaPdf" 
                        HorizontalAlignment="Left" 
                        Grid.Row="0"
                        Height="400" 
                        Width="Auto"
                        Panel.ZIndex="-10"
                        Visibility="Collapsed"
                        VerticalAlignment="Top" 
                        Margin="80,5,120,5"/>
            <MediaElement Name="vidBrowser" 
                          Grid.Row="0"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Height="300" 
                          Width="Auto"
                          Margin="80,5,120,5"
                          Visibility="Collapsed"
                          LoadedBehavior="Manual"/>
            <TextBox Name="txtObservacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
                       Grid.Row="2"
        		       FontSize="12"
                       Background="Transparent" 
                       BorderThickness="0"
                       IsReadOnly="True"
                       Margin="15,5,50,2"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
