<Window x:Class="GestorReportes.Vista.VistaMaestroTratamiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Maestro Tratamiento odontologico"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="700"
        Height="400"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="49*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
        </Border>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Maestro Tratamiento odontologico"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image MouseDown="btnCerrar_KeyDown"
               Style="{StaticResource styleImgButtonCerrarForm}"
               Source="/Sistema;component/Imagenes/sis_cerrar40.png"
               Grid.Row="1"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               Cursor="Hand"/>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Margin="1,3,0,0"
               VerticalAlignment="Top"
               Grid.Row="4"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFILTRO}"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <!-- Fin Perfil Usuario -->
        <!-- Control modo edicion formulario -->
        <TextBox Name="lblFormModoPopup"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrSIS_FormModoPopup,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <!-- Fin Control modo edicion formulario -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="12*" />
                <RowDefinition Height="78*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtG1Sia_nompro_prof"
                                             TabIndex="101"
                                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="3"
                                             Focusable="False"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                    <Button Name="cmdG1Sia_codpfa_prof"
                                            Content="..."
                                            Style="{StaticResource styleButtonMiniFormBrows}"
                                            TabIndex="101"
                                            Click="cmdG1Sia_codpfa_prof_Click"
                                            Grid.Column="2"
                                            IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                            ToolTip="Código del Profesional que inicia el evento"/>
                    <TextBlock Name="lblG1sia_codpfa_prof"
                                               ToolTip="Código del Profesional que inicia el evento"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Código del profesional"/>
                    </TextBlock>
                    <TextBox Name="txtG1Sia_codpfa_prof"
                                             TabIndex="1"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TextChanged="fcvValidacionTexto"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                             KeyDown="txtG1Sia_codpfa_prof_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                </Grid>
            </Grid>
            <TabControl Name="pagRegistro"
                        Style="{StaticResource styleTabControlZonaForm}"
                        TabIndex="2"
                        Grid.Row="1">
                <TabItem Name="pagTabsApertura"
                     Header="Apertura tratamiento"
                     Style="{StaticResource styleTabItemZonaForm}">
                    <Grid Style="{StaticResource styleGridTabItemZona}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40*"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,207,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="103"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="lblG1odn_tgrafi_odev"
                                           ToolTip="Tipo odontograma para graficar 1= Odontograma adultos 2= Odontograma niños"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}" Height="15" Margin="4,5,2,5">
                                           <Run Language="es-co" Text="Tipo odontograma"/>
                                </TextBlock>
                                <TextBox Name="txtG1Odn_tgrafi_odev"
                                         TabIndex="10"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         Visibility="Collapsed"
                                         TextChanged="ActualizarComboBoxOpcion"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus" 
                                         Margin="4,2,245,3"/>
                                <ComboBox Name="cboG1Odn_tgrafi_odev"
                            	          Grid.Column="1"
                            	          Style="{StaticResource styleComboBoxFormResize}"
                            	          SelectedIndex="0"
                                          FontSize="14"
                            	          SelectionChanged="SeleccionComboBoxOpcion"
                            	          ItemsSource="{Binding Path=G1CbOdn_tgrafi_odev}"
                            	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                            	          SelectedValuePath="{Binding Path=ValorSeleccion}" 
                                          Height="24"                                           
                                          Margin="0,2,2,3">
                                          <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                     <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                                     </StackPanel>
                                                 </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="lblG1odn_fecape_odev"
                                                   ToolTip="Fecha apertura tratamiento medico"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Inicia tratamiento"/>
                                </TextBlock>
                                <Grid Grid.Column="1"
                                          Style="{StaticResource styleDatePickerGridFormResize}">
                                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                                    <TextBox Name="txtG1Odn_fecape_odev"
                                                 TabIndex="1"
                                                 Style="{StaticResource styleTextBoxFormFecha}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                 TextChanged="fcvActualizarDatePicker"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <DatePicker Name="dpkG1Odn_fecape_odev"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                Style="{StaticResource styleDatePickerForm}"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="txtG1Sia_desare_aser"
                                         TabIndex="102"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="3"
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                                <Button Name="cmdG1Sia_codare_aser"
                                                Content="..."
                                                Style="{StaticResource styleButtonMiniFormBrows}"
                                                TabIndex="102"
                                                Click="cmdG1Sia_codare_aser_Click"
                                                Grid.Column="2"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                ToolTip="Código área de servicio donde se prestan los servicios"/>
                                <TextBlock Name="lblG1sia_codare_aser"
                                                   ToolTip="Código área de servicio donde se prestan los servicios"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Area servicios"/>
                                </TextBlock>
                                <TextBox Name="txtG1Sia_codare_aser"
                                                 TabIndex="2"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 TextChanged="fcvValidacionTexto"
                                                 Grid.Column="1"
                                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                 KeyDown="txtG1Sia_codare_aser_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="65*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="670"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="lblG1odn_obsape_odev"
                                           ToolTip="Observacion para apertura del evento"
                                           Grid.Row="0"
                                           Style="{StaticResource styleEtiquetasFormResize}" 
                                           Margin="4,4,529,4">
                                          <Run Language="es-co" Text="Observacion apertura"/>
                                </TextBlock>
                                <TextBox Name="txtG1Odn_obsape_odev"
                                         TabIndex="3"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus" 
                                         TextChanged="fcvValidacionTexto"
                                         TextWrapping="Wrap"
                                         Grid.Row="1" 
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" 
                                         Height="Auto" 
                                         Margin="4,5,2,10"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Name="pagTabsCierre"
                     Header="Cierre tratamiento"
                     Style="{StaticResource styleTabItemZonaForm}" >
                    <Grid Style="{StaticResource styleGridTabItemZona}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="323*"/>
                                <ColumnDefinition Width="347*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="lblG1odn_feccie_odev"
                                                   ToolTip="Datos del cierre  - Fecha cierre o finalizacion del tratamiento"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Fecha cierre tratamiento"/>
                                </TextBlock>
                                <Grid Grid.Column="1"
                                          Style="{StaticResource styleDatePickerGridFormResize}">
                                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                                    <TextBox Name="txtG1Odn_feccie_odev"
                                                 TabIndex="1"
                                                 Style="{StaticResource styleTextBoxFormFecha}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 TextChanged="fcvActualizarDatePicker"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    <DatePicker Name="dpkG1Odn_feccie_odev"
                                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                Style="{StaticResource styleDatePickerForm}"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="247"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="lblG1odn_estado_odev"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado tratamiento"/>
                                </TextBlock>
                                <TextBox Name="txtG1Odn_estado_odev"
                                         TabIndex="15"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         Visibility="Collapsed"
                                         TextChanged="ActualizarComboBoxOpcion"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                                <ComboBox Name="cboG1Odn_estado_odev"
											Grid.Column="1"
											Style="{StaticResource styleComboBoxFormResize}"
											SelectedIndex="0"
											SelectionChanged="SeleccionComboBoxOpcion"
											ItemsSource="{Binding Path=G1CbOdn_estado_odev}"
											DisplayMemberPath="{Binding Path=NombreOpcion}"
											SelectedValuePath="{Binding Path=ValorSeleccion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Name="lblG1odn_obscie_odev"
                                           ToolTip="Observacion para cierre tratamiento"
                                           Style="{StaticResource styleEtiquetasFormResize}" 
                                           Grid.Row="0" 
                                           Margin="4,3,544,0" 
                                           Height="17">
                                          <Run Language="es-co" Text="Observacion cierre"/>
                                </TextBlock>
                                <TextBox Name="txtG1Odn_obscie_odev"
                                         TabIndex="2"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus" 
                                         TextChanged="fcvValidacionTexto"
                                         TextWrapping="Wrap"
                                         Grid.Row="1" 
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" 
                                         Height="Auto" 
                                         Margin="4,10,2,10"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <Button Name="cmdGuardar"
                Margin="463,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="8"
                Click="fcvGuardarRegistro"
                Grid.Row="3"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Confirmar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="580,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="22"
                Click="cmdSalir_Click"
                Grid.Row="3"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>