<UserControl x:Class="GestorReportes.Vista.ControlOrdOdontoCierre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GestorReportes.Vista" 
             mc:Ignorable="d"
             d:DesignHeight="180" 
             Height="Auto"
             Width="750"
             d:DesignWidth="300">
    <Grid Name="grdContenedor">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Grid.RowSpan="6"/>
        <Border BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Margin="0,0,0,0"
                Background="#FFF2F3F3"/>
        <Button Name="cmdHistorialOcultar"
                Grid.Row="1"
                Margin="0,14,60,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Background="Transparent"
                Click="fcvActivarVistaDetalles"
                ToolTip="Ocultar detalles" 
                Height="30"
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropHistorial"
                        Source="/GestorReportes;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Button Name="cmdHistorialVer"
                Grid.Row="1"
                Margin="0,14,8,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Background="Transparent"
                ToolTip="Ver o editar registro" 
                Height="30" 
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgHistorialVer"
                        		   Source="/GestorReportes;component/Imagenes/Edt_edt_propiedades.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Grid.Row="1" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <!-- Orden servicio -->
            <Image Name="imgRegistro"
                   HorizontalAlignment="Left"
                   Margin="5,4,0,1"
                   Width="59"
                   Height="55"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_xcap_odontologia.png"
                   Stretch="Uniform"/>
            <!-- Orden servicio -->
            <Image Name="imgEstado"
                   HorizontalAlignment="Left"
                   Margin="5,37,0,3"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
                   Stretch="UniformToFill"/>
            <TextBox Name="txtG1Hcl_desreg_hctr"
                     Margin="64,18,4,0"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="0"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="Registro apertura tratamiento"
                     Focusable="False"/>
            <TextBlock Name="lblG1G1Hcl_nroreg_hcms"
                       FontSize="14"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}" 
                       Grid.Column="1">
                      <Run Language="es-co" Text="Numero:"/>
            </TextBlock>
            <TextBox Name="txtG1Odn_nroreg_odac"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     FontSize="16"
                     Margin="4,18,4,0"
                     Text="1000"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 2 - DATOS ORDEN SERVICIOS  -->
        <Grid Grid.Row="2" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1sia_codpfa_prof"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Profesional"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codpfa_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBox Name="txtG1Sia_nompro_prof"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="2"
                     Focusable="False"/>
            <TextBlock Name="lblG1hcl_gesfec_hcms"
                       Grid.Column="3"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                   <Run Language="es-co" Text="Fecha"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_gesfec_hcms"
                     Grid.Column="4"
                     Style="{StaticResource styleTextBoxEdtFormTouch}" 
                     Focusable="False"/>
            <TextBlock Name="lblG1sis_estpro_espr"
                       Grid.Column="5"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Registro"/>
            </TextBlock>
            <TextBox Name="txtG1Sis_despro_espr"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="6"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 3 - AREA DE SERVICIOS -->
        <Grid Grid.Row="3" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblG1sia_codare_aser"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Área servicios"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_desare_aser"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBlock Name="lblG1Odn_estado_odev"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Estado tratamiento"/>
            </TextBlock>
            <TextBox Name="txtG1Odn_estado_odev"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="3"
                     Focusable="False"/>
        </Grid>
        <!-- FILA 4 - DETALLES -->
        <Grid Name="grdDetalles" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblObservacion"
                       Grid.Row="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                    <Run Language="es-co" Text="Observación"/>
            </TextBlock>
            <TextBlock Name="txtObservacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Row="1"
        		       FontSize="12"
                       Margin="10,5,10,10"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>

        </Grid>
    </Grid>
</UserControl>
