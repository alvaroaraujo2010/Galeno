<UserControl x:Class="GestorReportes.Vista.ControlOrdDetallesBLiquido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="120" 
             d:DesignWidth="300"
             Height="Auto"
             Width="730">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="0,0.9,0,0"
                BorderBrush="#FFD1CFCF"
                Grid.Row="0"
                Grid.RowSpan="8"/>
        <Image Name="imgEstado"
               Grid.Row="0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,2,12,0"
               Width="20"
               Height="20"
               Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
               Stretch="UniformToFill"/>
        <Button Name="cmdEliminar"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                TabIndex="50"
                ToolTip="Eliminar registro" 
                Height="30" 
                Cursor="Hand"
                Width="40">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Image Name="imgRegistro"
                   HorizontalAlignment="Left"
                   Width="40"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_xcap_liquidosadministrados.png"
                   Stretch="Uniform" Margin="6,0,0,0"/>
            <TextBlock Name="txtTituloRegistro" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="Administracion de liquidos"
                       Margin="5,11,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtFecha" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="14"
                       Margin="5,11,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtHora" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="3"
        		       FontSize="14"
                       Margin="5,11,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblLiquido"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Liquido"/>
            </TextBlock>
            <TextBox Name="txtLiquido"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBlock Name="lblViaAdmiElim"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Via administración"/>
            </TextBlock>
            <TextBox Name="txtViaAdmiElim"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="4"
                     Focusable="False"/>
        </Grid>
        <Grid Name="grdLiqAdm" Grid.Row="2" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblAdmCantidad"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Cantidad administrada(ml)"/>
            </TextBlock>
            <TextBox Name="txtAdmCantidad"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBlock Name="lblAdmHoraInicial"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Hora Inicial"/>
            </TextBlock>
            <TextBox Name="txtAdmHoraInicial"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="3"
                     Focusable="False"/>
            <TextBlock Name="lblAdmHoraFinal"
                       Grid.Column="4"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Hora Final"/>
            </TextBlock>
            <TextBox Name="txtAdmHoraFinal"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="5"
                     Focusable="False"/>
        </Grid>
        <Grid Name="grdLiqElim" Visibility="Visible" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblElimCantidad"
                       Grid.Column="0"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Cantidad(ml)"/>
            </TextBlock>
            <TextBox Name="txtElimCantidad"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="1"
                     Focusable="False"/>
            <TextBlock Name="lblElimHora"
                       Grid.Column="2"
                       Style="{StaticResource styleEtiquetasEdtFormTouch}">
                     <Run Language="es-co" Text="Hora Eliminación"/>
            </TextBlock>
            <TextBox Name="txtElimHora"
                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                     Grid.Column="4"
                     Focusable="False"/>
        </Grid>
        <TextBlock Name="txtObservacion" 
        		   HorizontalAlignment="Stretch" 
        		   VerticalAlignment="Top"
                   Grid.Row="3"
        		   FontSize="12"
                   Margin="10,7,50,0"
                   Width="Auto"
        		   FontFamily="Segoe UI Symbol"
        		   TextAlignment="Justify"
        		   Foreground="#FF615C5C"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
