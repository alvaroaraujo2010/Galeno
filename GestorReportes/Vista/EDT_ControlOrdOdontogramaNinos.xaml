<UserControl x:Class="GestorReportes.Vista.OdontogramaNinos" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GestorReportes.Vista" 
             mc:Ignorable="d" 
             d:DesignHeight="440" 
             d:DesignWidth="450">
    <Grid>
        <Border Name="Fondo" 
                Background="Transparent"
                Margin="0,0,0,0"
                BorderThickness="0"
                BorderBrush="#FFD1CFCF"/>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Cuadrante 1 -->
            <local:Diente01 x:Name="D51" Grid.Row="0" Grid.Column="4" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D52" Grid.Row="0" Grid.Column="3" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D53" Grid.Row="0" Grid.Column="2" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D54" Grid.Row="0" Grid.Column="1" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D55" Grid.Row="0" Grid.Column="0" Loaded="fcvLoadDiente01"/>
            <!-- Cuadrante 2 -->
            <local:Diente01 x:Name="D61" Grid.Row="0" Grid.Column="5" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D62" Grid.Row="0" Grid.Column="6" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D63" Grid.Row="0" Grid.Column="7" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D64" Grid.Row="0" Grid.Column="8" Loaded="fcvLoadDiente01"/>
            <local:Diente01 x:Name="D65" Grid.Row="0" Grid.Column="9" Loaded="fcvLoadDiente01"/>
            <!-- Cuadrante 3 -->
            <local:Diente02 x:Name="D71" Grid.Row="2" Grid.Column="5" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D72" Grid.Row="2" Grid.Column="6" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D73" Grid.Row="2" Grid.Column="7" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D74" Grid.Row="2" Grid.Column="8" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D75" Grid.Row="2" Grid.Column="9" Loaded="fcvLoadDiente02"/>
            <!-- Cuadrante 4 -->
            <local:Diente02 x:Name="D81" Grid.Row="2" Grid.Column="4" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D82" Grid.Row="2" Grid.Column="3" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D83" Grid.Row="2" Grid.Column="2" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D84" Grid.Row="2" Grid.Column="1" Loaded="fcvLoadDiente02"/>
            <local:Diente02 x:Name="D85" Grid.Row="2" Grid.Column="0" Loaded="fcvLoadDiente02"/>
        </Grid>
    </Grid>
</UserControl>
