<UserControl x:Class="GestorReportes.Vista.ControlHojaAdmision"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="430"
             Width="720"
             d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>            
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="White"
                Visibility="Collapsed"
                Margin="0,0,0,0"
                BorderThickness="0.8"
                BorderBrush="#FFD1CFCF"
                Grid.RowSpan="5"
                Grid.Row="0"/>
        <!-- FILA 0 - HISTORIA CLINICA -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <!-- Numero Historia clinica -->
            <TextBlock Name="lblHcl_nrohis_hicl" Grid.Column="1" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Historia clinica"/>
            </TextBlock>
            <TextBox Name="txtHcl_nrohis_hicl" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="2"/>
            <!-- Estado de la Admision -->
            <TextBlock Name="lblSis_estadm_espr" Grid.Column="3" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Registro admisión"/>
            </TextBlock>
            <TextBox Name="txtSis_Desadm_espr" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="4"/>
        </Grid>
        <!-- FILA 1 - DATOS USUARIO  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="33"/>
                <ColumnDefinition Width="146"/>
                <ColumnDefinition Width="67"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Identificación -->
            <TextBlock Name="lblG1Sia_nroide_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Identificación"/>
            </TextBlock>
            <!-- Tipo ide -->
            <TextBox Name="txtG1Sia_tipide_tide" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Numero Ide -->
            <TextBox Name="txtG1Sia_nroide_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="2"/>
            <!-- Nombre -->
            <TextBlock Name="lblG1Sia_nomusu_usua" Grid.Column="3" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Nombre"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_nomusu_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="4"/>
        </Grid>
        <!-- FILA 2 - ADMISION  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Fecha nacimiento -->
            <TextBlock Name="lblSia_fecnac_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Fecha nacimiento"/>
            </TextBlock>
            <TextBox Name="txtSia_fecnac_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Sexo -->
            <TextBlock Name="lblSis_codsex_sexo" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Sexo"/>
            </TextBlock>
            <TextBox Name="txtSis_codsex_sexo" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
            <!-- Edad -->
            <TextBlock Name="lblSia_edaymd_usua" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Edad"/>
            </TextBlock>
            <TextBox Name="txtSia_edaymd_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5"/>
        </Grid>
        <!-- FILA 3 - ADMISION  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Codigo admision -->
            <TextBlock Name="lblG1adm_secadm_rgad" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Admisión"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_secadm_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Fecha admision -->
            <TextBlock Name="lblG1adm_fecadm_rgad" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Fecha"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_fecadm_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
            <!-- Hora admision -->
            <TextBlock Name="lblG1Adm_horadm_rgad" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Hora"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_horadm_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5"/>
        </Grid>
        <!-- FILA 4 - AREA INGRESO -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Area de ingreso al servicio -->
            <TextBlock Name="lblSia_areing_aser" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Area Ingreso"/>
            </TextBlock>
            <TextBox Name="txtSia_areing_aser" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Cuasa externa de consulta -->
            <TextBlock Name="lblAdm_codcex_tcex" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Causa consulta"/>
            </TextBlock>
            <TextBox Name="txtAdm_codcex_tcex" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
            <!-- Tipo de Atencion -->
        </Grid>
        <!-- FILA 5 - TIPO DE ATENCION -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="41*"/>
                <ColumnDefinition Width="19*"/>
            </Grid.ColumnDefinitions>
            <!-- Tipo de atencion -->
            <TextBlock Name="lblAdm_codtat_tatn" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Margin="4,-1,2,-1">
                       <Run Language="es-co" Text="Tipo de atención"/>
            </TextBlock>
            <TextBox Name="txtAdm_codtat_tatn" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Diagnostico de ingreso -->
            <TextBlock Name="lblSia_codeps_teps" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Margin="4,-1,2,-1">
                       <Run Language="es-co" Text="EPS"/>
            </TextBlock>
            <TextBox Name="txtSia_codeps_teps" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" Grid.ColumnSpan="2"/>
        </Grid>
        <!-- FILA 6 - Diagnostico -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Diagnostico de ingreso -->
            <TextBlock Name="lblSia_dixinvg_tdia" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Diagnostico"/>
            </TextBlock>
            <TextBox Name="txtSia_dixivng_tdia" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
        </Grid>
        <!-- FILA 7 - Diagnostico -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Observacion -->
            <TextBlock Name="lblAdm_caucon_rgad" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Observación"/>
            </TextBlock>
            <TextBox Name="txtAdm_caucon_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
        </Grid>
        <!-- FILA 8 - TIPO DE ATENCION -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Telefono Usuario -->
            <TextBlock Name="lblSia_telres_usua" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Height="19" Margin="4,-1,2,-1">
                       <Run Language="es-co" Text="Telefono"/>
            </TextBlock>
            <TextBox Name="txtSia_telres_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
            <!-- Dirección Usuario -->
            <TextBlock Name="lblSia_dirres_usua" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Height="19" Margin="4,-1,2,-1">
                       <Run Language="es-co" Text="Dirección"/>
            </TextBlock>
            <TextBox Name="txtSia_dirres_usua" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3"/>
        </Grid>
        <!-- FILA 9 - Profesional -->
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Profesional que Autoriza -->
            <TextBlock Name="lblG1sia_codpfa_prof" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}">
                       <Run Language="es-co" Text="Profesional"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codpfa_prof" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1"/>
        </Grid>        
        <!-- FILA 10 - Datos de Atencion -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Datos de Atencion -->
            <TextBlock Name="lblAdm_DatosAtn" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Foreground="Black" Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" >
                       <Run Language="es-co" Text="Datos de Atención"/>
            </TextBlock>
        </Grid>
        <!-- FILA 11 - Atencion -->
        <Grid Grid.Row="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>             
            </Grid.ColumnDefinitions>
            <!-- Embarazada SI/NO -->
            <TextBlock Name="lblAdm_pacemb_rgad" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Embarazada"/>
            </TextBlock>
            <TextBox Name="txtAdm_pacemb_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Reintegro 24H -->
            <TextBlock Name="lblG1adm_reingr_rgad" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Reingreso antes de 48h"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_reingr_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
            <!-- Origen Admision -->
            <TextBlock Name="lblG1adm_codoad_toad" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Origen Admisión"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_codoad_toad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5" />            
        </Grid>
        <!-- FILA 12 - Atencion -->
        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>
            </Grid.ColumnDefinitions>
            <!-- Registro de Atención -->
            <TextBlock Name="lblG1sia_regate_rgat" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Registro de Atención"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_regate_rgat" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- centro atención -->
            <TextBlock Name="lblG1sia_codcat_ceat" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Centro Atención"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codcat_ceat" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
            <!-- Diagnostico Ingreso -->
            <TextBlock Name="lblG1sia_dixing_tdia" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="20" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Diagnostico Ingreso"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_dixing_tdia" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5" />
        </Grid>
        <!-- FILA 13 - Atencion -->
        <Grid Grid.Row="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>
            </Grid.ColumnDefinitions>
            <!-- Área de servicios -->
            <TextBlock Name="lblG1sia_codare_aser" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,-1,2,-1" >
                       <Run Language="es-co" Text="Área de Servicios"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codare_aser" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Área de Ingreso -->
            <TextBlock Name="lblG1adm_codcex_tcex" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,-1,2,-1" >
                       <Run Language="es-co" Text="Causa Externa"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_codcex_tcex" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
            <!-- Tipo de Atención -->
            <TextBlock Name="lblG1hos_codcam_caho" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,-1,2,-1" >
                       <Run Language="es-co" Text="Código Cama"/>
            </TextBlock>
            <TextBox Name="txtG1Hos_codcam_caho" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5" />
        </Grid>
        <!-- FILA 14 - Datos de Contrato -->
        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Datos de Atencion -->
            <TextBlock Name="lblAdm_DatosCnt" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Foreground="Black" Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" >
                       <Run Language="es-co" Text="Datos de Contrato"/>
            </TextBlock>
        </Grid>
        <!-- FILA 15 - Contrato -->
        <Grid Grid.Row="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>
            </Grid.ColumnDefinitions>
            <!-- Número Contrato -->
            <TextBlock Name="lblG1cto_nrocon_cont" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Número Contrato"/>
            </TextBlock>
            <TextBox Name="txtG1Cto_nrocon_cont" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Código EPS -->
            <TextBlock Name="lblG1sia_codeps_teps" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Código EPS"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codeps_teps" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
            <!-- Número Autorización -->
            <TextBlock Name="lblG1adm_nroaut_rgad" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Número Autorización"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_nroaut_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5" />
        </Grid>
        <!-- FILA 16 - Contrato -->
        <Grid Grid.Row="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>
            </Grid.ColumnDefinitions>
            <!-- Régimen salud -->
            <TextBlock Name="lblG1sia_tipusu_regi" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Régimen Salud"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tipusu_regi" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Tipo Afiliado -->
            <TextBlock Name="lblG1sia_tipafi_tafi" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Tipo Afiliado"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tipafi_tafi" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
            <!-- Nivel Sisben -->
            <TextBlock Name="lblG1sia_nivsbn_nsbn" Grid.Column="4" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Nivel Sisben"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_nivsbn_nsbn" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="5" />
            
        </Grid>
        <!-- FILA 17 - Contrato -->
        <Grid Grid.Row="17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="161*"/>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="91*"/>
            </Grid.ColumnDefinitions>
            <!-- Tipo población especial -->
            <TextBlock Name="lblG1sia_tippob_tpob" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Población Especial"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tippob_tpob" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Nivel Contributivo -->
            <TextBlock Name="lblG1sia_nivcon_ncon" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="19" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Nivel Contributivo"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_nivcon_ncon" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
        </Grid>
        <!-- FILA 18 - Datos de Contrato -->
        <Grid Grid.Row="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Datos de Remisión -->
            <TextBlock Name="lblAdm_DatosRms" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Foreground="Black" Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" >
                       <Run Language="es-co" Text="Datos de Remisión"/>
            </TextBlock>
        </Grid>
        <!-- FILA 19 - Remision -->
        <Grid Grid.Row="19">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="131*"/>
                <ColumnDefinition Width="115*"/>
                <ColumnDefinition Width="332*"/>

            </Grid.ColumnDefinitions>
            <!-- Numero Remisión -->
            <TextBlock Name="lblG1adm_nrorem_rgad" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="18" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Numero Remisión"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_nrorem_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- Fecha Remisión -->
            <TextBlock Name="lblG1adm_fecrem_rgad" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="18" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Fecha Remisión"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_fecrem_rgad" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
        </Grid>
        <!-- FILA 20 - Remision -->
        <Grid Grid.Row="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="235*"/>
                <ColumnDefinition Width="137*"/>
                <ColumnDefinition Width="206*"/>
            </Grid.ColumnDefinitions>
            <!-- Municipio Origen -->
            <TextBlock Name="lblG1sis_idemun_muni" Grid.Column="0" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="18" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="Municipio Origen"/>
            </TextBlock>
            <TextBox Name="txtG1Sis_idemun_muni" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="1" />
            <!-- IPS Origen Remisión -->
            <TextBlock Name="lblG1sia_codips_tips" Grid.Column="2" Style="{StaticResource styleEtiquetasEdtFormTouch}" Grid.ColumnSpan="2" Height="18" Margin="4,0,2,0" >
                       <Run Language="es-co" Text="IPS Origen Remisión"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codips_tips" Style="{StaticResource styleTextBoxEdtFormTouch}" Focusable="False" Grid.Column="3" />
        </Grid>
        <!-- FILA 21 - Datos Acompañante -->
        <Grid Grid.Row="21">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
