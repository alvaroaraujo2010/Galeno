<UserControl x:Class="GestorReportes.Vista.ControlOrdServiciosTituloEdt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GestorReportes.Vista" 
             mc:Ignorable="d"
             d:DesignHeight="50" 
             Width="780">
    <Grid Name="grdContenedor">
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
        </Grid.RowDefinitions>
        <Border Name="detFondo" 
                Background="White"
                Visibility="Visible"
                BorderThickness="0"
                Grid.Row="0" 
                Grid.RowSpan="3"/>
        <TextBlock Name="lblTitulo"
                   Grid.Row="1"
                   FontSize="14"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Left"
                   Width="270"
                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                 <Run Language="es-co" Text="Indicación"/>
        </TextBlock>
        <!-- ENCABEZADO DETALLES MEDICAMENTOS -->
        <Grid Name="grdTituloDetalle" 
                  Grid.Row="2"
                  Visibility="Visible"
                  Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="lblMedicamento"
                     Margin="5,0,5,0"
                     BorderThickness="0,0,1,0"
                     FontWeight="Bold"
                     Focusable="False"
                     Grid.Column="0"
                    Text="Medicamentos"/>
            <TextBox Name="lblCantidad"
                     FontWeight="Bold"
                     BorderThickness="0,0,1,0"
                     Focusable="False"
                     Text="Cantidad"
                     Grid.Column="1"/>
            <TextBox Name="lblDosificacion"
                     FontWeight="Bold"
                     BorderThickness="0,0,1,0"
                     Focusable="False"
                     Grid.Column="2"
                     Text="Dosificación"/>
            <TextBox Name="lblDias"
                     FontWeight="Bold"
                     BorderThickness="0"
                     Focusable="False"
                     Text="Días"
                     Grid.Column="3"/>
        </Grid>
    </Grid>
</UserControl>
