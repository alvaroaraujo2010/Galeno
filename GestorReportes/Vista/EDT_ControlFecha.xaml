<UserControl x:Class="GestorReportes.Vista.ControlFecha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="24" 
             Width="144">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <Border Name="objBorder" Style="{StaticResource styleDatePickerBorder}" Grid.Column="0" Grid.ColumnSpan="2"/>
        <TextBox Name="txtFechaVista" 
                 Margin="2,3,1,2"
                 BorderThickness="0"
                 Text="01/01/1000"
                 TouchEnter="fcvTouchEnterTeclado"
                 TextChanged="fcvActualizarDatePicker"/>
        <DatePicker Name="dpkFecha" 
                    TabIndex="500"
                    SelectedDateChanged="fcvDatePickerSelected"
                    Style="{StaticResource styleDatePickerForm}" Grid.Column="1"/>
        <TextBox Name="txtFecha" Visibility="Collapsed"/>
    </Grid>
</UserControl>
