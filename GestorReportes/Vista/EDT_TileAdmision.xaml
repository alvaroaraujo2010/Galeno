<UserControl x:Class="GestorReportes.Vista.TileAdmision"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	        mc:Ignorable="d"
	        x:Name="UserControl"
	        d:DesignWidth="640" 
            d:DesignHeight="200" 
            Width="570" 
            Height="Auto" 
            Opacity="50">
    <Grid Name="LayoutRoot" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,0"
                BorderBrush="#FFB0AFAF"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="#FFFBFBFB" 
                Margin="0,2,0,-2">
        </Border>
        <Border BorderThickness="0,0,0,0"
                Grid.Row="0"
                Margin="0,2,0,0" 
                Background="#FFF1F1F1">
        </Border>
        <!-- Orden servicio #FFB4B4B4 -->
        <Image Name="imgRegistro"
               HorizontalAlignment="Left"
               Width="40"
               Height="40"
               Grid.Row="0"
               Source="/Sistema;component/Imagenes/sys_varios_treegrupos.png"
               Stretch="Uniform" Margin="11,2,0,3"/>
        <!-- Titulo del Modulo -->
        <Image Name="imgEstado"
               HorizontalAlignment="Left"
               Width="16" 
               Height="16"
               Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
               Stretch="UniformToFill" 
               Grid.Row="0" 
               Margin="5,21,0,8"/>
        <TextBlock Name="txtTitulo" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Grid.Row="0"
                   Margin="62,7,0,0" 
                   FontSize="13"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left" 
                   Text="Admisión paciente" 
                   Width="410"
                   Foreground="#FF1838A4"/>
        <TextBlock Name="txtPrograma" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="62,27,0,0" 
                   Grid.Row="0"
                   FontSize="10"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left"
                   Foreground="#FF5CA4C5"
                   Text="Programa Fecha y Hora" 
                   Width="333"
                   Height="16"/>
        <TextBlock Name="txtEstado" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Top"
                   Margin="0,27,60,0" 
                   Grid.Row="0"
                   FontSize="12"
                   FontWeight="Bold"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Right"
                   Foreground="#FFEC316C"
                   Text="Estado" 
                   Width="90"
                   Height="16"/>
        <Button Name="cmdHistorialOcultar"
                Grid.Row="0"
                Margin="0,4,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                TabIndex="50"
                Click="fcvActivarVistaDetalles"
                ToolTip="Ocultar la ventan Historial" 
                Height="40"
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropHistorial"
                        Source="/GestorReportes;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <StackPanel Name="stkHistorial"
                    Grid.Row="2"
                    Focusable="False"
                    Orientation="Vertical"
                    Height="Auto" 
                    Margin="10,1,5,0"/>
    </Grid>
</UserControl>
