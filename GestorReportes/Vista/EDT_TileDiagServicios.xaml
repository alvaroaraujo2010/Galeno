<UserControl x:Class="GestorReportes.Vista.TileDiagServicios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Width="203" 
             Height="42" 
             mc:Ignorable="d">
    <Grid>
        <Button Name="cmdRegistro"
                HorizontalAlignment="Left"
                Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                TabIndex="50"
                Height="40"
                Cursor="Hand"
                Width="200">
            <Grid Margin="0,0,0,0" HorizontalAlignment="Left" Width="196">
                <Image Name="imgImagen"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Source="/Imagenes/Edt_formas_circulo.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="Fill" 
                       Width="43" 
                       Height="34" 
                       Margin="2,0,0,0"/>
                <TextBlock Name="txtTexto" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           FontSize="8.5"
                           FontFamily="Segoe UI Symbol"
                           TextAlignment="Left"
                           Margin="51,1,1,4"
                           TextWrapping="Wrap"
                           Text="AFECCIONES ESPECIFICADAS DE LOS DIENTES Y ESTRUCTURAS DE SOSTEN" 
                           Width="145"
                           Height="32">
                </TextBlock>
            </Grid>
        </Button>
    </Grid>
</UserControl>
