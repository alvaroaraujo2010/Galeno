<UserControl x:Class="GestorReportes.Vista.ControlOrdHojaConsumoDe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="60" 
             d:DesignWidth="300"
             Height="Auto"
             Width="730">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Image Name="imgEstado"
               Grid.Row="0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,2,12,0"
               Width="20"
               Height="20"
               Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
               Stretch="UniformToFill"/>
        <Button Name="cmdEliminar"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                ToolTip="Eliminar registro" 
                Height="30" 
                Cursor="Hand"
                Width="40">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0.9,0,0"
                    BorderBrush="#FFD1CFCF"
                    Grid.Row="0"
                    Margin="0,25,10,0"
                    Grid.ColumnSpan="4"/>
            <TextBlock Name="txtFecha" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
        		       FontSize="12"
                       Margin="1,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtHora" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
        		       FontSize="12"
                       Margin="1,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtCantidad" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="12"
                       Margin="10,5,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtServicio" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="3"
        		       FontSize="12"
                       Margin="1,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtDetalle" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="4"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Margin="2,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtProfesional" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
        		       FontSize="10"
                       Margin="9,27,23,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C" Grid.ColumnSpan="4"/>
        </Grid>
    </Grid>
</UserControl>
