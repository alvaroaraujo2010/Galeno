<UserControl x:Class="GestorReportes.Vista.ControlVistaTriage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="550"
             Width="730"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="208*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="95*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="95*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <!-- ====================================== -->
        <!-- ENCABEZADO -->
        <!-- ====================================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_nroreg_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Registro"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_nroreg_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_gesfec_tria"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                               <Run Language="es-co" Text="Fecha servicio"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_gesfec_tria"
                         Grid.Column="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_geshor_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Hora servicio"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_geshor_tria"
                        Style="{StaticResource styleTextBoxEdtFormTouch}"
                        Grid.Column="1"/>
            </Grid>
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sis_estpro_espr"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Estado"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_estpro_espr"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
                <TextBox Name="txtG1Sis_despro_espr"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="2"/>
            </Grid>
        </Grid>
        <!-- ====================================== -->
        <!-- DATOS BASICOS DEL PACIENTE -->
        <!-- ====================================== -->
        <Rectangle Height="1"
                   Grid.Row="1"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Stroke="#FFD1CECE" 
                   Margin="0,5,0,0" />
        <Grid Grid.Row="1" Margin="6,6,6,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblDatosUsuario"
                       Grid.Column="0"
                       FontSize="18"
                       Style="{StaticResource styleEtiquetasFormResize}">
                       <Run Language="es-co" Text="Datos Básicos del paciente"/>
            </TextBlock>
            <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Name="lblG1sia_nroide_usua"
                                   Grid.Column="0"
                                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                   <Run Language="es-co" Text="Identificación"/>
                        </TextBlock>
                        <TextBox Name="txtG1Sia_tipide_tide"
                                 Style="{StaticResource styleTextBoxEdtFormTouch}"
                                 Grid.Column="1"/>
                        <TextBox Name="txtG1Sia_nroide_usua"
                                 Style="{StaticResource styleTextBoxEdtFormTouch}"
                                 Grid.Column="2"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="lblG1sia_priape_usua"
                           Grid.Column="0"
                           Grid.Row="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Primer Apellido"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_priape_usua"
                         Grid.Column="0"
                         Grid.Row="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
                <TextBlock Name="lblG1sia_segape_usua"
                           Grid.Column="1"
                           Grid.Row="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Segundo Apellido"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_segape_usua"
                         Grid.Column="1"
                         Grid.Row="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
                <TextBlock Name="lblG1sia_prinom_usua"
                           Grid.Column="2"
                           Grid.Row="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Primer Nombre"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_prinom_usua"
                         Grid.Column="2"
                         Grid.Row="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
                <TextBlock Name="lblG1sia_segnom_usua"
                           Grid.Column="3"
                           Grid.Row="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                          <Run Language="es-co" Text="Segundo Nombre"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_segnom_usua"
                         Grid.Column="3"
                         Grid.Row="1"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
                <TextBlock Name="lblG1sis_codsex_sexo"
                           Grid.Row="0"
                           Grid.Column="4"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Sexo"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_codsex_sexo"
                         Grid.Row="1"
                         Grid.Column="4"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"/>
            </Grid>
            <Grid Grid.Row="4" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_fecnac_usua"
                          Grid.Column="0"
                          Style="{StaticResource styleEtiquetasEdtFormTouch}">
                          <Run Language="es-co" Text="Fecha nacimiento"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_fecnac_usua"
                             Grid.Column="1"
                             Style="{StaticResource styleTextBoxEdtFormTouch}"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_edapac_usua"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                          <Run Language="es-co" Text="Edad"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_edapac_usua"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
                <TextBox Name="txtG1Sia_codmed_tmed"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="2"/>
            </Grid>
            <Grid Grid.Row="5" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1hcl_nrohis_hicl"
                                               ToolTip="Numero o código de la Ficha de Historias Clínicas electronica"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                               <Run Language="es-co" Text="Historia clínica"/>
                </TextBlock>
                <TextBox Name="txtG1Hcl_nrohis_hicl"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_tiplle_tria"
                                               ToolTip="Tipo llegada para recibir la atencion: 1 =Caminando,2=Vehiculo particular,3= Ambulancia  y otros"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                               <Run Language="es-co" Text="llegada al servicio"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_tiplle_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="5" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtG1Sia_deseps_teps"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="2"/>
                <TextBlock Name="lblG1sia_codeps_teps"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Código EPS"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_codeps_teps"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="6" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtG1Sis_nommun_muni"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="2"/>
                <TextBlock Name="lblG1sis_idemun_muni"
                                               ToolTip="Id Único Municipio: Cod.DANE.Departamento+Cod.DANE.Municipio"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                               <Run Language="es-co" Text="Municipio"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_idemun_muni"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="6" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sis_coddep_dpto"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Departamento"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_coddep_dpto"
                        Style="{StaticResource styleTextBoxEdtFormTouch}"
                        Grid.Column="1"/>
                <TextBox Name="txtG1Sis_desdep_dpto"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="2"/>
            </Grid>
        </Grid>
        <!-- ====================================== -->
        <!-- SIGNOS VITALES                         -->
        <!-- ====================================== -->
        <Rectangle Height="1"
                   Grid.Row="2"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Stroke="#FFD1CECE" 
                   Margin="0,5,0,0" />
        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="32*"/>
                <RowDefinition Height="32*"/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblSignos"
                       Grid.Column="0"
                       FontSize="18"
                       Style="{StaticResource styleEtiquetasFormResize}">
                       <Run Language="es-co" Text="Signos Vitales"/>
            </TextBlock>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_frecar_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Frecuencia cardiaca(FC)"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_frecar_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_freres_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Frecuencia respiratoria"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_freres_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_tasist_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="T.Arterial  sistólica"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_tasist_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_tadias_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="T.Arterial diastólica"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_tadias_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_temper_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Temperatura corporal"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_temper_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_pesokg_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Peso (kilogramos)"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_pesokg_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_tallac_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Talla (centimetros)"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_tallac_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
        </Grid>
        <!-- ====================================== -->
        <!-- MOTIVO CONSULTA                        -->
        <!-- ====================================== -->
        <Rectangle Height="1"
                   Grid.Row="3"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Stroke="#FFD1CECE" 
                   Margin="0,5,0,0" />
        <Grid Grid.Row="3" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="27"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblG1adm_motcon_tria"
                       Grid.Row="0"
                       FontSize="18"
                       Style="{StaticResource styleEtiquetasFormResize}">
                       <Run Language="es-co" Text="Motivo consulta"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_motcon_tria"
                     Background="Transparent"
                     Style="{StaticResource styleTextBoxFormResize}" 
                     Height="50" 
                     Grid.Row="1" 
                     BorderBrush="#FFDDDFE0"/>
        </Grid>
        <!-- ====================================== -->
        <!-- CLASIFICACION                          -->
        <!-- ====================================== -->
        <Grid Grid.Row="4" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_clasif_tria"
                                               ToolTip="Clasificacion de evaluacion Triage : 1= TRIAGE I  2= TRIAGE II  3= TRIAGE III"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                               <Run Language="es-co" Text="Clasificación triage"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_clasif_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1adm_remisi_tria"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasEdtFormTouch}">
                           <Run Language="es-co" Text="Destino Remisión"/>
                </TextBlock>
                <TextBox Name="txtG1Adm_remisi_tria"
                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                         Grid.Column="1"/>
            </Grid>
        </Grid>
        <!-- ====================================== -->
        <!-- OBSERVACION                            -->
        <!-- ====================================== -->
        <Rectangle Height="1"
                   Grid.Row="5"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Stroke="#FFD1CECE" 
                   Margin="0,5,0,0" />
        <Grid Grid.Row="5" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="27"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="lblG1adm_observ_tria"
                       Grid.Row="0"
                       FontSize="18"                       
                       Style="{StaticResource styleEtiquetasFormResize}">
                       <Run Language="es-co" Text="Observación"/>
            </TextBlock>
            <TextBox Name="txtG1Adm_observ_tria"
                     Style="{StaticResource styleTextBoxFormResize}"
                     Background="Transparent"
                     Grid.Row="1"
                     BorderBrush="#FFDDDFE0"
                     Height="50"/>
        </Grid>
        <!-- ====================================== -->
        <!-- SEDE Y PROFESIONAL                     -->
        <!-- ====================================== -->
        <Grid Grid.Row="6" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtG1Sia_descat_ceat"
                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                             Grid.Column="2"/>
                    <TextBlock Name="lblG1sia_codcat_ceat"
                                                   ToolTip="Centro de Atención  cuando hay varias sedes"
                                                   Grid.Column="0"
                                                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                                                   <Run Language="es-co" Text="Centro atención"/>
                    </TextBlock>
                    <TextBox Name="txtG1Sia_codcat_ceat"
                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                             Grid.Column="1"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblG1sia_codpfa_prof"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasEdtFormTouch}">
                               <Run Language="es-co" Text="Profesional atiende"/>
                    </TextBlock>
                    <TextBox Name="txtG1Sia_codpfa_prof"
                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                             Grid.Column="1"/>
                <TextBox Name="txtG1Sia_nompro_prof"
                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                             Grid.Column="2"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
