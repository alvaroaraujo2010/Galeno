<UserControl x:Class="GestorReportes.Vista.ActividadesMedicasMenu"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	        mc:Ignorable="d"
	        x:Name="UserControl"
	        d:DesignWidth="368" 
            d:DesignHeight="200" 
            Width="372" 
            Height="Auto" 
            Opacity="50">
    <Grid Name="LayoutRoot" >
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0.9,0,0"
                BorderBrush="#FFB0AFAF"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="White" Margin="0,2,0,-2">
        </Border>
        <Border BorderThickness="0,0.9,0,0"
                Grid.Row="0"
                BorderBrush="#FFB0AFAF"
                Margin="0,2,0,-2">
        </Border>
        <!-- Orden servicio #FFB4B4B4 -->
        <TextBlock Name="txtTitulo" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Grid.Row="0"
                   Margin="43,9,0,0" 
                   FontSize="13"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left" 
                   Text="Descripcion del evento" 
                   Width="290"
                   MouseDown="txtTitulo_MouseDown"
                   TouchDown="txtTitulo_TouchDown"
                   Foreground="#FF1838A4"/>
        <Button Name="cmdHistorialOcultar"
                Grid.Row="0"
                Margin="4,4,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                TabIndex="50"
                Click="fcvActivarVistaDetalles"
                Height="25"
                Cursor="Hand"
                Width="30">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropDetalles"
                        Source="/GestorReportes;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <StackPanel Name="stkDetalles"
                    Grid.Row="1"
                    Orientation="Vertical"
                    Height="Auto" 
                    Margin="3,0,3,0" 
                    Background="#FFF5F4F4">
            <WrapPanel Name="wraDetalles" Background="#FFF5F4F4" Margin="0,5,0,5" Height="Auto" Orientation="Horizontal"/>
        </StackPanel>
    </Grid>
</UserControl>
