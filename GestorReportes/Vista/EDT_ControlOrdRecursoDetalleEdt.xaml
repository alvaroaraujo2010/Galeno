<UserControl x:Class="GestorReportes.Vista.ControlOrdRecursoDetalleEdt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="90" 
             d:DesignWidth="400"
             Height="Auto"
             Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <!-- ENCABEZADO -->
        <Grid Name="grdTitulo" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Border Name="detFondo" 
                    Background="#FFF0F0F0"
                    Visibility="Visible"
                    BorderThickness="0"
                    Grid.ColumnSpan="6"
                    Grid.Column="0"/>
            <Image Name="imgEstado"
                   Grid.Column="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="23,8,12,0"
                   Width="20"
                   Height="20"
                   Source="/GestorReportes;component/Imagenes/Edt_edt_aceptar.png"
                   Stretch="UniformToFill"/>
            <Button Name="cmdEliminar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Eliminar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Margin="0,3,25,0"
                    Width="40">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdModificar"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Modificar el registro" 
                    Height="30"
                    Grid.Column="1"
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgEditar"
                       Height="20"
                       Width="20"
                       Source="/GestorReportes;component/Imagenes/Edt_hist_vista_abierto.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Name="lblTitulo"
                   Grid.Row="1"
                   FontSize="14"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Left"
                   Visibility="Collapsed"
                   Width="270"
                   Style="{StaticResource styleEtiquetasEdtFormTouch}">
                 <Run Language="es-co" Text="Recurso"/>
        </TextBlock>
        <Border BorderThickness="0,0,0,0.9"
                BorderBrush="#FFB0AFAF"
                Grid.Row="2"
                Grid.RowSpan="2"/>
        <Image Name="imgArchivo"
               Grid.Row="1"
               Grid.RowSpan="2"
               Height="60"
               Width="60"
               Grid.Column="0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="/Sistema;component/Imagenes/Edt_edt_adicionar.png"
               Style="{StaticResource styleImagBotonesForm}"
               Stretch="UniformToFill" 
               Margin="7,4,0,0"/>
        <TextBox Name="txtObservacion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Row="2"
        		       FontSize="12"
                       Background="Transparent" 
                       BorderThickness="0"
                       IsReadOnly="True"
                       Margin="74,7,30,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
    </Grid>
</UserControl>
