<UserControl x:Class="GestorReportes.Vista.ControlOrdOdontoServiciosDetalle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="45" 
             d:DesignWidth="300"
             Height="Auto"
             Width="730">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Image Name="imgProceso"
               Grid.Row="0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,6,12,0"
               Width="20"
               Height="20"
               Source="/GestorReportes;component/Imagenes/hc_od_dt1.png"
               Stretch="UniformToFill"/>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="txtItem" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
        		       FontSize="12"
                       Margin="1,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtDetalle" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Margin="2,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtEstado" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="12"
                       Margin="20,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
