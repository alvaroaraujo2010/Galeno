<Window x:Class="ConsultaExterna.Vista.VistaConsultaExterna"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConsultaExterna.Vista" 
        Title="Vista Consulta Externa" 
        Height="750" 
        Width="1024"  
        Name="MaxCEXConsultaExterna"
        WindowState="Maximized"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        KeyUp="MenuComponentes_KeyUp" 
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="35" />
            <RowDefinition Height="90*" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="1"
                Grid.Row="0"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown"/>
        <Border Margin="0,0,0,0"
                Grid.Row="1"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown" 
                Background="#FFF1F0F0">
        </Border>
        <local:crtBuscar
                HorizontalAlignment="Left"
                Height="30" 
                Width="220"
                Grid.Row="1"
                Margin="20,1,0,0" Loaded="crtBuscar_Loaded"/>
        <TextBlock Name="lblPaciente"
                   HorizontalAlignment="Left" 
                   Width="670"
                   Margin="290,6,0,5"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   FontFamily="Segoe UI Light"
                   FontSize="16"
                   Height="24"
                   Text="Registro:"/>
        <Image HorizontalAlignment="Right" 
               VerticalAlignment="Top"
               Margin="0,83,10,0" 
               Height="47"
               RenderTransformOrigin="1.432,0.938"
               Source="/Sistema;component/Imagenes/sys_cit01.png" 
               Width="58" 
               Grid.RowSpan="2" />
        <TextBlock Name="txtnick" 
                   Text="Nick" 
                   FontFamily="Segoe UI Light" 
                   FontSize="12"
                   TextAlignment="Right"
                   HorizontalAlignment="Right" 
                   Margin="0,10,72,8" 
                   Width="160" 
                   Grid.Row="1" />
        <!-- Logo del Sistema -->
        <Image Name="ImgPpal" 
               Grid.Row="0" 
               Height="76" 
               Width="95"
               Stretch="Fill"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Margin="17,17,0,0"
               Source="/Sistema;component/Imagenes/sys_atm01.png" />
        <!-- Titulo del Sistema -->
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Stretch" 
        	VerticalAlignment="Top"
        	Margin="117,56,228,0" 
        	FontSize="26"  
        	FontFamily="Segoe UI Light" Height="35">
            <Run Text="Consulta Externa"/>
            <Run Language="es-co"/><Run Text=" "/>
            <LineBreak/>
            <Run Language="es-co"/></TextBlock>
        <!-- Boton Minimizar -->
        <Image x:Name="MinimizeButton" 
               MouseDown="MinimizeButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="MinimizeButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_minimizar.png"
               Margin="0,0,80,0" />
        <!-- Boton Cerrar -->
        <Image MouseDown="CloseButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="CloseButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="2"
               Margin="0,0,0,-40" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,10,10"
               Grid.Row="2"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="2"
                   FontFamily="Segoe UI Light" 
                   FontSize="16"
                   Foreground="AntiqueWhite"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="20,0,0,20" Width="402"/>
        <!-- Zona de los Tiles -->
        <Canvas x:Name="MainCanvas" 
                Grid.Row="2"
                Margin="0,0,0,0"
                ClipToBounds="True" 
                Background="#00000000" 
                PreviewTouchDown="fcvMainCanvas_PreviewTouchDown"
                PreviewTouchUp="fcvMainCanvas_PreviewTouchUp"
                PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp" >
            <!-- Barra que sale en la Zona inferior -->
            <StackPanel Width="Auto"
                        Height="600" 
                        Canvas.Left="45" 
                        Canvas.Top="11" 
                        x:Name="MetroStackPanel" 
                        Orientation="Horizontal" 
                        Background="#00000000" 
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
        </Canvas>
        <!-- MENU INFERIOR  -->
        <Canvas Name="CanvasMenuBottom" 
                VerticalAlignment="Bottom" 
                Height="30" Background="#00000000" 
                Margin="0,0,-1,0"  
                TouchEnter="fcvActivarVistaMenuBottomTouchEnter"
                MouseEnter="fcvActivarVistaMenuBottomMouseEnter"
                Grid.Row="2">
            <Grid x:Name="GridMenuBottom" 
                  Height="80" 
                  Canvas.Top="40" 
                  Width="1025">
                <Image x:Name="Capa" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0" 
                       Source="/Sistema;component/Imagenes/sys_panel_fondo3.png"
                       Stretch="Fill"/>
                <Button Name="cmdBuscar"
                        Margin="300,8,0,0"
                        TabIndex="53"
                        Click="fcvBuscarFiltro"
                        Visibility="Collapsed"
                        Style="{StaticResource styleButtonImgFormTouch}"
                        ToolTip="Buscar turno existente en base de datos" >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgBuscar"
                    		Source="/Sistema;component/Imagenes/sys_varios_vistaprevia.png"/>
                    </StackPanel>
                </Button>
                <Button Name="cmdVistaHoy"
                        Margin="370,8,0,0"
                        TabIndex="53"
                        Click="fcvBuscarTodosHoy"
                        Style="{StaticResource styleButtonImgFormTouch}"
                        ToolTip="Mostrar programación para el dia de hoy" >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgVistaHoy"
                    		Source="/Sistema;component/Imagenes/sys_varios_citas.png"/>
                    </StackPanel>
                </Button>
                <Button Name="cmdAgrupar"
                        Margin="370,8,0,0"
                        TabIndex="53"
                        Visibility="Collapsed"
                        Click="fcvMostrarMenuContextual"
                        Style="{StaticResource styleButtonImgFormTouch}"
                        ToolTip="Clic para Cambiar estado del registro" >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgAgrupar"
                    		Source="/Sistema;component/Imagenes/sys_varios_agrupar.png"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuContextAgrupar" Style="{StaticResource styleMenuContextButtonTouch}">
                            <MenuItem Name="opAgruparTurno"
                                      Click="fcvAgruparPorTurnos"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Agrupar por Turnos">
                                    <MenuItem.Icon>
                                        <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                    </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="Transparent" BorderBrush="Black" />
                            <MenuItem Name="opAgruparServicio"
                                      Click="fcvAgruparPorServicio"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Agrupar por programa o servicio">
                                    <MenuItem.Icon>
                                        <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            <MenuItem Name="opAgruparProfesional"
                                      Click="fcvAgruparPorProfesional"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Agrupar por profesional">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Name="opAgruparAreaServicio"
                                      Click="fcvAgruparPorAreaServicio"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Agrupar por area de servicio">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_organizar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                        </Button.ContextMenu>
                </Button>
                <Button Name="cmdCampoVista"
                        Margin="440,8,0,0"
                        TabIndex="53"
                        Visibility="Collapsed"
                        Click="fcvMostrarMenuContextual"
                        Style="{StaticResource styleButtonImgFormTouch}"
                        ToolTip="Clic para cambiar datos de la vista" >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgCampoVista"
                    		Source="/Sistema;component/Imagenes/sys_varios_vistatiles.png"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuContextCampoVista" Style="{StaticResource styleMenuContextButtonTouch}">
                            <MenuItem Name="opVistaTurno"
                                      Click="fcvVistaCampoTurnos"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Ver Turnos de atención">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="Transparent" BorderBrush="Black" />
                            <MenuItem Name="opVistaServicio"
                                      Click="fcvVistaCampoServicio"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Ver programa o servicio">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Name="opVistaProfesional"
                                      Click="fcvVistaCampoProfesional"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Ver nombre profesional medico">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Name="opVistaAreaServicio"
                                      Click="fcvVistaCampoAreaServicio"
                                      Style="{StaticResource styleMenuItemContextButtonTouch}"
                                      Header="Ver area de servicio">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                                   Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Grid Grid.Row="0" 
                      Grid.Column="0" 
                      HorizontalAlignment="Left"
                      Margin="40,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Grid.ColumnSpan="2"  
                            Style="{StaticResource styleDatePickerBorder}" 
                            BorderThickness="2"
                            BorderBrush="White"/>
                    <TextBlock Name="lblFechaActiva"
                               Grid.Column="0"
                               FontSize="14"
                               Foreground="White"
                               Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Fecha activa"/>
                    </TextBlock>
                    <TextBox Name="txtFechaActiva"
                             TabIndex="1"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource styleTextBoxFormFecha}"
                             Focusable="False"
                             FontSize="22"
                             Text="01/01/1000"
                             Height="32"
                             TextChanged="fcvActualizarDatePicker" 
                             Margin="5,0,5,0"/>
                    <DatePicker Name="dpkFechaActiva"
                                Grid.Column="1"
                                SelectedDateChanged="fcvDatePickerSelected"
                             Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
            </Grid>
        </Canvas>
        <!-- MENU CORTINA DE LA DERECHA-->
        <Canvas x:Name="ExtrasCanvas" 
                Margin="0,0,0,-40" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Height="690" 
                Width="32" 
                Grid.Row="1" 
                Grid.RowSpan="2">
            <!-- Capa Cortina-->
            <Grid Name="ExtrasGrid" 
                  Width="270" 
                  Height="763"
                  Canvas.Left="33" 
                  Canvas.Top="-100" 
                  Background="#99000000">
                <Image HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0" 
                       Stretch="Fill"
                       Visibility="Collapsed"
                       Opacity="0.3"
                       Source="/Sistema;component/Imagenes/sys_panel_fondo8.png" />
                <!-- ENCABEZADO DEL MENU -->
                <Image HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Margin="0,0,0,0"
                       Height="198"
                       Stretch="Fill"
                       Source="/Sistema;component/Imagenes/sys_panel_fondo7.png" />
                <Button Name="cmdPropOcultar"
                            Margin="8,8,0,0"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaPropiedades"
                            ToolTip="Ocultar la ventan propiedades" 
                            Height="38" 
                            Width="45">
                    <StackPanel Orientation="Horizontal"
                                Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image Name="imgPropCerrar"
                               Source="/GestorReportes;component/Imagenes/Edt_edt_contraer.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    </StackPanel>
                </Button>
                <Image x:Name="imgADmFoto" 
                       Width="59" 
                       Height="67"  
                       Margin="10,46,201,0" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" 
                       Stretch="Fill"
                       ToolTip="Datos de la Admisión"
                       Source="/Sistema;component/Imagenes/sys_usu01.png"/>
                <TextBlock Name="lblCodigoAdmision"
                               HorizontalAlignment="Left"
                               Width="251"
                               Margin="9,150,0,591"
                               FontFamily="Segoe UI Symbol"
                               FontSize="10"
                               Text=""/>
                <TextBlock Name="lblNombrePaciente"
                               HorizontalAlignment="Left"
                               Width="251"
                               Margin="9,172,0,566"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               Text="Paciente"/>
                <!-- MENU AMBULATORIA -->
                <StackPanel Name="tbsAmbulatoria"
                            Margin="20,230,0,0"
                            Orientation="Vertical">
                    <Button Name="cmdHCLApertura"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            Visibility="Collapsed"
                            TabIndex="50"
                            ToolTip="Realizar registro de apertura Historia clinica del paciente"
                            Click="cmdAperturaHCLClinica_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit04.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Nueva Historia">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdADMConsulta"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            Visibility="Collapsed"
                            ToolTip="Completar Rips de Consulta"
                            Click="cmdAMBConsulta_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_atm01.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Antención Consulta">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHCLOrdenesMedicas"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            Visibility="Collapsed"
                            ToolTip="Generar nueva orden medica de servicios"
                            Click="cmdAMBFacturacion_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit04.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Orden de servicios">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHCLClinica"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Ver historia clinica del paciente"
                            Click="cmdHCLClinica_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_his01.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Historia Clinica">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdADMFinalizar"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Confirmar y finalizar el registro de atención"
                            Click="cmdAMBFinalizar_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit02.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Finalizar Consulta">
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
