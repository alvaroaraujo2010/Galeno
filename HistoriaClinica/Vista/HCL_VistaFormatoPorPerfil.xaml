                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="False"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_rutimg_perf"
                           ToolTip="Ruta y Nombre de la Imagen jpg que lo representa en las vista de Menú"
                           FontSize="12"   
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Imagen de Vista"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_rutimg_perf"
                         TabIndex="3"
                         Text="{Binding Path=G1Sys_rutimg_perf, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         MaxLength="150"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="False"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_nivusu_perf"
                           ToolTip="Nivel del usuario en el sistema: 1=Súper usuario 2=Administrador 3=Usuario de gestión"
                           FontSize="12"   
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Nivel del Usuario"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_nivusu_perf"
                         TabIndex="5"
                         Text="{Binding Path=G1Sys_nivusu_perf, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="False"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
