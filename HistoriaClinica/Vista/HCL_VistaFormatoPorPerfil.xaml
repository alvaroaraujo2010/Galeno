                <Grid Name="grdPropSelect" 
                      Width="500"
                      Height="750"
                      Style="{StaticResource styleTabControlEdtGridCortinaPropiedades}"
                      Canvas.Left="22" 
                      Canvas.Top="-210" 
                      Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- IMAGEN ENCABEZADO VENTANA -->
                    <Border BorderThickness="1,1,1,0"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="0"
                            Background="White">
                    </Border>
                    <TextBlock Name="txtPropDetallesTitulo" 
                               Text="Propiedades"
                               Grid.Row="0"
                               FontSize="16"
                               Foreground="#FF224AA0"
                               Style="{StaticResource styleTituloForm}" 
                               Margin="63,24,10,0" Height="26"/>
                    <Border BorderThickness="1,0,1,1"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="1"
                            Background="#F2EEEEEE" 
                            Grid.RowSpan="4"/>
                    <Button Name="cmdSelectOcultar"
                            Grid.Row="0"
                            Margin="10,6,6,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaSeleccion"
                            ToolTip="Ocultar la ventana seleccion canciones" 
                            Height="42" 
                            Width="48">
                        <StackPanel Orientation="Horizontal"
                                    Style="{StaticResource styleStackPanelBotonesForm}">
                            <Image Name="imgSelect2"
                        		   Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                            </Image>
                        </StackPanel>
                    </Button>
                    <ScrollViewer Name="PanelScroll" 
                                  Margin="0,2,0,15"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch" 
                                  Width="Auto"
                                  Height="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  PanningMode="HorizontalFirst"
                                  CanContentScroll="False">
                        <StackPanel Name="stkBasicas">
                            <Expander x:Name="expBasicas" 
                           		      Header="Detalles" 
                        		      HorizontalAlignment="Left" 
                        		      Margin="10,5,0,0" 
                        		      VerticalAlignment="Top" 
                        		      Width="470" 
                        		      FontSize="18"
                        		      Focusable="False"
                        		      IsExpanded="False">
