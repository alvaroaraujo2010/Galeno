                          Grid.Column="2"
                          IsEnabled="False"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSys_estper_perf}"
                          SelectedValuePath="ValorSeleccion">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1sys_estper_perf"
                           ToolTip="Estado del Perfil: 1=Activo 2=Inactivo"
                           FontSize="12"   
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Estado del perfil"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_estper_perf"
                         TabIndex="6"
                         Text="{Binding Path=G1Sys_estper_perf, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         IsReadOnly="True"   
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="False"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="3" Grid.Row="3">
            <Rectangle HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Height="40"
                       OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                       Fill="#FFF6F8F9"
                       Margin="1,0,0,-5"/>
            <TextBlock Height="23"
                       Grid.Row="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="21,10,0,0"
                       Name="lblFiltro"
                       Width="109"
                       FontSize="16"
                       FontFamily="Arial Unicode MS" >
                     <Run Language="es-co" Text="BUSCAR"/>
            </TextBlock>
            <TextBox Height="23"
                     Grid.Row="3"
                     Margin="155,5,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Name="txtFiltroDatos"
                     Width="400"
                     Style="{StaticResource styleTextBoxForm}"
                     Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
                     TabIndex="1"
                     KeyDown="fcvMoverFocus_KeyDown"
                     GotFocus="fcvTextBox_GotFocus"/>
            <local:crtBuscar HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Height="30"
                             Width="750"
                             Margin="155,3,0,0" 
                             Loaded="crtBuscarLoaded"/>
            <!-- Filtro -->
            <Button Content="Filtro..."
                    Height="26"
                    HorizontalAlignment="Left"
                    Margin="395,7,0,0"
                    Name="cmdFilVista"
                    VerticalAlignment="Top"
                    Width="89"
                    Visibility="Hidden"
                    Command="{Binding CmdFIL}"/>
            <!-- Fin Filtro-->
        </Grid>
        <!-- Filtro -->
        <Grid Grid.Row="4">
            <DataGrid AutoGenerateColumns="False"
                      Grid.Row="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="10,10,10,10"
                      Name="objDataGrid"
                      ItemsSource="{Binding TmpG2ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                      CanUserAddRows="False"
                      TabIndex="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Hcl_codreg_hcpr}"
                                        Header="Código registro"
                                        Width="100"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding Hcl_codreg_hcca}"
                                        Header="Registro actividad"
                                        Width="200"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding Hcl_desreg_hcca}"
                                        Header="Descripcion tipo registro"
                                        Width="795"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Grp_idepla_grpl}"
                                        Header="Formato"
                                        Width="100"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Hcl_destfor_hcpr}"
                                        Header="Estado"
                                        Width="100"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							    CommandParameter="{Binding SelectedItem, ElementName=objDataGrid}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
        </Grid>
        <Button Name="cmdGuardar"
                Margin="382,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="17"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                           Text="Guardar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="485,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="19"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                           Text="Cancelar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="485,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="20"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                       Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                           Text="Modificar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="22"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                       Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                           Text="Salir"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="23"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                       Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                           Text="Errores"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdBrowser"
                Margin="112,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="16"
                Command="{Binding CmdDFL}"
                Click="fcvBrowserBuscar"
                Grid.Row="5"
                ToolTip="Haga clic aqui para buscar un registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                       Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                           Text="Buscar..."
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <!-- CORTINA DETECHA SELECCION-->
        <Grid Name="grdPropSelectArea" 
              Grid.Row="1"
              Grid.RowSpan="4"
              Width="20"
              Height="Auto"
              Margin="-20,210,0,60"
              MouseEnter="fcvActivarVistaSeleccionMouseEnter"
              TouchEnter="fcvActivarVistaSeleccionTouchEnter"
              HorizontalAlignment="Right" 
              Background="Transparent">
