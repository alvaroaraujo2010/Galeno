                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_desper_perf"
                           ToolTip="Descripción del perfil textual del perfil"
                           FontSize="12"   
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Nombre del Perfil"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_desper_perf"
                         TabIndex="2"
