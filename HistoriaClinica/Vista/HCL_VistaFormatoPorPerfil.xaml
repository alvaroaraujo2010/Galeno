                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="8"/>
                                    </Grid.RowDefinitions>
                                    <!-- Datos factura -->
                                    <Grid Grid.Row="0" Grid.RowSpan="2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="txtG2Hcl_desreg_hcca"
                        					     TabIndex="109"
                        					     Text="{Binding G2Hcl_desreg_hcca, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        					     Style="{StaticResource styleTextBoxFormResizeDisable}"
                        					     TouchEnter="fcvTouchEnterTeclado"
                        					     Grid.Row="1"
                        					     Grid.Column="0"
                        					     Grid.ColumnSpan="3" 
                        					     FontSize="14"
                        					     Grid.RowSpan="2"
                        					     Focusable="False"
                        					     KeyDown="fcvMoverFocus_KeyDown"
                                                 TextWrapping="Wrap"
                        					     GotFocus="fcvTextBox_GotFocus"/>
                                        <Button x:Name="cmdG2Hcl_codreg_hcca"
                        				        Content="..."
                        					    Style="{StaticResource styleButtonMiniFormBrows}"
                        					    TabIndex="109"
                        					    Click="cmdG2Hcl_codreg_hcca_Click"
                        		                Grid.Column="2"
