                   Grid.Row="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="21,10,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
                 Grid.Row="3"
                 Margin="180,7,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Name="txtFiltroDatos"
                 Width="280"
                 Style="{StaticResource styleTextBoxForm}"
                 Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
                 TabIndex="1"
                 KeyDown="fcvMoverFocus_KeyDown"
                 GotFocus="fcvTextBox_GotFocus"/>
        <local:crtBuscar HorizontalAlignment="Left"
