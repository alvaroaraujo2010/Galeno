                            BorderBrush="#FFB0AFAF"
                            Grid.Row="0"
                           Background="White">
                    </Border>
                    <Border BorderThickness="1,0,1,1"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="1"
                           Background="#F2EEEEEE" Grid.RowSpan="4"/>
                    <Button Name="cmdSelectOcultar"
                            Grid.Row="0"
                            Margin="10,6,6,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaPropiedades"
                            ToolTip="Ocultar la ventana propiedades" 
                            Height="42" 
                            Width="48">
                        <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                            <Image Name="imgSelect2"
                        		   Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                            </Image>
                        </StackPanel>
                    </Button>
                    <TextBlock Name="lblPropieadVariable"
                               Grid.Row="0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                	           Width="380"
                	           Margin="76,20,0,0" 
                               FontSize="18" 
                               Foreground="#FF978E8E" 
                               Height="21">
                	       <Run Language="es-co" Text="Propiedades de la Variable"/>
                    </TextBlock>
                    <Grid Width="590" Margin="0,2,0,0" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <!-- datos Basicos Variable -->
                        <ScrollViewer Name="PanelScrollProp"
                                      HorizontalAlignment="Stretch" 
                                      Width="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      CanContentScroll="False"
									  Grid.Row="0"
                                      Height="Auto" 
                                      Margin="0,0,0,0">
                            <StackPanel Name="stkPropBasicas">
                                <Expander Name="PropBasicas" 
                                          Header="Propiedades Básicas" 
                                          HorizontalAlignment="Left" 
                                          Margin="4,5,0,0" 
                                          VerticalAlignment="Top" 
                                          Width="570" 
                                          FontSize="18"
                                          Focusable="False"
                                          IsExpanded="False">
                                    <StackPanel Background="Transparent" Margin="0,0,0,5" Height="Auto">
                                        <Grid Margin="0,2,0,2" Height="300">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="60"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="60"/>
                                                <RowDefinition Height="10"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="1" Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Name="lblG1hcl_titulo_hcvr"
																   ToolTip="Titulo de la variable para mostrar como descripcion corta"
																   Grid.Column="0"
																   Style="{StaticResource styleEtiquetasFormResize}">
																   <Run Language="es-co" Text="Titulo Variable"/>
                                                </TextBlock>
                                                <TextBox Name="txtG1Hcl_titulo_hcvr"
																 TabIndex="1"
																 Text="{Binding Path=G1Hcl_titulo_hcvr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
																 Style="{StaticResource styleTextBoxFormResize}"
																 MaxLength="150"
																 TouchEnter="fcvTouchEnterTeclado"
																 Grid.Column="1"
																 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
																 KeyDown="fcvMoverFocus_KeyDown"
																 GotFocus="fcvTextBox_GotFocus"/>
                                            </Grid>
                                            <Grid Grid.Row="2" Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Name="lblG1hcl_descri_hcvr"
																   ToolTip="Descripción larga de la variable"
																   Grid.Column="0"
																   VerticalAlignment="Top"
																   Style="{StaticResource styleEtiquetasFormResize}" 
																   Margin="4,6,2,0">
																   <Run Language="es-co" Text="Descripción Variable"/>
                                                </TextBlock>
                                                <TextBox Name="txtG1Hcl_descri_hcvr"
																 TabIndex="2"
																 Text="{Binding Path=G1Hcl_descri_hcvr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
																 Style="{StaticResource styleTextBoxFormResize}"
																 MaxLength="240"
																 TouchEnter="fcvTouchEnterTeclado"
																 Grid.Column="1"
																 TextWrapping="Wrap"
																 Height="55"
																 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
																 KeyDown="fcvMoverFocus_KeyDown"
																 GotFocus="fcvTextBox_GotFocus"/>
                                            </Grid>
                                            <Grid Grid.Row="3" Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Name="lblG1hcl_ordvis_hcvr"
																   ToolTip="Numero para orden vista en gestion impresión en formatos dentro del grupo al que pertenece"
																   Grid.Column="0"
																   Style="{StaticResource styleEtiquetasFormResize}">
																   <Run Language="es-co" Text="Orden visualización "/>
                                                </TextBlock>
                                                <TextBox Name="txtG1Hcl_ordvis_hcvr"
