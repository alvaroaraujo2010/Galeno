                                         TouchEnter="fcvTouchEnterTeclado"
                                         Height="24"                      
                                         FontSize="16"
                                         Grid.Column="1"
                                         Focusable="False"
                                         TextChanged="txtG1Hcl_secgru_hcgv_TextChanged"   
