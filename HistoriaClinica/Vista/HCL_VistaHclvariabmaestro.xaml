																 Text="{Binding Path=G1Hcl_nroreg_hcvr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
																 Style="{StaticResource styleTextBoxFormResizeDisable}"
																 TouchEnter="fcvTouchEnterTeclado"
																 Grid.Column="3"
																 Focusable="False"
																 KeyDown="fcvMoverFocus_KeyDown"
																 GotFocus="fcvTextBox_GotFocus"/>
                                            </Grid>
                                            <Grid Grid.Row="4" Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Name="lblG1hcl_auxvar_hcvr"
																   ToolTip="Identificador de la variable sin prefijo del grupo"
																   Grid.Column="0"
																   Style="{StaticResource styleEtiquetasFormResize}">
																   <Run Language="es-co" Text="Crear Nombre de variable"/>
                                                </TextBlock>
                                                <TextBox Name="txtG1Hcl_auxvar_hcvr"
																 TabIndex="4"
																 Text="{Binding Path=G1Hcl_auxvar_hcvr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
																 Style="{StaticResource styleTextBoxFormResize}"
																 MaxLength="28"
