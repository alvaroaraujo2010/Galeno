                                           FontSize="16"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Variable"/>
            </TextBlock>
            <TextBox Name="txtG1Hcl_nomvar_hcgv"
                                         TabIndex="300"
                                         Text="{Binding Path=G1Hcl_nomvar_hcgv, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="4"
                                         Height="24"                      
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            <TextBox Name="txtG1Sis_dessis_hcgv"
                                         TabIndex="300"
                                         Text="{Binding Path=G1Sis_dessis_hcgv, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="5"
                                         Height="24"                      
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
