                          ItemsSource="{Binding Path=G1CbHcl_tipvis_hcra}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1hcl_tipvis_hcra"
                           ToolTip="Saber si se muestra el grupo según el tipo de registro de atencion activo: 1= Solo en pacientes admitidos 2=Solo en Pacientes ambulatoria 3= Ambos casos"
