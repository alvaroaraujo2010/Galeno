                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          TabIndex="4"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbHcl_estreg_hcra}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1hcl_estreg_hcra"
                           ToolTip="Estado del registro 1= Activo 2= Inactivo"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Estado registro"/>
                </TextBlock>
                <TextBox Name="txtG1Hcl_estreg_hcra"
                         TabIndex="3"
                         Text="{Binding Path=G1Hcl_estreg_hcra, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextChanged="ActualizarComboBoxOpcion"
                         Focusable="False"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="3" Grid.Row="3">
            <Rectangle HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Height="40"
                       OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                       Fill="#FFF6F8F9"
                       Margin="1,0,0,-5"/>
            <TextBlock Height="23"
                       Grid.Row="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="21,10,0,0"
                       Name="lblFiltro"
                       Width="109"
                       FontSize="16"
                       FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
            </TextBlock>
            <TextBox Height="23"
                     Grid.Row="3"
                     Margin="155,5,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Name="txtFiltroDatos"
