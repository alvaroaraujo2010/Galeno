                        <ScrollViewer Name="PanelScrollProp"
                                      HorizontalAlignment="Stretch" 
                                      Width="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      CanContentScroll="False"
									  Grid.Row="0"
                                      Height="Auto" 
                                      Margin="-10,0,10,0">
