            <!-- Filtro -->
            <Button Content="Filtro..."
                    Height="26"
                    HorizontalAlignment="Left"
                    Margin="395,7,0,0"
                    Name="cmdFilVista"
                    VerticalAlignment="Top"
                    Width="89"
                    Visibility="Hidden"
                    Command="{Binding CmdFIL}"/>
            <!-- Fin Filtro-->
        </Grid>
        <Grid Grid.Row="4">
            <DataGrid AutoGenerateColumns="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="20,10,0,10"
                      Name="objDataGrid"
                      ItemsSource="{Binding TmpG2ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                      CanUserAddRows="False"
                      TabIndex="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Hcl_codreg_hcca}"
                                        Header="Tipo registro actividad"
                                        Width="180"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_desreg_hcca}"
                                        Header="Descripcion tipo registro"
                                        Width="445"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Grp_despla_grpl}"
                                        Header="Descripcion Plantilla"
                                        Width="250"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_edaini_hcca}"
                                        Header="Edad Inicial"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_desmedin_hcca}"
                                        Header="Medida edad Inicial"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_edafin_hcca}"
                                        Header="Edad final"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_desmedif_hcca}"
                                        Header="Medida edad final"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_destreg_hcca}"
                                        Header="Estado"
                                        Width="80"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=objDataGrid}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
        </Grid>
        <Button Name="cmdGuardar"
                Margin="382,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="28"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
