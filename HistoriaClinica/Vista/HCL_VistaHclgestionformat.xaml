                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1hcl_desgru_hcra"
                           ToolTip="Descripcion grupo actividades clasificadas para vista en captura historias clinicas"
