        <Button Name="cmdEliminar"
                Margin="568,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="37"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdValidacion"
                Margin="670,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="37"
                Click="fcvMostrarMenuContextual"
                Grid.Row="5"
                ToolTip="Gestión Valdiacion avanzada">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgValidacion"
                           Source="/Sistema;component/Imagenes/Edt_hist_ver.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblValidacion"
                               Text="Validación"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opValidar"
                              Click="fcvEjecutaValidacion"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Validacion Avanzada">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/Edt_hist_ver.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="Transparent" BorderBrush="Black" />
                    <MenuItem Name="opVistaErrores"
                              Command="{Binding CmdCON}"
                              Click="fcvActivarEtiqueta"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Mostrar vista errores en validación">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Name="cmdSalir"
                HorizontalAlignment="Right"
                Margin="0,10,40,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="38"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="39"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdBrowser"
                Margin="20,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="132"
                Command="{Binding CmdDFL}"
                Click="fcvBrowserBuscar"
                Grid.Row="5"
                ToolTip="Haga clic aqui para buscar un registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                           Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                               Text="Buscar..."
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <!-- NAVEGADOR DE ETIQUETAS -->
        <Canvas Name="cvaEtiqueta" 
                Grid.Row="5"
                Margin="0,50,0,0"
                Height="540"
                Visibility="Visible" 
                Width="1020">
            <Grid Name="grdEtiqueta" Height="540" Width="1020" Margin="0,0,0,0" Canvas.Left="0" Canvas.Top="0">
                <Border Name="objBorderEtiqueta" BorderThickness="1" Background="#99060606"/>
                <TextBlock Name="lblTituloEtiqueta"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                	       Width="936"
                	       Margin="10,4,0,0" FontSize="20" Foreground="White">
                	       <Run Language="es-co" Text="Titulo Etiqueta..."/>
                </TextBlock>
                <Button Name="cmdEtiquetaOcultar"
                        Margin="0,3,14,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource styleButtonImgEdtFormTouch}"
                        TabIndex="50"
                        Click="fcvActivarEtiqueta"
                        ToolTip="Ocultar vista" 
                        Height="30" 
                        Width="60">
                    <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image Name="imgEtiquetaCerrar"
                               Source="/Sistema;component/Imagenes/Edt_edt_contraer3.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill" />
                    </StackPanel>
                </Button>
                <Grid Name="grdVistaErrores" Margin="14,35,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource styleBorderFondoForm}"
                        BorderThickness="1"
                        Grid.Row="0"
                        Grid.RowSpan="2">
                    </Border>
                    <Grid Margin="20,0,10,0" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblFiltroErrores"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   FontSize="16"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                <Run Language="es-co" Text="Filtro"/>
                        </TextBlock>
                        <TextBox Name="txtFiltroErrores"
                                 TabIndex="3"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Column="1"
                                 Grid.Row="0"
                                 Height="30"
                                 FontSize="16"
                                 TouchEnter="fcvTouchEnterTeclado"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                        <Button Name="cmdFiltroErrores"
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="8,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridErroresEjecutar"
                                ToolTip="Aplicar filtro en vista de errore" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgFiltroErrores" Source="/Sistema;component/Imagenes/Edt_edt_filtro1.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdQFiltroErrores"
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="4,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridErroresQuitar"
                                ToolTip="Quitar filtro en vista errores" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgQFiltroErrores" Source="/Sistema;component/Imagenes/Edt_edt_filtro2.png"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Name="txtErrorCompiler"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Height="Auto"
                             Width="Auto"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Visibility="Collapsed"
                             Margin="0,0,0,0"/>
                    <DataGrid Name="objDataGridErrores" 
                              AutoGenerateColumns="False"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Visible"
                              Grid.Row="1"
                              CanUserAddRows="False"
                              TabIndex="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Secuencial}"
                                    Header="Secuencial"
                                    Width="70"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdRegistro}"
                                    Header="Registro"
                                    Width="60"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding NombreCampo}"
                                    Header="Campo"
                                    Width="240"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ValorCampo}"
                                    Header="Valor"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CodigoError}"
                                    Header="Codigo Error"
                                    Width="80"
                                    IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding MensajeError}"
                                    Header="Error"
                                    Width="480"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding NivelError}"
                                    Header="Nivel error"
                                    Width="90"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdUsuario}"
                                    Header="Identificación"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PApellido}"
                                    Header="Primer apellido"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SApellido}"
                                    Header="Segundo apellido"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PNombre}"
                                    Header="Primer nombre"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SNombre}"
                                    Header="Segundo nombre"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>