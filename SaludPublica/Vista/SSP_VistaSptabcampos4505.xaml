<!-- MARMOTA-GENCODE: VERSION 2.0 - 16/04/2014 10:01:46 AM -->
<Window
    x:Class="SaludPublica.Vista.VistaSptabcampos4505"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    DataContext="{Binding Path=VistaModeloSptabcampos4505, Source={StaticResource SSP_Locator}}"
    Title="Campos de la Resolución 4505"
    Icon="/Sistema;component/Imagenes/sis_logo40.png"
    Width="800"
    Height="424"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
              	Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="123*" />
            <RowDefinition Height="155*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border
                Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="799"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Campos de la Resolución 4505"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image MouseDown="btnCerrar_KeyDown"
               Style="{StaticResource styleImgButtonCerrarForm}"
               Source="/Sistema;component/Imagenes/sis_cerrar40.png"
               Grid.Row="1"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               Cursor="Hand"/>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="798"
               Margin="1,3,0,-3"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="798"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
             Grid.Row="2"
             Margin="130,7,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Name="txtFiltroDatos"
             Width="280"
             Style="{StaticResource styleTextBoxForm}"
             Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}" Grid.RowSpan="2"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3">
            <TextBlock Name="lblG1ssp_codcam_resc"
                               Width="122"
                               Margin="8,8,0,0"
                               ToolTip="Consecutivo Único de campo o nombre (ejemplo: SSP_CAM025_MS45)"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Código Campo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_codcam_resc"
                             Width="248"
                             Margin="135,8,0,0"
                             TabIndex="1"
                             Text="{Binding Path=G1Ssp_codcam_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_nomcam_resc"
                               Width="122"
                               Margin="8,31,0,0"
                               ToolTip="Etiqueta del campo (descripcion campo)"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Titulo o Etiqueta"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_nomcam_resc"
                             Width="248"
                             Margin="135,31,0,0"
                             TabIndex="2"
                             Text="{Binding Path=G1Ssp_nomcam_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_ordvis_resc"
                               Width="122"
                               Margin="8,54,0,0"
                               ToolTip="Orden de vista del campo en la resolucion (inicia desde campo cero (0) hasta 118)"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Orden Vista"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_ordvis_resc"
                             Width="248"
                             Margin="135,54,0,0"
                             TabIndex="3"
                             Text="{Binding Path=G1Ssp_ordvis_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_descam_resc"
                               Width="122"
                               Margin="8,77,0,0"
                               ToolTip="Descripción del Campo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Descripción"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_descam_resc"
                             Width="248"
                             Margin="135,77,0,0"
                             TabIndex="4"
                             Text="{Binding Path=G1Ssp_descam_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <ComboBox Name="cboG1Ssp_tipval_resc"
                    	Width="175"
                    	Margin="208,100,0,0"
                    	Grid.Row="3"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSsp_tipval_resc}"
                    	SelectedValuePath="ValorSeleccion">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1ssp_tipval_resc"
                               Width="122"
                               Margin="8,100,0,0"
                               ToolTip="Tipo de valor del campo Ejemplo: D=Fecha, C=Texto,N=Númerico"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Tipo de Valor"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_tipval_resc"
                             Width="70"
                             Margin="135,100,0,0"
                             TabIndex="5"
                             Text="{Binding Path=G1Ssp_tipval_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_valper_resc"
                               Width="122"
                               Margin="388,8,0,0"
                               ToolTip="Valores permitidos para el campo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Valor Permitido"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_valper_resc"
                             Width="248"
                             Margin="515,8,0,0"
                             TabIndex="6"
                             Text="{Binding Path=G1Ssp_valper_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <ComboBox Name="cboG1Ssp_camdig_resc"
                    	Width="175"
                    	Margin="588,31,0,0"
                    	Grid.Row="3"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSsp_camdig_resc}"
                    	SelectedValuePath="ValorSeleccion">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1ssp_camdig_resc"
                               Width="122"
                               Margin="388,31,0,0"
                               ToolTip="Campo digitable: 1=Si 2=No"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Campo digitable"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_camdig_resc"
                             Width="70"
                             Margin="515,31,0,0"
                             TabIndex="7"
                             Text="{Binding Path=G1Ssp_camdig_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_ranini_resc"
                               Width="122"
                               Margin="388,54,0,0"
                               ToolTip="Rango inicial del valor digitable"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Rango inicial"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_ranini_resc"
                             Width="248"
                             Margin="515,54,0,0"
                             TabIndex="8"
                             Text="{Binding Path=G1Ssp_ranini_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_ranfin_resc"
                               Width="122"
                               Margin="388,77,0,0"
                               ToolTip="Rango final del valor digitable"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Rango final"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_ranfin_resc"
                             Width="248"
                             Margin="515,77,0,0"
                             TabIndex="9"
                             Text="{Binding Path=G1Ssp_ranfin_resc, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="10,8,0,0"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  Height="150"
                  Width="778"
                  TabIndex="100" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Ssp_codcam_resc}"
                                    Header="Código Campo"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_nomcam_resc}"
                                    Header="Titulo o Etiqueta"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_ordvis_resc}"
                                    Header="Orden Vista"
                                    Width="75"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_descam_resc}"
                                    Header="Descripción"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_tipval_resc}"
                                    Header="Tipo de Valor"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_valper_resc}"
                                    Header="Valor Permitido"
                                    Width="90"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_camdig_resc}"
                                    Header="Campo digitable"
                                    Width="90"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_ranini_resc}"
                                    Header="Rango inicial"
                                    Width="90"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_ranfin_resc}"
                                    Header="Rango final"
                                    Width="90"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger
            		EventName="SelectionChanged">
                    <cmd:EventToCommand
            			Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="250,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="10"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="250,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="11"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="353,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="353,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="456,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="14"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="680,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="15"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
