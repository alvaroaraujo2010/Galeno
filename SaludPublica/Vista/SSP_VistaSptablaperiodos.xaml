<!-- MARMOTA-GENCODE: VERSION 2.0 - 03/07/2013 02:10:22 AM -->
<Window
    x:Class="SaludPublica.Vista.VistaSptablaperiodos"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    DataContext="{Binding Path=VistaModeloSptablaperiodos, Source={StaticResource SSP_Locator}}"
    Title="Tabla periodos SISPRO"
    Icon="/Sistema;component/Imagenes/sis_logo40.png"
    Width="700"
    Height="397"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
              	Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="110*" />
            <RowDefinition Height="141*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Height="383"
                Width="700"
                Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
        </Border>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="699"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Tabla periodos SISPRO"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image MouseDown="btnCerrar_KeyDown"
               Style="{StaticResource styleImgButtonCerrarForm}"
               Source="/Sistema;component/Imagenes/sis_cerrar40.png"
               Grid.Row="1"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               Cursor="Hand"/>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="698"
               Margin="1,3,0,-3"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="698"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
             Grid.Row="2"
             Margin="130,7,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Name="txtFiltroDatos"
             Width="280"
             Style="{StaticResource styleTextBoxForm}"
             Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}" Grid.RowSpan="2"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIDUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3">
            <TextBlock Name="lblG1ssp_codper_peri"
                               Width="106"
                               Margin="8,12,0,0"
                               ToolTip="Código de periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Código de periodo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_codper_peri"
                             Width="215"
                             Margin="119,8,0,0"
                             TabIndex="1"
                             Text="{Binding Path=G1Ssp_codper_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_desper_peri"
                               Width="106"
                               Margin="8,37,0,0"
                               ToolTip="Descripción periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Descripción periodo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_desper_peri"
                             Width="215"
                             Margin="119,33,0,0"
                             TabIndex="2"
                             Text="{Binding Path=G1Ssp_desper_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_mesper_peri"
                               Width="106"
                               Margin="8,62,0,0"
                               ToolTip="Mes del periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Mes del periodo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_mesper_peri"
                             Width="215"
                             Margin="119,58,0,0"
                             TabIndex="3"
                             Text="{Binding Path=G1Ssp_mesper_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_anoper_peri"
                               Width="106"
                               Margin="8,87,0,0"
                               ToolTip="Año del periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Año del periodo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_anoper_peri"
                             Width="215"
                             Margin="119,83,0,0"
                             TabIndex="4"
                             Text="{Binding Path=G1Ssp_anoper_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1ssp_fecini_peri"
                               Width="106"
                               Margin="339,12,0,0"
                               ToolTip="Fecha de inicio del periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Fecha de inicio del periodo"/>
            </TextBlock>
            <Grid Margin="450,8,0,0"
                          Width="215"
                          Grid.Row="3"
                          Style="{StaticResource styleDatePickerGrid}">
                <Border Style="{StaticResource styleDatePickerBorder}"/>
                <TextBox Name="txtG1Ssp_fecini_peri"
                                 TabIndex="5"
                                 Text="{Binding Path=G1Ssp_fecini_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormFecha}"
                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                 TextChanged="fcvActualizarDatePicker"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                <DatePicker Name="dpkG1Ssp_fecini_peri"
                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                Style="{StaticResource styleDatePickerForm}"/>
            </Grid>
            <TextBlock Name="lblG1ssp_fecfin_peri"
                               Width="106"
                               Margin="339,37,0,0"
                               ToolTip="Fecha de fin del periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Fecha de fin del periodo"/>
            </TextBlock>
            <Grid Margin="450,33,0,0"
                          Width="215"
                          Grid.Row="3"
                          Style="{StaticResource styleDatePickerGrid}">
                <Border Style="{StaticResource styleDatePickerBorder}"/>
                <TextBox Name="txtG1Ssp_fecfin_peri"
                                 TabIndex="6"
                                 Text="{Binding Path=G1Ssp_fecfin_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormFecha}"
                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                 TextChanged="fcvActualizarDatePicker"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                <DatePicker Name="dpkG1Ssp_fecfin_peri"
                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                Style="{StaticResource styleDatePickerForm}"/>
            </Grid>
            <ComboBox Name="cboG1Ssp_estper_peri"
                    	Width="140"
                    	Margin="525,58,0,0"
                    	Grid.Row="3"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSsp_estper_peri}"
                    	DisplayMemberPath="{Binding Path=NombreOpcion}"
                    	SelectedValuePath="{Binding Path=ValorSeleccion}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1ssp_estper_peri"
                               Width="106"
                               Margin="339,62,0,0"
                               ToolTip="Estado del periodo"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Estado del periodo"/>
            </TextBlock>
            <TextBox Name="txtG1Ssp_estper_peri"
                             Width="70"
                             Margin="450,58,0,0"
                             TabIndex="7"
                             Text="{Binding Path=G1Ssp_estper_peri, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="10,8,0,0"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  Height="131"
                  Width="678"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Ssp_codper_peri}"
                                    Header="Código"
                                    Width="70"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_desper_peri}"
                                    Header="Periodo"
                                    Width="130"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_mesper_peri}"
                                    Header="Mes"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_anoper_peri}"
                                    Header="Año"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_fecini_peri}"
                                    Header="Fecha de inicio"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_fecfin_peri}"
                                    Header="Fecha de fin"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Ssp_estper_peri}"
                                    Header="Estado"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger
            		EventName="SelectionChanged">
                    <cmd:EventToCommand
            			Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="8"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="9"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="303,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="10"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="303,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="11"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="406,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="580,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>