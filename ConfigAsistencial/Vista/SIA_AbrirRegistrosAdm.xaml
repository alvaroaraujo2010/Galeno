<Window x:Class="ConfigAsistencial.Vista.AbrirRegistrosAdm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Abrir regostros facturación"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="800"
        Height="750"
        AllowsTransparency="True"
        Background="{x:Null}" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Background="#66000E0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="42" />
                <RowDefinition Height="170" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
            </Border>
            <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <Image HorizontalAlignment="Left"
                   Height="37"
                   Margin="10,0,0,0"
                   VerticalAlignment="Top"
                   Width="50"
                   Stretch="Uniform"
                   Grid.RowSpan="2"
                   Source="/Sistema;component/Imagenes/sis_logo40.png"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <TextBlock Text="Abrir registros facturación"
                       Grid.Row="1"
                       Style="{StaticResource styleTituloForm}"
                       MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdSalir_Click"
                    ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                    </Image>
                </StackPanel>
            </Button>
            <Image HorizontalAlignment="Left"
                   Height="50"
                   Width="Auto"
                   Margin="1,3,1,0"
                   VerticalAlignment="Top"
                   Grid.Row="5"
                   Source="/Sistema;component/Imagenes/sis_fondo40.png"
                   StretchDirection="UpOnly"
                   Stretch="Fill"/>
            <!-- Fin Control modo edicion formulario -->
            <Grid Grid.Row="2" Margin="8,2,8,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblG1Admision"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Admisión"/>
                    </TextBlock>
                    <TextBox Name="txtAdmision"
                             Style="{StaticResource styleTextBoxFormResize}"
                             Focusable="False"
                             Grid.Column="1"/>
                    <Button Name="cmdAdmision"
                            Content="..."
                            Style="{StaticResource styleButtonMiniFormBrows}"
                            Click="fcvMostrarMenuEdicion"
                            Grid.Column="2"
                            ToolTip="buscar Admisión">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource styleMenuContextButton}">
                                <MenuItem Name="opTodos"
                                              Click="fcvBrowserBuscar"
                                              Style="{StaticResource styleMenuItemContextButton}"
                                              Header="Admisión ...">
                                    <MenuItem.Icon>
                                        <Image Stretch="UniformToFill"
                                                   Style="{StaticResource styleImagMenuContextButton}"
                                                   Source="/Sistema;component/Imagenes/sis_edt_buscar.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="Transparent" BorderBrush="Black"/>
                                <MenuItem Name="opFacturas"
                                      Click="fcvBrowserBuscar"
                                      Style="{StaticResource styleMenuItemContextButton}"
                                      Header="Buscar por numero de factura...">
                                    <MenuItem.Icon>
                                        <Image Stretch="UniformToFill"
                                           Style="{StaticResource styleImagMenuContextButton}"
                                           Source="/Sistema;component/Imagenes/Edt_edt_archivo.png"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBox Name="txtUsuario"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             Grid.Column="3"
                             Focusable="False"/>
                    <TextBox Name="txtFechaAdmision"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             Grid.Column="4"
                             Focusable="False"/>
                </Grid>
                <TextBox Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Foreground="#FF3399FF"
                         BorderBrush="#FF3399FF"
                         Height="25"
                         FontSize="16"
                         Style="{StaticResource styleTextBoxVistaPropGrupo}"
                         Text="Datos a modificar..."/>
                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblDatosFacturacion"
                               ToolTip="Abrir datos facturacion para la admisión activa"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Datos Facturas"/>
                    </TextBlock>
                    <TextBox Name="txtDatosFacturacion"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <ComboBox Name="cboDatosFacturacion"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblDatosGestionMedica"
                               ToolTip="Abrir datos gestión médica"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Datos Medicos"/>
                    </TextBlock>
                    <TextBox Name="txtDatosGestionMedica"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <ComboBox Name="cboDatosGestionMedica"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblDatosFinAtencion"
                               ToolTip="activar vista en registro admitidos"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Vista admitidos"/>
                    </TextBlock>
                    <TextBox Name="txtDatosFinAtencion"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <ComboBox Name="cboDatosFinAtencion"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblDatosRips"
                               ToolTip="Marcar datos gestion Rips"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Datos Rips"/>
                    </TextBlock>
                    <TextBox Name="txtDatosRips"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <ComboBox Name="cboDatosRips"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="4" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblDatosAdimision"
                               ToolTip="Eliminar todos los datos de la admisión"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Datos adimisión"/>
                    </TextBlock>
                    <TextBox Name="txtDatosAdimision"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <ComboBox Name="cboDatosAdimision"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <TextBox Grid.Row="5"
                         Grid.ColumnSpan="2"
                         Foreground="#FF3399FF"
                         BorderBrush="#FF3399FF"
                         Height="25"
                         FontSize="16"
                         Style="{StaticResource styleTextBoxVistaPropGrupo}"
                         Text="Datos historial médico..."/>
            </Grid>
            <Grid Grid.Row="3" HorizontalAlignment="Left" Width="460" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblDatosHistorial"
                               ToolTip="Gestion registros historial clinico"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}" Height="15">
                         <Run Language="es-co" Text="Gestion datos historial"/>
                </TextBlock>
                <TextBox Name="txtDatosHistorial"
                             TabIndex="10"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             Visibility="Collapsed"
                             TextChanged="ActualizarComboBoxOpcion"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                <ComboBox Name="cboDatosHistorial"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                   	          DisplayMemberPath="{Binding Path=NombreOpcion}"
                   	          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <DataGrid Name="grdDataGrid"
                  Grid.Row="4"
                  Margin="10,2,10,10"
                  AutoGenerateColumns="False" 
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch"
                  Height="Auto" 
                  Width="Auto"
                  CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="26"  Binding="{Binding MarcaBool, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate x:Name="chkMarca">
                                <CheckBox Click="fcvSelectCheckBox" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridCheckBoxColumn.HeaderTemplate>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_nroreg_hcev}" 
                                    Header="Registro" 
                                    Width="130"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_desreg_hcev}" 
                                    Header="Registro" 
                                    Width="380"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hcl_gesfec_hcev, StringFormat={}{0:dd/MM/yyyy}}" 
                                    Header="Fecha"
                                    Width="90"
                                   IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sis_despro_espr}" 
                                        Header="Estado"
                                        Width="110"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="27"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdAutorizar"
                    Margin="183,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="22"
                    Click="fcvGuardarRegistro"
                    Grid.Row="5"
                    ToolTip="Autorizar descuento" Width="127">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblGuardar"
                               Text="Ejecutar cambios"
            	               Style="{StaticResource styleLblBotonesForm}" Width="87"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>