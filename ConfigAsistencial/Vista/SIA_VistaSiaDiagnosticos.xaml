<Window x:Class="ConfigAsistencial.Vista.VistaSiaDiagnosticos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"        
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Path=VistaModeloSiaDiagnosticos, Source={StaticResource SIA_Locator}}"
        Title="Diagnosticos CIE-10"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="950"
        Height="750"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="160" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
        </Border>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Diagnosticos CIE-10"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Button Name="cmdCerrar"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
                TabIndex="150"
                Click="cmdSalir_Click"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Margin="1,3,1,0"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="798"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
                 Grid.Row="2"
                 Margin="130,7,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"                 
                 Name="txtFiltroDatos"
                 Width="400"
                 Style="{StaticResource styleTextBoxForm}"
                 Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
                 TabIndex="1"
                 KeyDown="fcvMoverFocus_KeyDown" 
                 GotFocus="fcvTextBox_GotFocus"/>       
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3" Margin="8,2,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_coddia_tdia"
                           ToolTip="Codgo del diagnostico según la tabla CIE-10"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Codigo Diagnostico"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_coddia_tdia"
                         TabIndex="1"
                         Text="{Binding Path=G1Sia_coddia_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         MaxLength="10"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cboG1Sia_altcos_tdia"
                          Grid.Column="2"
                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSia_altcos_tdia}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1sia_altcos_tdia"
                           ToolTip="Marca para saber si es diagnostico de alto costo:1=SI, 2=No"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Alto Costo Si/No"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_altcos_tdia"
                         TabIndex="3"
                         Text="{Binding Path=G1Sia_altcos_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cboG1Sia_notifc_tdia"
                          Grid.Column="2"
                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSia_notifc_tdia}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1sia_notifc_tdia"
                           ToolTip="Marca para saber si es diagnostico de notificacion obligatoria: 1=SI, 2 = No"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Notificacion obligatoria"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_notifc_tdia"
                         TabIndex="4"
                         Text="{Binding Path=G1Sia_notifc_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_desdia_tdia"
                           ToolTip="Descripcion del diagnostico"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}" 
                           Margin="4,8,2,26">
                          <Run Language="es-co" Text="Descripcion diagnostico"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_desdia_tdia"
                         TabIndex="8"
                         Text="{Binding Path=G1Sia_desdia_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         Height="40"
                         MaxLength="240"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextWrapping="Wrap"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_desaux_tdia"
                           ToolTip="Descripcion del diagnostico auxiliar, nombre popular"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Descripcion auxiliar"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_desaux_tdia"
                         TabIndex="9"
                         Text="{Binding Path=G1Sia_desaux_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         MaxLength="240"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_sexapl_tdia"
                           ToolTip="Sexo al que aplica el diagnostico: A=Ambos, M=Masculino F=Femenino"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Sexo al que aplica"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_sexapl_tdia"
                         TabIndex="5"
                         Text="{Binding Path=G1Sia_sexapl_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         MaxLength="1"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
                <ComboBox Name="cboG1Sia_sexapl_tdia"
                          Grid.Column="2"
                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSia_sexapl_tdia}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_edaini_tdia"
                           ToolTip="Edad incial para la cual aplica el diagnostico"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Edad inicial"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_edaini_tdia"
                         TabIndex="6"
                         Text="{Binding Path=G1Sia_edaini_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
                <TextBox Name="txtG1Sia_medini_tdia"
                         TabIndex="9"
                         Text="{Binding Path=G1Sia_medini_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="2"
                         Visibility="Collapsed"
                         Focusable="False"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
                <ComboBox Name="cboG1Sia_medini_tdia"
                          Grid.Column="3"
                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSia_medini_tdia}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sia_edafin_tdia"
                           ToolTip="Edad final para la cual aplica el diagnostico"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Edad final"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_edafin_tdia"
                         TabIndex="7"
                         Text="{Binding Path=G1Sia_edafin_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
                <ComboBox Name="cboG1Sia_medfin_tdia"
                          Grid.Column="3"
                          IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          ItemsSource="{Binding Path=G1CbSia_medfin_tdia}"
                          DisplayMemberPath="{Binding Path=NombreOpcion}"
                          SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Name="txtG1Sia_medfin_tdia"
                         TabIndex="11"
                         Text="{Binding Path=G1Sia_medfin_tdia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="2"
                         Visibility="Collapsed"
                         Focusable="False"
                         TextChanged="ActualizarComboBoxOpcion"
                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                         KeyDown="fcvMoverFocus_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="10,10,10,10"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Sia_coddia_tdia}"
                                    Header="Codgo Diagnostico"
                                    Width="115"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_desdia_tdia}"
                                    Header="Descripcion diagnostico"
                                    Width="*"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="270,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                           Text="Guardar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="270,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                       Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="373,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="14"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                           Text="Cancelar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="373,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="15"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                       Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                           Text="Modificar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="476,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="16"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                       Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                           Text="Eliminar"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="17"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                       Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                           Text="Salir"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="18"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                       Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                           Text="Errores"
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>