<Window
    x:Class="ConfigAsistencial.Vista.VistaSiacopagcontrib"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    DataContext="{Binding Path=VistaModeloSiacopagcontrib, Source={StaticResource SIA_Locator}}"
    Title="Copagos y cuotas moderadoras contributivo"
    Icon="/Sistema;component/Imagenes/sis_logo40.png"
    Width="700"
    Height="464"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
              	Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="31*" />
            <RowDefinition Height="44*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Height="450"
                Width="700"
                Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="699"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Copagos y cuotas moderadoras contributivo"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image MouseDown="btnCerrar_KeyDown"
               Style="{StaticResource styleImgButtonCerrarForm}"
               Source="/Sistema;component/Imagenes/sis_cerrar40.png"
               Grid.Row="1"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               Cursor="Hand"/>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="698"
               Margin="1,3,0,0"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="698"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
             Grid.Row="2"
             Margin="130,7,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Name="txtFiltroDatos"
             Width="280"
             Style="{StaticResource styleTextBoxForm}"
             Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3">
            <TextBlock Name="lblG1sia_codcpo_cpcb"
                               Width="106"
                               Margin="8,12,0,0"
                               ToolTip="Código único para el registro de rangos de copagos y cuotas moderadoras"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Código"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_codcpo_cpcb"
                             Width="215"
                             Margin="119,8,0,0"
                             TabIndex="1"
                             Text="{Binding Path=G1Sia_codcpo_cpcb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1sia_descpo_cpcb"
                               Width="106"
                               Margin="8,37,0,0"
                               ToolTip="Descripción del porcentaje copago aplicado: NIVEL1  (IBC) MENOR A 2 SMLMV, NIVEL 2 (IBC) DE 2 A 5  SMLMV y mas"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Descripción"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_descpo_cpcb"
                             Width="215"
                             Margin="119,33,0,0"
                             TabIndex="2"
                             Text="{Binding Path=G1Sia_descpo_cpcb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             Grid.Row="3"
                             GotFocus="fcvTextBox_GotFocus"/>
            <ComboBox Name="cboG1Sia_tipafi_tafi"
                    	Width="187"
                    	Margin="147,58,0,0"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSia_tipafi_tafi}"
                    	SelectedValuePath="ValorSeleccion">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1sia_tipafi_tafi"
                               Width="106"
                               Margin="8,62,0,0"
                               ToolTip="Tipo Afiliado contributivo textual: 1=COTIZANTE  2= BENEFICIARIO 3=AMBOS"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Tipo Afiliado"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tipafi_tafi"
                             Width="23"
                             Margin="119,58,0,0"
                             TabIndex="3"
                             Text="{Binding Path=G1Sia_tipafi_tafi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBox Name="txtG1Sia_descon_ncon"
                             Width="187"
                             Margin="147,83,0,0"
                             TabIndex="104"
                             Text="{Binding Path=G1Sia_descon_ncon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="False"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1sia_nivcon_ncon"
                               Width="106"
                               Margin="8,87,0,0"
                               ToolTip="Código Nivel Contributivo 1,2,3  para Calcular cuotas Moderadoras y copagos"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Nivel Contributivo"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_nivcon_ncon"
                             Width="23"
                             Margin="119,83,0,0"
                             TabIndex="4"
                             Text="{Binding Path=G1Sia_nivcon_ncon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="txtG1Sia_nivcon_ncon_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <ComboBox Name="cboG1Sia_tipcob_cpcb"
                    	Width="187"
                    	Margin="147,108,0,0"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSia_tipcob_cpcb}"
                    	SelectedValuePath="ValorSeleccion">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1sia_tipcob_cpcb"
                               Width="106"
                               Margin="8,112,0,0"
                               ToolTip="Tipo Cobro: 1= Copago 2= Cuota Moderadora"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Tipo de Cobro"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tipcob_cpcb"
                             Width="23"
                             Margin="119,108,0,0"
                             TabIndex="5"
                             Text="{Binding Path=G1Sia_tipcob_cpcb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1sia_porapl_cpsb"
                               Width="106"
                               Margin="339,12,0,0"
                               ToolTip="Porcentaje de aplicación del cobro copago o cuota moderadora"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Porcentaje cobro"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_porapl_cpsb"
                             Width="240"
                             Margin="450,8,0,0"
                             TabIndex="6"
                             Text="{Binding Path=G1Sia_porapl_cpsb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <ComboBox Name="cboG1Sia_tippor_cpsb"
                    	Width="215"
                    	Margin="475,33,0,0"
                    	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    	Style="{StaticResource styleComboBoxForm}"
                    	SelectedIndex="0"
                    	SelectionChanged="SeleccionComboBoxOpcion"
                    	ItemsSource="{Binding Path=G1CbSia_tippor_cpsb}"
                    	SelectedValuePath="ValorSeleccion">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Name="lblG1sia_tippor_cpsb"
                               Width="106"
                               Margin="339,37,0,0"
                               ToolTip="Tipo porcentaje para aplicar: 1=Sobre tarifa del servicio  2= sobre SMLMV 3= Salario SMLDV"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Tipo % aplicación"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_tippor_cpsb"
                             Width="20"
                             Margin="450,33,0,0"
                             TabIndex="7"
                             Text="{Binding Path=G1Sia_tippor_cpsb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             TextChanged="ActualizarComboBoxOpcion"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1sia_maxeve_cpsb"
                               Width="106"
                               Margin="339,62,0,0"
                               ToolTip="Máximo Porcentaje de aplicación en un evento en salario mensual legal vigente (SMLMV)"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Máximo % evento"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_maxeve_cpsb"
                             Width="240"
                             Margin="450,58,0,0"
                             TabIndex="8"
                             Text="{Binding Path=G1Sia_maxeve_cpsb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Name="lblG1sia_maxano_cpsb"
                               Width="106"
                               Margin="339,87,0,0"
                               ToolTip="Máximo Porcentaje de aplicación en un mismo año, en salario mensual legal vigente (SMLMV)"
                               Grid.Row="3"
                               Style="{StaticResource styleEtiquetasForm}">
                               <Run Language="es-co" Text="Máximo % año"/>
            </TextBlock>
            <TextBox Name="txtG1Sia_maxano_cpsb"
                             Width="240"
                             Margin="450,83,0,0"
                             TabIndex="9"
                             Text="{Binding Path=G1Sia_maxano_cpsb, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxForm}"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="10,8,0,0"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  Height="169"
                  Width="678"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Sia_codcpo_cpcb}"
                                    Header="Código"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_descpo_cpcb}"
                                    Header="Descripción"
                                    Width="180"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_tipafi_tafi}"
                                    Header="Tipo Afiliado Contributivo"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_nivcon_ncon}"
                                    Header="Nivel Contributivo"
                                    Width="110"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_descon_ncon}"
                                    Header="Descripción nivel contributivo"
                                    Width="170"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Sia_tipcob_cpcb}"
                                    Header="Tipo Cobro"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_porapl_cpsb}"
                                    Header="Porcentaje de cobro"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_tippor_cpsb}"
                                    Header="Tipo Porcentaje"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_maxeve_cpsb}"
                                    Header="Porcentaje evento"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_maxano_cpsb}"
                                    Header="Porcentaje año"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger
            		EventName="SelectionChanged">
                    <cmd:EventToCommand
            			Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="10"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="11"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="303,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="303,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="406,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="14"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="580,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="15"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
