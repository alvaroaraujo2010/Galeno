<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Inicio.Vista" 
        x:Class="Inicio.Vista.MainWindow"
        Title="Midwssoft Galeno Versión 4.0 " 
        Height="750"
        Name="Main"
        Width="1024"  
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        WindowState="Maximized"
        KeyUp="MainWindow_KeyUp" 
        Loaded="MainWindow_Loaded"
        Activated="Window_Activated_1"
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="35" />
            <RowDefinition Height="90*" />
        </Grid.RowDefinitions>
        <!-- Fondo General barra Titulo -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="1"
                Grid.Row="0"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown"/>
        <Border Margin="0,0,0,0"
                Grid.Row="1"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown" 
                Background="#FFF1F0F0">
        </Border>
        <local:crtBuscar
                HorizontalAlignment="Left"
                Height="30" 
                Width="220"
                Grid.Row="1"
                Margin="20,1,0,0" Loaded="crtBuscar_Loaded"/>
        <Image HorizontalAlignment="Right" 
               VerticalAlignment="Top"
               Margin="0,83,10,0" 
               Height="47"
               RenderTransformOrigin="1.432,0.938"
               Source="/Sistema;component/Imagenes/sys_cit01.png" 
               Width="58" 
               Grid.RowSpan="2" />
        <TextBlock Name="txtnick" 
                   Text="Nick" 
                   FontFamily="Segoe UI Light" 
                   FontSize="12"
                   TextAlignment="Right"
                   HorizontalAlignment="Right" 
                   Margin="0,10,72,8" 
                   Width="160" 
                   Grid.Row="1" />
        <!-- Logo del Sistema -->
        <Image x:Name="ImgPpal" 
               Grid.Row="0" 
               Height="70" 
               Width="78"
               Stretch="Fill"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Margin="17,16,0,0"
               Source="/Sistema;component/Imagenes/sis_logo40.png" />
        <!-- Titulo del Sistema -->
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Stretch" 
        	VerticalAlignment="Top"
        	Margin="100,56,232,0" 
        	FontSize="26"  
        	FontFamily="Segoe UI Light" Height="39"><Run Text="Midwssoft Galeno Versión 4.0"/>
            <Run Language="es-co"/>
        </TextBlock>
        <!-- Boton Cerrar -->
        <Image MouseDown="CloseButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="CloseButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
        <!-- Boton Minimizar -->
        <Image x:Name="MinimizeButton" 
               MouseDown="MinimizeButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="MinimizeButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_minimizar.png"
               Margin="0,0,80,0" />
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="2"
               Margin="0,0,0,-40" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondo.png" />
        <!-- Logo Midwssoft -->
        <Image x:Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,10,10"
               Grid.Row="2"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock x:Name="TxtHora" 
                   Grid.Row="2"
                   FontFamily="Segoe UI Light" 
                   FontSize="16"
                   Foreground="AntiqueWhite"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="20,0,0,20" Width="402"/>
        <!-- Zona de los Tiles -->
        <Canvas x:Name="MainCanvas" 
                Grid.Row="2"
                Margin="0,0,0,0"
                ClipToBounds="True" 
                Background="#00000000" 
                PreviewTouchDown="fcvMainCanvas_PreviewTouchDown"
                PreviewTouchUp="fcvMainCanvas_PreviewTouchUp"
                PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp" >
            <!-- Barra que sale en la Zona inferior -->
            <StackPanel Width="Auto" 
                        Height="600" 
                        Canvas.Left="45" 
                        Canvas.Top="17" 
                        Margin="0,0,0,0"
                        x:Name="MetroStackPanel" 
                        Orientation="Horizontal" 
                        Background="#00000000" 
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
        </Canvas>
    </Grid>
</Window>
