<Window x:Class="Inicio.Vista.frmLogin"
 		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingreso al Sistema" 
        Height="320" 
        Width="420" 
        Name="login" 
        ShowInTaskbar="True" 
        AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        Icon="/Sistema;component/Imagenes/sis_logo40.png">
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary 
                    Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10,0,10,27">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="203"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="1" 
                Margin="0,21,0,-30" 
                Grid.RowSpan="2" 
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" 
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="#FF6B7D87" />
        <Image 
           HorizontalAlignment="Center"
           Height="52"
           Width="400"
           Margin="0,22,0,0"
           VerticalAlignment="Top"
           Grid.Row="0"
           Source="/Sistema;component/Imagenes/sys_barratitulo.png"
           StretchDirection="UpOnly"
           Stretch="Fill"
           MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image HorizontalAlignment="Left" 
               Height="65" 
               Width="60"
               Margin="5,5,0,0" 
               VerticalAlignment="Top" 
               Source="/Sistema;component/Imagenes/sis_logo40.png"/>
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Left" 
        	VerticalAlignment="Top"
        	Margin="71,36,0,0" 
        	FontSize="20"  
        	Width="270"
            Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
        	FontFamily="Segoe UI Light" Height="39">
            <Run Text="Midwssoft Galeno Versión 4.0"/>
            <Run Language="es-co"/><Run Text=" "/>
            <LineBreak/>
            <Run Language="es-co"/></TextBlock>
        <ComboBox Name="cboListaBDatos"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
				  Grid.Column="0"
				  Height="26"
                  Width="225" 
				  FontSize="14"
				  Style="{StaticResource styleComboBoxFormResize}"
				  SelectedIndex="0"
				  SelectionChanged="SeleccionComboBoxOpcion"
				  SelectedValuePath="ValorSeleccion" 
                  Margin="115,91,0,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=NombreOpcion}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text ="Usuario"
        	    Name="lblUsuario"
        	    Width="52"
        	    Margin="49,134,0,0"
        	    Grid.Row="0"
        	    Style="{StaticResource styleEtiquetasForm}">
        	    <Run Language="es-co"/>
        </TextBlock>
        <TextBox Height="23" 
                     HorizontalAlignment="Left" 
                     Margin="115,133,0,0" 
                     Name="txtuser" 
                     VerticalAlignment="Top" 
                     Width="225" 
                     Text="" 
                     CharacterCasing="Upper"
                     TouchEnter="fcvTouchEnterTeclado"
                     GotFocus="fcvTextBox_GotFocus" 
                     TabIndex="1" 
                     KeyDown="fcvMoverFocus_KeyDown" />
        <TextBlock Text ="Clave"
        	    Name="lblClave"
        	    Width="52"
        	    Margin="56,172,0,0"
        	    Grid.Row="0"
        	    Style="{StaticResource styleEtiquetasForm}">
        	    <Run Language="es-co"/>
        </TextBlock>
        <PasswordBox Height="23" 
                     HorizontalAlignment="Left" 
                     Margin="115,168,0,0" 
                     Name="txtpass" 
                     VerticalAlignment="Top" 
                     Width="225" 
                     Password="" 
                     TabIndex="2" 
                     TouchEnter="fcvTouchEnterTeclado"
                     GotFocus="fcvPasswordBox_GotFocus" 
                     KeyDown="fcvPSMoverFocus_KeyDown" />
        <Button Name="btnAceptar"  
                Width="100" 
                Margin="115,20,0,0" 
                IsDefault="True" 
                Click="btnAceptar_Click" 
                Grid.Row="1" 
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="3">
            <StackPanel Orientation="Horizontal"  
                        Style="{StaticResource styleStackPanelBotonesForm}" >
                <Image x:Name="ImgGuardar" 
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png" 
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar" 
                           Text="Aceptar" 
        	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="btnCancelar"  
                Width="100" 
                Margin="240,20,0,0" 
                IsDefault="True" 
                Click="btnCancelar_Click" 
                Grid.Row="1" 
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="4">
            <StackPanel Orientation="Horizontal"  
                        Style="{StaticResource styleStackPanelBotonesForm}" >
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar" 
                           Text="Cancelar" 
        	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>

    </Grid>
</Window>


