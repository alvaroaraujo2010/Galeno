<Application x:Class="Sistema.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sistema.VistaModelo"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             StartupUri=""
             mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <vm:LocalizadorVistaModelo x:Key="SIS_Locator" d:IsDataSource="True" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Skins/EstiloSistema.xaml"/>
                <ResourceDictionary Source="Skins/EstiloSistemaTouch.xaml"/>
                <ResourceDictionary Source="Skins/EditorReportesDiseño.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
