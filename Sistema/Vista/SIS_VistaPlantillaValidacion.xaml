                    <TextBlock Name="lblG2sis_codcam_sivd"
                                               ToolTip="Nombre único del campo (ejemplo: SSP_CAM025_MS45, HCL_CODREG_HCVD)"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Nombre unico campo"/>
                    </TextBlock>
                    <TextBox Name="txtG2Sis_codcam_sivd"
                                             TabIndex="7"
                                             Text="{Binding Path=G2Sis_codcam_sivd, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                             KeyDown="txtG2Sis_codcam_sivd_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                    <Button Name="cmdG2Sis_codcam_sivd"
