                            	SelectionChanged="SeleccionComboBoxOpcion"
                            	ItemsSource="{Binding Path=G1CbSis_tippla_siva}"
                            	SelectedValuePath="ValorSeleccion">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1sis_tippla_siva"
                                           ToolTip="Tipo plantilla: 1= Plantilla Validacion por defecto  2= Planitlla validacion personalizada"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Tipo plantilla"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_tippla_siva"
                                         TabIndex="3"
                                         Text="{Binding Path=G1Sis_tippla_siva, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
