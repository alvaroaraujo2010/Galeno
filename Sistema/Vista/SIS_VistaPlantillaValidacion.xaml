                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Estado campo validación"/>
                    </TextBlock>
                    <TextBox Name="txtG2Sis_estreg_sivd"
