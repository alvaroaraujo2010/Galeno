                             Grid.Column="1"
                             TextChanged="ActualizarEditor"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Button Name="cmdAddAux"
                        Content="Guardar"
                        HorizontalContentAlignment="Left"
                        Margin="12,6,0,0"
                        Style="{StaticResource styleButtonMiniForm}"
                        TabIndex="11"
                        Command="{Binding CmdSAVAUX}"
                        Click="fcvGuardarRegistroRel"
                        ToolTip="Adicionar registro en la Grid"/>
                <Button Name="cmdCanAux"
                        Content="Nuevo"
                        HorizontalContentAlignment="Left"
                        Margin="85,6,0,0"
                        Style="{StaticResource styleButtonMiniForm}"
                        TabIndex="80"
                        Command="{Binding CmdCANREL}"
                        Click="fcvNuevoRegistroRel"
                        Grid.Row="4"
                        ToolTip="Nuevo o deshacer cambios en registro modificado"/>
                <Button Name="cmdDelAux"
                        Content="Eliminar"
                        HorizontalContentAlignment="Left"
                        Margin="158,6,0,0"
                        Style="{StaticResource styleButtonMiniForm}"
                        TabIndex="81"
                        Command="{Binding CmdDELREL}"
                        Click="fcvEliminarRegistroRel"
                        ToolTip="Eliminar registro activo de la lista"/>
                <DataGrid AutoGenerateColumns="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Grid.Row="1"
                          Margin="12,38,10,10"
                          Name="objDataGrid"
                          ItemsSource="{Binding TmpG2ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                          CanUserAddRows="False"
                          TabIndex="100">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Sis_ordvis_sivd}"
                                        Header="Campo"
                                        Width="50"
                                        IsReadOnly="True">
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Sis_nomcam_sivd}"
                                        Header="Titulo del campo"
                                        Width="345"
                                        IsReadOnly="True">
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger
            		    EventName="SelectionChanged">
                            <cmd:EventToCommand
            			    Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			    CommandParameter="{Binding SelectedItem, ElementName=objDataGrid}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="0" 
                  Grid.Column="1" 
                  Grid.RowSpan="2"
                  Margin="5,25,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="67*"/>
                </Grid.RowDefinitions>
                <ToolBar Height="50" DockPanel.Dock="Top">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}, AncestorLevel=1}, Path=IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.30" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToolBar.Resources>
                    <Button Height="40" Width="40" 
                            Command="{Binding CmdSAVAUX}"
                            Click="fcvGuardarRegistroRel"
                            ToolTip="Guardar cambios en código fuente">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_guardar2.png" Height="35" Width="35"/>
                    </Button>
                    <Separator/>
                    <Button Height="40" Width="40" 
                            ToolTip="Cortar"
                            Command="Cut">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_cortar.png" Height="35" Width="35"/>
                    </Button>
                    <Button Height="40" Width="40" 
                            ToolTip="Copiar"
                            Command="Copy">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_copiar.png" Height="35" Width="35"/>
                    </Button>
                    <Button Height="40" Width="40" 
                            ToolTip="Pegar"
                            Command="Paste">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_pegar.png" Height="35" Width="35"/>
                    </Button>
                    <Button Visibility="Collapsed" ToolTip="Eliminar texto codigo fuente" Height="40" Width="40" Command="Delete">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_eliminarpagina.png" Height="35" Width="35"/>
                    </Button>
                    <Separator/>
                    <Button Height="40" Width="40" 
                            ToolTip="deshacer"
                            Command="Undo">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_cancelar1.png" Height="35" Width="35"/>
                    </Button>
                    <Button Height="40" Width="40" 
                            ToolTip="Rehacer"
                            Command="Redo">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_cancelar2.png" Height="35" Width="35"/>
                    </Button>
                    <Separator/>
                    <CheckBox Height="40" Width="40" 
                              ToolTip="Mostrar el numero de lineas en codigo fuente."
                              IsChecked="{Binding ElementName=txtCodigoEditor,Path=ShowLineNumbers}">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_numerolineas.png" Height="35" Width="35"/>
                    </CheckBox>
                    <Button ToolTip="Validar código fuente"
                            Command="{Binding CmdVAL}"
                            Click="fcvEjecutaValidacion">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_ejecutar.png" Height="35" Width="35"/>
                    </Button>
                    <Button ToolTip="Vista Errores de Validar código fuente"
                            Click="fcvActivarVistaErrores">
                        <Image Source="/Sistema;component/Imagenes/Edt_edt_listerror.png" Height="35" Width="35"/>
                    </Button>
                </ToolBar>
                <avalonEdit:TextEditor
				    Name="txtCodigoEditor"
				    FontFamily="Consolas"
				    FontSize="10pt"
                    TouchEnter="fcvTouchEnterTeclado"
				    SyntaxHighlighting="C#"
                    IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                    Grid.Row="1">
                </avalonEdit:TextEditor>
            </Grid>
        </Grid>
        <!-- Zona de botones -->
        <Grid Grid.Row="5" 
              Width="310"
              HorizontalAlignment="Center" >
            <Button Name="cmdGuardar"
                    Margin="0,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="13"
                    Command="{Binding CmdSAV}"
                    Click="fcvGuardarRegistro"
                    Grid.Row="5"
                    ToolTip="Haga clic aqui para guardar los cambios">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgGuardar"
                               Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblGuardar"
                                   Text="Guardar"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdAdicionar"
                    Margin="0,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="14"
                    Command="{Binding CmdADD}"
                    Click="fcvNuevoRegistro"
                    ToolTip="Haga clic aqui para crear un nuevo registro">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgAdicionar"
                               Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblAdicionar"
                                   Text="Nuevo"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdCancelar"
                    Margin="102,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="15"
                    Command="{Binding CmdCAN}"
                    Click="fcvCancelarRegistro"
                    ToolTip="Cancelar los cambios">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgCancelar"
                               Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblCancelar"
                                   Text="Cancelar"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdModificar"
                    Margin="102,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    Command="{Binding CmdEDT}"
                    Click="fcvModificarRegistro"
                    Grid.Row="5"
                    ToolTip="Haga clic aqui para modificar el registro activo">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgModificar"
                               Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblModificar"
                                   Text="Modificar"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEliminar"
                    Margin="204,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="17"
                    Command="{Binding CmdDEL}"
                    ToolTip="Eliminar este registro">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgEliminar"
                               Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblEliminar"
                                   Text="Eliminar"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Button Name="cmdSalir"
                Margin="0,10,20,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="18"
                HorizontalAlignment="Right"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="19"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdBrowser"
                Margin="112,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="15"
                Command="{Binding CmdDFL}"
                Click="fcvBrowserBuscar"
                Grid.Row="5"
                ToolTip="Haga clic aqui para buscar un registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                           Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                               Text="Buscar..."
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <!-- NAVEGADOR DE ETIQUETAS -->
        <Canvas Name="cvaEtiqueta" 
                Grid.Row="5"
                Margin="0,50,0,0"
                Height="340"
                Visibility="Visible" 
                Width="1020">
            <Grid Name="grdEtiqueta" Height="340" Width="1020" Margin="0,0,0,0" Canvas.Left="0" Canvas.Top="0">
                <Border Name="objBorderEtiqueta" BorderThickness="1" Background="#99060606"/>
                <TextBlock Name="lblTituloEtiqueta"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                	       Width="936"
                	       Margin="10,4,0,0" FontSize="20" Foreground="White">
                	       <Run Language="es-co" Text="Resultados compilación..."/>
                </TextBlock>
                <Button Name="cmdEtiquetaOcultar"
                        Margin="0,3,14,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource styleButtonImgEdtFormTouch}"
                        TabIndex="50"
                        Click="fcvActivarVistaErrores"
                        ToolTip="Ocultar vista errores" 
                        Height="30" 
                        Width="60">
                    <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image Name="imgEtiquetaCerrar"
                               Source="/Sistema;component/Imagenes/Edt_edt_contraer3.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill" />
                    </StackPanel>
                </Button>
                <Grid Margin="14,35,14,10">
                    <TextBox Name="txtErrorCompiler"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Height="Auto"
                             Width="Auto"
                             Margin="0,0,0,0"/>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
