                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado plantilla"/>
                </TextBlock>
                <TextBox Name="txtG1Sis_estreg_siva"
                                         TabIndex="4"
                                         Text="{Binding Path=G1Sis_estreg_siva, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
