                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="cboG2Sis_estreg_sivd"
                            	    Grid.Column="2"
                            	    IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                            	    Style="{StaticResource styleComboBoxFormResize}"
                            	    SelectedIndex="0"
                            	    SelectionChanged="SeleccionComboBoxOpcion"
                            	    ItemsSource="{Binding Path=G2CbSis_estreg_sivd}"
                            	    SelectedValuePath="ValorSeleccion">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Name="lblG2sis_estreg_sivd"
