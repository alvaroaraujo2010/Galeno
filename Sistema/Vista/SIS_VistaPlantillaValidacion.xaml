                                        Style="{StaticResource styleButtonMiniFormBrows}"
                                        TabIndex="102"
                                        Click="cmdG2Sis_codcam_sivd_Click"
                                        Grid.Column="2"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        ToolTip="Buscar nombre campo en plantilla por defecto de archivos: RIPSAC = Rips consulta, RIPSAP=Rips Procedimiento, RE4505 = Resolucion 4505 y otros"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblG2sis_nomcam_sivd"
                                               ToolTip="Titulo o etiqueta del campo (descripcion corta del campo)"
