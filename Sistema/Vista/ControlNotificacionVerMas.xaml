<UserControl x:Class="Sistema.Vista.ControlNotificacionVerMas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="30" 
             Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Name="Fondo" 
                BorderThickness="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#FFF9F9F9"/>
        <TextBlock Name="txtTitulo" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Grid.Column="0"
                   FontSize="14"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left" 
                   Text="Cargando datos..."
                   Visibility="Collapsed"
                   Foreground="#FFA4C6E8" Margin="5,5,0,0"/>
        <Button Name="cmdVerMas"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                ToolTip="Ver mas registros..." 
                Height="28"
                Width="120"
                Cursor="Hand" 
                Margin="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropHistorial"
                        Source="/Sistema;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
