<Window x:Class="Sistema.Vista.Browser01"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF5" 
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="710" 
        Height="488"
        Title="Buscar Registro..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary 
                  Source="../Skins/EstiloSistema.xaml ">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Left" 
    		Height="42" 
    		Margin="8,43,0,0" 
    		Grid.Row="1" 
    		VerticalAlignment="Top" 
    		Width="589" 
    		OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
    		Fill="#FFF6F8F9"/>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Left" 
                Width="710" 
                Grid.RowSpan="3" Grid.Row="1" Margin="0,0,0,-9"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="710"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Name="cmdCerrar"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                TabIndex="50"
                Click="cmdCancelar_Click"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Buscar Registro..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <ListView x:Name="objDataGrid" 
                  Margin="0,5,0,0" 
                  Grid.Row="2" 
                  MouseDoubleClick="MouseDbClick" 
                  TabIndex="3" 
                  KeyDown="DataGridKeyDown"
                  FontSize="12"
                  GotFocus="objDataGrid_GotFocus" SelectionMode="Single">
            <ListView.View>
                <GridView 
    		    x:Name="objGridView"/>
            </ListView.View>
        </ListView>
        <Button
        	Height="32"
        	HorizontalAlignment="Left"
        	Margin="494,47,0,0"
        	x:Name="cmdBuscar"
        	VerticalAlignment="Top"
        	Width="89"
        	Visibility="Hidden"  
            Grid.Row="1"
        	Click="cmdBuscar_click" 
            Cursor="Hand" TabIndex="2">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgBuscar" 
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="Uniform" 
                       Margin="2" />
                <TextBlock x:Name="textBuscar" 
                           Text="Buscar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <TextBox Height="29"
        	    Grid.Row="1"
        	    HorizontalAlignment="Left"
                TouchEnter="fcvTouchEnterTeclado"
        	    Margin="92,52,0,0"
                Visibility="Collapsed"
        	    x:Name="txtFiltroDatos"
        	    VerticalAlignment="Top"
                Style="{StaticResource styleTextBoxForm}"
        	    Width="398" 
                KeyDown="txtFiltroDatos_KeyDown" 
                TextChanged="fcvFiltroTextChanged"/>
        <TextBlock Height="22"
        	        Grid.Row="1"
                    FontFamily="Segoe UI Light"
        	        HorizontalAlignment="Left"
        	        Margin="16,56,0,10"
        	        x:Name="textBlockBuscar"
        	        VerticalAlignment="Center"
                   Visibility="Collapsed"
                    Width="72" 
                    FontSize="18">
                    <Run Language="es-co" Text="Buscar"/>
        </TextBlock>
        <local:crtBuscar HorizontalAlignment="Left"
                         Grid.Row="1"
                         VerticalAlignment="Top"
                         TabIndex="1" 
                         Height="30"
                         Width="522"
                         Margin="13,45,0,0" 
                         Loaded="crtBuscarLoaded"/>
        <Image HorizontalAlignment="Left" 
               Width="Auto" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="3" 
               StretchDirection="UpOnly" 
               Stretch="Fill" Margin="0,0,0,-9"/>
        <Button Name="cmdCancelar" 
                Style="{StaticResource styleButtonImgForm}"
        	    Margin="585,17,0,0"
                Grid.Row="3" 
                TabIndex="13" 
                Click="cmdCancelar_Click">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="textCancelar" 
                           Text="Cancelar" 
            	           Style="{StaticResource styleLblBotonesForm}" 
                           Height="16"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAceptar" 
                Style="{StaticResource styleButtonImgForm}"
        	    Margin="470,17,0,0"
                Grid.Row="3" 
                TabIndex="13" 
                Click="cmdAceptar_Click">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgAceptar" 
                       Source="/Sistema;component/Imagenes/sis_edt_aceptar.png" 
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="textAceptar" 
                           Text="Aceptar" 
            	           Style="{StaticResource styleLblBotonesForm}" 
                           Height="16"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               Margin="8,3,0,0" 
               VerticalAlignment="Top" 
               Width="48" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
    </Grid>
</Window>
