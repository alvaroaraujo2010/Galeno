<Window x:Class="Sistema.Vista.DialogVistaErrores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesando..."
        Width="700"
        Height="430"
        VerticalContentAlignment="Center"
        HorizontalContentAlignment="Center"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="58*"/>
        </Grid.RowDefinitions>
        <Border Name="Fondo" 
                Background="#99060606"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="0"
                Grid.RowSpan="4"/>
        <Border BorderThickness="0.9"
                BorderBrush="#FFD1CFCF"
                Grid.Row="1"
                Margin="0,0,0,0"
                Background="#66F2F3F3"/>
        <TextBlock Name="lblTitulo"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Margin="40,3,80,0" 
                   FontSize="23" 
                   Foreground="White" Height="35">
                <Run Language="es-co" Text="Lista de Errores..."/>
        </TextBlock>
        <Button Name="cmdHistorialOcultar"
                Margin="0,6,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Click="fcvCerraVista"
                ToolTip="Ocultar vista" 
                Height="30"
                Cursor="Hand"
                Width="45">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgPropHistorial"
                        Source="/Sistema;component/Imagenes/Edt_edt_contraer3.png"
                        Style="{StaticResource styleImagBotonesForm}"
                        Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <Grid Grid.Row="1" Margin="10,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="57"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="txtNumeroRegistro" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
        		       FontSize="14"
                       Margin="4,5,3,5"
                       Width="Auto"
                       Text="Registro"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="White"/>
            <TextBlock Name="txtCodigoError" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="14"
                       Text="Codigo Error"
                       Margin="2,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="White"/>
            <TextBlock Name="txtNombreCampo" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="3"
        		       FontSize="14"
                       Text="Campo"
                       Margin="10,5,5,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="White"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtMensajeError" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="4"
        		       FontSize="14"
                       Text="Error"
                       Margin="4,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="White"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtNivelError" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="5"
        		       FontSize="14"
                       Margin="2,5,3,0"
                       Width="Auto"
                       Text="Nivel"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="White"/>
        </Grid>
        <ScrollViewer Name="PanelScroll" 
                      HorizontalAlignment="Stretch" 
                      Margin="10,5,10,20"
                      Width="Auto"
                      Grid.Row="2"
                      Background="White"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="HorizontalFirst"
                      CanContentScroll="False"
                      Height="Auto">
                <StackPanel Name="stkContenedor"
                        Grid.Row="2"
                        Margin="5,10,20,5"
                        Orientation="Vertical"
                        Height="Auto"/>
        </ScrollViewer>
    </Grid>
</Window>
