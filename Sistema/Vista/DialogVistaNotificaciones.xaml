<Window x:Class="Sistema.Vista.DialogVistaNotificaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sistema.Vista" 
        Title="Procesando..."
        Width="530"
        VerticalContentAlignment="Top"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Grid>
        <!-- Capa Cortina Propiedades-->
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- IMAGEN ENCABEZADO VENTANA -->
        <Border BorderThickness="0"
                BorderBrush="#FFB0AFAF"
                Grid.Row="0"
                Background="#FFA9ACAC">
        </Border>
        <Border Name="Fondo"
                BorderThickness="0"
                Grid.Row="1"
                Background="WhiteSmoke" 
                Grid.RowSpan="4"/>
        <Border BorderThickness="0"
                BorderBrush="#FFB0AFAF"
                Grid.Row="1"
                Background="#FFD9DCDC">
        </Border>
        <Button Name="cmdSelectOcultar"
                Grid.Row="0"
                Margin="10,6,6,0"
                HorizontalAlignment="Left"
                Style="{StaticResource styleButtonImgEdtFormTouch}"
                TabIndex="50"
                Click="fcvCerraVista"
                ToolTip="Ocultar ventana notificaciones" 
                Height="42" 
                Width="48">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgSelect2"
                       Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="lblNombrePaciente"
                    Grid.Row="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="380"
                	Margin="76,20,0,0" 
                    FontSize="18" 
                    Foreground="#FF978E8E" 
                   Visibility="Collapsed"
                    Height="21">
                <Run Language="es-co" Text="Notificaciones"/>
        </TextBlock>
        <TextBlock Name="lblTitulo"
				    Grid.Row="0"
				    VerticalAlignment="Top"
					HorizontalAlignment="Left"
					Width="355"
					Margin="70,6,0,0"
                    Foreground="White"
                   TextWrapping="Wrap"
					FontSize="16" 
					Height="42">
		   <Run Language="es-co" Text="TITULO"/>
        </TextBlock>
        <Border BorderThickness="0"
                BorderBrush="#FFB0AFAF"
                Grid.Row="0"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0,4,8,0" 
                Height="84"
                Width="84"
                Grid.RowSpan="2"
                Background="#FFE8E8E8">
        </Border>
        <Image Name="imgVista"
               Grid.Row="0"
               HorizontalAlignment="Right" 
               VerticalAlignment="Top"
               Stretch="Fill"
               Margin="0,6,10,0" 
               Height="80"
               Width="80"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sys_usu02.png" />
        <local:crtBuscar HorizontalAlignment="Left"
                         Grid.Row="1"
                         VerticalAlignment="Top"
                         Height="30"
                         Width="415"
                         Margin="10,5,0,0" 
                         Loaded="crtBuscarLoaded"/>
        <Grid Margin="0,2,2,0" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <ScrollViewer Name="PanelScroll" 
                      HorizontalAlignment="Stretch" 
                      Width="Auto"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="HorizontalFirst"
                      CanContentScroll="False"
                      Height="Auto">
                <StackPanel Name="stkHistorial"
                        Grid.Row="1"
                        Focusable="False"
                        Orientation="Vertical"
                        Height="Auto"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
