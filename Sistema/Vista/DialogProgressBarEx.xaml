<Window x:Class="Sistema.Vista.DialogProgressBarEx"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesando..."
        Width="700"
        Height="70"
        VerticalContentAlignment="Center"
        HorizontalContentAlignment="Center"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Grid>
        <Image x:Name="Capa" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0" 
                       Source="/Sistema;component/Imagenes/sys_panel_fondo3.png"
                       Stretch="Fill"/>
        <ProgressBar Name="objProgressBar"
                     HorizontalAlignment="Right"
                     Height="30"
                     Margin="0,11,93,9"
                     Value="1"
                     Minimum="0"
                     Maximum="100"
                     Width="240" 
                     BorderBrush="#FFFDFDFD" 
                     Foreground="#FF2DAA8E" 
                     LargeChange="0" 
                     Visibility="Collapsed"
                     Background="Transparent" />
        <TextBlock Name="lblStatus"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Stretch"
                   Margin="37,17,16,0"
                   FontSize="26" 
                   Foreground="White">
                <Run Language="es-co" Text="Barra de progreso..."/>
        </TextBlock>
        <Ellipse Fill="#7FFFFFFF" 
                 HorizontalAlignment="Left" 
                 Height="90" 
                 Width="90"
                 Margin="20,4,0,0"
                 Visibility="Collapsed"
                 VerticalAlignment="Top"/>
        <Image HorizontalAlignment="Left" 
               x:Name="rect" 
               Source="C:/temp/wpf/ejemplo28-animacion/MotionPathVS/sys_progress_panelcirculo.png"
               Height="46" 
               Margin="37,15,0,0" 
               VerticalAlignment="Top" 
               Visibility="Collapsed"
               RenderTransformOrigin="0.5,0.9" 
               Width="55"/>
    </Grid>
</Window>
