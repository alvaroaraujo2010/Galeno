<Window x:Class="Sistema.Vista.Browser01Ex"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        Name="VistaBrowser01Ex"
        WindowStartupLocation="CenterScreen"
        Width="910" 
        Height="600"
        Title="Buscar Registro..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Left" 
    		Height="42" 
    		Margin="8,43,0,0" 
    		Grid.Row="1" 
    		VerticalAlignment="Top" 
    		Width="589" 
    		OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
    		Fill="#FFF6F8F9"/>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Stretch" 
                Grid.RowSpan="3"
                Grid.Row="1"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Name="cmdCerrar"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                TabIndex="50"
                Click="cmdCancelar_Click"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Buscar Registro..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <ListView x:Name="objDataGrid" 
                  Margin="0,5,0,0" 
                  Grid.Row="2" 
                  MouseDoubleClick="MouseDbClick" 
                  TabIndex="3" 
                  KeyDown="DataGridKeyDown"
                  FontSize="12"
                  GotFocus="objDataGrid_GotFocus" SelectionMode="Single">
            <ListView.View>
                <GridView 
    		    x:Name="objGridView"/>
            </ListView.View>
        </ListView>
        <Button
        	Height="32"
        	HorizontalAlignment="Left"
        	Margin="494,47,0,0"
        	x:Name="cmdBuscar"
        	VerticalAlignment="Top"
        	Width="89"
        	Visibility="Hidden"  
            Grid.Row="1"
        	Click="cmdBuscar_click" 
            Cursor="Hand" TabIndex="2">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgBuscar" 
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="Uniform" 
                       Margin="2" />
                <TextBlock x:Name="textBuscar" 
                           Text="Buscar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <TextBox Name="txtFiltroDatos"
        	    Height="29"
        	    Grid.Row="1"
                Visibility="Collapsed"
        	    HorizontalAlignment="Left"
                TouchEnter="fcvTouchEnterTeclado"
        	    Margin="92,45,0,0"
        	    VerticalAlignment="Top"
                Style="{StaticResource styleTextBoxForm}"
        	    Width="523" 
                KeyDown="txtFiltroDatos_KeyDown" 
                TabIndex="1" 
                TextChanged="fcvFiltroTextChanged"/>
        <local:crtBuscar HorizontalAlignment="Left"
                         Grid.Row="1"
                         VerticalAlignment="Top"
                         TabIndex="1" 
                         Height="30"
                         Width="522"
                         Margin="13,45,0,0" 
                         Loaded="crtBuscarLoaded"/>
        <Image HorizontalAlignment="Left" 
               Height="Auto" 
               Margin="0,0,0,0" 
               VerticalAlignment="Stretch" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="3" 
               StretchDirection="UpOnly" 
               Stretch="Fill"/>
        <Button Name="cmdCancelar"
                Style="{StaticResource styleButtonImgForm}"
                HorizontalAlignment="Right"
        	    VerticalAlignment="Center"
        	    Visibility="Visible"
                Grid.Row="3" 
                Click="cmdCancelar_Click" 
                Cursor="Hand" TabIndex="5" Margin="0,11,58,7">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock Name="textCancelar" 
                           Text="Cancelar" 
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAceptar"
                Style="{StaticResource styleButtonImgForm}"
                HorizontalAlignment="Right"
        	    VerticalAlignment="Center"
                Grid.Row="3" 
                Click="cmdAceptar_Click" 
                IsEnabled="False"
                Cursor="Hand" 
                TabIndex="4" 
                Margin="0,11,189,7">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="ImgAceptar" 
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png" 
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock Name="textAceptar" 
                           Text="Aceptar" 
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="43" 
               Margin="8,6,0,0" 
               VerticalAlignment="Top" 
               Width="50" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
    </Grid>
</Window>
