<Window x:Class="Sistema.Vista.VistaEnviarCorreos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        Title="Vista captura reportes" 
        Height="750" 
        Width="1024"  
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        WindowState="Normal"
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                BorderThickness="1,1,1,1"
                BorderBrush="#FF6B7D87"
                Margin="0,0,0,0"
                Grid.RowSpan="4"
                Grid.Row="0"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="0"
               Margin="0,0,-1,-1" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" 
               Grid.RowSpan="2" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Visibility="Collapsed"
               Margin="0,0,52,02"
               Grid.Row="1"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/logo_megassoft.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="1"
                   FontFamily="Segoe UI Light"
                   Foreground="#FFFBF7F6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="15,0,0,4" 
                   Width="236" 
                   Height="21"/>
        <!-- BARRA INFERIOR -->
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Visibility="Collapsed"
               Margin="1,3,1,0"
               VerticalAlignment="Top"
               Grid.Row="4"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Border Grid.Row="4"
                    BorderThickness="1,0,1,1"
                    Background="#E5E6E6E6"
                    BorderBrush="#FF6B7D87">
        </Border>
        <Button Name="cmdLogErrores"
                    Margin="315,10,0,0"
                    Style="{StaticResource styleButtonImgFormError}"
                    TabIndex="19"
                    Click="fcvVistaLogErrores"
                    Grid.Row="3"
                    ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="64"
                Command="{Binding CmdSAL}"
                Click="CmdSalir_Click"
                Grid.Row="3"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <!-- ZONA DEL EDITOR -->
        <Grid Name="grdFondoEscritorio"  
              Grid.Row="1"
              Grid.RowSpan="2"
              Width="Auto"
			  Height="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                    BorderThickness="1,0,0,1"
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Grid.Row="0"
                    Grid.RowSpan="2" 
                    Background="White">
            </Border>
            <!-- diligenciar datos del correo remitente -->
            <Grid Name="grdCorreoInstitucional"  
                  Grid.Row="0"
			      Grid.Column="0"
                  Width="Auto"
			      Height="Auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource styleBorderFondoForm}"
                        BorderThickness="1"
                        Grid.Column="0"
                        Margin="5,15,5,0"
                        Grid.Row="0"
                        Background="#FFE3EBEE">
                </Border>
                <Grid Grid.Row="0" Margin="5,15,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left"
                               Grid.Row="1"
                               FontSize="16"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FF103AAA">
                          <Run Language="es-co" Text="Escriba aquí el Correo Remitente"/>
                    </TextBlock>
                    <TextBox Name="txtInstCorreo"
                             TabIndex="109"
                             Margin="5,0,5,0"
                             Height="25"
                             FontSize="14"
                             Style="{StaticResource styleTextBoxFormResize}"
                             Grid.Row="2"
                             TextChanged="fcvValidacionTexto"
                             Text="correo"
                             IsReadOnly="False"/>
                    <TextBlock HorizontalAlignment="Left"
                               Grid.Row="3"
                               FontSize="16"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FF103AAA">
                          <Run Language="es-co" Text="Escriba aquí la contraseña del correo"/>
                    </TextBlock>
                    <PasswordBox Name="txtInstClave"
                                 TabIndex="109"
                                 FontSize="14"
                                 Height="28"
                                 PasswordChanged="fcvValidacionTextoPassword"
                                 Margin="5,1,5,1"
                                 Grid.Row="4"/>
                </Grid>
                <!-- recomendaciones -->
                <Border Style="{DynamicResource styleBorderFondoForm}"
                        BorderThickness="0"
                        Grid.Column="0"
                        Margin="5,15,5,0"
                        Grid.Row="1"
                        Background="#FFE3EBEE">
                </Border>
                <Grid Grid.Row="1" Margin="5,15,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="8" />
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left"
                               Grid.Row="1"
                               FontSize="16"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FFE81169" 
                               Margin="10,0,0,0" 
                               Width="270">
                          <Run Language="es-co" Text="IMPORTANTE!!"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Grid.Row="2"
                               FontSize="20"
                               TextWrapping="Wrap"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FF103AAA" 
                               Margin="10,0,0,0" 
                               Width="270" 
                               Height="108">
                          <Run Language="es-co" Text="Por su seguridad, Galeno no almacena la contraseña del correo, debe digitarla."/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left"
                               Grid.Row="3"
                               FontSize="16"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FFE81169"
                               Margin="10,1,0,1" 
                               Width="270">
                          <Run Language="es-co" Text="TENER PRESENTE"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Grid.Row="4"
                               FontSize="20"
                               TextWrapping="Wrap"
                               Style="{StaticResource styleEtiquetasFormResize}" 
                               Foreground="#FF103AAA" 
                               Margin="10,0,0,0" 
                               Width="270" 
                               Height="70">
                          <Run Language="es-co" Text="Solo se admite envio desde correos HOTMAIL o GMAIL."/>
                    </TextBlock>

                </Grid>
                <!-- boton enviar -->
                <Button Name="cmdEnviar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TabIndex="53"
                        Grid.Row="3"
                        Height="60"
                        Width="200"
                        Background="#FF3C95FD"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        Click="CmdButton_EnviarCorreo_Click"
                        ToolTip="Enviar correo" >
                    <StackPanel Orientation="Horizontal" Width="178">
                        <Image Name="imgEnviar"
                           Height="40"
             		       Source="/Sistema;component/Imagenes/Gcorreo_imagen03.png"/>
                        <TextBlock x:Name="lblNuevo"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Enviar correo"
                                   Foreground="White"
            	                   Style="{StaticResource styleLblBotonesForm}" 
                                   FontSize="16" Height="22" Width="131"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ==================================
            datos de gestion correo 
            ==================================== -->
            <Border Style="{DynamicResource styleBorderFondoForm}"
                    Grid.Column="2"
                    BorderThickness="1"
                    Grid.Row="0"
                    Grid.RowSpan="2">
            </Border>
            <ScrollViewer Name="PanelScroll" 
						    Margin="8,1,2,2"
						    Grid.Column="1"
						    HorizontalAlignment="Left" 
						    Width="700"
						    Height="Auto"
						    VerticalScrollBarVisibility="Auto"
						    HorizontalScrollBarVisibility="Hidden"
						    PanningMode="HorizontalFirst"
						    CanContentScroll="False">
                <StackPanel Name="stkBase" HorizontalAlignment="Left">
                    <!-- codigo del registro maestro -->
                    <TextBox Name="txtG1Car_secreg_cagm"
                             HorizontalAlignment="Left"
                             Grid.Row="0"
                             Width="10"
                             Visibility="Collapsed"
                             TabIndex="1"
                             Text="{Binding Path=G1Car_secreg_cagm, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             Grid.Column="1"
                             Focusable="False"/>
                    <!-- Remitente -->
                    <Grid Grid.Row="0" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Margin="10,6,0,6"
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Remitente"/>
                        </TextBlock>
                        <Button Name="cmdREmitente"
                                HorizontalAlignment="Left"
                                Content="De:"
                                Style="{StaticResource styleButtonMiniFormBrows}"
                                TabIndex="109"
                                Click="CmdG1Car_faddre_caml_Click"
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                Height="45"
                                Width="55"
                                Margin="10,2,0,0"
                                IsEnabled="False"
                                ToolTip="Remitente del correo"/>
                        <Grid Grid.Row="1" Margin="70,5,15,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtG1Fcm_numprn_fcem"
                                             TabIndex="9"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="0"
                                             IsReadOnly="True"
                                             KeyDown="txtG1Sis_idterc_sitr_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                            <TextBox Name="txtG1Fcm_razsoc_fcem"
                                             TabIndex="109"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             Grid.Column="3"
                                             Focusable="False"/>
                        </Grid>
                        <TextBox Name="txtG1Fcm_ctoema_fcem"
                                 TabIndex="109"
                                 Margin="74,0,17,3"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="2"
                                 IsReadOnly="True"/>
                    </Grid>

                    <!-- Destinatario -->
                    <Grid Grid.Row="1" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Margin="10,6,0,6"
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Destinatario o Adquirente"/>
                        </TextBlock>
                        <Button Name="cmdG1Sis_idterc_sitr"
                                HorizontalAlignment="Left"
                                Content="Para:"
                                Style="{StaticResource styleButtonMiniFormBrows}"
                                TabIndex="109"
                                Click="cmdG1Sis_idterc_sitr_Click"
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                Height="45"
                                Width="55"
                                Margin="10,2,0,0"
                                IsEnabled="False"
                                ToolTip="Adquirente o Empresa cliente destinatario del correo"/>
                        <Grid Grid.Row="1" Margin="70,5,15,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtG1Sis_idterc_sitr"
                                             TabIndex="9"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="0"
                                             IsReadOnly="True"
                                             KeyDown="txtG1Sis_idterc_sitr_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                            <TextBox Name="txtG1Sis_razsoc_sitr"
                                             TabIndex="109"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             Grid.Column="3"
                                             Focusable="False"/>
                        </Grid>
                        <TextBox Name="txtG1Sis_emailc_sitr"
                                 TabIndex="109"
                                 Margin="74,3,17,0"
                                 TextChanged="fcvValidacionTexto"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Text="correo"
                                 Grid.Row="2"
                                 IsReadOnly="False"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Asunto"/>
                        </TextBlock>
                        <TextBox Name="txtG1Car_subjec_caml"
                                 TabIndex="109"
                                 Margin="4,5,4,2"
                                 Width="660"
                                 TextWrapping="Wrap"
                                 TextChanged="fcvValidacionTexto"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="1"
                                 Height="40"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Mensaje"/>
                        </TextBlock>
                        <TextBox Name="txtG1Car_bodyms_caml"
                                 TabIndex="109"
                                 Height="70"
                                 Width="660"
                                 TextChanged="fcvValidacionTexto"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="4,5,4,0"
                                 TextWrapping="Wrap"
                                 Text="{Binding Path=G1Car_bodyms_caml, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="1"/>
                    </Grid>
                    <!-- detalles -->
                    <StackPanel Name="stkAdjuntos" Grid.Row="4">
                        <!-- Archivos adjuntos externos -->
                        <Grid Visibility="Collapsed" Margin="5,2,5,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                            </Border>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                            </Border>
                            <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Archivos externos adjuntados"/>
                            </TextBlock>
                            <StackPanel Name="stkAdjArchivosExternos" Grid.Row="1" Margin="5,2,5,2"/>
                        </Grid>
                        <!-- Archivos adjuntos externos -->
                        <Grid Margin="5,2,5,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <TextBox Name="txtG2Fcm_secreg_mfac"
                                         TabIndex="22"
                                         Text="{Binding Path=G2Fcm_secreg_mfac, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="txtG2Fcm_secreg_mfac_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus" Margin="4,5,671,5"/>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                            </Border>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                            </Border>
                            <TextBlock HorizontalAlignment="Left"
                                       Grid.Row="0"
                                       FontSize="14"
                                       Margin="10,6,0,6"
                                       Style="{StaticResource styleEtiquetasFormResize}" 
                                       Foreground="#FF103AAA">
                                  <Run Language="es-co" Text="Archivos Adjuntos"/>
                            </TextBlock>
                            <StackPanel Name="stkAdjDocumentos" Margin="5,2,5,2" Grid.Row="1">
                                <!-- archivo adjunto por defecto -->
                                <TextBlock HorizontalAlignment="Left"
                                       Grid.Row="0"
                                       FontSize="12"
                                       Margin="10,6,0,0"
                                       Style="{StaticResource styleEtiquetasFormResize}" 
                                       Foreground="#FF78797C">
                                  <Run Language="es-co" Text="Archivo Attached (ajuntos Documento y Response DIAN) "/>
                                </TextBlock>
                                <TextBox Name="txtG1Car_attached_caml"
                                         TabIndex="109"
                                         FontSize="12"
                                         Height="35"
                                         VerticalScrollBarVisibility="Auto"
                                         Width="660"
                                         Margin="4,5,4,5"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         Grid.Row="1"
                                         IsReadOnly="True"/>
                                <!-- 1 adjuntar otro archivo -->
                                <TextBlock HorizontalAlignment="Left"
                                       Grid.Row="0"
                                       FontSize="12"
                                       Margin="10,6,0,0"
                                       Style="{StaticResource styleEtiquetasFormResize}" 
                                       Foreground="#FF78797C">
                                  <Run Language="es-co" Text=" 1 - Adjuntar archivos adicionales(PDF o cualquier otro)"/>
                                </TextBlock>
                                <Grid Margin="10,5,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="cmdBuscarArchivo1"
                                            HorizontalAlignment="Left"
                                            Content="Adjuntar..."
                                            Style="{StaticResource styleButtonMiniFormBrows}"
                                            TabIndex="109"
                                            Click="CmdButton_GetFile_Click1"
                                            Grid.Column="0"
                                            Height="35"
                                            Width="65"
                                            ToolTip="Buscar un archivo para enviar como adjunto"/>
                                    <Button Name="cmdQuitarArchivo1"
                                            HorizontalAlignment="Left"
                                            Content="X"
                                            Style="{StaticResource styleButtonMiniFormBrows}"
                                            TabIndex="109"
                                            Click="CmdButton_DeleteGetFile_Click1"
                                            Grid.Column="1"
                                            Height="35"
                                            Width="40"
                                            ToolTip="Quitar archivo adjunto"/>
                                    <TextBox Name="txtArchivoAdjunto1"
                                             TabIndex="109"
                                             Grid.Column="2"
                                             FontSize="12"
                                             Height="35"
                                             TextWrapping="Wrap"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             IsReadOnly="True"/>
                                </Grid>
                                <!-- 2 adjuntar otro archivo -->
                                <TextBlock HorizontalAlignment="Left"
                                       Grid.Row="0"
                                       FontSize="12"
                                       Margin="10,6,0,0"
                                       Style="{StaticResource styleEtiquetasFormResize}" 
                                       Foreground="#FF78797C">
                                  <Run Language="es-co" Text=" 2 - Adjuntar archivos adicionales(PDF o cualquier otro)"/>
                                </TextBlock>
