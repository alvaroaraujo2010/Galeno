<Window x:Class="Sistema.Vista.FacturacionResumenFiltro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="980" 
        Height="630"
        Name="MaxCITFiltroTurnos"
        ShowInTaskbar="False"
        Title="Filtrar turnos..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent">
    <Grid x:Name="LayoutRoot" Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Stretch" 
                Width="Auto" 
                Grid.RowSpan="4"
                Grid.Row="1"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdCancelar_Click"
                    ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Resumen general facturación..." 
                   Grid.Row="1" Margin="63,10,66,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               Margin="6,15,0,0" 
               VerticalAlignment="Top" 
               Width="48" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <!-- parametros  -->
        <Grid Grid.Row="1" Margin="8,45,8,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <!-- seleccion -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtFiltro"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="16"
                         Height="24"
                         Visibility="Collapsed"
                         TextChanged="fcvFiltroTextChanged"
                         Grid.Column="0"/>
                <local:crtBuscar HorizontalAlignment="Left"
                         Grid.Row="0"
                         VerticalAlignment="Top"
                         Height="30"
                         Width="434"
                         Margin="6,2,0,0" 
                         Loaded="crtBuscarLoaded"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblFechaInicial"
                           ToolTip="Fecha inicial"
                           FontSize="14"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Fecha inicial"/>
                </TextBlock>
                <TextBox Name="txtFechaInicial"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="14"
                         IsReadOnly="True"
                         Grid.Column="1"/>
                <TextBlock Name="lblFechaFinal"
                           ToolTip="Fecha inicial"
                           FontSize="14"
                           Grid.Column="2"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Fecha Final"/>
                </TextBlock>
                <TextBox Name="txtFechaFinal"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="14"
                         IsReadOnly="True"
                         Grid.Column="3"/>
                <!-- totale general -->
                <Border HorizontalAlignment="Stretch"
                        Width="Auto" 
                        Grid.Column="5"
                        Grid.ColumnSpan="4" 
                        Background="#FFEBF9FB"/>
                <TextBlock Name="lblTotalFacturas"
                           ToolTip="Cantidad total facturas"
                           FontSize="14"
                           Grid.Column="5"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Cantidad facturas"/>
                </TextBlock>
                <TextBox Name="txtTotalFacturas"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="14"
                         IsReadOnly="True"
                         Grid.Column="6"/>
                <TextBlock Name="lblValorFacturas"
                           ToolTip="Cantidad total facturas"
                           FontSize="14"
                           Grid.Column="7"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Valor"/>
                </TextBlock>
                <TextBox Name="txtValorFacturas"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="14"
                         IsReadOnly="True"
                         Grid.Column="8"/>
            </Grid>
        </Grid>
        <!-- grilla -->
        <DataGrid Name="grdDataGrid" 
                  AutoGenerateColumns="False" 
                  Height="375" 
                  HorizontalAlignment="Stretch" 
                  Grid.Row="2"
                  Width="Auto"
                  Margin="10,5,10,0" 
                  VerticalAlignment="Top"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Name="chkHeader" Click="fcvSelectCheckBoxTodos" HorizontalAlignment="Center" IsChecked="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Click="fcvSelectCheckBoxUno" 
									  HorizontalAlignment="Center" 
									  IsChecked="{Binding Path=seleccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding cto_nrocon_cont}" 
                                        Header="Contrato" 
                                        Width="120"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding cto_descon_cont}" 
                                        Header="Descripción Contrato"
                                        Width="220"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding sia_codeps_teps}" 
                                        Header="Codigo Eps"
                                        Width="80"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding sia_deseps_teps}" 
                                        Header="Nombre Eps"
                                        Width="250"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding fcm_totuni_dfac}" 
                                        Header="Cantidad.Facturas"
                                        Width="110"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding fcm_valfac_dfac, StringFormat={}{0:N0}}" 
                                    Header="Valor.Facturas"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <!-- totale general -->
            <Border HorizontalAlignment="Stretch"
                    Width="Auto" 
                    Grid.Column="1"
                    Grid.ColumnSpan="4" 
                    Margin="0,4,0,4"
                    Background="#FFF4F9D1"/>
            <TextBlock Name="lblSelectFacturas"
                           ToolTip="Cantidad total facturas seleccionadas"
                           FontSize="14"
                           Grid.Column="1"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Seleccion Facturas"/>
            </TextBlock>
            <TextBox Name="txtSelectFacturas"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="18"
                         Height="26"
                         IsReadOnly="True"
                         Grid.Column="2"/>
            <TextBlock Name="lblValSelectFacturas"
                           ToolTip="Cantidad total facturas"
                           FontSize="14"
                           Grid.Column="3"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Valor"/>
            </TextBlock>
            <TextBox Name="txtValSelectFacturas"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="18"
                         Height="26"
                         IsReadOnly="True"
                         Grid.Column="4"/>
        </Grid>
        <Image HorizontalAlignment="Stretch" 
               Height="50" 
               VerticalAlignment="Top" 
               Width="Auto" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="4" 
               StretchDirection="UpOnly" 
               Stretch="Fill" Margin="0,0,0,0"/>
        <Button Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    Margin="0,10,13,0"
        	    x:Name="cmdCancelar"
        	    VerticalAlignment="Top"
        	    Width="120"
        	    Visibility="Visible"
                Grid.Row="4" 
                Click="cmdCancelar_Click"
                ToolTip="Clic aquí para salir sin seleccionar"
                Cursor="Hand" TabIndex="5">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock x:Name="textCancelar" 
                           Text="Cancelar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    Margin="0,10,169,0"
        	    Name="cmdAceptar"
        	    VerticalAlignment="Top"
        	    Width="120"
        	    Visibility="Visible"
                Grid.Row="4" 
                Click="cmdAceptar_Click"
                ToolTip="Clic aquí para confirmar selección de turnos"
                Cursor="Hand" TabIndex="4">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgAceptar" 
                       Source="/Sistema;component/Imagenes/sis_edt_aceptar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2"/>
                <TextBlock x:Name="textAceptar" 
                           Text="Aceptar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
