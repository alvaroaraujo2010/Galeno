<UserControl x:Class="Sistema.Vista.ControlCorreoItemArchivo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="50"
             Width="250">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Name="brdFondo" 
                Grid.Row="1"
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="1"
                BorderBrush="#FFB4B4B4"
                Grid.Column="1"
                Grid.RowSpan="2"
                Grid.ColumnSpan="3"/>
        <Image Name="ImgIcono" 
                   Margin="5"
                   Grid.Column="1"   
                   Grid.RowSpan="2"
                   Grid.Row="1" 
                   Height="30" 
                   Width="30"
                   Stretch="Fill"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Source="/Sistema;component/Imagenes/Edt_edt_confirmar.png"/>
        <TextBox Name="txtNombreArchivo"
                 BorderThickness="0"
                 Grid.Column="2"
                 Grid.Row="1"
                 Background="Transparent"
                 Focusable="False"
                 FontSize="11"
                 Text="Nombre Item" 
                 Foreground="#FF27AEFB" Margin="0,2,0,18" Grid.RowSpan="2"/>
        <TextBox Name="txtTamano"
                 BorderThickness="0"
                 Grid.Column="2"
                 Grid.Row="2"
                 Background="Transparent"
                 Focusable="False"
                 FontSize="10"
                 Text="Tamaño" 
                 Foreground="#FF27AEFB"/>
        <Button Name="cmdQuitar"
                VerticalContentAlignment="Top"
                Margin="0,-7,0,2"
                Grid.Row="1"
                Grid.RowSpan="2"
                Height="25"
                Grid.Column="3"
                Style="{StaticResource styleButtonImgEdtFormTouchItem}"
                ToolTip="Quitar elemento">
            <StackPanel Orientation="Horizontal"
                         Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
