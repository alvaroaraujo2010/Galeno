<Window x:Class="Sistema.Vista.FacturacionFacAbiertas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="980" 
        Height="630"
        Name="MaxCITFiltroTurnos"
        ShowInTaskbar="False"
        Title="Filtrar turnos..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent">
    <Grid x:Name="LayoutRoot" Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="85" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Stretch" 
                Width="Auto" 
                Grid.RowSpan="3"
                Grid.Row="1"/>
        <Grid Grid.Row="1" Margin="8,45,8,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtFiltro"
                         TabIndex="5"
                         Style="{StaticResource styleTextBoxFormResize}"
                         FontSize="16"
                         Height="24"
                         Visibility="Collapsed"
                         Grid.Column="0"/>
                <local:crtBuscar HorizontalAlignment="Left"
                         Grid.Row="0"
                         VerticalAlignment="Top"
                         Height="30"
                         Width="434"
                         Margin="6,2,0,0" 
                         Loaded="crtBuscarLoaded"/>
                <TextBlock Name="lblG1cit_fecitr_turn"
                	        Grid.Column="1"
                	        Style="{StaticResource styleEtiquetasFormResize}">
                	<Run Language="es-co" Text="Fecha Inicio"/>
                </TextBlock>
                <Grid Grid.Column="2"
                      Style="{StaticResource styleDatePickerGridFormResize}">
                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                    <TextBox Name="txtG1Cit_fecitr_turn"
                                 TabIndex="1"
                                 Style="{StaticResource styleTextBoxFormFecha}"
                                 TextChanged="fcvActualizarDatePicker"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                    <DatePicker Name="dpkG1Cit_fecitr_turn"
                                Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
                <TextBlock Name="lblG1cit_fecftr_turn"
                	        Grid.Column="3"
                	        Style="{StaticResource styleEtiquetasFormResize}" Height="16">
                	<Run Language="es-co" Text="Fecha Finaliza"/>
                </TextBlock>
                <Grid Grid.Column="4"
                      Style="{StaticResource styleDatePickerGridFormResize}">
                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                    <TextBox Name="txtG1Cit_fecftr_turn"
                             TabIndex="2"
                             Style="{StaticResource styleTextBoxFormFecha}"
                             TextChanged="fcvActualizarDatePicker"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                    <DatePicker Name="dpkG1Cit_fecftr_turn"
                            Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
            </Grid>
        </Grid>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdCancelar_Click"
                    ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Facturas abiertas..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <ListView Name="objDataGrid" 
                  Margin="0,5,0,0" 
                  Grid.Row="2" 
                  MouseDoubleClick="MouseDbClick" 
                  TabIndex="3" 
                  KeyDown="DataGridKeyDown"
                  FontSize="12"
                  GotFocus="objDataGrid_GotFocus" SelectionMode="Single">
            <ListView.View>
                <GridView 
    		    x:Name="objGridView"/>
            </ListView.View>
        </ListView>
        <Image HorizontalAlignment="Stretch" 
               Height="50" 
               VerticalAlignment="Top" 
               Width="Auto" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="3" 
               StretchDirection="UpOnly" 
               Stretch="Fill" Margin="0,0,0,0"/>
        <Button Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    Margin="0,10,116,0"
        	    x:Name="cmdCancelar"
        	    VerticalAlignment="Top"
        	    Width="100"
        	    Visibility="Visible"
                Grid.Row="3" 
                Click="cmdCancelar_Click"
                ToolTip="Clic aquí para salir sin seleccionar"
                Cursor="Hand" TabIndex="5">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock x:Name="textCancelar" 
                           Text="Cancelar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <TextBlock Name="lblTotalFacturas"
                   ToolTip="Total registros con factuacion abierta "
                   FontSize="14"
                   Grid.Row="3"
                   Style="{StaticResource styleEtiquetasFormResize}" 
                   Margin="55,16,818,16">
             <Run Language="es-co" Text="Total Registros"/>
        </TextBlock>
        <TextBox Name="txtTotalFacturas"
                 TabIndex="5"
                 Style="{StaticResource styleTextBoxFormResize}"
                 FontSize="14"
                 IsReadOnly="True"
                 Grid.Row="3" 
                 Margin="167,15,685,15"/>
        <Button Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    Margin="0,10,228,0"
        	    x:Name="cmdAceptar"
        	    VerticalAlignment="Top"
        	    Width="100"
        	    Visibility="Visible"
                Grid.Row="3" 
                Click="cmdAceptar_Click"
                ToolTip="Clic aquí para confirmar selección de turnos"
                Cursor="Hand" TabIndex="4">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgAceptar" 
                       Source="/Sistema;component/Imagenes/sis_edt_aceptar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2"/>
                <TextBlock x:Name="textAceptar" 
                           Text="Aceptar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               Margin="6,15,0,0" 
               VerticalAlignment="Top" 
               Width="48" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
    </Grid>
</Window>
