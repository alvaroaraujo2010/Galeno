<Window x:Class="Sistema.Vista.DialogProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesando..."
        Width="700"
        Height="50"
        VerticalContentAlignment="Bottom"
        HorizontalContentAlignment="Left"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
        <Grid>
            <Image x:Name="Capa" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0" 
                       Source="/Sistema;component/Imagenes/sys_panel_fondo3.png"
                       Stretch="Fill"/>
            <ProgressBar Name="objProgressBar"
                         HorizontalAlignment="Right"
                         Height="30"
                         Margin="0,11,93,9"
                         Value="1"
                         Minimum="0"
                         Maximum="100"
                         Width="240" 
                         BorderBrush="#FFFDFDFD" 
                         Foreground="#FF2DAA8E" 
                         LargeChange="0" 
                         Background="Transparent" />
            <TextBlock Name="lblStatus"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Stretch"
                	       Margin="10,10,340,0" 
                           FontSize="22" 
                           Foreground="White">
                	       <Run Language="es-co" Text="Barra de progreso..."/>
            </TextBlock>
            <Button x:Name="btnCancel"
                        Click="btnCancel_Click"
                        Visibility="Collapsed"
                        Content="Cancel"
                        Width="80"
                        Margin="0,16,7,18"
                        HorizontalAlignment="Right" />
    </Grid>
</Window>
