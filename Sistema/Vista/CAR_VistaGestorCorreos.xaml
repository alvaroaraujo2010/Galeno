<Window x:Class="Sistema.Vista.VistaGestorCorreos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        DataContext="{Binding Path=VistaModeloGestorCorreos, Source={StaticResource SIS_Locator}}"
        Title="Vista captura reportes" 
        Height="700" 
        Width="1024"  
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        WindowState="Normal"
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                BorderThickness="1,1,1,1"
                BorderBrush="#FFB0AFAF"
                Margin="0,0,0,0"
                Grid.RowSpan="4"
                Grid.Row="0"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="0"
               Margin="0,0,-1,-1" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" 
               Grid.RowSpan="2" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Visibility="Collapsed"
               Margin="0,0,52,02"
               Grid.Row="1"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/logo_megassoft.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="1"
                   FontFamily="Segoe UI Light"
                   Foreground="#FFFBF7F6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="15,0,0,4" 
                   Width="236" 
                   Height="21"/>
        <!-- BARRA INFERIOR -->
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Visibility="Collapsed"
               Margin="1,3,1,0"
               VerticalAlignment="Top"
               Grid.Row="4"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Border Grid.Row="4"
                    BorderThickness="1,0,1,1"
                    Background="#E5E6E6E6"
                    BorderBrush="#FFB0AFAF">
        </Border>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="64"
                Command="{Binding CmdSAL}"
                Click="CmdSalir_Click"
                Grid.Row="3"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <!-- ZONA DEL EDITOR -->
        <Grid Name="grdFondoEscritorio"  
              Grid.Row="1"
              Grid.RowSpan="2"
              Width="Auto"
			  Height="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                    BorderThickness="1,0,0,1"
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Grid.Row="0"
                    Grid.RowSpan="2" 
                    Background="White">
            </Border>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                    Grid.Column="2"
                    BorderThickness="1"
                    Grid.Row="0"
                    Grid.RowSpan="2">
            </Border>
            <ScrollViewer Name="PanelScroll" 
						    Margin="8,8,8,2"
						    Grid.Column="1"
						    HorizontalAlignment="Stretch" 
						    Width="Auto"
						    Height="Auto"
						    VerticalScrollBarVisibility="Auto"
						    HorizontalScrollBarVisibility="Hidden"
						    PanningMode="HorizontalFirst"
						    CanContentScroll="False">
                <StackPanel Name="stkBase" Margin="2,2,14,2">
                    <!-- codigo del registro maestro -->
                    <TextBox Name="txtG1Car_secreg_cagm"
                             HorizontalAlignment="Left"
                             Grid.Row="0"
                             Width="10"
                             Visibility="Collapsed"
                             TabIndex="1"
                             Text="{Binding Path=G1Car_secreg_cagm, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             Grid.Column="1"
                             Focusable="False"/>
                    <!-- Remitente -->
                    <Grid Grid.Row="0" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Remitente"/>
                        </TextBlock>
                        <Button Name="cmdG1Car_faddre_caml"
                                HorizontalAlignment="Left"
                                Content="De:"
                                Style="{StaticResource styleButtonMiniFormBrows}"
                                TabIndex="109"
                                Click="CmdG1Car_faddre_caml_Click"
                                Grid.Row="1"
                                Height="28"
                                Width="55"
                                Margin="10,2,0,0"
                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                ToolTip="REsmitente del correo"/>
                        <TextBox Name="txtG1Car_faddre_caml"
                                 TabIndex="109"
                                 Margin="74,4,13,0"
                                 Text="{Binding Path=G1Car_faddre_caml, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="1"
                                 Height="28"
                                 IsReadOnly="True"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Margin="10,6,0,6"
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Destinatario o Adquirente"/>
                        </TextBlock>
                        <Button Name="cmdG1Sis_idterc_sitr"
                                HorizontalAlignment="Left"
                                Content="Para:"
                                Style="{StaticResource styleButtonMiniFormBrows}"
                                TabIndex="109"
                                Click="cmdG1Sis_idterc_sitr_Click"
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                Height="45"
                                Width="55"
                                Margin="10,2,0,0"
                                IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                ToolTip="Adquirente o Empresa cliente destinatario del correo"/>
                        <Grid Grid.Row="1" Margin="70,5,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtG1Sis_idterc_sitr"
                                             TabIndex="9"
                                             Text="{Binding Path=G1Sis_idterc_sitr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="0"
                                             IsReadOnly="True"
                                             KeyDown="txtG1Sis_idterc_sitr_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                            <TextBox Name="txtG1Sis_razsoc_sitr"
                                             TabIndex="109"
                                             Text="{Binding Path=G1Sis_razsoc_sitr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             Grid.Column="3"
                                             Focusable="False"/>
                        </Grid>
                        <TextBox Name="txtG1Car_taddre_caml"
                                 TabIndex="109"
                                 Margin="74,3,13,0"
                                 Text="{Binding Path=G1Car_taddre_caml, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="2"
                                 IsReadOnly="True"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Asunto"/>
                        </TextBlock>
                        <TextBox Name="txtG1Car_subjec_caml"
                                 TabIndex="109"
                                 Margin="10,5,13,2"
                                 Text="{Binding Path=G1Car_subjec_caml, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="1"
                                 Height="28"
                                 IsReadOnly="True"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="5,2,5,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                        </Border>
                        <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                        </Border>
                        <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Mensaje"/>
                        </TextBlock>
                        <TextBox Name="txtG1Car_bodyms_caml"
                                 TabIndex="109"
                                 Height="115"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="10,5,13,0"
                                 TextWrapping="Wrap"
                                 Text="{Binding Path=G1Car_bodyms_caml, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Row="1"
                                 IsReadOnly="True"/>
                    </Grid>
                    <!-- detalles -->
                    <StackPanel Name="stkAdjuntos" Grid.Row="4">
                        <!-- Archivos adjuntos externos -->
                        <Grid Margin="5,2,5,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                            </Border>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                            </Border>
                            <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Archivos externos adjuntados"/>
                            </TextBlock>
                            <StackPanel Name="stkAdjArchivosExternos" Grid.Row="1" Margin="5,2,5,2"/>
                        </Grid>
                        <!-- Archivos adjuntos externos -->
                        <Grid Margin="5,2,5,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <TextBox Name="txtG2Fcm_secreg_mfac"
                                         TabIndex="22"
                                         Text="{Binding Path=G2Fcm_secreg_mfac, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="txtG2Fcm_secreg_mfac_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus" Margin="4,5,671,5"/>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                BorderThickness="1"
                                Margin="0,0,0,0"
                                Grid.Row="0"
                                Grid.RowSpan="4" 
                                Background="White">
                            </Border>
                            <Border Style="{DynamicResource styleBorderFondoForm}"
                                Margin="1,1,1,0"
                                BorderThickness="0,0,0,1"
                                Grid.Row="0"
                                Background="White">
                            </Border>
                            <TextBlock HorizontalAlignment="Left"
                                   Grid.Row="0"
                                   FontSize="14"
                                   Margin="10,6,0,6"
                                   Style="{StaticResource styleEtiquetasFormResize}" 
                                   Foreground="#FF103AAA">
                              <Run Language="es-co" Text="Documentos eléctronicos adjuntados"/>
                            </TextBlock>
                            <StackPanel Name="stkAdjDocumentos" Margin="5,2,5,2" Grid.Row="1"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

        </Grid>
        <!-- MENU SUPERIOR -->
        <Grid Name="grdMenuSuperior" 
              Width="Auto"
              Height="100"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                    BorderThickness="1,1,1,0"
                    Background="White"
                    BorderBrush="#FFB0AFAF">
            </Border>
            <Border Grid.Row="1"
                    BorderThickness="1,0,1,1"
                    Background="#E5E6E6E6"
                    BorderBrush="#FFB0AFAF">
            </Border>
            <!-- Logo del Sistema -->
            <Image Name="ImgPpal" 
                   Margin="6,4,0,0"
                   Grid.Row="0" 
                   Height="42" 
                   Width="57"
                   Stretch="Fill"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Source="/Sistema;component/Imagenes/Gcorreo_imagen01.png"/>
            <!-- Titulo del Sistema -->
            <TextBlock x:Name="TextTitulo" 
        	                    Grid.Row="0" 
        	                    HorizontalAlignment="Stretch" 
        	                    VerticalAlignment="Top"
        	                    Margin="84,15,749,0" 
        	                    FontSize="26"  
        	                    FontFamily="Segoe UI Light" Height="35">
                                <Run Text="Gestión Correo"/>
                                <Run Language="es-co"/><Run Text=" "/>
                                <LineBreak/>
                                <Run Language="es-co"/></TextBlock>
            <!-- Boton Cerrar -->
            <Button Name="cmdCerrar"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgFormPlanExit}"
                    TabIndex="50"
                    Click="CmdSalir_Click"
                    IsEnabled="{Binding GlgSIS_ModoDefault}"
                    ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sys_cerrar01.png">
                    </Image>
                </StackPanel>
            </Button>
            <!-- Boton Minimizar -->
            <StackPanel Name="GridBarraDeTareas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Grid.Row="1">
                <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                <Button Name="cmdBrowser"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Height="40"
                        Command="{Binding CmdDFL}"
                        Click="fcvBrowserBuscar"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        ToolTip="Abrir plantilas de correos existentes" >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgCargarVsita"
                		        Source="/Sistema;component/Imagenes/Gcorreo_imagen02.png"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="10"/>
                <Button Name="cmdGuardar"
                       Margin="2,4,0,0"
                       TabIndex="53"
                       Height="40"
                       Command="{Binding CmdSAV}"
                       Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                       IsEnabled="{Binding Path=glgSIS_DatosVerificados}"
                       ToolTip="Guardar en base de datos..." >
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="imgGuardar"
                		        Source="/Sistema;component/Imagenes/Gcorreo_imagen07.png"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="10"/>
                <Button Name="cmdAdicionar"
                        Margin="2,4,0,0"
                        Width="140"
                        Height="40"
                        Command="{Binding CmdADD}"
                        Click="fcvNuevoRegistro"
                        Background="#FF2E87F1"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        TabIndex="60"
                        ToolTip="Haga clic aqui para crear un nuevo correo">
                    <StackPanel Orientation="Horizontal"
                                Height="40"
                                Style="{StaticResource styleStackPanelBotonesForm}" 
                                Width="105">
                        <TextBlock x:Name="lblEnviar"
                                     Text="Nuevo Mensaje"
                                     Foreground="White"
            	                     Style="{StaticResource styleLblBotonesForm}" 
                                     Height="16" 
                                     Width="109" 
                                     FontSize="14" 
                                     Margin="0,12"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="30"/>
                <Button Name="cmdEnviar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Height="40"
                        Width="100"
                        Command="{Binding CmdENV}"
                        Click="CmdEnviarCorreo_Click"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        IsEnabled="{Binding Path=GlgSIS_ModoVistaObjetos}"
                        ToolTip="Enviar correo" >
                    <StackPanel Orientation="Horizontal">
                        <Image Name="imgEnviar"
                               Height="40"
                		       Source="/Sistema;component/Imagenes/Gcorreo_imagen03.png"/>
                        <TextBlock x:Name="lblNuevo"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Enviar"
                                   Foreground="#FF1261C5"
            	                   Style="{StaticResource styleLblBotonesForm}" 
                                   FontSize="14"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                <Button Name="cmdAdjuntar"
                        Margin="2,4,0,0"
                        Height="40"
                        TabIndex="53"
                        Width="100"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        IsEnabled="{Binding Path=GlgSIS_ModoVistaObjetos}"
                        ToolTip="Adjuntar archivos externos" >
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40"
                		       Source="/Sistema;component/Imagenes/Gcorreo_imagen04.png"/>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Adjuntar"
                                   Foreground="#FF1261C5"
            	                   Style="{StaticResource styleLblBotonesForm}" 
                                   FontSize="14"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                <Button Name="cmdImportar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Height="40"
                        Width="100"
                        Click="fcvMostrarMenuEdicion"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        IsEnabled="{Binding Path=GlgSIS_ModoVistaObjetos}"
                        ToolTip="Adjuntar documentos desde cuentas de cobro o facturas" >
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40"
                		       Source="/Sistema;component/Imagenes/Gcorreo_imagen06.png"/>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Importar"
                                   Foreground="#FF1261C5"
            	                   Style="{StaticResource styleLblBotonesForm}" 
                                   FontSize="14"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource styleMenuContextButton}">
                            <MenuItem Name="opImportListaDoc"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Importar lista de facturas">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Name="opImportDocument"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Importar un documento DIAN">
                                <MenuItem.Icon>
                                    <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                <Button Name="cmdEliminar"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Height="40"
                        Width="100"
                        Command="{Binding CmdDEL}"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenu}"
                        IsEnabled="{Binding Path=GlgSIS_ModoVistaObjetos}"
                        ToolTip="Eliminar la plantilla de correo activa" >
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40"
                		       Source="/Sistema;component/Imagenes/Gcorreo_imagen05.png"/>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Eliminar"
                                   Foreground="#FF1261C5"
            	                   Style="{StaticResource styleLblBotonesForm}" 
                                   FontSize="14"/>
                    </StackPanel>
                </Button>
                <Separator Background="Transparent" BorderBrush="Black" Width="8"/>
                <Button Name="cmdLogErrores"
                        IsEnabled="True"
                        Margin="2,4,0,0"
                        TabIndex="53"
                        Height="40"
                        Width="100"
                        Command="{Binding CmdERR}"
                        Click="fcvVistaLogErrores"
                        Style="{StaticResource styleButtonImgEdtFormTouchMenuError}"
                        ToolTip="Lista de errores en gestión" >
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40"
                		       Source="/Sistema;component/Imagenes/Gcorreo_imagen08.png"/>
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
