<UserControl x:Class="Sistema.Vista.Tiles02"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	        mc:Ignorable="d"
	        x:Name="UserControl"
	        d:DesignWidth="640" 
            d:DesignHeight="480" 
            Width="270" 
            Height="120" 
            Opacity="50"
            Cursor="Hand">
    <UserControl.Resources>
        <Storyboard x:Key="OnMouseEnter1">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="TileSurfaceRct" Storyboard.TargetProperty="(UIElement.Opacity)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0.14"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeave1">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="TileSurfaceRct" Storyboard.TargetProperty="(UIElement.Opacity)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.14"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource OnMouseEnter1}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource OnMouseLeave1}" x:Name="OnMouseLeave1_BeginStoryboard"/>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid x:Name="LayoutRoot" >
        <Image x:Name="TileIcon" 
               HorizontalAlignment="Left"  
               VerticalAlignment="Top"  
               Stretch="Fill"
               Margin="3,0,0,0" 
               Source="/Sistema;component/Imagenes/sys_tiles2_verdemarino.png"
               RenderTransformOrigin="0.0,0.0" />
        <Image x:Name="Icono"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               Height="88" 
               Width="64"
               Stretch="UniformToFill"
               Source="/Sistema;component/Imagenes/sys_usu01.png"
               Margin="7,5,0,0" />
        <!-- Titulo del Modulo -->
        <TextBlock x:Name="txtTexto1" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="75,5,0,0" 
                   FontSize="16"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left" 
                   Text="Texto 1" 
                   Width="190"
                   RenderTransformOrigin="0.5,0.5" 
                   Foreground="White"/>
        <TextBlock x:Name="txtTexto2" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="75,26,0,0" 
                   FontSize="9"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left"
                   Foreground="White" 
                   Text="Titulo 2" 
                   Width="190"
                   Height="26"
                   TextWrapping="Wrap" 
                   RenderTransformOrigin="0.5,0.5"/>
        <TextBlock x:Name="txtTexto3" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="75,54,0,0" 
                   FontSize="9"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left"
                   Foreground="White" 
                   Text="Titulo 3" 
                   Width="190"
                   Height="26"
                   TextWrapping="Wrap"
                   RenderTransformOrigin="0.5,0.5" >
        </TextBlock>
        <TextBlock x:Name="txtTexto4" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="75,81,0,0" 
                   FontSize="9"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left"
                   Foreground="White" 
                   Text="Titulo 4" 
                   Width="190"
                   Height="14"
                   RenderTransformOrigin="0.5,0.5" >
        </TextBlock>
        <Grid Height="20"
              HorizontalAlignment="Left"
              Width="258"
              Margin="7,88,0,0"
              RenderTransformOrigin="0.0,0.0">
            <Image x:Name="Capa" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Margin="0,0,0,0"
                   Source="/Sistema;component/Imagenes/sys_panel_fondo2.png"
                   Stretch="Fill"/>
            <TextBlock x:Name="txtTexto5" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="0,4,0,0" 
                   FontSize="11"
                   FontFamily="Segoe UI Symbol"
                   TextAlignment="Left"
                   Foreground="White" 
                   Text="Titulo 5" 
                   Width="255"
                   TextWrapping="Wrap" 
                   RenderTransformOrigin="0.5,0.5" >
        </TextBlock>
        </Grid>
        <TextBlock x:Name="txtTexto6" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Background="White"
                   Margin="7,80,0,0"                    
                   FontSize="10"
                   TextAlignment="Center"
                   Foreground="Blue" 
                   Text="6" 
                   Width="20"
                   RenderTransformOrigin="0.5,0.5" >
        </TextBlock>
        <TextBlock x:Name="txtTexto7" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Background="White"
                   Margin="28,80,0,0" 
                   FontSize="10"
                   TextAlignment="Center"
                   Foreground="Green" 
                   Text="7" 
                   Width="20"
                   RenderTransformOrigin="0.5,0.5" >
        </TextBlock>
        <!-- Capa trasparente sobre el tile -->
        <Rectangle HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   x:Name="TileSurfaceRct" 
                   Fill="#FF000000" 
                   Opacity="0" 
                   Width="257"
                   Height="110"
                   Margin="8,5,0,0"
                   Stroke="#FFFBFBFB"/>
    </Grid>
</UserControl>
