<Window x:Class="Sistema.Vista.VistaErroresEjecucion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:Sistema.Vista" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="700" 
        Height="500"
        Title="Buscar Registro..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent" 
        ShowInTaskbar="False">
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Left" 
    		Height="42" 
    		Margin="8,43,0,0" 
    		Grid.Row="1" 
    		VerticalAlignment="Top" 
    		Width="589" 
    		OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
    		Fill="#FFF6F8F9"/>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Stretch" 
                Grid.RowSpan="3"
                Grid.Row="1"/>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdCancelar_Click"
                    ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Error de ejecución..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image HorizontalAlignment="Left" 
               Height="Auto" 
               Margin="0,5,0,0" 
               VerticalAlignment="Stretch" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="3" 
               StretchDirection="UpOnly" 
               Stretch="Fill"/>
        <Button Name="cmdCancelar"
                Style="{StaticResource styleButtonImgForm}"
                HorizontalAlignment="Right"
        	    VerticalAlignment="Center"
        	    Visibility="Visible"
                Grid.Row="3" 
                Click="cmdCancelar_Click" 
                Cursor="Hand" TabIndex="5" 
                Margin="0,11,58,7">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock Name="textCancelar" 
                           Text="Cerrar" 
            	           Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="43" 
               Margin="8,6,0,0" 
               VerticalAlignment="Top" 
               Width="50" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <TextBox Name="txtTitulo"
                 FontSize="16"
                 Height="Auto"
                 Width="Auto"
                 Grid.Row="1"
                 BorderThickness="0"
                 IsReadOnly="True"
                 Margin="15,45,15,5"/>
        <TextBox Name="txtErrorEjecucion"
                 Height="Auto"
                 Width="Auto"
                 Grid.Row="2"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Margin="15,10,15,0"/>
    </Grid>
</Window>
