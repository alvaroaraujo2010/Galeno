<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dg="http://schemas.microsoft.com/wpf/2008/toolkit"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ======================================== -->
    <!-- Estilo de Botones con Imagenes para Menu -->
    <!-- ======================================== -->
    <!-- Estilo de Botones con Imagenes -->
    <Style x:Key="styleButtonImgFormTouch"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="13" />
        <Setter Property="Control.Height" Value="65" />
        <Setter Property="Control.Width" Value="65" />
        <Setter Property="Control.Cursor" Value="Hand" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.BorderBrush" Value="Transparent" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Padding" Value="0"/>
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- StackPanel de Botones Con Imagenes -->
    <Style x:Key="styleStackPanelBotonesFormTouch" TargetType="StackPanel">
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ======================================== -->
    <!-- Estilo Botones con Imagenes Menu Capa    -->
    <!-- ======================================== -->
    <!-- Estilo de Botones con Imagenes -->
    <Style x:Key="styleButtonMenuPropCapaTouch"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="13" />
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Width" Value="230" />
        <Setter Property="Control.Cursor" Value="Hand" />
        <Setter Property="Control.BorderBrush" Value="Transparent" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Margin" Value="0,5,0,5"/>
        <Setter Property="Control.Padding" Value="0"/>
        <Setter Property="Control.Focusable" Value="False"/>
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="Control.Background" >
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA9D4C5" Offset="0"/>
                    <GradientStop Color="#FF5E9380" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Grid de Botones Con Imagenes -->
    <Style x:Key="styleGridMenuPropCapaTouch" TargetType="Grid">
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.Width" Value="216" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Imagen de Botones Con Imagenes -->
    <Style x:Key="styleImageMenuPropCapaTouch" TargetType="Image">
        <Setter Property="Control.Margin" Value="0,4,154,8" />
        <Setter Property="Control.Width" Value="53" />
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Center" />
    </Style>
    <!-- TextBlock de Botones Con Imagenes -->
    <Style x:Key="styleTextBlockMenuPropCapaTouch" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="16" />
        <Setter Property="Control.Height" Value="26" />
        <Setter Property="Control.Width" Value="149" />
        <Setter Property="Control.Margin" Value="67,21,0,0" />
        <Setter Property="Control.Foreground" Value="White" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- ======================================== -->
    <!-- Estilo Menu Contextual en Botones        -->
    <!-- ======================================== -->
    <!-- Menu Contextual de Menu Contextual en Botones -->
    <Style x:Key="styleMenuContextButtonTouch" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="16" />
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Name="Border" Background="White" BorderBrush="Black" BorderThickness="1" >
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="true">
                            <Setter TargetName="Border" Property="Padding" Value="0,3,0,3"/>
                            <Setter TargetName="Border" Property="CornerRadius" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- MenuItem de Menu Contextual en Botones -->
    <Style x:Key="styleMenuItemContextButtonTouch" TargetType="MenuItem">
        <Setter Property="Control.Height" Value="40" />
    </Style>
    <!-- Imagen de Menu Contextual en Botones -->
    <Style x:Key="styleImagMenuContextButtonTouch" TargetType="Image">
        <Setter Property="Control.Height" Value="30" />
        <Setter Property="Control.Width" Value="24" />
        <Setter Property="Control.Margin" Value="2,2,2,2" />
    </Style>
    <!-- ======================================== -->
    <!-- BOTONES IMAGENS PARA CONTROLES SERVICIOS-->
    <!-- ======================================== -->
    <!-- Estilo Botones Imagenes para controles -->
    <Style x:Key="styleButtonImgEdtControlesTouchEx"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="14" />
        <Setter Property="Control.Margin" Value="4,2,4,2" />
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Width" Value="355" />
        <Setter Property="Control.Cursor" Value="Hand" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.BorderBrush" Value="AliceBlue" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Padding" Value="0"/>
        <Setter Property="Control.Focusable" Value="False"/>
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Grid Botones Con Imagenes para controles-->
    <Style x:Key="styleGridImgEdtControlesTouchEx" TargetType="Grid">
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.Height" Value="50" />
        <Setter Property="Control.Width" Value="355" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Imagen de los Botones -->
    <Style x:Key="styleImageImgEdtControlesTouchEx" TargetType="Image">
        <Setter Property="Control.Width" Value="50" />
        <Setter Property="Control.Height" Value="42" />
        <Setter Property="Control.Margin" Value="5,-2,0,0" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
    </Style>
    <!-- TextBlock de Botones Con Imagenes -->
    <Style x:Key="styleTextImgEdtControlesTouchEx" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="14" />
        <Setter Property="Control.Height" Value="25" />
        <Setter Property="Control.Width" Value="290" />
        <Setter Property="Control.Margin" Value="60,15,0,0" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>   
    
    