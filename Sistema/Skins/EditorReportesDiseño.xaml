        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Control.Background" Value="#FFDDEEB9" />
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.Background" Value="Azure" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ======================================== -->
    <!-- Estilo Fondo del Editor                  -->
    <!-- ======================================== -->
    <Style x:Key="styleStackPanelEdtFondoEditor" TargetType="StackPanel">
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.Padding" Value="0,10,0,0" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.Focusable" Value="False"/>
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Background" Value="#00000000" />
    </Style>
    <!-- ======================================== -->
    <!-- Estilo Fondo del Editor                  -->
    <!-- ======================================== -->
    <Style x:Key="styleWrapPanelEdtFondoEditor" TargetType="WrapPanel">
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.Focusable" Value="False"/>
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Background" Value="#00000000" />
    </Style>
    <!-- =================================== -->
    <!-- Grid Principal Propiedades          -->
    <!-- =================================== -->
    <!-- Cortina Propiedades y Herramientas  -->
    <Style x:Key="styleTabControlEdtGridCortinaPropiedades" TargetType="Grid">
        <Setter Property="Control.Padding" Value="0" />
        <Setter Property="Control.Margin" Value="0,0,0,0" />
        <Setter Property="Control.Background" Value="#00000000" />
    </Style>
    <!-- =================================== -->
    <!-- TabControl para Propiedades         -->
    <!-- =================================== -->
    <!-- TabControl Encabezado Para Propiedades y Herramientas  -->
    <Style x:Key="styleTabControlEdtPropiedades" TargetType="TabControl">
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value = "White" />
        <Setter Property="Control.Margin" Value="0,44,1,0" />
    </Style>
    <!-- TabItem Encabezado  -->
    <Style x:Key="styleTabItemEdtPropiedades" TargetType="TabItem">
        <Setter Property="Control.Background" Value = "White" />
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="12" />
        <Setter Property="Control.Height" Value="100" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}">
                        <ContentPresenter.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </ContentPresenter.LayoutTransform>
                    </ContentPresenter>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="3" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Control.Background" Value="#FFDDEEB9" />
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.Background" Value="Azure" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="styleGridTabItemEdtPropiedades" TargetType="Grid">
        <Setter Property="Control.Background" Value = "White" />
        <Setter Property="Control.Padding" Value = "0" />
    </Style>
    <!-- ======================================== -->
    <!-- ComboBox Valores propiedades Objeto Activo -->
    <!-- ======================================== -->
    <Style x:Key="styleComboBoxEdtPropiedades" TargetType="ComboBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="14" />
        <Setter Property="Control.Height" Value="25" />
        <Setter Property="Control.Width" Value="260" />
        <Setter Property="Control.Margin" Value="160,2,0,1" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- ======================================== -->
    <!-- Etiquetas y Campos Captura propiedades   -->
    <!-- ======================================== -->
    <!-- Titulo o Etiquetas de campos -->
    <Style x:Key="styleEtiquetasEdtPropiedades" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="14" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Width" Value="150" />
        <Setter Property="Control.Margin" Value="8,3,0,2" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Campos de Captura de datos con validacion Error -->
    <Style x:Key="styleTextBoxEdtPropiedades" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="23" />
        <Setter Property="Control.Width" Value="260" />
        <Setter Property="Control.Margin" Value="160,2,0,1" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={
                        x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.FontWeight" Value="Bold" />
                <Setter Property="Control.Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Grid Contenedor de Propiedades -->
    <Style x:Key="styleTabControlEdtGridPropiedades" TargetType="Grid">
        <Setter Property="Control.Padding" Value="0" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.Margin" Value="0,1,0,0" />
    </Style>
    <!-- ======================================== -->
    <!-- BOTONES CON IMAGENS PARA CONTROLES -->
    <!-- ======================================== -->
    <!-- Estilo Botones Imagenes para controles -->
    <Style x:Key="styleButtonImgEdtControlesTouch"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="13" />
        <Setter Property="Control.Margin" Value="4,2,4,2" />
        <Setter Property="Control.Height" Value="54" />
        <Setter Property="Control.Width" Value="82" />
        <Setter Property="Control.Cursor" Value="Hand" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.BorderBrush" Value="AliceBlue" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Padding" Value="0"/>
        <Setter Property="Control.Focusable" Value="False"/>
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- StackPanel Botones Con Imagenes para controles-->
    <Style x:Key="styleStackPanelBotonesEdtControlesTouch" TargetType="StackPanel">
        <Setter Property="Control.Margin" Value="0" />
        <Setter Property="Control.Height" Value="54" />
        <Setter Property="Control.Width" Value="80" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Imagen de los Botones -->
    <Style x:Key="styleImagBotonesEdtControlesForm" TargetType="Image">
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Margin" Value="0,0,0,0" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

    