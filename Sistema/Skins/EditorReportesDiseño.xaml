    <!-- ======================================== -->
    <!-- Estilo TextBox y TextBlock para UserControl-->
    <!-- ======================================== -->
    <!-- Titulo o Etiquetas de campos -->
    <Style x:Key="styleEtiquetasEdtFormTouch" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="10" />
        <Setter Property="Control.FontStyle" Value="Normal" />
        <Setter Property="Control.FontWeight" Value="Black" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Campos de Captura de datos -->
    <Style x:Key="styleTextBoxEdtFormTouch" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="10" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Grid para UserControl -->
    <Style x:Key="styleGridEdtUserControl" TargetType="Grid">
    </Style>
