    <!-- Fondo titulo de la ventan propiedades -->
    <Style x:Key="styleBorderVistaPropTitulo" TargetType="Border">
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Background" Value="White" />
    </Style>
    <!-- Fondo de la ventan propiedades -->
    <Style x:Key="styleBorderVistaPropFondo" TargetType="Border">
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Background" Value="#F908A1B0" />
    </Style>
</ResourceDictionary>       
