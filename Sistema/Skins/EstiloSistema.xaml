    <!-- Estilo color fondo normal de Botones -->
    <LinearGradientBrush x:Key="BotonColorNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFF" Offset="0.0"/>
                <GradientStop Color="#CCC" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <!-- ======================================== -->
    <!-- Estilo Menu Contextual en Botones        -->
    <!-- ======================================== -->
    <!-- MenuItem de Menu Contextual en Botones -->
    <Style x:Key="styleMenuContextButton" TargetType="ContextMenu">
        <Setter Property="Control.Background" Value="White" />
    </Style>
    <!-- MenuItem de Menu Contextual en Botones -->
    <Style x:Key="styleMenuItemContextButton" TargetType="MenuItem">
        <Setter Property="Control.Height" Value="40" />
        <Setter Property="Control.Background" Value="White" />
    </Style>
    <!-- Imagen de Menu Contextual en Botones -->
    <Style x:Key="styleImagMenuContextButton" TargetType="Image">
        <Setter Property="Control.Height" Value="{Binding Path=ActualHeight}" />
        <Setter Property="Control.Width" Value="{Binding Path=ActualHeight}" />
        <Setter Property="Control.Margin" Value="0,0,0,0" />
        <Setter Property="Control.Padding" Value="-1" />
    </Style>
    <!-- =================================== -->
    <!-- TabControl para Zonas en Formulario -->
    <!-- =================================== -->
    <!-- TabControl Encabezado  -->
    <Style x:Key="styleTabControlZonaForm" TargetType="TabControl">
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalAlignment" Value="Stretch" />
        <Setter Property="Control.Margin" Value="10,2,10,2" />
    </Style>
    <!-- TabItem Encabezado  -->
    <Style x:Key="styleTabItemZonaForm" TargetType="TabItem">
        <Setter Property="Control.Background" Value = "White" />
    </Style>
    <Style x:Key="styleGridTabItemZona" TargetType="Grid">
        <Setter Property="Control.Background" Value = "White" />
    </Style>
    <!-- ======================== -->
    <!-- UserControl Buscar Tiles -->
    <!-- ======================== -->
    <!-- Comtrol Bordes  -->
    <Style x:Key="styleCrtBrdBuscarTiles" TargetType="Border">
        <Setter Property="Control.Margin" Value="0,1,0,0" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.BorderBrush" Value="#FF959393" />
        <Setter Property="Control.Background" Value="White" />
    </Style>
    <!-- Imagen de Menu Contextual en Botones -->
    <Style x:Key="styleImagBuscarTiles" TargetType="Image">
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Width" Value="24" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="Control.Margin" Value="4,6,0,0" />
    </Style>
    <!-- Campos de Captura texto -->
    <Style x:Key="styleTextBuscarTiles" TargetType="TextBox">
        <Setter Property="Control.Height" Value="24" />
        <Setter Property="Control.Width" Value="180" />
        <Setter Property="Control.FontSize" Value="14" />
        <Setter Property="Control.Margin" Value="34,4,0,0" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- =================================== -->
    <!-- DATAGRID Control                    -->
    <!-- =================================== -->
    <!-- Estilo Fila diferenciadas -->
    <Style x:Key="styleDataGridFila" TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="0" >
                <Setter Property="Background" Value="White"  />
            </Trigger>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="Azure" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ======================================== -->
    <!-- TextBox y TextBlock para Formularios Resize-->
    <!-- ======================================== -->
    <!-- Titulo o Etiquetas de campos -->
    <Style x:Key="styleEtiquetasFormResize" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Campos de Captura de datos -->
    <Style x:Key="styleTextBoxFormResize" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={
                        x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.FontWeight" Value="Bold" />
                <Setter Property="Control.Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Campos de Captura de datos Desactivos-->
    <Style x:Key="styleTextBoxFormResizeDisable" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="Control.BorderBrush" Value="#FFA9AAAA" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={
                        x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.FontWeight" Value="Bold" />
                <Setter Property="Control.Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Grid Contenedor de objetos -->
    <Style x:Key="styleGridFormResize" TargetType="Grid">
    </Style>
    <!-- Control Grid Fecha -->
    <Style  x:Key="styleDatePickerGridFormResize" TargetType="Grid">
        <Setter Property="Height" Value="23" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- ComboBox Form Resize -->
    <Style x:Key="styleComboBoxFormResize" TargetType="ComboBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- ======================================== -->
    <!-- OBJETOS VISTA PROPIEDADES IZQUIERDA	  -->
    <!-- ======================================== -->
    <!-- Texto Titulo Ventana Propiedades -->
    <Style x:Key="styleEtiquetasVistaPropTitulo" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="24" />
        <Setter Property="Control.Foreground" Value="#FF435191" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Height" Value="Auto" />
        <Setter Property="Control.Margin" Value="114,14,0,0" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Texto Titulo del grupo propidades -->
    <Style x:Key="styleTextBoxVistaPropGrupo" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="20" />
        <Setter Property="Control.Height" Value="32" />
        <Setter Property="Control.Width" Value="Auto" />
        <Setter Property="Control.Focusable" Value="False" />
        <Setter Property="Control.Margin" Value="4,0,2,0" />
        <Setter Property="Control.VerticalAlignment" Value="Center" />
        <Setter Property="Control.Foreground" Value="White" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value="Transparent" />
        <Setter Property="Control.BorderBrush" Value="AliceBlue" />
