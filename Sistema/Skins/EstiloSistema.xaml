<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dg="http://schemas.microsoft.com/wpf/2008/toolkit"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--=======================================================-->
    <!-- ESTILO FORMULARIOS MENU PRINCIPAL DEL SISTEMA -->
    <!--=======================================================-->
    <!-- Titulo barra titulo Menu principal del Sistema -->
    <Style x:Key="styleTituloMenuForm" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="26" />
        <Setter Property="Control.Height" Value="39" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.Margin"  Value="100,56,30,0" />
    </Style>
    <!-- Titulo Grupos de Tiles Menu principal del Sistema -->
    <Style x:Key="styleTituloGrupoTiles" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="16" />
        <Setter Property="Control.Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Margin"  Value="0,0,0,0" />
    </Style>
    <!--=======================================================-->
    <!-- ESTILO VARIOS -->
    <!--=======================================================-->
    <Color x:Key="detailMark">White</Color>
    <SolidColorBrush x:Key="detailMarkBrush" Color="{StaticResource ResourceKey=detailMark}" />
    <!--=======================================================-->
    <!-- ESTILO FORMULARIOS DE CAPTURAS -->
    <!--=======================================================-->
    <!-- Titulo barra titulo Formulario -->
    <Style x:Key="styleTituloForm" TargetType="TextBlock">
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="20" />
        <Setter Property="Control.Height" Value="28" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.Margin"  Value="70,8,30,0" />
        <Setter Property="Control.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        <Setter Property="Control.OpacityMask" Value="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" />
    </Style>
    <!-- Boton Cerra Formulario (en Barra de Titulo) -->
    <Style x:Key="styleImgButtonCerrarForm" TargetType="Image">
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Right" />
        <Setter Property="Control.Margin"  Value="0,0,4,0" />
        <Setter Property="Control.Height" Value="35" />
        <Setter Property="Control.Width" Value="40" />
        <Setter Property="Stretch" Value="Fill" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Control.Background" Value="#FFDDEEB9" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Boton Cerra Formulario (en Barra de Titulo) -->
    <Style x:Key="styleImgButtonCerrarFormMenu" TargetType="Image">
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Right" />
        <Setter Property="Control.Margin"  Value="0,6,16,0" />
        <Setter Property="Control.Height" Value="38" />
        <Setter Property="Control.Width" Value="38" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Opacity" Value="0.82" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Fondo del Formulario -->
    <Style x:Key="styleBorderFondoForm" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        <Setter Property="Control.BorderBrush" Value="#FF6B7D87" />
    </Style>
    <!-- Titulo o Etiquetas de campos -->
    <Style x:Key="styleEtiquetasForm" TargetType="TextBlock">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="17" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- ComboBox -->
    <Style x:Key="styleComboBoxForm" TargetType="ComboBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Campos de Captura de datos con validacion Error -->
    <Style x:Key="styleTextBoxForm" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Margin" Value="1" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={
                        x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.FontWeight" Value="Bold" />
                <Setter Property="Control.Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Campos de vista de datos deshabilitados sin bordes -->
    <Style x:Key="styleTextBoxFormDisableNoBorder" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="20" />
        <Setter Property="Control.Margin" Value="1" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Control.Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Control.IsEnabled" Value="False">
                <Setter Property="Control.Background" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="Red"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ==================== -->
    <!-- Controles de Fechas  -->
    <!-- ==================== -->
    <!-- Control Grid  -->
    <Style  x:Key="styleDatePickerGrid" TargetType="Grid">
        <Setter Property="Height" Value="23" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Comtrol Bordes  -->
    <Style  x:Key="styleDatePickerBorder" TargetType="Border">
        <Setter Property="Control.Margin" Value="0,1,0,0" />
        <Setter Property="Control.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
    </Style>
    <!-- Comtrol DatePiker Fechas  -->
    <Style  x:Key="styleDatePickerForm" TargetType="DatePicker">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Text" Value="" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectedDateFormat" Value="Short" />
    </Style>
    <!-- Campos de Captura Fecha con validacion Error -->
    <Style x:Key="styleTextBoxFormFecha" TargetType="TextBox">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.Height" Value="18" />
        <Setter Property="Control.Margin" Value="2,3,25,0" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.BorderBrush" Value="#FF34C4EE" />
        <Setter Property="Control.Background" Value="{StaticResource ResourceKey=detailMarkBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={
                        x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.FontWeight" Value="Bold" />
                <Setter Property="Control.Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ======================================== -->
    <!-- Estilo de Botones Formularios            -->
    <!-- ======================================== -->
    <!-- Estilo de Botones general -->
    <Style x:Key="styleButtonForm"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="13" />
        <Setter Property="Control.Height" Value="30" />
        <Setter Property="Control.Width" Value="90" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.BorderBrush" Value="#FF082708" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Control.Background" Value="#FFDDEEB9" />
            </Trigger>
            <Trigger Property="Control.IsFocused" Value="True">
                <Setter Property="Control.Background" Value="Azure" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Estilo de Botones Pequeños -->
    <Style x:Key="styleButtonMiniForm"  TargetType="Button">
        <Setter Property="Control.FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="Control.FontSize" Value="11" />
        <Setter Property="Control.Height" Value="24" />
        <Setter Property="Control.Width" Value="70" />
        <Setter Property="Control.Background" Value="White" />
        <Setter Property="Control.BorderBrush" Value="#FF082708" />
        <Setter Property="Control.VerticalAlignment" Value="Top" />
        <Setter Property="Control.HorizontalAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" 
                                CornerRadius="0"
                                BorderThickness="1"
                                BorderBrush="Black" >
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFF" Offset="0.0"/>
                                <GradientStop Color="#CCC" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="OpacityMask" Value="#E503473B"/>
                            <Setter Property="Margin" Value="2 1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderThickness" Value="0"/>
                            <!--<Setter Property="Background" Value="DimGray"/>-->
                            <Setter TargetName="Border" Property="Background" >
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientBrush.GradientStops>
                                            <GradientStopCollection>
                                                <GradientStop Color="#FFD7D7D8" Offset="0.674"/>
                                                <GradientStop Color="#FFE6E7E8" Offset="0.326"/>
                                                <GradientStop Color="#FFB9B9B9" Offset="0.983"/>
                                                <GradientStop Color="LightGray" Offset="0.004"/>
                                                <GradientStop Color="#FFE2E4E6" Offset="0.502"/>
                                            </GradientStopCollection>
                                        </GradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientBrush.GradientStops>
                                            <GradientStopCollection>
                                                <GradientStop Color="#FFF" Offset="0.0"/>
                                            </GradientStopCollection>
                                        </GradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
