<Window x:Class="CitasMedicas.Vista.VistaFiltroturnos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF4" 
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="810" 
        Height="659"
        Title="Filtrar turnos..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary 
                  Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="26*" />
            <RowDefinition Height="143*" />
            <RowDefinition Height="422*" />
            <RowDefinition Height="58*" />
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Left" 
    		Height="42" 
    		Margin="8,43,0,0" 
    		Grid.Row="1" 
    		VerticalAlignment="Top" 
    		Width="589" 
    		OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
    		Fill="#FFF6F8F9"/>
        <Border 
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Left" 
                Width="810" 
                Grid.RowSpan="3"
                Grid.Row="1">
            <DataGrid Name="grdDataGrid" 
                      AutoGenerateColumns="False" 
                      Height="409" 
                      HorizontalAlignment="Left" 
                      Width="790"
                      Margin="9,151,0,0" 
                      VerticalAlignment="Top"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="26">
                        <DataGridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate x:Name="chkMarca">
                                <CheckBox Click="fcvSelectCheckBox" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridCheckBoxColumn.HeaderTemplate>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding cit_codtur_turn}" 
                                        Header="Turno" 
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding sia_codpfa_prof}" 
                                        Header="Codigo"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding sia_nompro_prof}" 
                                        Header="Profesional"
                                        Width="250"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding cit_destur_turn}" 
                                        Header="Descripcion turno"
                                        Width="300"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Image HorizontalAlignment="Left"
           Height="40"
           Width="810"
           Margin="0,0,0,0"
           VerticalAlignment="Top"
           Grid.Row="1"
           Source="/Sistema;component/Imagenes/sys_barratitulo.png"
           StretchDirection="UpOnly"
           Stretch="Fill"
           MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image  Name="btnCerrar"
                MouseDown="btnCerrar_Click"
                Style="{StaticResource styleImgButtonCerrarForm}"
                Source="/Sistema;component/Imagenes/sis_cerrar40.png"
                Grid.Row="1"
                Cursor="Hand"/>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Buscar Turnos..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <TextBlock Name="lblG1cit_fecitr_turn"
                	Width="115"
                	Margin="25,52,0,0"
                	Grid.Row="1"
                	Style="{StaticResource styleEtiquetasForm}">
                	<Run Language="es-co" Text="Fecha Inicio"/>
        </TextBlock>
        <Grid Margin="145,50,0,0"
                      Width="144"
                      Grid.Row="1"
                      Style="{StaticResource styleDatePickerGrid}">
            <Border Style="{StaticResource styleDatePickerBorder}"/>
            <TextBox Name="txtG1Cit_fecitr_turn"
                             TabIndex="1"
                             Style="{StaticResource styleTextBoxFormFecha}"
                             TextChanged="fcvActualizarDatePicker"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <DatePicker Name="dpkG1Cit_fecitr_turn"
                            Style="{StaticResource styleDatePickerForm}"/>
        </Grid>
        <TextBlock Name="lblG1cit_fecftr_turn"
                	Width="88"
                	Margin="304,52,0,0"
                	Grid.Row="1"
                	Style="{StaticResource styleEtiquetasForm}" Height="16">
                	<Run Language="es-co" Text="Fecha Finaliza"/>
        </TextBlock>
        <Grid Margin="397,50,0,0"
                      Width="144"
                      Grid.Row="1"
                      Style="{StaticResource styleDatePickerGrid}">
            <Border Style="{StaticResource styleDatePickerBorder}"/>
            <TextBox Name="txtG1Cit_fecftr_turn"
                             TabIndex="2"
                             Style="{StaticResource styleTextBoxFormFecha}"
                             TextChanged="fcvActualizarDatePicker"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            <DatePicker Name="dpkG1Cit_fecftr_turn"
                            Style="{StaticResource styleDatePickerForm}"/>
        </Grid>
        <TextBlock x:Name="textProfesional"
                   Height="20" 
                   Grid.Row="1"
                   Margin="27,83,0,0"
                   Style="{StaticResource styleEtiquetasForm}"
                   Width="113">
            <Run Language="es-co" Text="Profesional"/></TextBlock>
        <TextBox x:Name="txtProfesional"
                 Height="24"
                 Grid.Row="1"
                 HorizontalAlignment="Left"
                 Margin="145,78,0,0"
                 VerticalAlignment="Top"
                 Style="{StaticResource styleTextBoxForm}"
                 Width="396" 
                 KeyDown="fcvMoverFocus_KeyDown" 
                 TabIndex="3" 
                 TextChanged="fcvFiltroTextChanged"/>
        <TextBlock x:Name="textTurno"
                   Height="20" 
                   Grid.Row="1"
                   Margin="27,109,0,0"
                   Style="{StaticResource styleEtiquetasForm}"
                   Width="113">
            <Run Language="es-co" Text="Descripcion turno"/></TextBlock>
        <TextBox x:Name="txtTurnos"
                 Height="24"
                 Grid.Row="1"
                 HorizontalAlignment="Left"
                 Margin="145,106,0,0"
                 VerticalAlignment="Top"
                 Style="{StaticResource styleTextBoxForm}"
                 Width="396" 
                 KeyDown="fcvMoverFocus_KeyDown" 
                 TabIndex="4" 
                 TextChanged="fcvFiltroTextChanged"/>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               VerticalAlignment="Top" 
               Width="810" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="3" 
               StretchDirection="UpOnly" 
               Stretch="Fill" Margin="0,8,0,0"/>
        <Button
        	Style="{StaticResource styleButtonForm}"
            Height="32" 
        	HorizontalAlignment="Left"
        	Margin="657,18,0,0"
        	x:Name="cmdCancelar"
        	VerticalAlignment="Top"
        	Width="89"
        	Visibility="Visible"
        	RenderTransformOrigin="0.831,12.346" 
            Grid.Row="3" 
            Click="cmdCancelar_Click" 
            Cursor="Hand" TabIndex="5">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock x:Name="textCancelar" 
                           Text="Cancelar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Button 
            Style="{StaticResource styleButtonForm}"
            Height="32" 
            HorizontalAlignment="Left"
        	Margin="542,18,0,0"
        	x:Name="cmdAceptar"
        	VerticalAlignment="Top"
        	Width="89"
        	Visibility="Visible"
        	RenderTransformOrigin="0.831,12.346" 
            Grid.Row="3" 
            Click="cmdAceptar_Click" 
            Cursor="Hand" TabIndex="4">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgAceptar" 
                       Source="/Sistema;component/Imagenes/sis_edt_guardar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2"/>
                <TextBlock x:Name="textAceptar" 
                           Text="Aceptar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               Margin="8,3,0,0" 
               VerticalAlignment="Top" 
               Width="48" 
               Grid.RowSpan="2" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
    </Grid>
</Window>
