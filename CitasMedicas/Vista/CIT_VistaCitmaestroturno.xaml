						 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
						 TextChanged="fcvActualizarDatePicker"
						 KeyDown="fcvMoverFocus_KeyDown"
						 GotFocus="fcvTextBox_GotFocus"/>
                    <DatePicker Name="dpkG2Cit_feccit_mcit"
							IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
							Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
            </Grid>
            <!-- fila 3 columna 0 -->
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG2cit_proqrx_mcit"
						   Grid.Column="0"
						   Style="{StaticResource styleEtiquetasFormResize}">
					  <Run Language="es-co" Text="Cita Quirúrgica"/>
                </TextBlock>
                <TextBox Name="txtG2Cit_proqrx_mcit"
						 TabIndex="20"
						 Text="{Binding Path=G2Cit_proqrx_mcit, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 Style="{StaticResource styleTextBoxFormResize}"
						 TextChanged="ActualizarComboBoxOpcion"
						 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
						 KeyDown="fcvMoverFocus_KeyDown"
						 Grid.Column="1"
						 GotFocus="fcvTextBox_GotFocus"/>
                <ComboBox Name="cboG2Cit_proqrx_mcit"
						 Grid.Column="2"
						 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
						 Style="{StaticResource styleComboBoxFormResize}"
						 SelectedIndex="0"
						 SelectionChanged="SeleccionComboBoxOpcion"
						 ItemsSource="{Binding Path=G2CbCit_proqrx_mcit}"
						 DisplayMemberPath="{Binding Path=NombreOpcion}"
						 SelectedValuePath="{Binding Path=ValorSeleccion}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <!-- fila 1 columna 1 -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG2cit_caucan_ccan"
						   Grid.Column="0"
						   Style="{StaticResource styleEtiquetasFormResize}">
					  <Run Language="es-co" Text="Causa Cancelación cita"/>
                </TextBlock>
                <TextBox Name="txtG2Cit_caucan_ccan"
						 TabIndex="21"
						 Text="{Binding Path=G2Cit_caucan_ccan, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 Style="{StaticResource styleTextBoxFormResize}"
						 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
						 KeyDown="txtG2Cit_caucan_ccan_KeyDown"
						 Grid.Column="1"
						 GotFocus="fcvTextBox_GotFocus"/>
                <TextBox Name="txtG2Cit_descan_ccan"
						 TabIndex="121"
						 Text="{Binding Path=G2Cit_descan_ccan, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 Style="{StaticResource styleTextBoxFormResizeDisable}"
						 IsEnabled="False"
						 KeyDown="fcvMoverFocus_KeyDown"
						 Grid.Column="2"
						 GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <!-- fila 2 columna 1 -->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG2cit_estcit_easi"
						   Grid.Column="0"
						   Style="{StaticResource styleEtiquetasFormResize}">
					 <Run Language="es-co" Text="Estado de la Cita"/>
                </TextBlock>
                <TextBox Name="txtG2Cit_estcit_easi"
						 TabIndex="22"
						 Text="{Binding Path=G2Cit_estcit_easi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 Style="{StaticResource styleTextBoxFormResize}"
						 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
						 KeyDown="txtG2Cit_estcit_easi_KeyDown"
						 Grid.Column="1"
						 GotFocus="fcvTextBox_GotFocus"/>
                <TextBox Name="txtG2Cit_descit_easi"
						 TabIndex="122"
						 Text="{Binding Path=G2Cit_descit_easi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
						 Style="{StaticResource styleTextBoxFormResizeDisable}"
						 IsEnabled="False"
						 KeyDown="fcvMoverFocus_KeyDown"
						 Grid.Column="2"
						 GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <!--ZONA DE TRABAJO 3-->
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="311"
               Width="897"
               Grid.Row="4"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0" Grid.RowSpan="2"/>
        <Grid Grid.Row="4" Margin="10,0,10,0">
             <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Button Name="cmdGenTurnos"
						Content="Generar Turnos"
						Style="{StaticResource styleButtonMiniFormBrows}"
						TabIndex="82"
						Command="{Binding CmdGENTRN}"
						Grid.Column="1"
						ToolTip="Generar turnos"/>
                <Button Name="cmdAddAux"
						Content="Guardar"
						Style="{StaticResource styleButtonMiniFormBrows}"
						TabIndex="23"
						Command="{Binding CmdSAVREL}"
						Click="fcvGuardarRegistroRel"
						Grid.Column="3"
						ToolTip="Adicionar registro en la Grid"/>
                <Button Name="cmdCanAux"
						Content="Nuevo"
						Style="{StaticResource styleButtonMiniFormBrows}"
						TabIndex="80"
						Command="{Binding CmdCANREL}"
						Click="fcvNuevoRegistroRel"
						Grid.Column="4"
						ToolTip="Nuevo o deshacer cambios en registro modificado"/>
                <Button Name="cmdDelAux"
						Content="Eliminar"
						Style="{StaticResource styleButtonMiniFormBrows}"
						TabIndex="81"
						Command="{Binding CmdDELREL}"
						Click="fcvEliminarRegistroRel"
						Grid.Column="5"
						ToolTip="Eliminar registro activo de la lista"/>
            </Grid>
            <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="0,0,0,0"
                  Name="objDataGrid"
                  ItemsSource="{Binding TmpG2ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  Height="260"
                  Width="878"
                  TabIndex="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Cit_descit_easi}"
                                    Header="Estado"
                                    Width="120"
                                    IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="LIBRE">
                                        <Setter Property="Background" Value="LightPink"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="ASIGNADA">
                                        <Setter Property="Background" Value="Aquamarine"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="CONFIRMADA O CUMPLIDA">
                                        <Setter Property="Background" Value="Bisque"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="ATENCION RECIBIDA">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="CANCELADA">
                                        <Setter Property="Background" Value="Red"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="NO DISPONIBLE">
                                        <Setter Property="Background" Value="Gray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Cit_ordvis_mcit}"
                                    Header="Registro"
                                    Width="70"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Cit_feccit_mcit, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="Fecha"
                                    Width="90"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Cit_horini_mcit}"
                                    Header="Hora Inicia"
                                    Width="80"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Cit_horfni_mcit}"
                                    Header="Hora Finaliza"
                                    Width="80"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Cit_mindur_turn}"
                                    Header="Minutos Cita"
                                    Width="90"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_codesp_esme}"
                                    Header="Codigo"
                                    Width="90"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_desesp_esme}"
                                    Header="Especialidad"
                                    Width="240"
                                    IsReadOnly="True" />
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=objDataGrid}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
        </Grid>
        <Button Name="cmdConfirmar"
                Margin="300,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="26"
                Command="{Binding CmdCON}"
                Click="fcvConfirmarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui Confirmar el registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgConfirmar"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblConfirmar"
                               Text="Confirmar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdGuardar"
                Margin="300,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="26"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="300,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="27"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="403,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="28"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="403,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="29"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEdicion"
                Margin="506,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="30"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="5"
                ToolTip="Clic para Cambiar estado del registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEdicion"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEdicion"
                               Text="Edición"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opCON"
                                          Command="{Binding CmdCON}"
                                          Click="fcvConfirmarRegistro"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Confirmar">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opANU"
                                          Command="{Binding CmdANU}"
                                          Click="fcvAnularRegistro"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Anular">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opDEL"
                                          Command="{Binding CmdDEL}"
                                          Click="fcvConfirmarRegistro"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Eliminar">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Name="cmdSalir"
                Margin="780,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="31"
                Command="{Binding CmdDFL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdBrowser"
                Margin="137,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="25"
                Command="{Binding CmdDFL}"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="5"
                ToolTip="Haga clic aqui para buscar un registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                           Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                               Text="Buscar..."
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opTodos"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Todos...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_buscar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opAbierto"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Abiertos...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_abrir.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opCerrado"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Cerrados...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opAnulado"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Anulados...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Name="cmdConfiguracion"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="27"
                Width="110"
                Command="{Binding CmdDFL}"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="5"
                ToolTip="Clic para ajustes">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgConfiguracion"
                           Source="/Sistema;component/Imagenes/sis_edt_configurar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblConfiguracion"
                               Text="Configuración"
                               Width="80"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opMODEDT"
                                          Command="{Binding CmdMODEDT}"
                                          Click="fcvConfigModoGuardar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Modo Edición: Guardar Registro (por defecto)">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_modificar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opMODCON"
                                          Command="{Binding CmdMODCON}"
                                          Click="fcvConfigModoConfirmar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Modo Edición: Confirmar Registro">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</Window>