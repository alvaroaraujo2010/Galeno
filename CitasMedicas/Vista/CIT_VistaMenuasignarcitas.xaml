<Window x:Class="CitasMedicas.Vista.VistaMenuasignarcitas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CitasMedicas.Vista" 
        Title="Confirmar Citas" 
        Height="750" 
        Width="1024"  
        Name="MaxCITMenuASigCitas"
        WindowState="Maximized"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        KeyUp="MenuComponentes_KeyUp" 
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="35" />
            <RowDefinition Height="90*" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="1"
                Grid.Row="0"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown"/>
        <Border Margin="0,0,0,0"
                Grid.Row="1"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown" 
                Background="#FFF1F0F0">
        </Border>
        <local:crtBuscar
                HorizontalAlignment="Left"
                Height="30" 
                Width="220"
                Grid.Row="1"
                Margin="20,1,0,0" Loaded="crtBuscar_Loaded"/>
        <Image HorizontalAlignment="Right" 
               VerticalAlignment="Top"
               Margin="0,83,10,0" 
               Height="47"
               RenderTransformOrigin="1.432,0.938"
               Source="/Sistema;component/Imagenes/sys_cit01.png" 
               Width="58" 
               Grid.RowSpan="2" />
        <TextBlock Name="txtnick" 
                   Text="Nick" 
                   FontFamily="Segoe UI Light" 
                   FontSize="12"
                   TextAlignment="Right"
                   HorizontalAlignment="Right" 
                   Margin="0,10,72,8" 
                   Width="160" 
                   Grid.Row="1" />
        <!-- Logo del Sistema -->
        <Image Name="ImgPpal" 
               Grid.Row="0" 
               Height="76" 
               Width="95"
               Stretch="Fill"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Margin="17,17,0,0"
               Source="/Sistema;component/Imagenes/sys_cit05.png" />
        <!-- Titulo del Sistema -->
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Stretch" 
        	VerticalAlignment="Top"
        	Margin="117,56,270,0" 
        	FontSize="26"  
        	FontFamily="Segoe UI Light" Height="35">
            <Run Text="Asignar Citas"/>
            <Run Language="es-co"/><Run Text=" "/>
            <LineBreak/>
            <Run Language="es-co"/></TextBlock>
        <!-- Boton Minimizar -->
        <Image x:Name="MinimizeButton" 
               MouseDown="MinimizeButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="MinimizeButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_minimizar.png"
               Margin="0,6,58,0" />
        <!-- Boton Cerrar -->
        <Image MouseDown="CloseButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="CloseButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="2"
               Margin="0,0,0,-40" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,10,10"
               Grid.Row="2"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="2"
                   FontFamily="Segoe UI Light" 
                   FontSize="16"
                   Foreground="AntiqueWhite"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="20,0,0,20" Width="402"/>
        <!-- Zona de los Tiles -->
        <Canvas x:Name="MainCanvas" 
                Grid.Row="2"
                Margin="0,0,0,0"
                ClipToBounds="True" 
                Background="#00000000" 
                PreviewTouchDown="fcvMainCanvas_PreviewTouchDown"
                PreviewTouchUp="fcvMainCanvas_PreviewTouchUp"
                PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp" >
            <!-- Barra que sale en la Zona inferior -->
            <StackPanel Width="Auto"
                        Height="600" 
                        Canvas.Left="45" 
                        Canvas.Top="11" 
                        x:Name="MetroStackPanel" 
                        Orientation="Horizontal" 
                        Background="#00000000" 
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
        </Canvas>
        <Canvas x:Name="ExtrasCanvas" 
                VerticalAlignment="Bottom" 
                Height="30" 
                Background="#00000000" 
                Margin="0,0,-1,0"  
                TouchEnter="fcvActivarVistaMenuBottomTouchEnter"
                MouseEnter="fcvActivarVistaMenuBottomMouseEnter"
                Grid.Row="2">
            <Grid x:Name="GridMenuBottom" 
                  Height="80" 
                  Canvas.Top="40" 
                  Width="1024">
                <Image x:Name="Capa" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0" 
                       Source="/Sistema;component/Imagenes/sys_panel_fondo3.png"
                       Stretch="Fill"/>
                <Image x:Name="imgFiltro" 
                       MouseDown="fcvFiltroBuscar" 
                       Width ="60" 
                       Height="60" 
                       Margin="300,10,13,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Cursor="Hand" 
                       Stretch="UniformToFill"
                       TouchDown="fcvFiltroBuscar_TouchDown"
                       ToolTip="Filtro general"
                       Source="/Sistema;component/Imagenes/sys_varios_calendario.png" />
                <Image x:Name="imgTurno" 
                       MouseDown="fcvBrowserBuscar" 
                       Width ="60" 
                       Height="60" 
                       Margin="380,10,0,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Stretch="UniformToFill"
                       Cursor="Hand" 
                       TouchDown="fcvBrowserBuscar_TouchDown"
                       ToolTip="Filtro por turno"
                       Source="/Sistema;component/Imagenes/sys_varios_citas.png"/>
                <Image x:Name="imgGrupos" 
                       Width ="60" 
                       Height="60" 
                       Margin="460,10,0,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Stretch="UniformToFill"
                       Cursor="Hand" 
                       MouseDown="fcvBrowserHistorialUsuario" 
                       TouchDown="fcvBrowseHistorialUsuario_TouchDown"
                       ToolTip="Filtro por turno"
                       Source="/Sistema;component/Imagenes/sys_varios_buscarregistro.png"/>
                <Image x:Name="imgImprimir" 
                       Width ="60" 
                       Height="60" 
                       Margin="539,10,0,0" 
                       MouseDown="fcvImprimir" 
                       TouchDown="fcvImprimir_TouchDown"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Stretch="UniformToFill"
                       Cursor="Hand" 
                       ToolTip="Imprimir lista de agenda activa en pantalla"
                       Source="/Sistema;component/Imagenes/sys_varios_imprimir.png"/>
            </Grid>
        </Canvas>
    </Grid>
</Window>
