                         Text="{Binding GcrSIS_FormModoActualizado}"
                         Style="{StaticResource styleTextBoxForm}"
                         IsEnabled="False"
                         Grid.Row="0"/>
        <TextBlock x:Name="lblG1sia_edapac_usua"
                                       Width="139"
                                       Margin="4,88,0,0"
                                       Visibility="Collapsed"
                                       ToolTip="Edad Paciente al Momento de Admisión"
                                       Style="{StaticResource styleEtiquetasForm}" Grid.Column="1"><Run Language="es-co" Text="Edad Paciente"/></TextBlock>
        <TextBox x:Name="txtG1Sia_edapac_usua"
                                     Width="333"
                                     Margin="148,85,0,0"
                                     TabIndex="15"
                                     Visibility="Collapsed"
                                     Text="{Binding G1Sia_edapac_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Style="{StaticResource styleTextBoxForm}"
                                     IsEnabled="False"
                                     KeyDown="fcvMoverFocus_KeyDown"
                                     GotFocus="fcvTextBox_GotFocus" Grid.Column="1"/>
        <Button x:Name="cmdGuardar"
                Margin="300,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="47"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="3"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button x:Name="cmdAdicionar"
                Margin="300,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="48"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="3"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button x:Name="cmdCancelar"
                Margin="403,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="49"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="3"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button x:Name="cmdModificar"
                Margin="403,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="50"
                Command="{Binding CmdEDTAUX}"
                Click="fcvModificarRegistro"
                Grid.Row="3"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEdicion"
                Margin="506,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="53"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="5"
                ToolTip="Clic para Cambiar estado del registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEdicion"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEdicion"
                               Text="Procesos"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opCON"
                              Command="{Binding CmdCNF}"
                              Click="fcvConfirmarRegistro"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Confirmar registro de atención">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opANU"
                              Command="{Binding CmdANU}"
                              Click="fcvAnularRegistro"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Anular registro de atención confirmado">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="Transparent" BorderBrush="Black"/>
                    <MenuItem x:Name="opUSModificar"
								Click="fcvBrowsUsuarios"
                               Command="{Binding CmdEDTUSU}"
								Style="{StaticResource styleMenuItemContextButton}"
								Header="Modificar datos usuario o paciente...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
								   Style="{StaticResource styleImagMenuContextButton}"
								   Source="/Sistema;component/Imagenes/sys_usu01.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="Transparent" BorderBrush="Black"/>
                    <MenuItem Name="opDEL"
                              Command="{Binding CmdDEL}"
                              Click="fcvEliminarRegistro"
                              Style="{StaticResource styleMenuItemContextButton}"
                              Header="Eliminar registro de atención no confirmado ">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                   Style="{StaticResource styleImagMenuContextButton}"
                                   Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button x:Name="cmdSalir"
                Margin="780,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="52"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="3"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button x:Name="cmdBrowser"
                Margin="137,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="49"
                Visibility="Collapsed"
                Command="{Binding CmdDFL}"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="3"
                ToolTip="Haga clic aqui para buscar un registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                           Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                               Text="Buscar..."
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem x:Name="opTodos"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Todos los registros de admisión...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_buscar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="opAbierto"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Registros admisiones no confirmadas...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_abrir.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="opCerrado"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Registros admisiones confirmadas...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="opAnulado"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Registros admisiones anuladas...">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="Transparent" BorderBrush="Black" />
                    <MenuItem x:Name="opDatosUsuario"
                                          Click="fcvBrowserBuscar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Ver datos básicos usuario admitido">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sys_usu01.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="100"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        </Grid>
