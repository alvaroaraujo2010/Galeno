<Window x:Class="FacturacionMedica.Vista.VistaCuentaCobroSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:ignore="http://www.ignore.com"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d ignore"
        WindowStartupLocation="CenterScreen"
        Width="900" 
        Height="659"
        Title="Filtrar turnos..." 
        ResizeMode="NoResize"
        WindowStyle="None" 
        AllowsTransparency="True" 
		Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary 
                  Source= "/Sistema;component/Skins/EstiloSistema.xaml">
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="200" />
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Left" 
    		Height="42" 
    		Margin="8,43,0,0" 
    		Grid.Row="1" 
    		VerticalAlignment="Top" 
    		Width="589" 
    		OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
    		Fill="#FFF6F8F9"/>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" 
                BorderThickness="1" 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="Auto"
                Grid.Row="1"
                Grid.RowSpan="4">
        </Border>
        <Grid Grid.Row="1" Margin="12,45,12,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource styleBorderFondoForm}"
                        Grid.ColumnSpan="7"/>
                <TextBlock Name="lblG1cto_seccon_cont"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Contrato"/>
                </TextBlock>
                <TextBox Name="txtG1Cto_seccon_cont"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Focusable="False"
                         Grid.Column="1"/>
                <TextBox Name="txtG1Cto_nrocon_cont"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Grid.Column="2"
                         Focusable="False"/>
                <TextBlock Name="lblFiltroFechaInicio" 
                           Grid.Column="3"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Fecha inicio"/>
                </TextBlock>
                <TextBox Name="txtFiltroFechaInicio"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Grid.Column="4"
                         Focusable="False"/>
                <TextBlock Name="lblFiltroFechaFin" 
                           Grid.Column="5"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Fecha fin"/>
                </TextBlock>
                <TextBox Name="txtFiltroFechaFin"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Grid.Column="6"
                         Focusable="False"/>
            </Grid>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                    Grid.Row="2"
                    Grid.RowSpan="4"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblTipoActividad" Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                          <Run Language="es-co" Text="Tipo Actividad"/>
                </TextBlock>
                <TextBox Name="txtTipoActividad"
                         TabIndex="7"
                         Visibility="Collapsed"
                         Style="{StaticResource styleTextBoxFormResize}"
                         Grid.Column="0"/>
                <ComboBox Name="cboTipoActividad"
                          Grid.Column="1"
                          Style="{StaticResource styleComboBoxFormResize}"
                          SelectedIndex="0"
                          FontSize="14"
                          SelectionChanged="SeleccionComboBoxOpcion"
                          SelectedValuePath="ValorSeleccion" 
                          Height="23" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lbG1Sia_codeps_teps" Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Código EPS"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_codeps_teps"
                             TabIndex="5"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TextChanged="fcvValidacionTexto"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             KeyDown="txtG1Sia_codeps_teps_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdG1Sia_codeps_teps"
                            Content="..."
                            Style="{StaticResource styleButtonMiniFormBrows}"
                            TabIndex="103"
                            Click="cmdG1Sia_codeps_teps_Click"
                            Grid.Column="2"
                            ToolTip="Empresa o Eps aseguradora según codigos asignados por la supersalud"/>
                <TextBox Name="txtG1Sia_deseps_teps"
                             TabIndex="103"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="3"
                             Focusable="False"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1Sia_tipusu_regi" Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}">
                            <Run Language="es-co" Text="Regimen de salud"/>
                </TextBlock>
                <TextBox Name="txtG1Sia_tipusu_regi"
                             TabIndex="5"
                             Style="{StaticResource styleTextBoxFormResize}"
                             TextChanged="fcvValidacionTexto"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="1"
                             KeyDown="txtG1Sia_tipusu_regi_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdG1Sia_tipusu_regi"
                            Content="..."
                            Style="{StaticResource styleButtonMiniFormBrows}"
                            TabIndex="105"
                            Click="cmdG1Sia_tipusu_regi_Click"
                            Grid.Column="2"
                            ToolTip="Regimen: 1=Contributivo 2=Subsidiado 3... y otros(Resolución: 3374 RIPS)"/>
                <TextBox Name="txtG1Sia_destip_regi"
                             TabIndex="105"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             TouchEnter="fcvTouchEnterTeclado"
                             Grid.Column="3"
                             Focusable="False"
                             KeyDown="fcvMoverFocus_KeyDown"
                             GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtG1Fcm_descpr_cpro"
                                                 TabIndex="106"
                                                 Style="{StaticResource styleTextBoxFormResizeDisable}"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="3"
                                                 Focusable="False"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdG1Fcm_codcpr_cpro"
                        Content="..."
                        Style="{StaticResource styleButtonMiniFormBrows}"
                        TabIndex="106"
                        Click="cmdG1Fcm_codcpr_cpro_Click"
                        Grid.Column="2"
                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                        ToolTip="Codigo centro de produccion donde se presta el servicio"/>
                <TextBlock Name="lblG1fcm_codcpr_cpro"
                           ToolTip="Codigo centro de produccion donde se presta el servicio"
                           Grid.Column="0"
                           Style="{StaticResource styleEtiquetasFormResize}">
                         <Run Language="es-co" Text="Centro de producción"/>
                </TextBlock>
                <TextBox Name="txtG1Fcm_codcpr_cpro"
                         TabIndex="7"
                         Style="{StaticResource styleTextBoxFormResize}"
                         TextChanged="fcvValidacionTexto"
                         TouchEnter="fcvTouchEnterTeclado"
                         Grid.Column="1"
                         KeyDown="txtG1Fcm_codcpr_cpro_KeyDown"
                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <Border Style="{DynamicResource styleBorderFondoForm}"
                Margin="11,1,11,1"
                BorderThickness="0"
                Grid.Row="2" 
                Background="#FFECF0EF"/>
        <Grid Grid.Row="2" Margin="11,1,20,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="lblConFacturas" 
                           Grid.Column="2"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Facturas"/>
            </TextBlock>
            <TextBox Name="txtConFacturas"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Grid.Column="3"
                         Focusable="False"/>
            <TextBlock Name="lblValorFacturas" 
                           Grid.Column="4"
                           Style="{StaticResource styleEtiquetasFormResize}">
                      <Run Language="es-co" Text="Valor"/>
            </TextBlock>
            <TextBox Name="txtValorFacturas"
                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                         Grid.Column="5"
                         Focusable="False"/>
        </Grid>
        <DataGrid Name="grdDataGrid"
                  Grid.Row="3"
                  Margin="10,2,10,10"
                  AutoGenerateColumns="False" 
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch"
                  Height="Auto" 
                  Width="Auto"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="26"  Binding="{Binding MarcaBool, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.HeaderTemplate>
                        <DataTemplate x:Name="chkMarca">
                            <CheckBox Click="fcvSelectCheckBox" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridCheckBoxColumn.HeaderTemplate>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Binding="{Binding Sia_desate_rgat}" 
                                    Header="Tipo atención" 
                                    Width="110"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Adm_secadm_rgad}" 
                                    Header="Admisión" 
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Fcm_numfac_mfac}" 
                                        Header="Factura"
                                        Width="100"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_nroide_usua}" 
                                        Header="Id Usuario"
                                        Width="110"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_nomusu_usua}" 
                                        Header="Usuario"
                                        Width="250"
                                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Fcm_fecfac_mfac, StringFormat={}{0:dd/MM/yyyy}}" 
                                    Header="Fecha"
                                    Width="90"
                                   IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Fcm_valfac_dfac, StringFormat={}{0:N0}}"
			                        Header="Valor"
			                        Width="110"
			                        IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sia_codeps_teps}" 
                                        Header="EPS"
                                        Width="90"
                                        IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Image HorizontalAlignment="Stretch"
               Height="40"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image  Name="btnCerrar"
                MouseDown="btnCerrar_KeyDown"
                Style="{StaticResource styleImgButtonCerrarForm}"
                Source="/Sistema;component/Imagenes/sis_cerrar40.png"
                Grid.Row="1"
                Cursor="Hand"/>
        <TextBlock Name="txtblockTitulo"
                   VerticalAlignment="Top"
                   Text="Seleccionar facturas..." 
                   Grid.Row="1" Margin="63,10,37,0" 
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Image HorizontalAlignment="Stretch" 
               VerticalAlignment="Stretch" 
               Source="/Sistema;component/Imagenes/sis_fondo40.png" 
               Grid.Row="4" 
               StretchDirection="UpOnly" 
               Stretch="Fill"/>
        <Button Name="cmdCancelar"
        	    Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    Margin="0,10,56,0"
        	    VerticalAlignment="Top"
        	    Width="89"
        	    Visibility="Visible"
                Grid.Row="4" 
                Click="cmdSalir_Click"
                ToolTip="Clic aquí para salir sin seleccionar"
                Cursor="Hand" TabIndex="5">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgCancelar" 
                       Source="/Sistema;component/Imagenes/sis_edt_cancelar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2" />
                <TextBlock x:Name="textCancelar" 
                           Text="Cancelar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAceptar"
                Style="{StaticResource styleButtonImgForm}"
                Height="32" 
                HorizontalAlignment="Right"
        	    VerticalAlignment="Top"
        	    Width="89"
        	    Visibility="Visible"
                Grid.Row="4" 
                Click="cmdAceptar_Click"
                ToolTip="Clic aquí para confirmar selección de turnos"
                Cursor="Hand" TabIndex="4" 
                Margin="0,10,166,0">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgAceptar" 
                       Source="/Sistema;component/Imagenes/sis_edt_aceptar.png" 
                       Width="24" 
                       Height="22" 
                       Stretch="UniformToFill" 
                       Margin="2"/>
                <TextBlock x:Name="textAceptar" 
                           Text="Aceptar" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="0" 
                           Width="56"/>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left" 
               Height="50" 
               Margin="6,6,0,0" 
               VerticalAlignment="Top" 
               Width="48" 
               Source="/Sistema;component/Imagenes/sis_logo40.png" 
               MouseLeftButtonDown="Window_MouseLeftButtonDown" Grid.RowSpan="2"/>
        <Button Name="cmdLogErrores"
                        Margin="10,10,0,0"
                        Style="{StaticResource styleButtonImgForm}"
                        TabIndex="19"
                        Click="fcvVistaLogErrores"
                        Grid.Row="5"
                        ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                               Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                                   Text="Errores"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdConsultar"
                Margin="200,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="9"
                Grid.Row="4"
                Click="cmdConsultar_Click"
                ToolTip="Consultar facturas pendientes para cargar en vista cuenta de cobro contrato" 
                Width="145">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource styleStackPanelBotonesForm}" Width="135">
                <Image Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="lblConsultar"
                           Text="Consultar facturas..."
            	           Style="{StaticResource styleLblBotonesForm}" Height="16" Width="103"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>

