                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Fcm_facini_srfa}"
                                    Header="Secuencial inicio"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Fcm_facfin_srfa}"
