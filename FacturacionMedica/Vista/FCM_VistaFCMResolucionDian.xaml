                </TextBlock>
                <TextBox Name="txtG1Fcm_ultgen_srfa"
                         TabIndex="8"
                         Text="{Binding Path=G1Fcm_ultgen_srfa, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
