<UserControl x:Class="FacturacionMedica.Vista.ControlVistaAutorizacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="72"
             Width="720"
             Loaded="fcvCargarDatos">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Name="brdFondo" 
                Background="#FFF1EEEE"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="1"
                BorderBrush="#FFD1CFCF"
                Grid.ColumnSpan="2"/>
        <Border Name="brdFondoFoto" 
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="1"
                BorderBrush="#FFD1CFCF"
                Grid.Column="0"/>
        <Image Name="imgFoto"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="65"
                   Height="66"
                   Source="/Sistema;component/Imagenes/sys_usu01.png"             
                   Margin="4,3,0,0"/>
        <Image Name="imgAbierto"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="25"
                   Height="25"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_abierto.png"             
                   Margin="4,42,0,0"/>
        <Image Name="imgAprobado"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="25"
                   Height="25"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_confirmado.png"             
                   Margin="4,42,0,0"/>
        <Image Name="imgAplicado"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="25"
                   Height="25"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_aplicado.png"             
                   Margin="4,42,0,0"/>
        <Image Name="imgNegado"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="25"
                   Height="25"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_anulado.png"             
                   Margin="4,42,0,0"/>
        <Grid Grid.Column="1"  Margin="2,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Name="brdFondo2" 
                        Background="White"
                        Visibility="Visible"
                        Margin="0,1,1,0"
                        BorderThickness="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                <TextBlock Name="lblIdUsuario"
                           Background="Transparent"
                           FontSize="18"
                           Margin="0,3,0,0"
                           Grid.Column="0" 
                           Foreground="#FF8D8C8C">
                       <Run Language="es-co" Text="ID"/>
                </TextBlock>
                <TextBox Name="txtSia_nroide_usua"
                         BorderThickness="0"
                         Grid.Column="1"
                         Margin="0,3,0,0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="18"
                         Text="0000000" 
                         Foreground="#FF27AEFB"/>
                <TextBox Name="txtSia_nomusu_usua"
                         BorderThickness="0"
                         Grid.Column="2"
                         Background="Transparent"
                         Focusable="False"
                         Margin="0,3,2,0"
                         FontSize="18"
                         Text="Nombre Usuario" 
                         Foreground="#FF27AEFB"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblFcm_valref_dfac"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="0">
                       <Run Language="es-co" Text="Valor Cobro"/>
                </TextBlock>
                <TextBox Name="txtFcm_valref_dfac"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Grid.Column="1" Height="22" VerticalAlignment="Top"/>
                <TextBlock Name="lblFcm_valdes_ades"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="2">
                       <Run Language="es-co" Text="Des.Solicitado"/>
                </TextBlock>
                <TextBox Name="txtFcm_valdes_ades"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Grid.Column="3"/>
                <TextBlock Name="lblFcm_valdes_adesv"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="4">
                       <Run Language="es-co" Text="Des.Autorizado"/>
                </TextBlock>
                <TextBox Name="txtFcm_valdes_dfac"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Grid.Column="5"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblFcm_horsol_ades"
                           Background="Transparent"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="0">
                       <Run Language="es-co" Text="Facturador:"/>
                </TextBlock>
                <TextBox Name="txtDes_ususol_usux"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="ADMIN"
                         Grid.Column="1" 
                         Foreground="#FF1582CD"/>
                <TextBlock Name="lblFcm_fecsol_ades"
                           Grid.Column="2"
                           Foreground="#FF8D8C8C"                           
                           FontSize="12">
                      <Run Language="es-co" Text="Fecha:"/>
                </TextBlock>
                <TextBox Name="txtFcm_fecsol_ades"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="00/00/0000"
                         Grid.Column="3" 
                         Foreground="#FF1582CD"/>
                <TextBlock Name="lblFcm_estaut_ades"
                           Grid.Column="4"
                           Background="Transparent"
                           Foreground="#FF8D8C8C"                           
                           FontSize="12">
                <Run Language="es-co" Text="Autorización:"/>
                </TextBlock>
                <TextBox Name="txtFcm_estaut_ades"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="ESTADO"
                         Grid.Column="5" 
                         Foreground="#FF1582CD"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
