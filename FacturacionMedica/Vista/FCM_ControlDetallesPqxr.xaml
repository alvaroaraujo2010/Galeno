<UserControl x:Class="FacturacionMedica.Vista.ControlDetallesPqxr"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="30" 
             d:DesignWidth="800"
             Height="Auto"
             Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Border Name="brdFondo1" 
                        Background="Transparent"
                        Visibility="Visible"
                        BorderThickness="1,0,1,1"
                        BorderBrush="#FFD1CFCF"
                        Grid.ColumnSpan="6"/>
            <Border Name="brdFondo2" 
                    Background="Transparent"
                    Visibility="Visible"
                    Grid.Column="1"
                    BorderThickness="1,0,1,0"
                    BorderBrush="#FFD1CFCF"/>
            <Border Name="brdFondo3" 
                    Background="Transparent"
                    Visibility="Visible"
                    Grid.Column="3"
                    BorderThickness="1,0,1,0"
                    BorderBrush="#FFD1CFCF"/>
            <Border Name="brdFondo4" 
                    Background="Transparent"
                    Visibility="Visible"
                    Grid.Column="4"
                    Margin="0,0,0,0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#FFD1CFCF"/>
            <TextBlock Name="txtCodigo" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="0"
        		       FontSize="12"
                       Margin="5,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtCodigoDigita" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
        		       FontSize="12"
                       Margin="5,5,3,5"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       Foreground="#FF615C5C"/>
            <TextBlock Name="txtDescripcion" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="1"
                       Grid.RowSpan="2"
        		       FontSize="12"
                       Margin="5,5,3,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Justify"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtCantidad" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="2"
        		       FontSize="12"
                       Margin="5,5,5,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Center"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtPuntaje" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="3"
        		       FontSize="12"
                       Margin="5,5,5,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Center"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
            <TextBlock Name="txtValor" 
        		       HorizontalAlignment="Stretch" 
        		       VerticalAlignment="Top"
                       Grid.Column="4"
        		       FontSize="12"
                       Margin="5,5,5,0"
                       Width="Auto"
        		       FontFamily="Segoe UI Symbol"
        		       TextAlignment="Center"
        		       Foreground="#FF615C5C"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
