<!-- MARMOTA-GENCODE: VERSION 2.0 - 29/11/2018 04:41:41 PM -->
<Window x:Class="Systemas.Vista.VistaSysusuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:ff="clr-namespace:Sistema.Utilidades;assembly=Sistema"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Path=VistaModeloSysusuarios, Source={StaticResource SYS_Locator}}"
        Title="Maestro de Usuarios del Sistema"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="1000"
        Height="697"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="46*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
        </Border>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Maestro de Usuarios del Sistema"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Button Name="cmdCerrar"
               Grid.Row="1"
               HorizontalAlignment="Right"
               Style="{StaticResource styleButtonImgEdtFormTouchExit}"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               TabIndex="150"
               Click="cmdSalir_Click"
               ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                    Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Margin="1,3,1,0"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="698"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
             Grid.Row="2"
             Margin="130,7,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Name="txtFiltroDatos"
             Width="280"
             Style="{StaticResource styleTextBoxForm}"
             Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3" Margin="8,2,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="165"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_codusu_usux"
                                           ToolTip="Código único del usuario generado por el sistema: ejm US001"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Código único sistema"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_codusu_usux"
                                         TabIndex="1"
                                         Text="{Binding Path=G1Sys_codusu_usux, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_ideusu_usux"
                                           ToolTip="ID que digita el usuario  para acceso al sistema ejm: calos4, juanb, MAN34,mile25"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="ID del  Usuario"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_ideusu_usux"
                                         TabIndex="2"
                                         Text="{Binding Path=G1Sys_ideusu_usux, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         MaxLength="20"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_nomusu_usux"
                                           ToolTip="Nombre Completo del  usuario"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Nombre Usuario"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_nomusu_usux"
                                         TabIndex="3"
                                         Text="{Binding Path=G1Sys_nomusu_usux, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         MaxLength="50"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock                                                            
                 Grid.Column="0"
                 Style="{StaticResource styleEtiquetasFormResize}">
                 <Run Language="es-co" Text="Digite la clave"/>
                </TextBlock>
                <PasswordBox x:Name="Clave"
                             HorizontalAlignment="Left"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                             ff:PasswordBoxAssistant.BindPassword="True"  
                             ff:PasswordBoxAssistant.BoundPassword="{Binding Path=lcrTmpClave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="4"
                             Grid.Column="1"
                             VerticalAlignment="Top"
                             Height="20"
                             Width="264"
                             KeyDown="fcvMoverFocus2_KeyDown"
                             GotFocus="fcvTextBox2_GotFocus" Margin="4,3,0,0"/>
            </Grid>
            <Grid Grid.Row="4" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
            	Style="{StaticResource styleEtiquetasFormResize}">
                 <Run Language="es-co" Text="Confirmar la clave"/>
                </TextBlock>
                <PasswordBox x:Name="ClaveConfirmar"
                             HorizontalAlignment="Left"
                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"                     
                             ff:PasswordBoxAssistant.BindPassword="True"  
                             ff:PasswordBoxAssistant.BoundPassword="{Binding Path=lcrTmpConfirmar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="5"                     
                             VerticalAlignment="Top"
                             Height="20"
                             Width="264"
                             Grid.Column="1"
                             KeyDown="fcvMoverFocus2_KeyDown"
                             GotFocus="fcvTextBox2_GotFocus" Margin="4,3,0,0"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtG1Sys_desper_perf"
                                         TabIndex="105"
                                         Text="{Binding Path=G1Sys_desper_perf, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="3"
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdG1Sys_codper_perf"
                                        Content="..."
                                        Style="{StaticResource styleButtonMiniFormBrows}"
                                        TabIndex="105"
                                        Click="cmdG1Sys_codper_perf_Click"
                                        Grid.Column="2"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        ToolTip="Código del perfil de usuario"/>
                <TextBlock Name="lblG1sys_codper_perf"
                                           ToolTip="Código del perfil de usuario"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Código del Perfil"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_codper_perf"
                                         TabIndex="5"
                                         Text="{Binding Path=G1Sys_codper_perf, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="txtG1Sys_codper_perf_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1sys_imagen_usux"
                                           ToolTip="Ruta nombre y extensión del archivo de imagen que representa al usuario (cuando este vacio se representa con imagen del perfil)"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Imagen usuario"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_imagen_usux"
                                         TabIndex="6"
                                         Text="{Binding Path=G1Sys_imagen_usux, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         MaxLength="150"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdFoto" 
                        Style="{StaticResource styleButtonImgForm}"                                       
                        VerticalAlignment="Top" 
                        Width="63" 
                        TabIndex="9"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Command=""
                        Click="fcvNuevoRegistro"
                        ToolTip="Haga clic aqui para crear un nuevo registro" Height="20" Margin="3,3,0,0">
                    <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}" Width="53">
                        <TextBlock x:Name="lblFoto"
                                   Text="Foto..."
            	                   Style="{StaticResource styleLblBotonesForm}" Width="48"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cboG1Sys_estusu_usux"
                            	Grid.Column="2"
                            	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                            	Style="{StaticResource styleComboBoxFormResize}"
                            	SelectedIndex="0"
                            	SelectionChanged="SeleccionComboBoxOpcion"
                            	ItemsSource="{Binding Path=G1CbSys_estusu_usux}"
                            	SelectedValuePath="ValorSeleccion">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1sys_estusu_usux"
                                           ToolTip="Estado del Usuario  1= Activo 2= Inactivo"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado Usuario"/>
                </TextBlock>
                <TextBox Name="txtG1Sys_estusu_usux"
                                         TabIndex="7"
                                         Text="{Binding Path=G1Sys_estusu_usux, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         TextChanged="ActualizarComboBoxOpcion"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource styleDatePickerBorder}" Margin="10,0"/>
                <Image Name="imgfotografia"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="140"
                   Height="129"
                   Source="/Sistema;component/Imagenes/sys_usu01.png" Margin="13,1,0,0"/>
            </Grid>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="10,10,10,10"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Sys_ideusu_usux}"
                                    Header="ID Usuario"
                                    Width="120"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sys_nomusu_usux}"
                                    Header="Nombre Usuario"
                                    Width="560"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Sys_desper_perf}"
                                    Header="Nombre Perfil"
                                    Width="170"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Sys_destusu_usux}"
                                    Header="Estado"
                                    Width="100"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="220,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="8"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="220,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="9"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="323,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="10"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="323,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="11"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="426,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="14"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
