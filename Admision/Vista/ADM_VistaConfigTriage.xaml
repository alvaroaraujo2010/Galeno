                    <DataGridTextColumn Binding="{Binding Adm_clasif_tria}"
                                        Header="Clasificación"
                                        Width="80"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Adm_titcla_adct}"
                                        Header="Titulo "
                                        Width="80"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Adm_descla_adct}"
                                        Header="Descripcion "
                                        Width="500"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Adm_tiempo_adct}"
                                        Header="Tiempos de atencion "
                                        Width="200"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
