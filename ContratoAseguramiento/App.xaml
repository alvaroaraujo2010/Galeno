<Application x:Class="ContratoAseguramiento.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContratoAseguramiento.VistaModelo"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             StartupUri=""
             mc:Ignorable="d">
    
    <Application.Resources>
        <!--Global View Model Locator-->
        <ResourceDictionary>
            <vm:LocalizadorVistaModelo x:Key="CTO_Locator" d:IsDataSource="True" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sistema;component/Skins/EstiloSistema.xaml" />
                <ResourceDictionary Source="/Sistema;component/Skins/EstiloSistemaTouch.xaml" />
                <ResourceDictionary Source="/Sistema;component/Skins/EditorReportesDiseño.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
