                                                       Style="{StaticResource styleEtiquetasVistaPropEtiqueta}">
                                                       <Run Language="es-co" Text="Selecionar Contrato"/>
                                            </TextBlock>
                                            <TextBox Name="txtG1Cto_seccon_cont"
                                                     TabIndex="28"
                                                     Text="{Binding Path=G1Cto_seccon_cont, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxVistaPropCaptura}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="1"
                                                     Visibility="Collapsed"
                                                     Focusable="False"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                            <TextBox Name="txtG1Cto_nrocon_cont"
                                                     TabIndex="29"
                                                     Text="{Binding Path=G1Cto_nrocon_cont, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxFormResize}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="1"
                                                     Focusable="False"
                                                     KeyDown="fcvMoverFocus_KeyDown"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                            <Button Name="cmdG1Cto_seccon_cont"
                                                    Content="..."
                                                    Style="{StaticResource styleButtonMiniFormBrows}"
                                                    TabIndex="128"
                                                    Click="cmdG1Cto_seccon_cont_Click"
                                                    Grid.Column="2"
                                                    ToolTip="Seleccionar Contrato"/>
                                            <TextBox Name="txtG1Cto_descon_cont"
                                                     TabIndex="128"
                                                     Text="{Binding Path=G1Cto_descon_cont, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxVistaPropCaptura}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="3"
                                                     Focusable="False"
                                                     KeyDown="fcvMoverFocus_KeyDown"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblG1sia_codeps_teps"
                                                       ToolTip="Eps o Asegurador según Listado EPS Ministerio Protección social"
                                                       Grid.Column="0"
                                                       Style="{StaticResource styleEtiquetasVistaPropEtiqueta}">
                                                       <Run Language="es-co" Text="EPS de Salud"/>
                                            </TextBlock>
                                            <TextBox Name="txtG1Sia_codeps_teps"
                                                     TabIndex="3"
                                                     Text="{Binding Path=G1Sia_codeps_teps, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxVistaPropCaptura}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="1"
                                                     Focusable="False"
                                                     KeyDown="txtG1Sia_codeps_teps_KeyDown"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                            <TextBox Name="txtG1Sia_deseps_teps"
                                                     TabIndex="103"
                                                     Text="{Binding Path=G1Sia_deseps_teps, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxVistaPropCaptura}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="2"
                                                     Focusable="False"
                                                     KeyDown="fcvMoverFocus_KeyDown"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                        </Grid>
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="0"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblG1RegistrosBdatos"
                                                       ToolTip="Accionones con registros existentes en base de datos"
                                                       Grid.Column="0"
                                                       Style="{StaticResource styleEtiquetasVistaPropEtiqueta}">
                                                       <Run Language="es-co" Text="Registros existentes"/>
                                            </TextBlock>
                                            <TextBox Name="txtRegistrosBdatos"
                                                     TabIndex="9"
                                                     Visibility="Collapsed"
                                                     Style="{StaticResource styleTextBoxVistaPropCaptura}"
                                                     TouchEnter="fcvTouchEnterTeclado"
                                                     Grid.Column="1"
                                                     TextChanged="ActualizarComboBoxOpcion"
                                                     IsEnabled="False"
                                                     KeyDown="fcvMoverFocus_KeyDown"
                                                     GotFocus="fcvTextBox_GotFocus"/>
                                            <ComboBox Name="cboRegistrosBdatos"
									                  Grid.Column="2"
									                  Style="{StaticResource styleComboBoxFormResize}"
									                  SelectedIndex="0"
                                                      Height="25"
                                                      FontSize="14"
                                                      ToolTip="Que hacer con registros existentes en base de datos"
									                  SelectionChanged="SeleccionComboBoxOpcion"
									                  ItemsSource="{Binding Path=G1cboRegistrosBdatos}"
									                  SelectedValuePath="ValorSeleccion">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblEliminarRegistros"
                                                       ToolTip="Eliminar registros existentes para el contrato seleccionado"
                                                       Grid.Column="0"
                                                       Style="{StaticResource styleEtiquetasVistaPropEtiqueta}">
                                                       <Run Language="es-co" Text="Eliminar registros existentes en base de datos para el contrato seleccionado"/>
                                            </TextBlock>
                                            <CheckBox Name="chkEliminar" 
													  Grid.Column="1"
													  HorizontalAlignment="Right" 
													  Margin="0,8,10,0" 
													  VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Name="objHistCortina" 
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Height="Auto"
                          Visibility="Collapsed"
                          Background="#CCFFFFFF" 
                          Margin="0"/>
                </Grid>
            </Canvas>
        </Grid>
        <!-- NAVEGADOR DE ETIQUETAS -->
        <Canvas Name="cvaEtiqueta" 
                Grid.Row="3"
                Margin="0,8,0,0"
                Height="540"
                Visibility="Visible" 
                Width="1020">
            <Grid Name="grdEtiqueta" Height="540" Width="1020" Margin="0,0,0,0" Canvas.Left="0" Canvas.Top="0">
                <Border Name="objBorderEtiqueta" BorderThickness="1" Background="#99060606"/>
                <TextBlock Name="lblTituloEtiqueta"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                	       Width="936"
                	       Margin="10,4,0,0" FontSize="20" Foreground="White">
                	       <Run Language="es-co" Text="Titulo Etiqueta..."/>
                </TextBlock>
                <Button Name="cmdEtiquetaOcultar"
                        Margin="0,3,14,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource styleButtonImgEdtFormTouch}"
                        TabIndex="50"
                        Click="fcvActivarEtiqueta"
                        ToolTip="Ocultar vista" 
                        Height="30" 
                        Width="60">
                    <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image Name="imgEtiquetaCerrar"
                               Source="/Sistema;component/Imagenes/Edt_edt_contraer3.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill" />
                    </StackPanel>
                </Button>
                <Grid Name="grdVistaErrores" Margin="14,35,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource styleBorderFondoForm}"
                        BorderThickness="1"
                        Grid.Row="0"
                        Grid.RowSpan="2">
                    </Border>
                    <Grid Margin="20,0,10,0" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="lblFiltroErrores"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   FontSize="16"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                <Run Language="es-co" Text="Filtro"/>
                        </TextBlock>
                        <TextBox Name="txtFiltroErrores"
                                 TabIndex="3"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Column="1"
                                 Grid.Row="0"
                                 Height="30"
                                 FontSize="16"
                                 TouchEnter="fcvTouchEnterTeclado"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                        <Button Name="cmdFiltroErrores"
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="8,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridErroresEjecutar"
                                ToolTip="Aplicar filtro en vista de errore" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgFiltroErrores" Source="/Sistema;component/Imagenes/Edt_edt_filtro1.png"/>
                            </StackPanel>
                        </Button>
                        <Button Name="cmdQFiltroErrores"
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="4,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridErroresQuitar"
                                ToolTip="Quitar filtro en vista errores" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                            <StackPanel Orientation="Horizontal">
                                <Image Name="imgQFiltroErrores" Source="/Sistema;component/Imagenes/Edt_edt_filtro2.png"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Name="txtErrorCompiler"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Height="Auto"
                             Width="Auto"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Visibility="Collapsed"
                             Margin="0,0,0,0"/>
                    <DataGrid Name="objDataGridErrores" 
                              AutoGenerateColumns="False"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Visible"
                              Grid.Row="1"
                              CanUserAddRows="False"
                              TabIndex="100">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="64" Header="Propiedad">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Height="25" Click="fcvGrillaIrAVistaRegistro" ToolTip="Ir al registro validado" >...</Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Secuencial}"
                                    Header="Secuencial"
                                    Width="70"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdRegistro}"
                                    Header="Registro"
                                    Width="60"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding NombreCampo}"
                                    Header="Campo"
                                    Width="240"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ValorCampo}"
                                    Header="Valor"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CodigoError}"
                                    Header="Codigo Error"
                                    Width="80"
                                    IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding MensajeError}"
                                    Header="Error"
                                    Width="480"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding NivelError}"
                                    Header="Nivel error"
                                    Width="90"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdUsuario}"
                                    Header="Identificación"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PApellido}"
                                    Header="Primer apellido"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SApellido}"
                                    Header="Segundo apellido"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PNombre}"
                                    Header="Primer nombre"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SNombre}"
                                    Header="Segundo nombre"
                                    Width="120"
                                    IsReadOnly="True">
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
