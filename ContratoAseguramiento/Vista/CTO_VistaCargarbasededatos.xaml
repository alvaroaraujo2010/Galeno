                                                 Text="3. Parametros para guardar en base de datos "/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblG1cto_seccon_cont"
                                                       ToolTip="Nuevo contrato para los registros a guardar en base de datos"
