<Window x:Class="ContratoAseguramiento.Vista.VistaCargarbasededatos"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:ContratoAseguramiento.Vista" 
        xmlns:Util="clr-namespace:ContratoAseguramiento.Utilidades" 
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        Title="Vista captura reportes" 
        Height="700" 
        Width="1024"  
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        WindowState="Maximized"
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Window.Resources>
        <CollectionViewSource x:Key="ItemCollectionViewSource" CollectionViewType="ListCollectionView"/>
        <Util:ForegroundColorEstado x:Key="ForegroundColorEstado"/>
        <Util:BackgroundColorEstado x:Key="BackgroundColorEstado"/>
    </Window.Resources>
    <Window.DataContext>
        <Binding Path="VistaModeloCargarbasededatos" Source="{StaticResource CTO_Locator}"/>
    </Window.DataContext>
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="4"
                Grid.Row="0"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="0"
               Margin="0,0,-1,-1" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" 
               Grid.RowSpan="2" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,52,02"
               Grid.Row="1"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="1"
                   FontFamily="Segoe UI Light"
                   Foreground="#FFFBF7F6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="15,0,0,4" 
                   Width="236" 
                   Height="21"/>
        <!-- ZONA DEL EDITOR -->
        <Grid Name="grdFondoEscritorio"  
              Grid.Row="0"
              Grid.RowSpan="2"
              Margin="10,30,10,25"
              Width="Auto"
			  Height="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="89*" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                        BorderThickness="1"
                        Grid.Row="0"
                        Grid.RowSpan="2">
            </Border>
            <Grid Margin="20,0,10,0" Grid.Row="0" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblFiltro"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   FontSize="16"
                                   Style="{StaticResource styleEtiquetasFormResize}">
                                <Run Language="es-co" Text="Filtro"/>
                </TextBlock>
                <TextBox Name="txtFiltro"
                                 TabIndex="3"
                                 Style="{StaticResource styleTextBoxFormResize}"
                                 Grid.Column="1"
                                 Grid.Row="1"
                                 Height="30"
                                 FontSize="16"
                                 TouchEnter="fcvTouchEnterTeclado"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdFiltro"
                                Grid.Row="0"
                                Grid.Column="3"
                                Grid.RowSpan="2"
                                Margin="8,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridEjecutar"
                                ToolTip="Aplicar filtro en vista de datos" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                    <StackPanel Orientation="Horizontal">
                        <Image Name="imgFiltro" Source="/Sistema;component/Imagenes/Edt_edt_filtro1.png"/>
                    </StackPanel>
                </Button>
                <Button Name="cmdQFiltro"
                                Grid.Row="0"
                                Grid.Column="4"
                                Grid.RowSpan="2"
                                Margin="4,4,0,0"
                                TabIndex="53"
                                Click="fcvFiltroDataGridQuitar"
                                ToolTip="Quitar filtro en vista de datos" 
                                Style="{StaticResource styleButtonImgEdtFormTouchMenu}">
                    <StackPanel Orientation="Horizontal">
                        <Image Name="imgQFiltro" Source="/Sistema;component/Imagenes/Edt_edt_filtro2.png"/>
                    </StackPanel>
                </Button>
            </Grid>
            <DataGrid Name="objDataGrid" 
                          AutoGenerateColumns="False"
                          Grid.Row="2"
                          DataContext="{StaticResource ItemCollectionViewSource}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="0,5,0,0"
                          RowDetailsVisibilityMode="Collapsed"
                          CanUserAddRows="False"
                          TabIndex="100">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" >
                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Item.Estado, Converter={StaticResource ForegroundColorEstado}}" />
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Item.BoolEstado, Converter={StaticResource BackgroundColorEstado}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="50" Header="Propiedad">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Height="25" Click="fcvGrillaMostrarDetalles" ToolTip="Propiedaes del registro" >...</Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Width="60" Binding="{Binding BoolEstado, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate x:Name="chkMarca">
                                <CheckBox Click="fcvSelectCheckBox" 
                                          ToolTip="incluido o excluido en validación y generar planos" 
                                          IsChecked="True" 
                                          Content="Incluir"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridCheckBoxColumn.HeaderTemplate>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding Ssp_ideaux_ctou}"
                                        Header="Registro"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_codeps_teps}"
                                        Header="Código EPS"
                                        Width="90"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_idesec_usua}"
                                            Header="Id unica del usuario"
                                            Width="140"
                                            IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_tipide_tide}"
                                        Header="Tipo id"
                                        Width="60"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_nroide_usua}"
                                        Header="Identificación"
                                        Width="140"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_priape_usua}"
                                        Header="Primer Apellido"
                                        Width="130"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_segape_usua}"
                                        Header="Segundo Apellido"
                                        Width="130"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_prinom_usua}"
                                        Header="Primer Nombre"
                                        Width="130"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_segnom_usua}"
                                        Header="Segundo Nombre"
                                        Width="130"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_fecnac_usua}"
                                        Header="Fecha Nacimiento"
                                        Width="130"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sis_codsex_sexo}"
                                        Header="Sexo"
                                        Width="70"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <!-- campos para contributivo  -->
                    <DataGridTextColumn Binding="{Binding Sia_tipcot_tcot}"
                                        Header="Tipo de Cotizante"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_tipafi_tafi}"
                                        Header="Tipo Afiliado"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_parent_tafi}"
                                        Header="Parentesco"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_conben_usua}"
                                        Header="Benef.Mayor 18"
                                        Width="120"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <!-- -->
                    <DataGridTextColumn Binding="{Binding Sis_coddep_dpto}"
                                        Header="Dpartamento"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sis_codmun_muni}"
                                        Header="Municipio"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sis_zonres_tzon}"
                                        Header="Zona Residencia"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_tippob_tpob}"
                                        Header="Tipo población"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_nivsbn_nsbn}"
                                        Header="nivel Sisben"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_fecsss_usua}"
                                        Header="Afiliación SGSSS"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sia_feceps_usua}"
                                        Header="Afiliación EPS"
                                        Width="100"
                                        IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NotaRegistro}"
                                            Header="Nota del registro"
                                            Width="280"
                                            IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0" Background="White" Padding="10">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Margin="45,0,0,0" Height="340" Width="900" Style="{StaticResource styleGridTabItemZona}" Background="#FFD2E5EA">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="400"/>
                                            <ColumnDefinition Width="10"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                        </Grid.RowDefinitions>
                                        <!-- DATOS DEL USUARIO -->
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   FontSize="20"
                                                   Style="{StaticResource styleEtiquetasFormResize}" Background="#66D8D3D3">
                                               <Run Language="es-co" Text="DATOS DEL USUARIO"/>
                                        </TextBlock>
                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_tipide_tide"
                                                               Grid.Column="0"
                                                               FontSize="14"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                               <Run Language="es-co" Text="Identificación del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_tipide_tide"
                                                                 TabIndex="4"
                                                                 FontSize="14"
                                                                 Text="{Binding Path=Sia_tipide_tide, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                 Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                                 Grid.Column="1"
                                                                 IsEnabled="False"/>
                                            <TextBox Name="txtSia_nroide_usua"
                                                                         FontSize="16"
                                                                         TabIndex="5"
                                                                         Text="{Binding Path=Sia_nroide_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                         Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                                         Grid.Column="2"
                                                                         IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_priape_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Primer apellido del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSsp_cam005_ms45"
                                                             TabIndex="6"
                                                             FontSize="16"
                                                             Text="{Binding Path=Sia_priape_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_segape_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Segundo apellido del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_segape_usua"
                                                             FontSize="16"
                                                             TabIndex="7"
                                                             Text="{Binding Path=Sia_segape_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="4" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_prinom_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Primer nombre del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_prinom_usua"
                                                             FontSize="16"
                                                             TabIndex="8"
                                                             Text="{Binding Path=Sia_prinom_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="5" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_segnom_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Segundo nombre del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_segnom_usua"
                                                             FontSize="16"
                                                             TabIndex="9"
                                                             Text="{Binding Path=Sia_segnom_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="6" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_fecnac_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Fecha de Nacimiento"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_fecnac_usua"
                                                             FontSize="16"
                                                             TabIndex="10"
                                                             Text="{Binding Path=Sia_fecnac_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="7" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSis_codsex_sexo"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Sexo de usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSis_codsex_sexo"
                                                             FontSize="16"
                                                             TabIndex="11"
                                                             Text="{Binding Path=Sis_codsex_sexo, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="8" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_edaymd_usua"
                                                               FontSize="14"
                                                               Grid.Column="0"
                                                               Style="{StaticResource styleEtiquetasFormResize}">
                                                           <Run Language="es-co" Text="Edad del usuario"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_edaymd_usua"
                                                             FontSize="16"
                                                             TabIndex="12"
                                                             Text="{Binding Path=Sia_edaymd_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                             Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                             Grid.Column="1"
                                                             IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="9" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_edames_usua"
                                                                   FontSize="14"
                                                                   Grid.Column="0"
                                                                   Style="{StaticResource styleEtiquetasFormResize}">
                                                               <Run Language="es-co" Text="Edad Usuario en meses"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_edames_usua"
                                                                 FontSize="16"
                                                                 TabIndex="12"
                                                                 Text="{Binding Path=Sia_edames_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                 Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                                 Grid.Column="1"
                                                                 IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="10" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Name="lblSia_edadia_usua"
                                                                       FontSize="14"
                                                                       Grid.Column="0"
                                                                       Style="{StaticResource styleEtiquetasFormResize}">
                                                                   <Run Language="es-co" Text="Edad Usuario en dias"/>
                                            </TextBlock>
                                            <TextBox Name="txtSia_edadia_usua"
                                                                     FontSize="16"
                                                                     TabIndex="12"
                                                                     Text="{Binding Path=Sia_edadia_usua, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                                     Grid.Column="1"
                                                                     IsEnabled="False"/>
                                        </Grid>
                                        <!-- DATOS VALIDACION -->
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   FontSize="20"
                                                   Style="{StaticResource styleEtiquetasFormResize}" Background="#66D8D3D3">
                                               <Run Language="es-co" Text="VALIDACIÓN"/>
                                        </TextBlock>
                                        <Grid Grid.Row="1" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="14"
                                                       Style="{StaticResource styleEtiquetasFormResize}">
                                                   <Run Language="es-co" Text="Errores en Validación"/>
                                            </TextBlock>
                                            <TextBox TabIndex="4"
                                                     FontSize="14"
                                                     Text="{Binding Path=Ssp_toterr_ctou, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                     Grid.Column="1"
                                                     IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="14"
                                                       Style="{StaticResource styleEtiquetasFormResize}">
                                                     <Run Language="es-co" Text="Nivel Errores"/>
                                            </TextBlock>
                                            <TextBox TabIndex="4"
                                                     FontSize="14"
                                                     Text="{Binding Path=Ssp_niverr_ctou, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                     Grid.Column="1"
                                                     IsEnabled="False"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Grid.RowSpan="6" Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="35"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row ="0"
                                                       FontSize="14"
                                                       Style="{StaticResource styleEtiquetasFormResize}">
                                                    <Run Language="es-co" Text="Nota del registro"/>
                                            </TextBlock>
                                            <TextBox TabIndex="4"
                                                     FontSize="12"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding Path=NotaRegistro, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                     Style="{StaticResource styleTextBoxEdtFormTouch}"
                                                     Grid.Row="1"
                                                     IsEnabled="False"/>
                                        </Grid>
                                        <!-- BOTONES -->
                                        <TextBlock Grid.Row="9"
                                                           Grid.Column="2"
                                                           FontSize="20"
                                                           Style="{StaticResource styleEtiquetasFormResize}" Background="#66D8D3D3">
                                                         <Run Language="es-co" Text="OPCIONES"/>
                                        </TextBlock>
                                        <Button Grid.Row="10"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Left"
                                                        Margin="10,0,0,0"
                                                        Width="90"
                                                        Click="fcvGrillamModificarRegistro"
                                                        ToolTip="Modificar valores del registro"
                                                        Content="Modificar"
                                                        Height="30"/>
                                        <Button Grid.Row="10"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Left"
                                                        Margin="102,0,0,0"
                                                        Width="90"
                                                        Click="fcvGrillaIrAVistaErrores"
                                                        ToolTip="Ver lista de errores en validacion"
                                                        Content="Ver Validación"
                                                        Height="30"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
