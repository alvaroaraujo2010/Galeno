<UserControl x:Class="Estadisticas.Vista.FcmControlGenPlanosRips"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Height="60"
             Width="680">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Name="brdFondo" 
                Background="#FFF1EEEE"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="1"
                BorderBrush="#FFD1CFCF"
                Grid.ColumnSpan="2"/>
        <Border Name="brdFondoFoto" 
                Background="White"
                Visibility="Visible"
                Margin="0,0,0,0"
                BorderThickness="1"
                BorderBrush="#FFD1CFCF"
                Grid.Column="0"/>
        <Image Name="imgArchivo"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="50"
                   Height="40"
                   Source="/Sistema;component/Imagenes/Edt_controles_xuser_captura.png"             
                   Margin="6,7,0,0"/>
        <Image Name="imgEstado"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Stretch="Fill"
                   Width="20"
                   Height="20"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_confirmado.png"             
                   Margin="5,35,0,0"/>
        <Grid Grid.Column="1"  Margin="2,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Name="brdFondo2" 
                        Background="White"
                        Visibility="Visible"
                        Margin="0,1,1,0"
                        BorderThickness="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"/>
                <TextBox Name="txtDescripArchivo"
                         BorderThickness="0"
                         Grid.Column="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="18"
                         Text="Nombre Archivo" 
                         Foreground="#FF27AEFB"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblIdArchivo"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="0">
                       <Run Language="es-co" Text="Archivo:"/>
                </TextBlock>
                <TextBox Name="txtNombreArchivo"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Grid.Column="1" 
                         VerticalAlignment="Top"/>
                <TextBlock Name="lblTotalRegistros"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="2">
                       <Run Language="es-co" Text="Registros:"/>
                </TextBlock>
                <TextBox Name="txtTotalRegistros"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Grid.Column="3"/>
                <TextBlock Name="lblPorcentaje"
                           Background="Transparent"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="4">
                       <Run Language="es-co" Text="Completado:"/>
                </TextBlock>
                <TextBox Name="txtPorcentaje"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="100%"
                         Grid.Column="5"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblFcm_horsol_ades"
                           Background="Transparent"
                           FontSize="12"
                           Visibility="Collapsed"
                           Foreground="#FF8D8C8C"                           
                           Grid.Column="0">
                       <Run Language="es-co" Text="Facturador:"/>
                </TextBlock>
                <TextBox Name="txtDes_ususol_usux"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Visibility="Collapsed"
                         Text="ADMIN"
                         Grid.Column="1" 
                         Foreground="#FF1582CD"/>
                <TextBlock Name="lblPeriodo"
                           Grid.Column="2"
                           Foreground="#FF8D8C8C"                           
                           FontSize="12">
                      <Run Language="es-co" Text="Periodo:"/>
                </TextBlock>
                <TextBox Name="txtFechaPeriodoIni"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="00/00/0000"
                         Grid.Column="3" 
                         Foreground="#FF1582CD"/>
                <TextBlock Name="lblSeparador"
                           Grid.Column="4"
                           Height="15"
                           Background="Transparent"
                           Foreground="#FF8D8C8C" 
                           TextAlignment="Center"
                           FontWeight="Bold"
                           FontSize="16" 
                           Margin="0,0,0,5">
                <Run Language="es-co" Text="-"/>
                </TextBlock>
                <TextBox Name="txtFechaPeriodoFin"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         FontSize="12"
                         Text="00/00/0000"
                         Grid.Column="5" 
                         Foreground="#FF1582CD"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
