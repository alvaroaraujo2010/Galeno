<Window x:Class="Estadisticas.Vista.EstInformesHospitalizados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:local="clr-namespace:Estadisticas.Vista" 
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Autorizar descuentos en caja facturación"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="700"
        Height="750"
        AllowsTransparency="True"
        Background="{x:Null}" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Background="#66000E0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="700"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="40" />
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
            </Border>
            <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <Image HorizontalAlignment="Left"
               Height="46"
               Margin="10,-9,0,0"
               VerticalAlignment="Top"
               Width="55"
               Stretch="Uniform"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sys_fcm01.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <TextBlock Text="Informes hospitalización"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <Button Name="cmdCerrar"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgEdtFormTouchExit}"
                    TabIndex="50"
                    Click="cmdSalir_Click"
                    ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Name="imgExit"
                           Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                    </Image>
                </StackPanel>
            </Button>
            <Image MouseDown="btnCerrar_KeyDown"
                   Style="{StaticResource styleImgButtonCerrarForm}"
                   Source="/Sistema;component/Imagenes/sis_cerrar40.png"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
                   Cursor="Hand"/>
            <Image HorizontalAlignment="Left"
                   Height="50"
                   Width="Auto"
                   Margin="1,3,1,0"
                   VerticalAlignment="Top"
                   Grid.Row="5"
                   Source="/Sistema;component/Imagenes/sis_fondo40.png"
                   StretchDirection="UpOnly"
                   Stretch="Fill"/>
            <Rectangle HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Grid.Row="2"
                       OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                       Fill="#FFF6F8F9"
                       Grid.RowSpan="2"/>
            <!-- PARAMETROS BASICOS -->
            <Grid Grid.Row="2" Margin="8,2,8,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblG1FechaInicial"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}">
                            <Run Language="es-co" Text="Fecha Inicio filtro"/>
                    </TextBlock>
                    <Grid Grid.Column="1"
                          Style="{StaticResource styleDatePickerGridFormResize}">
                        <Border Style="{StaticResource styleDatePickerBorder}"/>
                        <TextBox Name="txtG1FechaInicial"
                                 TabIndex="2"
                                 Style="{StaticResource styleTextBoxFormFecha}"
                                 TouchEnter="fcvTouchEnterTeclado"
                                 TextChanged="fcvActualizarDatePicker"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus" HorizontalAlignment="Left" Margin="2,3,0,0" Width="209"/>
                        <DatePicker Name="dpkG1FechaInicial"
                                    Style="{StaticResource styleDatePickerForm}"/>
                    </Grid>
                    <TextBlock Name="lblG1FechaFinal"
                               Grid.Column="2"
                               Style="{StaticResource styleEtiquetasFormResize}">
                            <Run Language="es-co" Text="Fecha final filtro"/>
                    </TextBlock>
                    <Grid Grid.Column="3"
                          Style="{StaticResource styleDatePickerGridFormResize}">
                        <Border Style="{StaticResource styleDatePickerBorder}"/>
                        <TextBox Name="txtG1FechaFinal"
                                 TabIndex="2"
                                 Style="{StaticResource styleTextBoxFormFecha}"
                                 TouchEnter="fcvTouchEnterTeclado"
                                 TextChanged="fcvActualizarDatePicker"
                                 KeyDown="fcvMoverFocus_KeyDown"
                                 GotFocus="fcvTextBox_GotFocus" HorizontalAlignment="Left" Margin="2,3,0,0" Width="209"/>
                        <DatePicker Name="dpkG1FechaFinal"
                                    Style="{StaticResource styleDatePickerForm}"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblG1TipoInforme"
                               Grid.Column="0"
                               Style="{StaticResource styleEtiquetasFormResize}">
                           <Run Language="es-co" Text="Tipo Informe"/>
                    </TextBlock>
                    <TextBox Name="txtG1TipoInforme"
                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                             TextChanged="fcvValidacionTexto"
                             Visibility="Collapsed"
                             Grid.Column="1"
                             Focusable="False"/>
                    <ComboBox Name="cboG1TipoInforme"
                              Grid.Column="1"
                              Style="{StaticResource styleComboBoxFormResize}"
                              FontSize="16"
                              Height="25"
                              SelectedIndex="0"
                              SelectionChanged="SeleccionComboBoxOpcion"
                              SelectedValuePath="ValorSeleccion">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=NombreOpcion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>
            <!-- PARAMETROS AVANZADOS -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- AGRUPAR -->
                <Grid Grid.Row="0" Margin="10,2,10,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource styleBorderFondoForm}"
                            Grid.Row="0"
                            Grid.RowSpan="2"/>
                    <TextBox Grid.Row="0"
                             FontSize="16"
                             Height="28"
                             Width="80"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Left"
                             Style="{StaticResource styleTextBoxVistaPropGrupo}" 
                             Foreground="#FF3399FF"
                             Text =" Agrupar..." Margin="4,2,0,0" Grid.RowSpan="2"/>
                    <local:ControlAddGrupo x:Name="crtAgrupar" 
                                           Grid.Row="1"
                                           Loaded="crtAgruparLoaded"
                                           Margin="10,1,10,10"/>
                </Grid>
                <!-- FILTRO -->
                <Grid Grid.Row="1" Margin="10,4,10,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource styleBorderFondoForm}"
                            Grid.Row="0"
                            Grid.RowSpan="2"/>
                    <TextBox Grid.Row="0"
                             FontSize="16"
                             Height="30"
                             Grid.ColumnSpan="3"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"
                             Style="{StaticResource styleTextBoxVistaPropGrupo}" 
                             Foreground="#FF3399FF"
                             Text =" Filtro..."/>
                    <local:ControlAddCondicion x:Name="crtCondiciones" 
                                           Grid.Row="1"
                                           Loaded="crtCondicionLoaded"
                                           Margin="10,1,10,10"/>

                </Grid>
            </Grid>
            <Button Name="cmdEjecutar"
                    Margin="183,10,0,0"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="22"
                    Grid.Row="4"
                    ToolTip="Ejecutar consulta" Click="cmdEjecutar_Click">
                <StackPanel Orientation="Horizontal"
                                    Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgEjecutar"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock Name="lblGuardar"
                               Text="Ejecutar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdSalir"
                    Margin="0,10,10,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="27"
                    Command="{Binding CmdSAL}"
                    Click="cmdSalir_Click"
                    Grid.Row="5"
                    ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="28"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- CORTINA DETECHA SELECCION-->
        <Grid Name="grdPropSelectArea" 
              Grid.Column="2"
              Width="20"
              Height="Auto"
              Margin="-20,110,0,60"
              MouseEnter="fcvActivarVistaSeleccionMouseEnter"
              TouchEnter="fcvActivarVistaSeleccionTouchEnter"
              HorizontalAlignment="Right" 
              Background="Transparent">
            <Canvas Name="cnvPropSelect" Width="42" >
                <!-- Capa Cortina Propiedades-->
                <Grid Name="grdPropSelect" 
                          Width="630"
                          Height="700"
                          Style="{StaticResource styleTabControlEdtGridCortinaPropiedades}"
                          Canvas.Left="22" 
                          Canvas.Top="-110" 
                          Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- IMAGEN ENCABEZADO VENTANA -->
                    <Border BorderThickness="1,1,1,0"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="0"
                           Background="White">
                    </Border>
                    <Border BorderThickness="1,0,1,1"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="1"
                           Background="#F2EEEEEE" Margin="0,1,0,-1"/>
                    <Button Name="cmdSelectOcultar"
                            Grid.Row="0"
                            Margin="10,6,6,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaPropiedades"
                            ToolTip="Ocultar la ventana propiedades" 
                            Height="42" 
                            Width="48">
                        <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                            <Image Name="imgSelect2"
                        		   Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                            </Image>
                        </StackPanel>
                    </Button>
                    <TextBlock Name="lblNombrePaciente"
                               Grid.Row="0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                	           Width="380"
                	           Margin="76,20,0,0" 
                               FontSize="18" 
                               Foreground="#FF978E8E" 
                               Height="21">
                	       <Run Language="es-co" Text="Solicitud descuentos"/>
                    </TextBlock>
                    <Grid Width="590" Margin="0,2,0,0" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="230"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
