<UserControl x:Class="Estadisticas.Vista.ControlAddCondicion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" 
             d:DesignWidth="670">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="37"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtControlAddCondicion" Visibility="Collapsed"/>
            <TextBox Name="txtIdItemSelect"
                     Style="{StaticResource styleTextBoxFormResizeDisable}"
                     Grid.Column="0"
                     Visibility="Collapsed"/>
            <ComboBox Name="cboListItems"
                      Grid.Column="0"
                      Style="{StaticResource styleComboBoxFormResize}"
                      SelectedIndex="0"
                      IsEnabled="False"
                      SelectionChanged="SeleccionComboBoxOpcion"
                      DisplayMemberPath="{Binding Path=NombreOpcion}"
                      SelectedValuePath="{Binding Path=ValorSeleccion}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Name="txtListCondiciones"
                     Style="{StaticResource styleTextBoxFormResizeDisable}"
                     Visibility="Collapsed"
                     Grid.Column="1"
                     Focusable="False"/>
            <ComboBox Name="cboListCondiciones"
                      Grid.Column="1"
                      Style="{StaticResource styleComboBoxFormResize}"
                      SelectedIndex="0"
                      SelectionChanged="SeleccionComboBoxOpcion"
                      DisplayMemberPath="{Binding Path=NombreOpcion}"
                      SelectedValuePath="{Binding Path=ValorSeleccion}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Name="txtValor"
                     Style="{StaticResource styleTextBoxFormResizeDisable}"
                     Visibility="Visible"
                     Grid.Column="2"/>
            <Button Name="cmdAddBrowser"
                    Content="..."
                    Style="{StaticResource styleButtonMiniFormBrows}"
                    TabIndex="107"
                    Grid.Column="3"/>
            <TextBox Name="txtDescripcion"
                     Style="{StaticResource styleTextBoxFormResizeDisable}"
                     Visibility="Visible"
                     Grid.Column="4"
                     FontSize="9"
                     Focusable="False"/>
            <Button Name="cmdAddItem"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="9"
                    Width="35"
                    Height="28"
                    IsEnabled="False"
                    Grid.Column="5"
                    ToolTip="Clic aqui para Agregar item" 
                    Click="cmdAddItem_Click">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           HorizontalAlignment="Left"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="Uniform"/>
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Name="PanelScroll" 
                      HorizontalAlignment="Stretch" 
                      Margin="10,0,10,5"
                      Width="Auto"
                      Height="Auto"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="HorizontalFirst"
                      CanContentScroll="False">
            <StackPanel Name="stkAgrupar"
					Grid.Row="2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Orientation="Vertical"
                    Height="Auto">
                <WrapPanel Name="wraCondiciones" 
                       Margin="0,0,0,0"
                       Background="Transparent"
                       Style="{StaticResource styleWrapPanelEdtFondoEditor}" 
                       Orientation="Horizontal">
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
