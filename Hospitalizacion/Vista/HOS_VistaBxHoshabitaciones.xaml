                                    Width="80"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Hos_dessec_hsec}"
                                    Header="Codigo sección"
                                    Width="100"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Hos_estcam_ecam}"
