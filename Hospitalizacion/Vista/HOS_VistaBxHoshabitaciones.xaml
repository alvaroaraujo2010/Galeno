                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgConfirmar"
                           Source="/Sistema;component/Imagenes/sis_edt_aceptar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblConfirmar"
                               Text="Confirmar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdGuardar"
