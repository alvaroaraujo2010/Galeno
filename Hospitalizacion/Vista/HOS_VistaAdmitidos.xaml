<Window x:Class="Hospitalizacion.Vista.VistaAdmitidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hospitalizacion.Vista"
        Title="Vista Admitidos" 
        Height="750" 
        Width="1024"  
        Name="MaxHOSVistaAdmitidos"
        ShowInTaskbar="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        KeyUp="MenuComponentes_KeyUp" 
        Icon="/Sistema;component/Imagenes/sis_logo40.png" >
    <Window.Resources>
        <Storyboard x:Key="OnMouseEnter1">
            <!-- Capa de del menu -->
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="GridMenuBottom" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.5000000" Value="-98"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeave1">
            <!-- Capa de del menu -->
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="GridMenuBottom" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="-98"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!--Capa de vista grupos -->
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter" SourceName="CanvasMenuBottom">
            <BeginStoryboard Storyboard="{StaticResource OnMouseEnter1}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave" SourceName="CanvasMenuBottom">
            <BeginStoryboard Storyboard="{StaticResource OnMouseLeave1}" x:Name="OnMouseLeave1_BeginStoryboard"/>
        </EventTrigger>
    </Window.Triggers>
    <Grid x:Name="MainGrid" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="35" />
            <RowDefinition Height="90*" />
        </Grid.RowDefinitions>
        <!-- Fondo General -->
        <Border Background="White"
                Margin="0,0,0,0"
                Grid.RowSpan="1"
                Grid.Row="0"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown"/>
        <Border Margin="0,0,0,0"
                Grid.Row="1"
                MouseLeftButtonDown="MainBgrndRct_MouseLeftButtonDown" 
                Background="#FFF1F0F0">
        </Border>
        <local:crtBuscar
                HorizontalAlignment="Left"
                Height="30" 
                Width="220"
                Grid.Row="1"
                Margin="20,1,0,0" Loaded="crtBuscar_Loaded"/>
        <TextBlock Name="lblPaciente"
                   HorizontalAlignment="Left" 
                   Width="670"
                   Margin="290,6,0,5"
                   Grid.Row="1"
                   FontFamily="Segoe UI Light"
                   FontSize="16"
                   Visibility="Collapsed"
                   Height="24"
                   Text="Admisión:"/>
        <Image HorizontalAlignment="Right" 
               VerticalAlignment="Top"
               Margin="0,83,10,0" 
               Height="47"
               RenderTransformOrigin="1.432,0.938"
               Source="/Sistema;component/Imagenes/sys_cit01.png" 
               Width="58" 
               Grid.RowSpan="2" />
        <TextBlock Name="txtnick" 
                   Text="Nick" 
                   FontFamily="Segoe UI Light" 
                   FontSize="12"
                   TextAlignment="Right"
                   HorizontalAlignment="Right" 
                   Margin="0,10,72,8" 
                   Width="160" 
                   Grid.Row="1" />
        <!-- Logo del Sistema -->
        <Image Name="ImgPpal" 
               Grid.Row="0" 
               Height="76" 
               Width="95"
               Stretch="Fill"
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Margin="17,17,0,0"
               Source="/Sistema;component/Imagenes/sys_adm01.png" />
        <!-- Titulo del Sistema -->
        <TextBlock x:Name="TextTitulo" 
        	Grid.Row="0" 
        	HorizontalAlignment="Stretch" 
        	VerticalAlignment="Top"
        	Margin="117,56,228,0" 
        	FontSize="26"  
        	FontFamily="Segoe UI Light" Height="35">
            <Run Text="Admitidos"/>
            <Run Language="es-co"/><Run Text=" "/>
            <LineBreak/>
            <Run Language="es-co"/></TextBlock>
        <!-- Boton Cerrar -->
        <Image MouseDown="CloseButton_Click" 
               Style="{StaticResource styleImgButtonCerrarFormMenu}"
               Grid.Row="0" 
               Cursor="Hand"
               TouchDown="CloseButton_TouchDown"
               Source="/Sistema;component/Imagenes/sys_cerrar.png"/>
        <!-- Fondo del Sistema -->
        <Image HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Grid.Row="2"
               Margin="0,0,0,-40" 
               Stretch="Fill"
               Source="/Sistema;component/Imagenes/sys_fondocomponentes.png" />
        <!-- Logo Midwssoft -->
        <Image Name="ImgMidwssoft" 
               Height="36" 
               Width="160"
               Margin="0,0,10,10"
               Grid.Row="2"
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom"
               Source="/Sistema;component/Imagenes/sys_logomidwssoft2.png"/>
        <!-- Hora del sistema-->
        <TextBlock Name="TxtHora" 
                   Grid.Row="2"
                   FontFamily="Segoe UI Light" 
                   FontSize="16"
                   Foreground="AntiqueWhite"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom"
                   Text="00:00:00 AM"
                   Margin="20,0,0,20" Width="402"/>
        <!-- Zona de los Tiles -->
        <Canvas x:Name="MainCanvas" 
                Grid.Row="2"
                Margin="0,0,0,0"
                ClipToBounds="True" 
                Background="#00000000" 
                PreviewTouchDown="fcvMainCanvas_PreviewTouchDown"
                PreviewTouchUp="fcvMainCanvas_PreviewTouchUp"
                PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp" >
            <!-- Barra que sale en la Zona inferior -->
            <StackPanel Width="Auto"
                        Height="600" 
                        Canvas.Left="45" 
                        Canvas.Top="11" 
                        x:Name="MetroStackPanel" 
                        Orientation="Horizontal" 
                        Background="#00000000" 
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
        </Canvas>
        <!-- MENU INFERIOR  -->
        <Canvas x:Name="CanvasMenuBottom" 
                VerticalAlignment="Bottom" 
                Height="30" Background="#00000000" 
                Margin="0,0,-1,0"  
                Grid.Row="2">
            <Grid x:Name="GridMenuBottom" 
                  Height="80" 
                  Canvas.Top="40" 
                  RenderTransformOrigin="0.5,0.5" 
                  Width="1024">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform AngleX="0" AngleY="0"/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="Capa" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="0,0,0,0"
                       Source="/Sistema;component/Imagenes/sys_panel_fondo3.png"
                       Stretch="Fill"/>
                <Image x:Name="imgFiltro" 
                       MouseDown="fcvFiltroBuscar" 
                       Width ="60" 
                       Height="60" 
                       Margin="300,10,13,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Cursor="Hand" 
                       Stretch="UniformToFill"
                       TouchDown="fcvFiltroBuscar_TouchDown"
                       ToolTip="Filtro por fechas y'profesional"
                       Source="/Sistema;component/Imagenes/sys_varios_calendario.png" />
                <Image x:Name="imgTurno" 
                       MouseDown="fcvBrowserBuscar" 
                       Width ="60" 
                       Height="60" 
                       Margin="380,10,0,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Stretch="UniformToFill"
                       Cursor="Hand" 
                       TouchDown="fcvBrowserBuscar_TouchDown"
                       ToolTip="Seleccionar profesional y un turno"
                       Source="/Sistema;component/Imagenes/sys_varios_citas.png"/>
                <Image x:Name="imgFiltroEstado" 
                       Width ="60" 
                       Height="60" 
                       Margin="460,10,0,0" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Stretch="UniformToFill"
                       Cursor="Hand" 
                       ToolTip="Filtro por estado de la cita"
                       Source="/Sistema;component/Imagenes/sys_varios_filtro.png"/>
                <Image x:Name="imgFacturacion" 
                	Width ="60" 
                	Height="60" 
                	Margin="539,10,0,0" 
                	HorizontalAlignment="Left" 
                	VerticalAlignment="Top"
                	Stretch="UniformToFill"
                	Cursor="Hand" 
                	ToolTip="Factuacion de Servicios"
                	Source="/Sistema;component/Imagenes/sys_varios_factura.png"/>
            </Grid>
        </Canvas>
        <!-- MENU CORTINA DE LA DERECHA-->
        <Canvas x:Name="ExtrasCanvas" 
                Margin="0,0,0,0" 
                Background="#00000000"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Height="806" 
                Width="32" 
                RenderTransformOrigin="0.5,0.5" 
                Grid.Row="1">
            <!-- Capa Cortina-->
            <Grid Name="ExtrasGrid"  
                  Width="270" 
                  Height="761" 
                  RenderTransformOrigin="0.5,0.5" 
                  Canvas.Left="33" 
                  Background="#99000000"
                  Canvas.Top="-100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="393*"/>
                </Grid.ColumnDefinitions>
                <Image HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Grid.Row="2"
                       Margin="0,0,0,0" 
                       Stretch="Fill"
                       Visibility="Collapsed"
                       Opacity="0.3"
                       Source="/Sistema;component/Imagenes/sys_panel_fondo8.png" />
                <!-- ENCABEZADO DEL MENU -->
                <Image HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       Margin="0,0,0,0"
                       Height="198"
                       Stretch="Fill"
                       Source="/Sistema;component/Imagenes/sys_panel_fondo7.png" />
                <Border BorderThickness="0"
                        BorderBrush="#FFB0AFAF"
                        Grid.Row="0"
                        Width="270"
                        Height="48"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" 
                        Background="#F2EEEEEE"/>
                <Button Name="cmdPropOcultar"
                        HorizontalAlignment="Right"
                        Style="{StaticResource styleButtonImgEdtFormTouch}"
                        TabIndex="50"
                        Click="fcvActivarVistaPropiedades"
                        ToolTip="Ocultar la ventan propiedades" 
                        Height="38" 
                        Width="45" Margin="0,6,7,0">
                    <StackPanel Orientation="Horizontal"
                                Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image Name="imgPropCerrar"
                               Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    </StackPanel>
                </Button>
                <Border BorderThickness="1"
                        BorderBrush="#FFB0AFAF"
                        Grid.Row="0"
                        Width="72"
                        Height="70"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" 
                        Background="#F2EEEEEE" 
                        Margin="10,8,0,0"/>
                <Image x:Name="imgADmFoto" 
                       Width="67" 
                       Height="65"  
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" 
                       Stretch="Fill"
                       ToolTip="Datos de la Admisión"
                       Source="/Sistema;component/Imagenes/sys_usu01.png" 
                       Margin="12,11,0,0"/>
                <TextBlock Name="lblCodigoAdmision"
                           HorizontalAlignment="Left"
                           Width="249"
                           Margin="14,83,0,652"
                           FontFamily="Segoe UI Symbol"
                           FontSize="20"
                           Text="000" 
                           Foreground="#FF6C6B6B"/>
                <TextBlock Name="lblTituloPaciente"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Width="81"
                           Margin="12,112,0,0"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           Text="PACIENTE" 
                           Foreground="#FF245FDE"/>
                <TextBlock Name="lblNombrePaciente"
                           HorizontalAlignment="Left"
                           Width="249"
                           Margin="11,129,0,590"
                           FontFamily="Segoe UI Symbol"
                           TextWrapping="Wrap"
                           FontSize="16"
                           Text="Paciente"
                           Foreground="#FF6C6B6B"/>
                <!-- MENU ADMITIDOS -->
                <StackPanel Name="tbsAmbulatoria"
                            Margin="20,230,0,0"
                            Orientation="Vertical">
                    <Button Name="cmdADMRegAdmision"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            Visibility="Collapsed"
                            ToolTip="Ver datos de la admisión"
                            Click="cmdADMAdmision_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_hos01.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Registro admisión">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHCLApertura"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            Visibility="Collapsed"
                            ToolTip="Realizar registro de apertura Historia clinica del paciente"
                            Click="cmdAperturaHCLClinica_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit04.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Nueva Historia">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHCLClinica"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Ver historia clinica del paciente"
                            Click="cmdHCLClinica_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_his01.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Historia Clinica">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHCLOrdenesMedicas"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            Visibility="Collapsed"
                            ToolTip="Generar nueva orden medica de servicios"
                            Click="cmdADMOrdenServicios_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit04.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Orden de servicios">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHOSTrasladoInterno"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Traslado interno de pacientes"
                            Click="cmdHOSTrasladoInterno_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_adm01.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Traslado pacientes">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdADMAutorizaEgreso"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Autorizar egreso del paciente"
                            Click="cmdADMAutorizSalida_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit02.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Autorización salida">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdHOSEgresoUrgencia"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Gestionar el egreso de urgencias"
                            Click="cmdHOSEgresoUrgencia_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_hos02.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       Text="Egreso de urgencias">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdADMEgreso"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Registo salida del paciente desde hospitalización (egreso)"
                            Click="cmdADMEgreso_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_hos03.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       FontSize="15"
                                       Text="Egreso Hospitalización">
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Name="cmdADMFinalizar"
                            Style="{StaticResource styleButtonMenuPropCapaTouch}"
                            TabIndex="50"
                            ToolTip="Finalizar atención medica y quitar de la vista"
                            Click="cmdADMFinalizar_Click">
                        <Grid Style="{StaticResource styleGridMenuPropCapaTouch}">
                            <Image Style="{StaticResource styleImageMenuPropCapaTouch}"
                                   Source="/Sistema;component/Imagenes/sys_cit02.png"
                                   Stretch="Uniform" />
                            <TextBlock Style="{StaticResource styleTextBlockMenuPropCapaTouch}"
                                       FontSize="15"
                                       Text="Finalizar atención">
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
