        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="10,10,10,10"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Hos_codcam_caho}"
                                    Header="Codigo"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Hos_descam_caho}"
                                    Header="Nombre cama"
                                    Width="280"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Hos_destip_tcam}"
                                    Header="Tipo camas"
                                    Width="180"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Hos_dessec_hsec}"
                                    Header="Sección/Area servicios"
                                    Width="150"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Hos_desest_ecam}"
                                    Header="Disponibilidad"
                                    Width="150"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Sis_estreg_esrg}"
                                    Header="Estado"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger
            		EventName="SelectionChanged">
                    <cmd:EventToCommand
            			Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
