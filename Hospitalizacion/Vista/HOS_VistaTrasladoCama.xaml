                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG2sis_estpro_espr"
                                           ToolTip="Estado del registro de estancia: 1=Abierto 2=confirmado 3= Anulado"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado Traslado"/>
                </TextBlock>
                <TextBox Name="txtG2Sis_estpro_espr"
                                         TabIndex="18"
                                         Text="{Binding Path=G2Sis_despro_espr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="4">
            <Rectangle HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Grid.Row="4"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,1,0"/>
            <Button Name="cmdGuardar"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="22"
                    Command="{Binding CmdSAVREL}"
                    Click="fcvGuardarRegistroRel"
                    ToolTip="Adicionar registros" Margin="0,8,228,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgGuardarx"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblGuardarx"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdAnular"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="25"
                    Command="{Binding CmdDELREL}"
                    Click="fcvEliminarRegistroRel"
                    ToolTip="Anular registro de traslado" Margin="0,8,11,0">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgAnular"
                               Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblAnular"
                                   Text="Anular"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdCancelar"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="24"
                    Command="{Binding CmdCAN}"
                    Click="fcvCancelarRegistro"
                    ToolTip="Cancelar los cambios" 
                    Margin="0,8,119,0">
                    <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                        <Image x:Name="imgCancelar"
                               Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                        <TextBlock x:Name="lblCancelar"
                                   Text="Cancelar"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                    </StackPanel>
            </Button>
            <Button Name="cmdAdicionar"
                    HorizontalAlignment="Right"
                    Style="{StaticResource styleButtonImgForm}"
                    TabIndex="25"
                    Command="{Binding CmdCANREL}"
                    Click="fcvNuevoRegistroRel"
                    ToolTip="Nuevo registro" Margin="0,8,119,0">
                <StackPanel Orientation="Horizontal"
                            Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgNuevo"
                               Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                               Style="{StaticResource styleImagBotonesForm}"
                               Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblNuevo"
                                   Text="Nuevo"
            	                   Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <DataGrid AutoGenerateColumns="False"
                      Grid.Row="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="10,45,10,10"
                      Name="objDataGrid"
                      ItemsSource="{Binding TmpG2ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                      CanUserAddRows="False"
                      TabIndex="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Hos_codant_caho}"
                                    Header="Cama anterior"
                                    Width="130"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hos_codcam_caho}"
                                    Header="Nueva cama"
                                    Width="130"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hos_descam_caho}"
                                    Header="Descripción nueva cama"
                                    Width="350"
                                    IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Hos_fecing_espa, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="Fecha traslado"
                                    Width="90"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Hos_horing_espa}"
                                    Header="Hora"
                                    Width="90"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <cmd:EventToCommand  Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            			                     CommandParameter="{Binding SelectedItem, ElementName=objDataGrid}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
        </Grid>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="27"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="28"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdBrowser"
                Margin="145,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="77"
                Command="{Binding CmdDFL}"
                Click="fcvBrowserBuscar"
                Grid.Row="5"
                ToolTip="Buscar registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgBrowser"
                           Source="/Sistema;component/Imagenes/sis_edt_buscar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblBrowser"
                               Text="Buscar..."
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdConfiguracion"
                Margin="112,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="79"
                Width="110"
                Visibility="Collapsed"
                Command="{Binding CmdDFL}"
                Click="fcvMostrarMenuEdicion"
                Grid.Row="5"
                ToolTip="Clic para ajustes">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgConfiguracion"
                           Source="/Sistema;component/Imagenes/sis_edt_configurar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblConfiguracion"
                               Text="Configuración"
                               Width="80"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
            <Button.ContextMenu>
                <ContextMenu Style="{StaticResource styleMenuContextButton}">
                    <MenuItem Name="opMODEDT"
                                          Command="{Binding CmdMODEDT}"
                                          Click="fcvConfigModoGuardar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Modo Edición: Guardar Registro (por defecto)">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_modificar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Name="opMODCON"
                                          Command="{Binding CmdMODCON}"
                                          Click="fcvConfigModoConfirmar"
                                          Style="{StaticResource styleMenuItemContextButton}"
                                          Header="Modo Edición: Confirmar Registro">
                        <MenuItem.Icon>
                            <Image Stretch="UniformToFill"
                                               Style="{StaticResource styleImagMenuContextButton}"
                                               Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</Window>