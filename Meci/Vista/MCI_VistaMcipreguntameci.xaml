             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus" Grid.ColumnSpan="2" Margin="5,0,0,0"/>
            </Grid>
        </Grid>
        <!-- Fin tercera fila -->
