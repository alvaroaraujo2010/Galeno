                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Código de Parámetro"/>
                </TextBlock>
                <TextBox Name="txtG1Mci_idesec_mcpa"
                                         TabIndex="7"
                                         Text="{Binding Path=G1Mci_idesec_mcpa, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
