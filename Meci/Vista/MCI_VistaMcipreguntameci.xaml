                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
            <TextBox Name="txtG1Mci_desgrp_mcgr"
                                         TabIndex="106"
                                         Text="{Binding Path=G1Mci_desgrp_mcgr, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
