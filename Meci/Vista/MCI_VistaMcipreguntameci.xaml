                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Etiqueta Pregunta"/>
                </TextBlock>
                <TextBox Name="txtG1Mci_etqpre_mcpr"
                                         TabIndex="8"
