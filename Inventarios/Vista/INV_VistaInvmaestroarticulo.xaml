<Window x:Class="Inventarios.Vista.VistaInvmaestroarticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Path=VistaModeloInvmaestroarticulo, Source={StaticResource INV_Locator}}"
        Title="Maestro de articulos"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="950"
        Height="750"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Name="grdPrincipal" Background="#66000E0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="grdCol1" Width="*"/>
            <ColumnDefinition Name="grdCol2" Width="950"/>
            <ColumnDefinition Name="grdCol3" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="750"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="42" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
            </Border>
            <Image HorizontalAlignment="Left"
               Height="40"
               Width="Auto"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
            <TextBlock Text="Maestro de articulos"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <Button Name="cmdCerrar"
               Grid.Row="1"
               HorizontalAlignment="Right"
               Style="{StaticResource styleButtonImgEdtFormTouchExit}"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               TabIndex="150"
               Click="cmdSalir_Click"
               ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                    Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                    </Image>
                </StackPanel>
            </Button>
            <Image HorizontalAlignment="Left"
               Height="50"
               Width="Auto"
               Margin="1,3,1,0"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
            <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="948"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
            <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
            </TextBlock>
            <TextBox Height="23"
                     Grid.Row="2"
                     Margin="130,7,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Name="txtFiltroDatos"
                     Width="389"
                     Style="{StaticResource styleTextBoxForm}"
                     Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
                     TabIndex="1"
                     KeyDown="fcvMoverFocus_KeyDown"
                     GotFocus="fcvTextBox_GotFocus"/>
            <TextBlock Height="23"
                       Grid.Row="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,7,292,0"
                       Name="lblTipoVistaFiltro"
                       Width="97"
                       FontSize="16"
                       FontFamily="Arial Unicode MS" >
                <Run Language="es-co" Text="TIPO VISTA"/>
            </TextBlock>
            <TextBox Name="txtG1TipoFiltroVista"
                         TabIndex="177"
                         Style="{StaticResource styleTextBoxFormResize}"
                         Grid.Row="2"
                         Visibility="Collapsed"
                         TextChanged="ActualizarComboBoxOpcion"/>
            <ComboBox Name="cboG1TipoFiltroVista"
                      Margin="0,7,12,0"
                      Grid.Row="2"
                      Height="24"
                      Width="280"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      FontSize="14"
                      Style="{StaticResource styleComboBoxFormResize}"
                      SelectedIndex="0"
                      SelectionChanged="SeleccionComboBoxOpcion"
                      DisplayMemberPath="{Binding Path=NombreOpcion}"
                      SelectedValuePath="{Binding Path=ValorSeleccion}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=NombreOpcion}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Filtro -->
            <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}"/>
            <!-- Fin Filtro-->
            <!-- Perfil Usuario -->
            <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
            <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
            <!-- Fin Perfil Usuario -->
            <!-- Control modo edicion formulario -->
            <TextBox Name="lblFormModoPopup"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrSIS_FormModoPopup,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89"/>
            <!-- Fin Control modo edicion formulario -->
            <DataGrid AutoGenerateColumns="False"
                      Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="4,10,16,10"
                      Name="grdDetalles"
                      ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                      CanUserAddRows="False"
                      TabIndex="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Inv_secart_inar}"
                                    Header="Secuencial"
                                    Width="80"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_codaux_inar}"
                                    Header="Código Auxiliar"
                                    Width="120"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_codbar_inar}"
                                    Header="Código Barra"
                                    Width="130"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_nomart_inar}"
                                    Header="Nombre artículo"
                                    Width="280"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_lotref_inar}"
                                    Header="Referencia"
                                    Width="120"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_regsan_inar}"
                                    Header="Registro sanitario"
                                    Width="120"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_codgru_ingr}"
                                    Header="Grupo"
                                    Width="80"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_desgru_ingr}"
                                    Header="Descripcion Grupo"
                                    Width="150"
                                    IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Inv_codsub_insg}"
                                    Header="Subgrupo"
                                    Width="80"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Inv_dessub_insg}"
                                    Header="Descripcion Subgrupo"
                                    Width="150"
                                    IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Inv_estart_inar}"
                                    Header="Estado"
                                    Width="180"
                                    IsReadOnly="True">
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            					                CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </DataGrid>
            <Button Name="cmdGuardar"
                Margin="382,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="34"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdAdicionar"
                Margin="382,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="35"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdCancelar"
                Margin="485,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="36"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdModificar"
                Margin="485,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="37"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdEliminar"
                Margin="588,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="38"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="39"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
            <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="40"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- CORTINA DETECHA SELECCION-->
        <Grid Name="grdPropSelectArea" 
              Grid.Row="0"
              Grid.Column="2"
              Grid.RowSpan="2"
              Width="20"
              Height="Auto"
              Margin="-20,110,0,60"
              MouseEnter="fcvActivarVistaSeleccionMouseEnter"
              TouchEnter="fcvActivarVistaSeleccionTouchEnter"
              HorizontalAlignment="Right" 
              Background="Transparent">
            <Canvas Name="cnvPropSelect" Width="42">
                <!-- Capa Cortina Propiedades-->
                <Grid Name="grdPropSelect" 
                          Width="500"
                          Height="750"
                          Style="{StaticResource styleTabControlEdtGridCortinaPropiedades}"
                          Canvas.Left="22" 
                          Canvas.Top="-110" 
                          Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- IMAGEN ENCABEZADO VENTANA -->
                    <Border BorderThickness="1,1,1,0"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="0"
                           Background="White">
                    </Border>
                    <TextBlock Name="txtPropDetallesTitulo" 
                               Text="Propiedades"
                               Grid.Row="0"
                               FontSize="16"
                               Foreground="#FF224AA0"
                               Style="{StaticResource styleTituloForm}" 
                               Margin="63,24,10,0" Height="26"/>
                    <Border BorderThickness="1,0,1,1"
                            BorderBrush="#FFB0AFAF"
                            Grid.Row="1"
                            Background="#F2EEEEEE" 
                            Grid.RowSpan="4"/>
                    <Button Name="cmdSelectOcultar"
                            Grid.Row="0"
                            Margin="10,6,6,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource styleButtonImgEdtFormTouch}"
                            TabIndex="50"
                            Click="fcvActivarVistaSeleccion"
                            ToolTip="Ocultar la ventana seleccion canciones" 
                            Height="42" 
                            Width="48">
                        <StackPanel Orientation="Horizontal"
                                        Style="{StaticResource styleStackPanelBotonesForm}">
                            <Image Name="imgSelect2"
                        		   Source="/Sistema;component/Imagenes/Edt_edt_contraer.png"
                        		   Style="{StaticResource styleImagBotonesForm}"
                        		   Stretch="UniformToFill">
                            </Image>
                        </StackPanel>
                    </Button>
                    <ScrollViewer Name="PanelScroll" 
                                  Margin="0,20,0,15"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch" 
                                  Width="Auto"
                                  Height="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  PanningMode="HorizontalFirst"
                                  CanContentScroll="False">
                        <StackPanel Name="stkBasicas">
                            <Expander Name="expBasicas" 
                                      Header="Propiedades" 
                                      HorizontalAlignment="Left" 
                                      Margin="10,5,0,0" 
                                      VerticalAlignment="Top" 
                                      Width="470" 
                                      FontSize="18"
                                      Focusable="False"
                                      IsExpanded="False">
                                <Grid Name="grdPropBasicas">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="45"/>
                                        <RowDefinition Height="45"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="8"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0"
                                             Foreground="#FF3399FF"
                                             BorderBrush="#FF3399FF"
                                             FontSize="14"
                                             Height="22"
                                             Style="{StaticResource styleTextBoxVistaPropGrupo}"
                                             Text="Propiedades básicas" 
                                             Margin="0,1,0,2"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblG1inv_secart_inar"
                                               ToolTip="Secuencial de articulo generado por el sistema"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Secuencial Unico"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_secart_inar"
                                             TabIndex="1"
                                             Text="{Binding Path=G1Inv_secart_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResizeDisable}"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             Focusable="False"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblG1inv_codaux_inar"
                                               ToolTip="Código Auxiliar del articulo puede ser digitado por el usuario"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Código Auxiliar"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_codaux_inar"
                                             TabIndex="2"
                                             Text="{Binding Path=G1Inv_codaux_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             MaxLength="20"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblG1inv_codbar_inar"
                                               ToolTip="Código de Barra Artículo"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Código Barra"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_codbar_inar"
                                             TabIndex="3"
                                             Text="{Binding Path=G1Inv_codbar_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             MaxLength="20"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblG1inv_regsan_inar"
                                               ToolTip="Registro sanitario (IMVIMA)"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Registro sanitario"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_regsan_inar"
                                             TabIndex="4"
                                             Text="{Binding Path=G1Inv_regsan_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource styleTextBoxFormResize}"
                                             MaxLength="30"
                                             TouchEnter="fcvTouchEnterTeclado"
                                             Grid.Column="1"
                                             IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                             KeyDown="fcvMoverFocus_KeyDown"
                                             GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Name="lblG1inv_nomart_inar"
                                               ToolTip="Nombre del artículo para vista en informes y gestion"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Nombre artículo"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_nomart_inar"
                                                 TabIndex="5"
                                                 Text="{Binding Path=G1Inv_nomart_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 MaxLength="80"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 Grid.RowSpan="2"
                                                 Height="40"
                                                 TextWrapping="Wrap"
                                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Name="lblG1inv_desart_inar"
                                               ToolTip="Descripción del larga del artículo 250 caracteres"
                                               Grid.Column="0"
                                               Style="{StaticResource styleEtiquetasFormResize}">
                                               <Run Language="es-co" Text="Descripción Artículo"/>
                                        </TextBlock>
                                        <TextBox Name="txtG1Inv_desart_inar"
                                                 TabIndex="6"
                                                 Text="{Binding Path=G1Inv_desart_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                 Style="{StaticResource styleTextBoxFormResize}"
                                                 MaxLength="250"
                                                 TouchEnter="fcvTouchEnterTeclado"
                                                 Grid.Column="1"
                                                 Grid.RowSpan="2"
                                                 Height="40"
                                                 TextWrapping="Wrap"
                                                 IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                                 KeyDown="fcvMoverFocus_KeyDown"
                                                 GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="7">
                                        <Grid.ColumnDefinitions>
