<!-- MARMOTA-GENCODE: VERSION 2.0 - 16/08/2017 06:15:04 PM -->
<Window x:Class="Inventarios.Vista.VistaInvperiodomaest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Path=VistaModeloInvperiodomaest, Source={StaticResource INV_Locator}}"
        Title="Maestro gestion periodos inventario"
        Icon="/Sistema;component/Imagenes/sis_logo40.png"
        Width="1130"
        Height="730"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="42" />
            <RowDefinition Height="40" />
            <RowDefinition Height="45*" />
            <RowDefinition Height="156*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource styleBorderFondoForm}"
                Grid.RowSpan="5"
                Grid.Row="1">
        </Border>
        <Image HorizontalAlignment="Left"
               Height="40"
               Width="1130"
               Margin="0,0,0,0"
               VerticalAlignment="Top"
               Grid.Row="1"
               Source="/Sistema;component/Imagenes/sys_barratitulo.png"
               StretchDirection="UpOnly"
               Stretch="Fill"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Image HorizontalAlignment="Left"
               Height="50"
               Margin="5,1,0,0"
               VerticalAlignment="Top"
               Width="50"
               Grid.RowSpan="2"
               Source="/Sistema;component/Imagenes/sis_logo40.png"
               MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <TextBlock Text="Maestro gestion periodos inventario"
                   Grid.Row="1"
                   Style="{StaticResource styleTituloForm}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Button Name="cmdCerrar"
               Grid.Row="1"
               HorizontalAlignment="Right"
               Style="{StaticResource styleButtonImgEdtFormTouchExit}"
               IsEnabled="{Binding Path=GlgSIS_ModoDefault}"
               TabIndex="150"
               Click="cmdSalir_Click"
               ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                    Style="{StaticResource styleStackPanelBotonesForm}">
                <Image Name="imgExit"
                       Source="/Sistema;component/Imagenes/sis_cerrar01.png">
                </Image>
            </StackPanel>
        </Button>
        <Image HorizontalAlignment="Left"
               Height="50"
               Width="1130"
               Margin="1,3,0,-3"
               VerticalAlignment="Top"
               Grid.Row="5"
               Source="/Sistema;component/Imagenes/sis_fondo40.png"
               StretchDirection="UpOnly"
               Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Height="40"
               Width="798"
               Grid.Row="2"
               OpacityMask="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
               Fill="#FFF6F8F9"
               Margin="1,0,0,0"/>
        <TextBlock Height="23"
                   Grid.Row="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="19,7,0,0"
                   Name="lblFiltro"
                   Width="109"
                   FontSize="16"
                   FontFamily="Arial Unicode MS" >
        <Run Language="es-co" Text="BUSCAR"/>
        </TextBlock>
        <TextBox Height="23"
             Grid.Row="2"
             Margin="130,7,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Name="txtFiltroDatos"
             Width="280"
             Style="{StaticResource styleTextBoxForm}"
             Text="{Binding GcrFiltroDatos, UpdateSourceTrigger=PropertyChanged}"
             TabIndex="1"
             KeyDown="fcvMoverFocus_KeyDown"
             GotFocus="fcvTextBox_GotFocus"/>
        <!-- Filtro -->
        <Button Content="Filtro..."
                Height="26"
                HorizontalAlignment="Left"
                Margin="395,7,0,0"
                Name="cmdFilVista1"
                VerticalAlignment="Top"
                Width="89"
                Visibility="Hidden"
                Command="{Binding CmdFIL}" Grid.RowSpan="2"/>
        <!-- Fin Filtro-->
        <!-- Perfil Usuario -->
        <TextBox Name="lblSysUsuIdUsuario"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuIdUsuario,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <TextBox Name="lblSysUsuCodigoPerfil"
                 HorizontalAlignment="Left"
                 Visibility="Hidden"
                 Text="{Binding Path=GcrUsuCodigoPerfil,UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Height="23"
                 Width="89" Grid.RowSpan="2"/>
        <!-- Fin Perfil Usuario -->
        <Grid Grid.Row="3" Margin="8,2,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1inv_codper_inpe"
                                           ToolTip="Perido gestion datos (suma año + mes) ejemplo:  año 2016 mes febrero = 201602"
                                           Grid.Column="0"                          
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Código periodo"/>
                </TextBlock>
                <TextBox Name="txtG1Inv_codper_inpe"
                                         TabIndex="1"
                                         Text="{Binding Path=G1Inv_codper_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         MaxLength="6"
                                         Focusable="False"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoAdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1inv_desper_inpe"
                                           ToolTip="Descripcion textual del periodo"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Descripcion"/>
                </TextBlock>
                <TextBox Name="txtG1Inv_desper_inpe"
                                         TabIndex="2"
                                         Text="{Binding Path=G1Inv_desper_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         MaxLength="30"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtG1Inv_desalm_inal"
                                         TabIndex="103"
                                         Text="{Binding Path=G1Inv_desalm_inal, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResizeDisable}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="3"
                                         Focusable="False"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                <Button Name="cmdG1Inv_codalm_inal"
                                        Content="..."
                                        Style="{StaticResource styleButtonMiniFormBrows}"
                                        TabIndex="103"
                                        Click="cmdG1Inv_codalm_inal_Click"
                                        Grid.Column="2"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        ToolTip="Código del Almacén que realiza el movimiento"/>
                <TextBlock Name="lblG1inv_codalm_inal"
                                           ToolTip="Código del Almacén que realiza el movimiento"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Código Almacén"/>
                </TextBlock>
                <TextBox Name="txtG1Inv_codalm_inal"
                                         TabIndex="3"
                                         Text="{Binding Path=G1Inv_codalm_inal, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="txtG1Inv_codalm_inal_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblG1inv_fecini_inpe"
                                           ToolTip="Fecha inicio perodo"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Fecha inicio"/>
                </TextBlock>
                <Grid Grid.Column="1"
                                  Style="{StaticResource styleDatePickerGridFormResize}">
                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                    <TextBox Name="txtG1Inv_fecini_inpe"
                                         TabIndex="4"
                                         Text="{Binding Path=G1Inv_fecini_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormFecha}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         TextChanged="fcvActualizarDatePicker"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                    <DatePicker Name="dpkG1Inv_fecini_inpe"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
                <TextBlock Name="lblG1inv_fecfin_inpe"
                                           ToolTip="Fecha fin del perodo"
                                           Grid.Column="2"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Fecha final"/>
                </TextBlock>
                <Grid Grid.Column="3"
                                  Style="{StaticResource styleDatePickerGridFormResize}">
                    <Border Style="{StaticResource styleDatePickerBorder}"/>
                    <TextBox Name="txtG1Inv_fecfin_inpe"
                                         TabIndex="5"
                                         Text="{Binding Path=G1Inv_fecfin_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormFecha}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         TextChanged="fcvActualizarDatePicker"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
                    <DatePicker Name="dpkG1Inv_fecfin_inpe"
                                        IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                        Style="{StaticResource styleDatePickerForm}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
               
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cboG1Inv_peract_inpe"
                            	Grid.Column="2"
                            	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                            	Style="{StaticResource styleComboBoxFormResize}"
                            	SelectedIndex="0"
                            	SelectionChanged="SeleccionComboBoxOpcion"
                            	ItemsSource="{Binding Path=G1CbInv_peract_inpe}"
                            	SelectedValuePath="ValorSeleccion">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1inv_peract_inpe"
                                           ToolTip="Periodo activo gestion actual:  1=Periodo actual de gestion 2=Periodo anterior 3=Cerrado"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado Periodo"/>
                </TextBlock>
                <TextBox Name="txtG1Inv_peract_inpe"
                                         TabIndex="6"
                                         Text="{Binding Path=G1Inv_peract_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         TextChanged="ActualizarComboBoxOpcion"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cboG1Inv_estreg_inpe"
                            	Grid.Column="2"
                            	IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                            	Style="{StaticResource styleComboBoxFormResize}"
                            	SelectedIndex="0"
                            	SelectionChanged="SeleccionComboBoxOpcion"
                            	ItemsSource="{Binding Path=G1CbInv_estreg_inpe}"
                            	SelectedValuePath="ValorSeleccion">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=NombreOpcion}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Name="lblG1inv_estreg_inpe"
                                           ToolTip="Estado del registro 1=Abierto 2=Cerrado"
                                           Grid.Column="0"
                                           Style="{StaticResource styleEtiquetasFormResize}">
                                           <Run Language="es-co" Text="Estado Registro"/>
                </TextBlock>
                <TextBox Name="txtG1Inv_estreg_inpe"
                                         TabIndex="7"
                                         Text="{Binding Path=G1Inv_estreg_inpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource styleTextBoxFormResize}"
                                         TouchEnter="fcvTouchEnterTeclado"
                                         Grid.Column="1"
                                         TextChanged="ActualizarComboBoxOpcion"
                                         IsEnabled="{Binding Path=GlgSIS_ModoEdicion}"
                                         KeyDown="fcvMoverFocus_KeyDown"
                                         GotFocus="fcvTextBox_GotFocus"/>
            </Grid>
        </Grid>
        <DataGrid AutoGenerateColumns="False"
                  Grid.Row="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="10,10,10,10"
                  Name="grdDetalles"
                  ItemsSource="{Binding TmpG1ListaBrow, UpdateSourceTrigger=PropertyChanged}"
                  CanUserAddRows="False"
                  TabIndex="100">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Inv_codper_inpe}"
                                    Header="Periodo"
                                    Width="97"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_desper_inpe}"
                                    Header="Descripcion"
                                    Width="143"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_codalm_inal}"
                                    Header="Código"
                                    Width="97"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_desalm_inal}"
                                    Header="Almacén"
                                    Width="260"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Inv_fecini_inpe, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="Fecha inicio"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_fecfin_inpe, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="Fecha final"
                                    Width="80"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_desperact_inpe}"
                                    Header="Estado periodo"
                                    Width="160"
                                    IsReadOnly="True">
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Inv_destreg_inpe}"
                                    Header="Estado registro"
                                    Width="160"
                                    IsReadOnly="True">
                </DataGridTextColumn>
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
                Margin="270,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="8"
                Command="{Binding CmdSAV}"
                Click="fcvGuardarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para guardar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgGuardar"
                           Source="/Sistema;component/Imagenes/sis_edt_guardar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblGuardar"
                               Text="Guardar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdAdicionar"
                Margin="270,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="9"
                Command="{Binding CmdADD}"
                Click="fcvNuevoRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para crear un nuevo registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgAdicionar"
                           Source="/Sistema;component/Imagenes/sis_edt_adicionar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblAdicionar"
                               Text="Nuevo"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdCancelar"
                Margin="373,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="10"
                Command="{Binding CmdCAN}"
                Click="fcvCancelarRegistro"
                Grid.Row="5"
                ToolTip="Cancelar los cambios">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgCancelar"
                           Source="/Sistema;component/Imagenes/sis_edt_cancelar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblCancelar"
                               Text="Cancelar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdModificar"
                Margin="373,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="11"
                Command="{Binding CmdEDT}"
                Click="fcvModificarRegistro"
                Grid.Row="5"
                ToolTip="Haga clic aqui para modificar el registro activo">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgModificar"
                           Source="/Sistema;component/Imagenes/sis_edt_modificar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblModificar"
                               Text="Modificar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdEliminar"
                Margin="476,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="12"
                Command="{Binding CmdDEL}"
                Grid.Row="5"
                ToolTip="Eliminar este registro">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgEliminar"
                           Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblEliminar"
                               Text="Eliminar"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdSalir"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="13"
                Command="{Binding CmdSAL}"
                Click="cmdSalir_Click"
                Grid.Row="5"
                ToolTip="Salir de esta pantalla">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgSalir"
                           Source="/Sistema;component/Imagenes/sis_edt_salir.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblSalir"
                               Text="Salir"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
        <Button Name="cmdLogErrores"
                Margin="10,10,0,0"
                Style="{StaticResource styleButtonImgForm}"
                TabIndex="14"
                Command="{Binding CmdERR}"
                Click="fcvVistaLogErrores"
                Grid.Row="5"
                ToolTip="Ver registro de errores">
            <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                <Image x:Name="imgLogErrores"
                           Source="/Sistema;component/Imagenes/sis_edt_agrupar.png"
                           Style="{StaticResource styleImagBotonesForm}"
                           Stretch="UniformToFill"/>
                <TextBlock x:Name="lblLogErrores"
                               Text="Errores"
            	               Style="{StaticResource styleLblBotonesForm}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
