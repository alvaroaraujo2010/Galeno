                            				     TouchEnter="fcvTouchEnterTeclado"
                            				     Grid.Column="3"
                            				     Focusable="False"
                            				     KeyDown="fcvMoverFocus_KeyDown"
                            				     GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblG2inv_codest_ines"
                            				       ToolTip="Codgo del estante para cada almacen: Ejemplo E01-Estante Medicamentos de control"
                            				       Grid.Column="0"
                            				       Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Código Estante"/></TextBlock>
                                        <TextBox x:Name="txtG3Inv_codest_ines"
                            				     TabIndex="8"
                            				     Text="{Binding G3Inv_codest_ines, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            				     Style="{StaticResource styleTextBoxFormResize}"
                            				     TouchEnter="fcvTouchEnterTeclado"
                            				     FontSize="15"
                            				     Height="25"
                            				     Grid.Column="1"
                            				     Focusable="True"
                            				     IsEnabled="{Binding GlgSIS_ModoEdicion}"
                            				     KeyDown="fcvMoverFocus_KeyDown"
                            				     GotFocus="fcvTextBox_GotFocus"/>
                                        <TextBlock x:Name="lblG2inv_seccio_ines"
                            				       ToolTip="Lista de secciones del estante para validacion (generada por el sistema) ejemplo: S01,S02,S03,S04 según el numero de secciones que contenga el estante"
                            				       Grid.Column="2"
                            				       Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Sección"/></TextBlock>
                                        <TextBox x:Name="txtG3Inv_seccio_ines"
                            				     TabIndex="9"
                            				     Text="{Binding G3Inv_seccio_ines, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            				     Style="{StaticResource styleTextBoxFormResize}"
                            				     FontSize="15"
                            				     Height="25"
                            				     MaxLength="10"
                            				     TouchEnter="fcvTouchEnterTeclado"
                            				     Grid.Column="3"
                            				     Focusable="True"
                            				     IsEnabled="{Binding GlgSIS_ModoEdicion}"
                            				     KeyDown="fcvMoverFocus_KeyDown"
                            				     GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="119"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblG2inv_totaju_injd"
                            				       FontSize="12"                           
                            				       Height="25"                                                                       
                            				       ToolTip="UNIDADES DIGITADAS, cantidad de unidades digitadas para realizar calculo según tipo ajuste 1= Reconteo Total inventario 2= Por suma o Resta de Unidades"
                            				       Grid.Column="0"
                            				       Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Unidades digitadas"/></TextBlock>
                                        <TextBox x:Name="txtG3Inv_totaju_injd"
                            				     FontSize="12"                         
                            				     Height="25"                                                                     
                            				     TabIndex="10"
                            				     Text="{Binding G3Inv_totaju_injd, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            				     Style="{StaticResource styleTextBoxFormResize}"
                            				     MaxLength="10"
                            				     TouchEnter="fcvTouchEnterTeclado"
                            				     Grid.Column="1"
                            				     IsEnabled="{Binding GlgSIS_ModoEdicion}"
                            				     KeyDown="fcvMoverFocus_KeyDown"
                            				     GotFocus="fcvTextBox_GotFocus"/>
                                        <TextBox x:Name="txtSis_desume_sium"
                            				     FontSize="12"                         
                            				     Height="25"                                                                     
                            				     TabIndex="112"
                            				     Text="{Binding G3Sis_desume_sium, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            				     Style="{StaticResource styleTextBoxFormResizeDisable}"
                            				     TouchEnter="fcvTouchEnterTeclado"
                            				     Grid.Column="3"
                            				     Focusable="False"
                            				     KeyDown="fcvMoverFocus_KeyDown"
                            				     GotFocus="fcvTextBox_GotFocus"/>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="cmdGuardarRegKa"                                                
                            				    Style="{StaticResource styleButtonImgForm}"
                            				    Margin="7,2,0,0"
                            				    TabIndex="11"
                            				    Command="{Binding CmdSAVKAR}"
                            				    Click="fcvGuardarRegKar"
                            				    Grid.Column="1"
                            				    Height="25"
                            				    ToolTip="Haga clic para crear nuevo registro vacio" 
                            				    Width="80">
                                            <StackPanel Orientation="Horizontal"
                            					Style="{StaticResource styleStackPanelBotonesForm}">
                                                <Image x:Name="imgAgregar"
                            				     	   Source="/Sistema;component/Imagenes/Edt_edt_confirmar.png"                                                     
                            						   Style="{StaticResource styleImagBotonesForm}"
                            						   Stretch="UniformToFill" Height="17" Width="18"/>
                                                <TextBlock x:Name="lblGuardarRegKa"
                            						       Text="Guardar"
                            						       Style="{StaticResource styleLblBotonesForm}" 
                            						       Height="16" 
                            						       Width="42"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="cmdNuevoRegKa"                                               
                            				    Command="{Binding CmdCANKAR}"
                            				    Style="{StaticResource styleButtonImgForm}"
                            				    TabIndex="12"
                            				    Margin="7,2,0,0"
                            				    Height="25"
                            				    Click="fcvNuevoRegistroKardex"
                            				    Grid.Column="2"
                            				    ToolTip="Haga clic para crear nuevo registro vacio" 
                            				    Width="80">
                                            <StackPanel Orientation="Horizontal"
                            					        Style="{StaticResource styleStackPanelBotonesForm}">
                                                <Image x:Name="imgNuevo"
                            						   Source="/Sistema;component/Imagenes/Edt_edt_adicionar.png"
                            						   Style="{StaticResource styleImagBotonesForm}"
                            						   Stretch="UniformToFill" Height="17" Width="18"/>
                                                <TextBlock x:Name="lblNuevo"
                            						       Text="Nuevo"
                            						       Style="{StaticResource styleLblBotonesForm}" Height="16" Width="36"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="cmdDelRegKa"
                            				    Grid.Column="3"
                            				    Margin="7,2,0,0"                                                
                            				    Style="{StaticResource styleButtonImgForm}"
                            				    TabIndex="81"
                            				    Height="25"
                            				    Command="{Binding CmdDELKAR}"
                            				    Click="fcvEliminarRegKar"               
                            				    ToolTip="Eliminar registro activo de la lista" 
                            				    Width="80">
                                            <StackPanel Orientation="Horizontal"
                            				     	    Style="{StaticResource styleStackPanelBotonesForm}">
                                                <Image x:Name="imgDelRegKa"
                            						   Source="/Sistema;component/Imagenes/sis_edt_eliminar.png"
                            						   Style="{StaticResource styleImagBotonesForm}"
                            						   Stretch="UniformToFill" Height="17" Width="18"/>
                                                <TextBlock x:Name="lblDelRegKa"
                            						       Text="Eliminar"
                            						       Style="{StaticResource styleLblBotonesForm}" Height="16" Width="40"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid Grid.Row="6">
                                        <DataGrid AutoGenerateColumns="False"
                            				      HorizontalAlignment="Stretch"
                            				      VerticalAlignment="Stretch"    
                            				      x:Name="objDataGridVistaLotes"  
                            				      FontSize="11"
                            				      ItemsSource="{Binding TmpG3ListaBrowLot, UpdateSourceTrigger=PropertyChanged}"
                            				      CanUserAddRows="False"
                            				      TabIndex="100">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Inv_lotref_inar}"
                            						                Header="Lote"
                            						                Width="90"
                            						                IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Inv_fecven_inka, StringFormat=\{0:dd/MM/yyyy\}}"
                            						                Header="Fecha Vencimiento"
                            						                Width="105"
                            						                IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Inv_totuni_inex}"
                            						                Header="Total unidades"
                            						                Width="80"
                            						                IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Inv_totaju_injd}"
                            						                Header="U. digitadas"
                            						                Width="80"
                            						                IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Inv_codest_ines}"
                            						                Header="Ubicacion"
                            						                Width="105"
                            						                IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <cmd:EventToCommand CommandParameter="{Binding SelectedItem, ElementName=objDataGridVistaLotes}" 
                                                                        Command="{Binding SelectionChangedKardex, Mode=TwoWay}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                    <Grid Grid.Row="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="cmdAddAux"                                                
                            				    Content="Guardar"
                            				    Grid.Column="1"
                            				    Margin="12,3,0,0"
                            				    Style="{StaticResource styleButtonMiniForm}"
                            				    TabIndex="19"
                            				    Command="{Binding CmdSAVREL}"
                            				    Click="fcvGuardarRegistroRel"                                              
                            				    ToolTip="Adicionar registro en la Grid"/>
                                        <Button x:Name="cmdCanAux"
                            				    Content="Nuevo"
                            				    Grid.Column="2"
                            				    Margin="12,3,0,0"                                                
                            				    Style="{StaticResource styleButtonMiniForm}"
                            				    TabIndex="80"
                            				    Command="{Binding CmdCANREL}"
                            				    Click="fcvNuevoRegistroRel"               
                            				    ToolTip="Nuevo o deshacer cambios en registro modificado"/>
                                        <Button x:Name="cmdDelAux"
                            				    Content="Eliminar" 
                            				    Grid.Column="3"
                            				    Margin="12,3,0,0"                                                
                            				    Style="{StaticResource styleButtonMiniForm}"
                            				    TabIndex="81"
                            				    Command="{Binding CmdDELREL}"
                            				    Click="fcvEliminarRegistroRel"               
                            				    ToolTip="Eliminar registro activo de la lista"/>
                                    </Grid>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>