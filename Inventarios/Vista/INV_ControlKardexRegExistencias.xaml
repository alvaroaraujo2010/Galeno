<UserControl x:Class="Inventarios.Vista.ControlKardexRegExistencias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="110" 
             d:DesignWidth="300"
             Height="40"
             Width="460">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0.9,0,0"
                BorderBrush="#FFD1CFCF"
                Grid.Row="0"/>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="txtInv_lotref_inar" 
                     Style="{StaticResource styleTextBoxFormResize}"
                     IsReadOnly="True"
                     Grid.Column="0"/>
            <TextBox Name="txtInv_fecven_inka" 
                     Style="{StaticResource styleTextBoxFormResize}"
                     IsReadOnly="True"
                     Grid.Column="1"/>
            <TextBox Name="txtInv_totuni_inex" 
                     Style="{StaticResource styleTextBoxFormResize}"
                     IsReadOnly="True"
                     Grid.Column="2"/>           
            <TextBox Name="txtInv_codest_ines" 
                     Style="{StaticResource styleTextBoxFormResize}"
                     IsReadOnly="True"
                     Grid.Column="3"/>
            <Image Name="imgEstado"
                   Grid.Column="5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,3,12,0"
                   Width="20"
                   Height="20"
                   Source="/Sistema;component/Imagenes/Edt_hist_vista_abierto.png"
                   Stretch="UniformToFill"/>
            <Button Name="cmdEliminar"
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Eliminar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialDel"
                       Height="20"
                       Width="20"
                       Source="/Sistema;component/Imagenes/Edt_hist_vista_anulado.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
            <Button Name="cmdVerRegistro"
                    Grid.Column="6"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Style="{StaticResource styleButtonImgEdtFormTouchMini}"
                    TabIndex="50"
                    ToolTip="Ver o editar registro" 
                    Height="30" 
                    Cursor="Hand"
                    Width="40" 
                    Margin="0,2,2,0">
                <StackPanel Orientation="Horizontal"
                        Style="{StaticResource styleStackPanelBotonesForm}">
                    <Image x:Name="imgHistorialVer"
                       Height="20"
                       Width="20"
                       Source="/Sistema;component/Imagenes/Edt_edt_propiedades.png"
                       Style="{StaticResource styleImagBotonesForm}"
                       Stretch="UniformToFill">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
