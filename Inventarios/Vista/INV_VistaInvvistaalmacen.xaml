                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblG1inv_valcos_inex"
                            				       ToolTip="Valor total en costo de compra de actuales existencias en almacen"
                            				       Grid.Column="0"
                            				       Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Valor total costo"/></TextBlock>
                                        <TextBox x:Name="txtG1Inv_valcos_inex"
                            			      	TabIndex="10"
                            			    	Text="{Binding G1Inv_valcos_inex, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            				    Style="{StaticResource styleTextBoxFormResize}"
                            				    IsReadOnly="True"
                            				    MaxLength="17"
                            				    Grid.Column="1" />
                                    </Grid>
                                    <Grid Grid.Row="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="cmdVerExistencias"
                            				    Content="Ver Existencias" 
                            			       	Grid.Column="1" 
                            				    Style="{StaticResource styleButtonMiniForm}"
                            				    Command="{Binding CmdEXIST}"
                            				    Click="fcvVistaExistencias"
                            				    HorizontalAlignment="Center"
                            				    FontSize="15"
                            				    Margin="14,5,12,0" VerticalAlignment="Top" 
                            				    Width="130"
                            				    Height="25"
                            			    	ToolTip="Haga clic aqui para ver las existencias del articulo seleccionado"/>
                                    </Grid>
                                </Grid>
                            </Expander>
                            <Expander x:Name="expPropiedades"                                     
                                      Header="Existencias" 
                                      HorizontalAlignment="Left" 
                                      Margin="10,5,0,0" 
                                      VerticalAlignment="Top" 
                                      Width="470" 
                                      FontSize="18"
                                      Focusable="False"
                                      IsExpanded="False">
                                <Grid x:Name="grdPropiedades" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="230"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblG2inv_lotref_inar"
                            				        FontSize="12"                           
                            			        	Height="25"                                                                       
                            			           	ToolTip="Lote o Referencia del articulo Artículo"
                            			           	Grid.Column="0"
                            				        Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Lote o Referencia"/></TextBlock>
                                        <TextBox x:Name="txtG2Inv_lotref_inar"
                            		           		TabIndex="10"
                            			        	Text="{Binding G3Inv_lotref_inar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            			         	Grid.Column="1"              
                            			        	Style="{StaticResource styleTextBoxFormResize}"
                            			        	IsReadOnly="True" />
                                        <TextBlock x:Name="lblG3inv_fecven_inka"
                            				        FontSize="12"                           
                            				        Height="25"                                                                       
                            			        	ToolTip="Fecha vencimiento"
                            	        			Grid.Column="2"
                                     				Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Fecha Vencimiento"/></TextBlock>
                                          <TextBox x:Name="txtG3Inv_fecven_inka"
                                    				FontSize="12"                         
                            	         			TabIndex="10"
                            		           		Text="{Binding G3Inv_fecven_inka, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            		          		Style="{StaticResource styleTextBoxFormResize}"
                            			        	Grid.Column="3"                                                 
                            				        IsReadOnly="True"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="119"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblG3inv_totuni_inex"
                            	        			FontSize="12"                           
                            			        	Height="25"                                                                       
                            				        ToolTip="TOTAL UNIDADES EN ALMACEN, cantidad de unidades en existencias fisicas desde almacen (teniendo en cuenta el lote)"
                            		           		Grid.Column="0"
                            			        	Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Existencias"/></TextBlock>
                                        <TextBox x:Name="txtG3Inv_totuni_inex"
                            				       TabIndex="13"
                                    				Text="{Binding G3Inv_totuni_inex, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            	           			Style="{StaticResource styleTextBoxFormResizeDisable}"
                            		          		IsReadOnly="True"
                            				        MaxLength="10"
                            				        Grid.Column="1" />
                                        <TextBox x:Name="txtG3Sis_desume_sium"
                            				        FontSize="12"                         
                            				        TabIndex="112"
                            	        			IsReadOnly="True"
                            		        		Text="{Binding G3Sis_desume_sium, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            		        		Style="{StaticResource styleTextBoxFormResizeDisable}"
                            		        		Grid.Column="3"/>
                                                </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"                           
                            		         		Height="25"                                                                       
                            			        	ToolTip="Lote o referencia del articulo"
                            				        Grid.Column="0"
                            				        TextAlignment="Center"
                            				        Style="{StaticResource styleEtiquetasFormResize}" Margin="10,0,7,0"><Run Language="es-co" Text="Lote/Ref"/></TextBlock>
                                        <TextBlock FontSize="12"                           
                            			        	Height="25"                                                                       
                            			        	ToolTip="fecha de vencimiento del producto"
                            		        		Grid.Column="1"
                            			        	TextAlignment="Center"
                            		        		Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="F. Vencimiento"/></TextBlock>
                                        <TextBlock FontSize="12"                           
                            		        		Height="25"                                                                       
                            			        	ToolTip="Total unidades existencias"
                                    				Grid.Column="2"
                            		        		TextAlignment="Center"
                            				        Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Existencias"/></TextBlock>                                        
                                        <TextBlock FontSize="12"                           
                            				        Height="25"                                                                       
                            				        ToolTip="Codigo de estante para cada almacen"
                            			    	    Grid.Column="3"
                            			        	Style="{StaticResource styleEtiquetasFormResize}"><Run Language="es-co" Text="Ubicacion"/></TextBlock>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <!-- DETALLES EXISTENCIAS KARDEX -->
                                        <ScrollViewer x:Name="PanelScrollProp"
                            			            	HorizontalAlignment="Stretch" 
                            				            Width="Auto"
                            				            VerticalScrollBarVisibility="Auto"
                                        				HorizontalScrollBarVisibility="Hidden"
                            			            	CanContentScroll="False"
                            			            	Height="Auto" 
                            		            		Margin="2,2,2,2">
                                            <StackPanel x:Name="stkKardex"
                            					        Orientation="Vertical"
                            				        	Height="Auto"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Canvas>
        </Grid>
    </Grid>
</Window>
