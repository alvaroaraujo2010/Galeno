                <DataGridTextColumn Binding="{Binding Fcm_codcpr_cpro}"
                                    Header="Cent.Prod"
                                    Width="65"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding Fcm_descpr_cpro}"
                                    Header="Centro producción"
                                    Width="170"
                                    IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Sia_descat_ceat}"
                                    Header="Centro atención"
                                    Width="130"
                                    IsReadOnly="True" />
            </DataGrid.Columns>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <cmd:EventToCommand Command="{Binding SelectionChangedCommand, Mode=TwoWay}"
            							CommandParameter="{Binding SelectedItem, ElementName=grdDetalles}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </DataGrid>
        <Button Name="cmdGuardar"
